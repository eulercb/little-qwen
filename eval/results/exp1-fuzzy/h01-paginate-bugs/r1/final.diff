diff --git a/page/page.go b/page/page.go
index 4876b58..99bc39d 100644
--- a/page/page.go
+++ b/page/page.go
@@ -28,17 +28,19 @@ func Get[T any](items []T, size, n int) (Page[T], error) {
 	if n < 1 {
 		return Page[T]{}, ErrBadPage
 	}
-	total := len(items)/size + 1
-	if len(items) == 0 {
-		total = 0
-	}
+	total := (len(items) + size - 1) / size
 	start := (n - 1) * size
-	end := start + size
-	if end > len(items) {
-		end = len(items) - 1
+	var itemsOut []T
+	if start < len(items) {
+		end := start + size
+		if end > len(items) {
+			end = len(items)
