+
+func TestMergeDoesNotMutateArguments(t *testing.T) {
+	base := Config{Tags: []string{"a", "b"}}
+	ov := Config{Tags: []string{"c"}}
+	c := Merge(base, ov)
+	if len(base.Tags) != 2 || base.Tags[0] != "a" || base.Tags[1] != "b" {
+		t.Fatalf("base mutated: %v", base.Tags)
