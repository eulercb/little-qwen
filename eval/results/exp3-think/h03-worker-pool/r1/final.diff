+// TestLowestErrorIndex verifies Map reports the failing input with the lowest
+// index, not the error that happened to arrive first.
+func TestLowestErrorIndex(t *testing.T) {
+	errLate := errors.New("late failure")
+	errEarly := errors.New("early failure")
+	for k := 0; k < 10; k++ {
+		_, err := Map(context.Background(), []int{0, 1, 2, 3, 4, 5, 6, 7}, 2, func(_ context.Context, x int) (int, error) {
+			switch x {
+			case 6:
+				time.Sleep(10 * time.Millisecond) // fails fast
+				return 0, errLate
+			case 1:
+				time.Sleep(80 * time.Millisecond) // fails slow
+				return 0, errEarly
+			}
+			return x, nil
+		})
+		var ie *IndexError
+		if !errors.As(err, &ie) {
+			t.Fatalf("err = %v, want *IndexError", err)
+		}
+		if ie.Index != 1 {
+			t.Fatalf("Index = %d, want 1 (err=%v)", ie.Index, ie.Err)
+		}
+		if !errors.Is(err, errEarly) {
+			t.Fatalf("wrapped err = %v, want %v", ie.Err, errEarly)
+		}
+	}
+}
