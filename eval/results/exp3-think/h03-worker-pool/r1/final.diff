+// TestCancellation verifies Map returns promptly with ctx.Err() after
+// cancellation and does not leak goroutines.
+func TestCancellation(t *testing.T) {
+	before := runtime.NumGoroutine()
+	ctx, cancel := context.WithCancel(context.Background())
+	in := make([]int, 20)
+	for i := range in {
+		in[i] = i
+	}
+	var called atomic.Int64
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		cancel()
+	}()
+	done := make(chan struct{})
+	var err error
+	start := time.Now()
+	go func() {
+		_, err = Map(ctx, in, 4, func(c context.Context, x int) (int, error) {
+			called.Add(1)
+			<-c.Done() // long-running work that respects ctx
+			return 0, nil
+		})
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Map did not return after ctx cancellation")
+	}
+	if time.Since(start) > 3*time.Second {
+		t.Fatalf("Map took %v after cancellation", time.Since(start))
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+	// No goroutine leaks: when Map returns, all workers must be gone.
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if runtime.NumGoroutine() <= before {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("goroutine leak: %d now, was %d", runtime.NumGoroutine(), before)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	// New work must stop once the context is cancelled: the number of fn
+	// calls must be stable (no calls after Map returns / stop takes effect).
+	c1 := called.Load()
+	time.Sleep(100 * time.Millisecond)
+	if c2 := called.Load(); c2 != c1 {
+		t.Fatalf("new work started after cancellation: calls %d -> %d", c1, c2)
+	}
+}
