+// TestOrdering verifies out[i] is the result for in[i] even when results
+// arrive out of order under concurrency.
+func TestOrdering(t *testing.T) {
+	in := make([]int, 500)
+	for i := range in {
+		in[i] = i
+	}
+	done := make(chan struct{})
+	var out []int
+	var err error
+	go func() {
+		out, err = Map(context.Background(), in, 16, func(_ context.Context, x int) (int, error) {
+			// Make results arrive in an order unrelated to input order.
+			time.Sleep(time.Duration(500-x) * time.Microsecond)
+			return x * 2, nil
+		})
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Map hung")
+	}
+	if err != nil || len(out) != len(in) {
+		t.Fatalf("out=%v err=%v", out, err)
+	}
+	for i, r := range out {
+		if r != in[i]*2 {
+			t.Fatalf("out[%d]=%d, want %d", i, r, in[i]*2)
+		}
+	}
+}
