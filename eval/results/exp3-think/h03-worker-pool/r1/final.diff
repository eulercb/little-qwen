+// TestErrorStopsNewWork verifies that once a call fails, Map stops starting
+// new work and the running calls all finish.
+func TestErrorStopsNewWork(t *testing.T) {
+	in := make([]int, 1000)
+	for i := range in {
+		in[i] = i
+	}
+	var started, finished atomic.Int64
+	boom := errors.New("boom")
+	out, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+		started.Add(1)
+		if x == 0 {
+			return 0, boom // fails immediately
+		}
+		time.Sleep(100 * time.Millisecond)
+		finished.Add(1)
+		return x, nil
+	})
+	if out != nil {
+		t.Fatalf("out = %v, want nil", out)
+	}
+	var ie *IndexError
+	if !errors.As(err, &ie) || ie.Index != 0 || !errors.Is(err, boom) {
+		t.Fatalf("err = %v, want IndexError{0, boom}", err)
+	}
+	// No new work after the error: the started count must be stable.
+	s1, f1 := started.Load(), finished.Load()
+	time.Sleep(200 * time.Millisecond)
+	if s2, f2 := started.Load(), finished.Load(); s2 != s1 || f2 != f1 {
+		t.Fatalf("work still in flight: started %d->%d, finished %d->%d", s1, s2, f1, f2)
+	}
+	if s1 > 64 {
+		t.Fatalf("too much new work started after failure: %d", s1)
+	}
+}
