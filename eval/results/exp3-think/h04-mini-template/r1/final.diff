+// Package tmpl is a tiny text template engine supporting {{ name | filter }}
+// tags.
+package tmpl
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Render substitutes {{ ... }} tags in src using the values in data.
+// Text outside tags is copied verbatim; {{{{ emits a literal {{.
+func Render(src string, data map[string]any) (string, error) {
+	var b strings.Builder
+	for i := 0; i < len(src); {
+		if strings.HasPrefix(src[i:], "{{{{") {
+			b.WriteString("{{")
+			i += 4
+			continue
+		}
+		idx := strings.Index(src[i:], "{{")
+		if idx < 0 {
+			b.WriteString(src[i:])
+			break
+		}
+		b.WriteString(src[i : i+idx])
+		if strings.HasPrefix(src[i+idx:], "{{{{") {
+			b.WriteString("{{")
+			i = i + idx + 4
+			continue
+		}
+		body := src[i+idx+2:]
+		end := strings.Index(body, "}}")
+		if end < 0 {
+			return "", fmt.Errorf("unterminated tag %q", body)
+		}
+		val, err := evalTag(body[:end], data)
+		if err != nil {
+			return "", err
+		}
+		b.WriteString(val)
+		i = i + idx + 2 + end + 2
+	}
+	return b.String(), nil
+}
+
+// tagParser walks the inside of a {{ ... }} tag.
+type tagParser struct {
+	s string
+	i int
+}
+
+func (t *tagParser) skip() {
+	for t.i < len(t.s) && isSpace(t.s[t.i]) {
+		t.i++
+	}
+}
+
+func (t *tagParser) parseName() (string, bool) {
+	if t.i >= len(t.s) || !isStart(t.s[t.i]) {
+		return "", false
+	}
+	start := t.i
+	for t.i < len(t.s) && isIdent(t.s[t.i]) {
+		t.i++
+	}
+	name := t.s[start:t.i]
+	for t.i < len(t.s) && t.s[t.i] == '.' {
+		t.i++
+		segStart := t.i
+		if t.i >= len(t.s) || !isStart(t.s[t.i]) {
+			return "", false
+		}
+		for t.i < len(t.s) && isIdent(t.s[t.i]) {
+			t.i++
+		}
+		name += "." + t.s[segStart:t.i]
+	}
+	return name, true
+}
+
+// parseArg reads a double-quoted argument, handling \" and \\ escapes.
+func (t *tagParser) parseArg() (string, bool) {
+	if t.i >= len(t.s) || t.s[t.i] != '"' {
+		return "", false
+	}
+	t.i++
+	var b strings.Builder
+	for t.i < len(t.s) {
+		c := t.s[t.i]
+		switch {
+		case c == '"':
+			t.i++
+			return b.String(), true
+		case c == '\\':
+			if t.i+1 >= len(t.s) {
+				return "", false
+			}
+			n := t.s[t.i+1]
+			if n != '"' && n != '\\' {
+				return "", false
+			}
+			b.WriteByte(n)
+			t.i += 2
+		default:
+			b.WriteByte(c)
+			t.i++
+		}
+	}
+	return "", false
+}
+
+func isStart(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdent(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
+
+// evalTag evaluates the body of one tag against data.
+func evalTag(body string, data map[string]any) (string, error) {
+	t := &tagParser{s: body}
+	t.skip()
+	full, ok := t.parseName()
+	if !ok {
+		if strings.TrimSpace(body) == "" {
+			return "", fmt.Errorf("empty tag %q", body)
+		}
+		return "", fmt.Errorf("bad name in tag %q", body)
+	}
+	segments := strings.Split(full, ".")
+	val, err := lookup(full, segments, data)
+	if err != nil {
+		return "", err
+	}
+	s := format(val)
+	t.skip()
+	if t.i < len(t.s) && t.s[t.i] != '|' {
+		return "", fmt.Errorf("bad name in tag %q", body)
+	}
+	for t.skip(); t.i < len(t.s); {
+		if t.s[t.i] != '|' {
+			return "", fmt.Errorf("unexpected %q in tag %q", t.s[t.i:], body)
+		}
+		t.i++
+		t.skip()
+		fname, ok := t.parseName()
+		if !ok {
+			return "", fmt.Errorf("bad filter name in tag %q", body)
+		}
+		t.skip()
+		hasArg := false
+		var arg string
+		if t.i < len(t.s) && t.s[t.i] == ':' {
+			t.i++
+			t.skip()
+			a, ok := t.parseArg()
+			if !ok {
+				return "", fmt.Errorf("bad argument for filter %s in tag %q", fname, body)
+			}
+			arg = a
+			hasArg = true
+		}
+		var err error
+		s, err = applyFilter(fname, hasArg, arg, s)
+		if err != nil {
+			return "", err
+		}
+		t.skip()
+	}
+	return s, nil
+}
+
+// lookup resolves dotted name segments against nested maps.
+// A missing name or nil value yields (nil, nil); indexing a non-map errors
+// with the full name in the message.
+func lookup(full string, segments []string, data map[string]any) (any, error) {
+	v, ok := data[segments[0]]
+	if !ok || v == nil {
+		return nil, nil
+	}
+	for _, f := range segments[1:] {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("cannot index %s: %s is not a map", f, full)
+		}
+		v, ok = m[f]
+		if !ok || v == nil {
+			return nil, nil
+		}
+	}
+	return v, nil
+}
+
+// format renders a resolved value as a string.
+func format(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return v
+	case bool:
+		return strconv.FormatBool(v)
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// applyFilter applies a named filter to the current string value.
+func applyFilter(name string, hasArg bool, arg, s string) (string, error) {
+	switch name {
+	case "upper":
+		if hasArg {
+			return "", fmt.Errorf("extra argument for filter upper")
+		}
+		return strings.ToUpper(s), nil
+	case "lower":
+		if hasArg {
+			return "", fmt.Errorf("extra argument for filter lower")
+		}
+		return strings.ToLower(s), nil
+	case "trim":
+		if hasArg {
+			return "", fmt.Errorf("extra argument for filter trim")
+		}
+		return strings.TrimSpace(s), nil
+	case "default":
+		if !hasArg {
+			return "", fmt.Errorf("missing argument for filter default")
+		}
+		if s == "" {
+			return arg, nil
+		}
+		return s, nil
+	case "truncate":
+		if !hasArg {
+			return "", fmt.Errorf("missing argument for filter truncate")
+		}
+		n, err := strconv.Atoi(arg)
+		if err != nil || n < 0 {
+			return "", fmt.Errorf("filter truncate: argument %q must be a non-negative integer", arg)
+		}
+		runes := []rune(s)
+		if len(runes) <= n {
+			return s, nil
+		}
+		return string(runes[:n]) + "\u2026", nil
+	case "html":
+		if hasArg {
+			return "", fmt.Errorf("extra argument for filter html")
+		}
+		repl := strings.NewReplacer(
+			"&", "&amp;",
+			"<", "&lt;",
+			">", "&gt;",
+			"\"", "&#34;",
+			"'", "&#39;",
+		)
+		return repl.Replace(s), nil
+	default:
+		return "", fmt.Errorf("unknown filter %s", name)
+	}
+}
diff --git a/tmpl/tmpl_test.go b/tmpl/tmpl_test.go
