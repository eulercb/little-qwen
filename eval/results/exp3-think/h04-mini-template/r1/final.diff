+++ b/tmpl/tmpl_test.go
@@ -0,0 +1,218 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRenderText(t *testing.T) {
+	out, err := Render("hello, world", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "hello, world" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderLiteralBraces(t *testing.T) {
+	out, err := Render("a {{{{ b", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "a {{ b" {
+		t.Fatalf("got %q", out)
+	}
+	if out, err = Render("{{{{", nil); err != nil || out != "{{" {
+		t.Fatalf("got %q, %v", out, err)
+	}
+}
+
+func TestRenderString(t *testing.T) {
+	out, err := Render("Hi {{ name }}!", map[string]any{"name": "Ada"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "Hi Ada!" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderTypes(t *testing.T) {
+	data := map[string]any{
+		"i":       42,
+		"i64":     int64(7),
+		"f":       1.5,
+		"yes":     true,
+		"no":      false,
+		"nothing": nil,
+	}
+	cases := []struct{ tag, want string }{
+		{"{{ i }}", "42"},
+		{"{{ i64 }}", "7"},
+		{"{{ f }}", "1.5"},
+		{"{{ yes }}", "true"},
+		{"{{ no }}", "false"},
+		{"{{ nothing }}", ""},
+		{"{{ absent }}", ""},
+	}
+	for _, c := range cases {
+		got, err := Render(c.tag, data)
+		if err != nil {
+			t.Fatalf("%s: %v", c.tag, err)
+		}
+		if got != c.want {
+			t.Errorf("%s: got %q want %q", c.tag, got, c.want)
+		}
+	}
+}
+
+func TestRenderNested(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name":  "Bob",
+			"score": 3,
+		},
+	}
+	out, err := Render("{{ user.name }}: {{ user.score }}", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "Bob: 3" {
+		t.Fatalf("got %q", out)
+	}
+	// Missing nested field -> empty, no error.
+	out, err = Render("[{{ user.missing }}]", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "[]" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderIndexNonMapError(t *testing.T) {
+	data := map[string]any{"user": "not a map"}
+	_, err := Render("{{ user.name.first }}", data)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if !strings.Contains(err.Error(), "user.name.first") {
+		t.Fatalf("error %q does not mention full name", err)
+	}
+}
+
+func TestWhitespaceAroundParts(t *testing.T) {
+	data := map[string]any{"name": "  Ada  "}
+	out, err := Render("{{   name   |   trim   }}|{{ name|upper|trim }}", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "Ada|ADA" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestFilters(t *testing.T) {
+	data := map[string]any{"s": "  Hello,  World  ", "empty": "", "long": "héllo wörld"}
+	cases := []struct{ tag, want string }{
+		{"{{ s | upper }}", "  HELLO,  WORLD  "},
+		{"{{ s | lower }}", "  hello,  world  "},
+		{"{{ s | trim }}", "Hello,  World"},
+		{"{{ empty | default:\"nil\" }}", "nil"},
+		{"{{ s | default:\"nil\" | trim }}", "Hello,  World"},
+		{"{{ long | truncate:\"5\" }}", "héllo…"},
+		{"{{ s | truncate:\"3\" | upper }}", "  H…"},
+	}
+	for _, c := range cases {
+		got, err := Render(c.tag, data)
+		if err != nil {
+			t.Fatalf("%s: %v", c.tag, err)
+		}
+		if got != c.want {
+			t.Errorf("%s: got %q want %q", c.tag, got, c.want)
+		}
+	}
+}
+
+func TestTruncateNotCut(t *testing.T) {
+	got, err := Render("{{ s | truncate:\"99\" }}", map[string]any{"s": "abc"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "abc" {
+		t.Fatalf("got %q", got)
+	}
+	got, err = Render("{{ s | truncate:\"3\" }}", map[string]any{"s": "abc"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "abc" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestHTML(t *testing.T) {
+	got, err := Render("{{ s | html }}", map[string]any{"s": `& < > " '`})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "&amp; &lt; &gt; &#34; &#39;" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestEscapedArg(t *testing.T) {
+	got, err := Render("{{ empty | default:\"say \\\"hi\\\"\\\\\" }}", map[string]any{"empty": ""})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != `say "hi"\` {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	data := map[string]any{"name": "Ada"}
+	cases := []struct {
+		src      string
+		data     map[string]any
+		fragment string // must appear in the error
+	}{
+		{"{{ name | bogus }}", data, "bogus"},
+		{"{{ name | upper:\"x\" }}", data, "upper"},
+		{"{{ name | default }}", data, "default"},
+		{"{{ name | truncate:\"-1\" }}", data, "truncate"},
+		{"{{ name | truncate:\"x\" }}", data, "truncate"},
+		{"{{ name | truncate }}", data, "truncate"},
+		{"{{ name |", data, "unterminated"},
+		{"{{ }}", data, "empty"},
+		{"{{ }}", data, ""},
+		{"{{ 1bad }}", data, "name"},
+		{"{{ us-er }}", data, "name"},
+		{"{{ name | upper extra }}", data, ""},
+	}
+	for _, c := range cases {
+		out, err := Render(c.src, c.data)
+		if err == nil {
+			t.Fatalf("%q: expected error, got %q", c.src, out)
+		}
+		if out != "" {
+			t.Errorf("%q: output %q not empty on error", c.src, out)
+		}
+		if c.fragment != "" && !strings.Contains(err.Error(), c.fragment) {
+			t.Errorf("%q: error %q lacks %q", c.src, err, c.fragment)
+		}
+	}
+}
+
+func TestMultipleTagsAndText(t *testing.T) {
+	data := map[string]any{"name": "ada", "count": 3}
+	out, err := Render("user={{ name | upper }} count={{ count }} done", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "user=ADA count=3 done" {
+		t.Fatalf("got %q", out)
+	}
+}
