+func commentPos(v string) int {
+	for i, c := range v {
+		if c != ';' && c != '#' {
+			continue
+		}
+		if i == 0 || v[i-1] == ' ' || v[i-1] == '\t' {
+			return i
+		}
+	}
+	return -1
+}
