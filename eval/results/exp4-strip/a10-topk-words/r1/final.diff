+package words
+
+import (
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestTopKBasics(t *testing.T) {
+	in := strings.Repeat("Don't don't DON'T the the cat cat cat a a the o'clock o'clock don't ", 10)
+	got, err := TopK(strings.NewReader(in), 5, []string{"The"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []WordCount{
+		{"don't", 40},
+		{"cat", 30},
+		{"a", 20},
+		{"o'clock", 20},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestTopKLeadingTrailing(t *testing.T) {
+	got, err := TopK(strings.NewReader("'quoted' and 'it's ok"), 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 'quoted' -> quoted; 'it's -> it's (internal apostrophe); ok.
+	want := []WordCount{
+		{"and", 1},
+		{"it's", 1},
+		{"ok", 1},
+		{"quoted", 1},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestTopKZeroAndFewer(t *testing.T) {
+	got, err := TopK(strings.NewReader("a b c"), 0, nil)
+	if err != nil || got == nil || len(got) != 0 {
+		t.Fatalf("k=0: got %v err %v", got, err)
+	}
+	got, err = TopK(strings.NewReader("a b c"), 5, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 3 {
+		t.Fatalf("want all 3, got %v", got)
+	}
+	if got[0].Word != "a" || got[1].Word != "b" || got[2].Word != "c" {
+		t.Fatalf("tie order: %v", got)
+	}
+}
+
+type shortReader struct{}
+
+func (shortReader) Read(p []byte) (int, error) {
+	n := copy(p, []byte("abc"))
+	return n, io.ErrUnexpectedEOF
+}
+
+func TestTopKPropagatesError(t *testing.T) {
+	_, err := TopK(shortReader{}, 2, nil)
+	if err != io.ErrUnexpectedEOF {
+		t.Fatalf("want io.ErrUnexpectedEOF, got %v", err)
+	}
+}
+
+func TestTopKUnicodeAndDigits(t *testing.T) {
+	got, err := TopK(strings.NewReader("héllo 123 héllo x9 x9"), 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []WordCount{{"héllo", 2}, {"x9", 2}, {"123", 1}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+// A single very long line must not cause problems.
+func TestTopKLongLine(t *testing.T) {
+	var sb strings.Builder
+	for i := 0; i < 200000; i++ {
+		sb.WriteString("word ")
+	}
+	got, err := TopK(strings.NewReader(sb.String()), 1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []WordCount{{"word", 200000}}) {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTopKStopCaseInsensitive(t *testing.T) {
+	got, err := TopK(strings.NewReader("The the THE x"), 10, []string{"tHe"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []WordCount{{"x", 1}}) {
+		t.Fatalf("got %v", got)
+	}
+}
