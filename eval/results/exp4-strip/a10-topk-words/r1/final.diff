+// Package words implements streaming word-count utilities.
+package words
+
+import (
+	"bufio"
+	"io"
+	"sort"
+	"strings"
+	"unicode"
+)
+
+// WordCount pairs a word with the number of times it occurred.
+type WordCount struct {
+	Word  string
+	Count int
+}
+
+// TopK streams r in chunks and returns the k most frequent words,
+// by count descending, ties broken by the word ascending (byte order).
+// If there are fewer than k distinct words, all of them are returned.
+// A k <= 0 returns an empty (non-nil) slice.
+//
+// A word is a maximal run of Unicode letters or digits, optionally
+// containing internal apostrophes between letters (don't, o'clock);
+// leading and trailing apostrophes are not part of the word, and any
+// other rune separates words. Words are case-folded with
+// strings.ToLower, and words present in stop (compared
+// case-insensitively) are ignored.
+func TopK(r io.Reader, k int, stop []string) ([]WordCount, error) {
+	if k <= 0 {
+		return []WordCount{}, nil
+	}
+	stopSet := make(map[string]struct{}, len(stop))
+	for _, w := range stop {
+		stopSet[strings.ToLower(w)] = struct{}{}
+	}
+
+	counts := make(map[string]int)
+	flush := func(word []rune) {
+		w := strings.ToLower(string(word))
+		if _, ok := stopSet[w]; !ok {
+			counts[w]++
+		}
+	}
+
+	br := bufio.NewReaderSize(r, 256*1024)
+	var word []rune
+	inWord := false
+	endWord := func() {
+		flush(word)
+		inWord = false
+		word = nil
+	}
+
+	for {
+		ch, _, err := br.ReadRune()
+		if err == io.EOF {
+			if inWord {
+				flush(word)
+			}
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+		switch {
+		case isLetterDigit(ch):
+			word = append(word, ch)
+			inWord = true
+		case isApostrophe(ch):
+			if !inWord {
+				// Leading apostrophe: not part of a word.
+				continue
+			}
+			if !unicode.IsLetter(word[len(word)-1]) {
+				// Apostrophe after a digit: separator.
+				endWord()
+				continue
+			}
+			// Possibly an internal apostrophe: it belongs to the
+			// word only when another letter follows.
+			nch, _, nerr := br.ReadRune()
+			switch {
+			case nerr == io.EOF:
+				// Trailing apostrophe at end of input.
+				endWord()
+			case nerr != nil:
+				return nil, nerr
+			case unicode.IsLetter(nch):
+				word = append(word, ch, nch)
+			default:
+				// Trailing apostrophe.
+				if uerr := br.UnreadRune(); uerr != nil {
+					return nil, uerr
+				}
+				endWord()
+			}
+		default:
+			// Any other rune separates words.
+			if inWord {
+				endWord()
+			}
+		}
+	}
+
+	result := make([]WordCount, 0, len(counts))
+	for w, c := range counts {
+		result = append(result, WordCount{Word: w, Count: c})
+	}
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].Count != result[j].Count {
+			return result[i].Count > result[j].Count
+		}
+		return result[i].Word < result[j].Word
+	})
+	if k < len(result) {
+		result = result[:k]
+	}
+	return result, nil
+}
+
+// isLetterDigit reports whether ch is a Unicode letter or digit.
+func isLetterDigit(ch rune) bool {
+	return unicode.IsLetter(ch) || unicode.IsDigit(ch)
+}
+
+// isApostrophe reports whether ch is an apostrophe.
+func isApostrophe(ch rune) bool {
+	switch ch {
+	case '\'', '’', '‘':
+		return true
+	}
+	return false
+}
