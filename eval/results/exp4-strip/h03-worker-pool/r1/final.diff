+// leakGoroutines reports how many goroutines are currently live.
+func leakGoroutines() int { return runtime.NumGoroutine() }
+
 func TestSquares(t *testing.T) {
 	out, err := Map(context.Background(), []int{1, 2, 3}, 1, func(_ context.Context, x int) (int, error) { return x * x, nil })
 	if err != nil || len(out) != 3 || out[2] != 9 {
 		t.Fatal(out, err)
 	}
 }
+
+// Workers may finish out of order; out[i] must still be fn(in[i]).
+func TestOrderPreserved(t *testing.T) {
+	in := make([]int, 100)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+		if x%7 == 0 {
+			time.Sleep(time.Millisecond)
+		}
+		return x * 2, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range in {
+		if out[i] != in[i]*2 {
+			t.Fatalf("out[%d] = %d, want %d", i, out[i], in[i]*2)
+		}
+	}
+}
+
+// On failure, the error must be an *IndexError for the LOWEST failing index,
+// even if a higher-indexed error arrives first. Higher indices finish first:
+// higher x sleeps less.
+func TestErrorLowestIndex(t *testing.T) {
+	in := make([]int, 10)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 10, func(_ context.Context, x int) (int, error) {
+		if x >= 2 {
+			time.Sleep(time.Duration(20-x) * time.Millisecond)
+			return 0, fmt.Errorf("boom %d", x)
+		}
+		return x, nil
+	})
+	if out != nil {
+		t.Fatalf("out = %v, want nil", out)
+	}
+	var idx *IndexError
+	if !errors.As(err, &idx) {
+		t.Fatalf("err = %v, want *IndexError", err)
+	}
+	if idx.Index != 2 {
+		t.Fatalf("idx.Index = %d, want 2", idx.Index)
+	}
+	if idx.Err.Error() != "boom 2" {
+		t.Fatalf("idx.Err = %q, want %q", idx.Err, "boom 2")
+	}
+}
+
+// Cancellation must not hang and must return ctx.Err().
+func TestContextCancelNoHang(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	var running int32
+	in := make([]int, 100)
+	for i := range in {
+		in[i] = i
+	}
+	done := make(chan struct{})
+	var err error
+	go func() {
+		_, err = Map(ctx, in, 8, func(ctx context.Context, x int) (int, error) {
+			atomic.AddInt32(&running, 1)
+			defer atomic.AddInt32(&running, -1)
+			<-ctx.Done() // each running call exits promptly on cancel
+			return 0, nil
+		})
+		close(done)
+	}()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Map did not return after cancellation")
+	}
+	if err != context.Canceled {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+}
+
+// Map must not leak workers: by the time it returns, all worker goroutines
+// have exited.
+func TestNoWorkerLeak(t *testing.T) {
+	base := leakGoroutines()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	in := make([]int, 20)
+	for i := range in {
+		in[i] = i
+	}
+	_, _ = Map(ctx, in, 5, func(_ context.Context, x int) (int, error) { return x, nil })
+	if n := leakGoroutines() - base; n > 0 {
+		t.Fatalf("goroutine leak: %+d extra", n)
+	}
+}
+
+func TestNoWorkerLeakOnCancel(t *testing.T) {
+	base := leakGoroutines()
+	ctx, cancel := context.WithCancel(context.Background())
+	in := make([]int, 20)
+	for i := range in {
+		in[i] = i
+	}
+	done := make(chan struct{})
+	go func() {
+		_, _ = Map(ctx, in, 5, func(ctx context.Context, x int) (int, error) {
+			<-ctx.Done()
+			return 0, nil
+		})
+		close(done)
+	}()
+	cancel()
+	<-done
+	if n := leakGoroutines() - base; n > 0 {
+		t.Fatalf("goroutine leak after cancel: %+d extra", n)
+	}
+}
+
+// A failing fn must stop the rest of the work from starting.
+func TestStopsOnFirstFailure(t *testing.T) {
+	var started int32
+	in := make([]int, 100)
+	for i := range in {
+		in[i] = i
+	}
+	_, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+		atomic.AddInt32(&started, 1)
+		if x == 3 {
+			return 0, errors.New("boom")
+		}
+		time.Sleep(5 * time.Millisecond)
+		return x, nil
+	})
+	if err == nil {
+		t.Fatal("want error")
+	}
+	if n := atomic.LoadInt32(&started); n >= 50 {
+		t.Fatalf("started = %d, want most inputs never attempted after failure", n)
+	}
+}
+
+// If a fn error is already reported when the ctx gets cancelled, the
+// *IndexError must win over ctx.Err().
+func TestErrorWinsOverCancel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	in := make([]int, 10)
+	for i := range in {
+		in[i] = i
+	}
+	errSeen := make(chan struct{})
+	done := make(chan struct{})
+	var err error
+	go func() {
+		_, err = Map(ctx, in, 1, func(_ context.Context, x int) (int, error) {
+			if x == 2 {
+				close(errSeen)
+				return 0, errors.New("boom")
+			}
+			time.Sleep(20 * time.Millisecond)
+			return x, nil
+		})
+		close(done)
+	}()
+	<-errSeen
+	cancel()
+	<-done
+	var idx *IndexError
+	if !errors.As(err, &idx) || idx.Index != 2 {
+		t.Fatalf("err = %v, want *IndexError index 2", err)
+	}
+}
