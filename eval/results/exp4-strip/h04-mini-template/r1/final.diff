+++ b/tmpl/tmpl_test.go
@@ -0,0 +1,222 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRenderVerbatim(t *testing.T) {
+	out, err := Render("hello world", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "hello world" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderLiteralBraces(t *testing.T) {
+	out, err := Render("a {{{{ b {{x}}}} c", map[string]any{"x": "y"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a {{ b y}} c"
+	if out != want {
+		t.Fatalf("got %q, want %q", out, want)
+	}
+	// {{{{ }} closes the escaped open brace: outputs a literal {{.
+	out, err = Render("{{{{}}", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "{{" {
+		t.Fatalf("got %q", out)
+	}
+	// Both sides escaped: outputs literal {{ }}.
+	out, err = Render("{{{{}}}}", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "{{}}" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderBasic(t *testing.T) {
+	data := map[string]any{
+		"name":  "Alice",
+		"count": 42,
+		"score": 3.5,
+		"big":   int64(10000000000),
+		"ok":    true,
+		"nope":  false,
+		"none":  nil,
+	}
+	tests := []struct {
+		src  string
+		want string
+	}{
+		{"{{ name }}", "Alice"},
+		{"hi {{name}}!", "hi Alice!"},
+		{"{{ count }}", "42"},
+		{"{{ score }}", "3.5"},
+		{"{{ big }}", "10000000000"},
+		{"{{ ok }}", "true"},
+		{"{{ nope }}", "false"},
+		{"{{ none }}", ""},
+		{"{{ missing }}", ""},
+		{"{{  name  |  upper  }}", "ALICE"},
+		{"{{ name | lower }}", "alice"},
+	}
+	for _, tc := range tests {
+		out, err := Render(tc.src, data)
+		if err != nil {
+			t.Errorf("%q: unexpected error: %v", tc.src, err)
+			continue
+		}
+		if out != tc.want {
+			t.Errorf("%q: got %q, want %q", tc.src, out, tc.want)
+		}
+	}
+}
+
+func TestRenderNestedLookup(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name": map[string]any{"first": "Bob"},
+			"age":  30,
+		},
+	}
+	out, err := Render("{{ user.name.first }}", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "Bob" {
+		t.Fatalf("got %q", out)
+	}
+	// Missing nested key -> empty, no error.
+	out, err = Render("[{{ user.name.last }}]", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "[]" {
+		t.Fatalf("got %q", out)
+	}
+	// Indexing into a non-map -> error containing the full name.
+	_, err = Render("{{ user.age.older }}", data)
+	if err == nil {
+		t.Fatal("expected error indexing into non-map")
+	}
+	if !strings.Contains(err.Error(), "user.age.older") {
+		t.Fatalf("error %q does not contain full name", err.Error())
+	}
+}
+
+func TestRenderFilters(t *testing.T) {
+	data := map[string]any{
+		"title":   "  Hello, World  ",
+		"empty":   "",
+		"quote":   `<a href="x">&</a>`,
+		"unicode": "héllo",
+	}
+	tests := []struct {
+		src  string
+		want string
+	}{
+		{"{{ title | trim }}", "Hello, World"},
+		{"{{ title | trim | upper }}", "HELLO, WORLD"},
+		{"{{ title | upper | lower }}", "  hello, world  "},
+		{"{{ empty | default:\"x\" }}", "x"},
+		{"{{ title | default:\"x\" }}", "  Hello, World  "},
+		{"{{ title | trim | truncate:8 }}", "Hello, W…"},
+		{"{{ title | trim | truncate:12 }}", "Hello, World"},
+		{"{{ unicode | truncate:2 }}", "hé…"},
+		{"{{ empty | truncate:3 }}", ""},
+		{"{{ quote | html }}", "&lt;a href=&#34;x&#34;&gt;&amp;&lt;/a&gt;"},
+	}
+	for _, tc := range tests {
+		out, err := Render(tc.src, data)
+		if err != nil {
+			t.Errorf("%q: unexpected error: %v", tc.src, err)
+			continue
+		}
+		if out != tc.want {
+			t.Errorf("%q: got %q, want %q", tc.src, out, tc.want)
+		}
+	}
+}
+
+func TestRenderArgEscapes(t *testing.T) {
+	data := map[string]any{"x": ""}
+	out, err := Render(`{{ x | default:"say \"hi\"\ and \\backslash" }}`, data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != `say "hi"\ and \backslash` {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestRenderErrors(t *testing.T) {
+	data := map[string]any{"name": "Alice", "user": map[string]any{"name": "Bob"}}
+	tests := []struct {
+		src   string
+		match string
+	}{
+		{"{{ name | noexist }}", "noexist"},
+		{"{{ name | noexist:\"a\" }}", "noexist"},
+		{"{{ name | upper:\"x\" }}", "upper"},
+		{"{{ name | trim:\"x\" }}", "trim"},
+		{"{{ name | lower:\"x\" }}", "lower"},
+		{"{{ name | html:\"x\" }}", "html"},
+		{"{{ name | default }}", "default"},
+		{"{{ name | truncate }}", "truncate"},
+		{"{{ name | truncate:\"abc\" }}", "truncate"},
+		{"{{ name | truncate:\"-2\" }}", "truncate"},
+		{"{{ name", ""}, // unterminated tag
+		{"{{ }}", ""},   // empty tag
+		{"{{ 1bad }}", ""},
+		{"{{ .x }}", ""},
+	}
+	for _, tc := range tests {
+		out, err := Render(tc.src, data)
+		if err == nil {
+			t.Errorf("%q: expected error, got output %q", tc.src, out)
+			continue
+		}
+		if out != "" {
+			t.Errorf("%q: expected empty output, got %q", tc.src, out)
+		}
+		if tc.match != "" && !strings.Contains(err.Error(), tc.match) {
+			t.Errorf("%q: error %q does not contain %q", tc.src, err, tc.match)
+		}
+	}
+}
+
+func TestRenderMixed(t *testing.T) {
+	data := map[string]any{
+		"user":  map[string]any{"name": "Bob"},
+		"count": 7,
+		"empty": "",
+	}
+	src := "user is {{ user.name | upper }}\ncount={{count}} {{ empty | default:\"n/a\" }}\nliteral {{{{ end"
+	out, err := Render(src, data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "user is BOB\ncount=7 n/a\nliteral {{ end"
+	if out != want {
+		t.Fatalf("got %q, want %q", out, want)
+	}
+}
+
+func TestRenderMultipleTags(t *testing.T) {
+	data := map[string]any{"a": "1", "b": "2"}
+	out, err := Render("{{ a }}-{{ b }}-{{ a }}", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "1-2-1" {
+		t.Fatalf("got %q", out)
+	}
+}
