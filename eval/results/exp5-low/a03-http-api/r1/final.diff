@@ -0,0 +1,261 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// doRequest runs a single request against the handler and records the response.
+func doRequest(t *testing.T, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	if method == http.MethodPost {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	rec := httptest.NewRecorder()
+	NewHandler(NewStore()).ServeHTTP(rec, req)
+	return rec
+}
+
+// doRequestOn runs a request against a specific handler so tests can share state.
+func doRequestOn(t *testing.T, h http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	if method == http.MethodPost {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func decode(t *testing.T, rec *httptest.ResponseRecorder, v any) {
+	t.Helper()
+	if err := json.Unmarshal(rec.Body.Bytes(), v); err != nil {
+		t.Fatalf("unmarshal %q: %v", rec.Body.String(), err)
+	}
+}
+
+func TestHealthz(t *testing.T) {
+	rec := doRequest(t, http.MethodGet, "/healthz", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	if ct := rec.Header().Get("Content-Type"); !strings.HasPrefix(ct, "text/plain") {
+		t.Fatalf("content-type = %q, want text/plain", ct)
+	}
+	if got := rec.Body.String(); got != "ok" {
+		t.Fatalf("body = %q, want %q", got, "ok")
+	}
+}
+
+func TestHealthzMethodNotAllowed(t *testing.T) {
+	rec := doRequest(t, http.MethodPost, "/healthz", "")
+	if rec.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusMethodNotAllowed)
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	var err errorResponse
+	decode(t, rec, &err)
+	if err.Error == "" {
+		t.Fatal("expected non-empty error message")
+	}
+}
+
+func TestCreateNote(t *testing.T) {
+	rec := doRequest(t, http.MethodPost, "/notes", `{"title":"First","body":"hello"}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want %d (body %q)", rec.Code, http.StatusCreated, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	var n Note
+	decode(t, rec, &n)
+	if n.ID != 1 {
+		t.Fatalf("id = %d, want 1", n.ID)
+	}
+	if n.Title != "First" || n.Body != "hello" {
+		t.Fatalf("note = %+v, want title First body hello", n)
+	}
+}
+
+func TestCreateNoteRequiresTitle(t *testing.T) {
+	for _, body := range []string{
+		`{"title":"","body":"b"}`,
+		`{"title":"   ","body":"b"}`,
+		`{"body":"b"}`,
+	} {
+		rec := doRequest(t, http.MethodPost, "/notes", body)
+		if rec.Code != http.StatusBadRequest {
+			t.Fatalf("body %q: status = %d, want %d", body, rec.Code, http.StatusBadRequest)
+		}
+		if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+			t.Fatalf("content-type = %q, want application/json", ct)
+		}
+		var err errorResponse
+		decode(t, rec, &err)
+		if err.Error == "" {
+			t.Fatal("expected non-empty error message")
+		}
+	}
+}
+
+func TestCreateNoteInvalidJSON(t *testing.T) {
+	rec := doRequest(t, http.MethodPost, "/notes", `{not json`)
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
+	}
+}
+
+func TestListEmptyIsEmptyArray(t *testing.T) {
+	rec := doRequest(t, http.MethodGet, "/notes", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	if got := strings.TrimSpace(rec.Body.String()); got != "[]" {
+		t.Fatalf("body = %q, want %q", got, "[]")
+	}
+}
+
+func TestListOrderedByID(t *testing.T) {
+	h := NewHandler(NewStore())
+	// Create out of order.
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"three","body":""}`)
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"one","body":""}`)
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"two","body":""}`)
+
+	rec := doRequestOn(t, h, http.MethodGet, "/notes", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	var notes []Note
+	decode(t, rec, &notes)
+	want := []int{1, 2, 3}
+	if len(notes) != 3 {
+		t.Fatalf("len = %d, want 3", len(notes))
+	}
+	for i, n := range notes {
+		if n.ID != want[i] {
+			t.Fatalf("notes[%d].id = %d, want %d", i, n.ID, want[i])
+		}
+	}
+}
+
+func TestListQueryFilter(t *testing.T) {
+	h := NewHandler(NewStore())
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"Alpha","body":"red apple"}`)
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"Beta","body":"banana"}`)
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"Gamma","body":"APPLE pie"}`)
+
+	// Case-insensitive match in body.
+	rec := doRequestOn(t, h, http.MethodGet, "/notes?q=apple", "")
+	var notes []Note
+	decode(t, rec, &notes)
+	if len(notes) != 2 {
+		t.Fatalf("q=apple: len = %d, want 2 (got %+v)", len(notes), notes)
+	}
+
+	// Case-insensitive match in title.
+	rec = doRequestOn(t, h, http.MethodGet, "/notes?q=BETA", "")
+	decode(t, rec, &notes)
+	if len(notes) != 1 || notes[0].Title != "Beta" {
+		t.Fatalf("q=BETA: got %+v, want one Beta note", notes)
+	}
+
+	// No matches.
+	rec = doRequestOn(t, h, http.MethodGet, "/notes?q=zzz", "")
+	decode(t, rec, &notes)
+	if len(notes) != 0 {
+		t.Fatalf("q=zzz: len = %d, want 0", len(notes))
+	}
+	if got := strings.TrimSpace(rec.Body.String()); got != "[]" {
+		t.Fatalf("q=zzz: body = %q, want []", got)
+	}
+}
+
+func TestGetNote(t *testing.T) {
+	h := NewHandler(NewStore())
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"T","body":"B"}`)
+
+	rec := doRequestOn(t, h, http.MethodGet, "/notes/1", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	var n Note
+	decode(t, rec, &n)
+	if n.ID != 1 || n.Title != "T" || n.Body != "B" {
+		t.Fatalf("note = %+v, want {1 T B}", n)
+	}
+}
+
+func TestGetNoteNotFound(t *testing.T) {
+	rec := doRequest(t, http.MethodGet, "/notes/99", "")
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusNotFound)
+	}
+	var err errorResponse
+	decode(t, rec, &err)
+	if err.Error == "" {
+		t.Fatal("expected non-empty error message")
+	}
+}
+
+func TestGetNoteBadID(t *testing.T) {
+	rec := doRequest(t, http.MethodGet, "/notes/notanint", "")
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
+	}
+}
+
+func TestDeleteNote(t *testing.T) {
+	h := NewHandler(NewStore())
+	doRequestOn(t, h, http.MethodPost, "/notes", `{"title":"T","body":"B"}`)
+
+	rec := doRequestOn(t, h, http.MethodDelete, "/notes/1", "")
+	if rec.Code != http.StatusNoContent {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusNoContent)
+	}
+	// Gone after delete.
+	rec = doRequestOn(t, h, http.MethodGet, "/notes/1", "")
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("after delete: status = %d, want %d", rec.Code, http.StatusNotFound)
+	}
+}
+
+func TestDeleteNoteNotFound(t *testing.T) {
+	rec := doRequest(t, http.MethodDelete, "/notes/99", "")
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusNotFound)
+	}
+}
+
+func TestMethodNotAllowed(t *testing.T) {
+	cases := []struct{ method, path string }{
+		{http.MethodPut, "/notes"},
+		{http.MethodDelete, "/notes"},
+		{http.MethodPut, "/notes/1"},
+		{http.MethodPatch, "/notes/1"},
+		{http.MethodPost, "/healthz"},
+	}
+	for _, c := range cases {
+		rec := doRequest(t, c.method, c.path, "")
+		if rec.Code != http.StatusMethodNotAllowed {
+			t.Fatalf("%s %s: status = %d, want %d", c.method, c.path, rec.Code, http.StatusMethodNotAllowed)
+		}
+		if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+			t.Fatalf("%s %s: content-type = %q, want application/json", c.method, c.path, ct)
+		}
+	}
+}
