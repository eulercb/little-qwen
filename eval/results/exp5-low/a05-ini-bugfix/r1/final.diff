+
+// quoted reports whether val is wrapped in double quotes.
+func quoted(val string) bool {
+	return len(val) >= 2 && val[0] == '"' && val[len(val)-1] == '"'
+}
+
+// stripInlineComment removes an inline comment, which starts at the first
+// " ;" or " #" (whitespace then ; or #) and runs to the end of the line.
+func stripInlineComment(val string) string {
+	best := len(val)
+	for _, mark := range []string{" ;", " #"} {
+		if j := strings.Index(val, mark); j >= 0 && j < best {
+			best = j
+		}
+	}
+	if best == len(val) {
+		return val
+	}
+	return strings.TrimSpace(val[:best])
+}
+
+// value normalises the raw text after the '=': it is trimmed, an inline
+// comment is removed unless the value is quoted, and a quoted value has its
+// quotes removed while keeping its inner whitespace exactly.
+func value(raw string) string {
+	val := strings.TrimSpace(raw)
+	if !quoted(val) {
+		val = stripInlineComment(val)
+	}
+	if quoted(val) {
+		val = val[1 : len(val)-1]
+	}
+	return val
+}
