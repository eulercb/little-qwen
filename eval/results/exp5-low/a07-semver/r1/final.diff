+// Package semver implements Semantic Versioning 2.0.0 parsing and precedence.
+package semver
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version is a semantic version: MAJOR.MINOR.PATCH with optional
+// pre-release and build metadata.
+type Version struct {
+	Major uint64
+	Minor uint64
+	Patch uint64
+	Pre   []string // pre-release identifiers, nil if absent
+	Build []string // build metadata identifiers, nil if absent
+}
+
+// Parse parses s as a semantic version. A leading "v" is optional.
+// It returns an error for anything that violates SemVer 2.0.0:
+// missing parts, leading zeros in numeric fields or numeric pre-release
+// identifiers, empty identifiers, or characters outside [0-9A-Za-z-].
+func Parse(s string) (Version, error) {
+	var v Version
+	if strings.HasPrefix(s, "v") {
+		s = s[1:]
+	}
+
+	// Split off build metadata first, then pre-release.
+	rest := s
+	if i := strings.IndexByte(rest, '+'); i >= 0 {
+		build := rest[i+1:]
+		rest = rest[:i]
+		ids := strings.Split(build, ".")
+		for _, id := range ids {
+			if err := checkIdentifier(id); err != nil {
+				return Version{}, fmt.Errorf("semver: invalid build identifier in %q: %w", s, err)
+			}
+		}
+		v.Build = ids
+	}
+	if i := strings.IndexByte(rest, '-'); i >= 0 {
+		pre := rest[i+1:]
+		rest = rest[:i]
+		ids := strings.Split(pre, ".")
+		for _, id := range ids {
+			if err := checkIdentifier(id); err != nil {
+				return Version{}, fmt.Errorf("semver: invalid pre-release identifier in %q: %w", s, err)
+			}
+		}
+		v.Pre = ids
+	}
+
+	parts := strings.Split(rest, ".")
+	if len(parts) != 3 {
+		return Version{}, fmt.Errorf("semver: version %q must have exactly three numeric parts MAJOR.MINOR.PATCH", s)
+	}
+	for i, name := range []string{"major", "minor", "patch"} {
+		part := parts[i]
+		if part == "" {
+			return Version{}, fmt.Errorf("semver: empty %s in %q", name, s)
+		}
+		for _, c := range part {
+			if c < '0' || c > '9' {
+				return Version{}, fmt.Errorf("semver: %s in %q contains non-digit %q", name, s, c)
+			}
+		}
+		if len(part) > 1 && part[0] == '0' {
+			return Version{}, fmt.Errorf("semver: leading zero in %s of %q", name, s)
+		}
+		n, err := strconv.ParseUint(part, 10, 64)
+		if err != nil {
+			return Version{}, fmt.Errorf("semver: %s in %q out of range: %w", name, s, err)
+		}
+		switch i {
+		case 0:
+			v.Major = n
+		case 1:
+			v.Minor = n
+		case 2:
+			v.Patch = n
+		}
+	}
+	return v, nil
+}
+
+// checkIdentifier validates a pre-release or build identifier: non-empty,
+// characters restricted to [0-9A-Za-z-], and no leading zeros if numeric.
+func checkIdentifier(id string) error {
+	if id == "" {
+		return fmt.Errorf("empty identifier")
+	}
+	for _, c := range id {
+		if (c < '0' || c > '9') && (c < 'a' || c > 'z') && (c < 'A' || c > 'Z') && c != '-' {
+			return fmt.Errorf("identifier %q contains invalid character %q", id, c)
+		}
+	}
+	if isNumeric(id) && len(id) > 1 && id[0] == '0' {
+		return fmt.Errorf("identifier %q has a leading zero", id)
+	}
+	return nil
+}
+
+// isNumeric reports whether id consists only of ASCII digits.
+func isNumeric(id string) bool {
+	for i := 0; i < len(id); i++ {
+		if id[i] < '0' || id[i] > '9' {
+			return false
+		}
+	}
+	return len(id) > 0
+}
+
+// String returns the canonical form without the "v" prefix.
+func (v Version) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%d.%d.%d", v.Major, v.Minor, v.Patch)
+	if len(v.Pre) > 0 {
+		b.WriteByte('-')
+		b.WriteString(strings.Join(v.Pre, "."))
+	}
+	if len(v.Build) > 0 {
+		b.WriteByte('+')
+		b.WriteString(strings.Join(v.Build, "."))
+	}
+	return b.String()
+}
+
+// Compare returns -1 if a < b, 0 if a == b, and +1 if a > b according
+// to SemVer precedence. Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := cmpInt(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := cmpInt(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := cmpInt(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	if len(a.Pre) == 0 && len(b.Pre) == 0 {
+		return 0
+	}
+	if len(a.Pre) == 0 {
+		return 1 // a is a release, b is a pre-release of the same core
+	}
+	if len(b.Pre) == 0 {
+		return -1
+	}
+	for i := 0; i < len(a.Pre) && i < len(b.Pre); i++ {
+		c := compareIdentifier(a.Pre[i], b.Pre[i])
+		if c != 0 {
+			return c
+		}
+	}
+	// All shared identifiers are equal: the shorter list is lower.
+	switch {
+	case len(a.Pre) < len(b.Pre):
+		return -1
+	case len(a.Pre) > len(b.Pre):
+		return 1
+	default:
+		return 0
+	}
+}
+
+// cmpInt is a signed comparison for uint64 values.
+func cmpInt(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// compareIdentifier compares two pre-release identifiers: numeric
+// identifiers are compared numerically, alphanumeric identifiers
+// lexically in ASCII order, and numeric identifiers always have lower
+// precedence than alphanumeric ones.
+func compareIdentifier(a, b string) int {
+	na, nb := isNumeric(a), isNumeric(b)
+	switch {
+	case na && nb:
+		if len(a) != len(b) { // different digit counts: longer is larger, leading zeros excluded
+			if len(a) < len(b) {
+				return -1
+			}
+			return 1
+		}
+		switch {
+		case a < b:
+			return -1
+		case a > b:
+			return 1
+		default:
+			return 0
+		}
+	case na != nb:
+		if na {
+			return -1
+		}
+		return 1
+	default:
+		switch {
+		case a < b:
+			return -1
+		case a > b:
+			return 1
+		default:
+			return 0
+		}
+	}
+}
+
+// MustParse parses s and panics if it is not a valid semantic version.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
