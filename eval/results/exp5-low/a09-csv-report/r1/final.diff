+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// runOutput runs run with the given args and input, returning the output
+// and any error.
+func runOutput(t *testing.T, args []string, in string) (string, error) {
+	t.Helper()
+	var out bytes.Buffer
+	err := run(args, strings.NewReader(in), &out)
+	return out.String(), err
+}
+
+const basicInput = "region,product,qty,price\n" +
+	"north,apple,3,1.10\n" +
+	"south,pear,1,2.00\n"
+
+func TestByRegionDefault(t *testing.T) {
+	got, err := runOutput(t, nil, basicInput)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestByProduct(t *testing.T) {
+	got, err := runOutput(t, []string{"--by", "product"}, basicInput)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestByProductEqualsForm(t *testing.T) {
+	got, err := runOutput(t, []string{"--by=product"}, basicInput)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestBadBy(t *testing.T) {
+	_, err := runOutput(t, []string{"--by", "store"}, basicInput)
+	if err == nil {
+		t.Fatal("expected error for invalid --by value")
+	}
+	if !strings.Contains(err.Error(), "store") {
+		t.Fatalf("error should mention the bad value, got %q", err)
+	}
+}
+
+func TestUnknownArgument(t *testing.T) {
+	_, err := runOutput(t, []string{"--nope"}, basicInput)
+	if err == nil {
+		t.Fatal("expected error for unknown argument")
+	}
+}
+
+func TestSortingRevenueDescTieByName(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"beta,apple,1,5.00\n" +
+		"alpha,pear,2,2.50\n" +
+		"gamma,fig,10,0.10\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "alpha\t2\t5.00\n" +
+		"beta\t1\t5.00\n" +
+		"gamma\t10\t1.00\n" +
+		"TOTAL\t13\t11.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTopLimitsGroupsButNotTotal(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"beta,apple,1,5.00\n" +
+		"alpha,pear,2,2.50\n" +
+		"gamma,fig,10,0.10\n"
+	got, err := runOutput(t, []string{"--top", "2"}, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	// TOTAL still covers all rows, not only the printed groups.
+	want := "alpha\t2\t5.00\n" +
+		"beta\t1\t5.00\n" +
+		"TOTAL\t13\t11.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTopLargerThanGroupCount(t *testing.T) {
+	got, err := runOutput(t, []string{"--top", "10"}, basicInput)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestBadTop(t *testing.T) {
+	for _, arg := range []string{"0", "-1", "x", "1.5"} {
+		_, err := runOutput(t, []string{"--top", arg}, basicInput)
+		if err == nil {
+			t.Fatalf("expected error for --top %s", arg)
+		}
+	}
+}
+
+func TestMissingColumnMentionsName(t *testing.T) {
+	cases := []struct {
+		in   string
+		col  string
+	}{
+		{"product,qty,price\napple,3,1.10\n", "region"},
+		{"region,qty,price\nnorth,3,1.10\n", "product"},
+		{"region,product,price\nnorth,apple,1.10\n", "qty"},
+		{"region,product,qty\nnorth,apple,3\n", "price"},
+	}
+	for _, tc := range cases {
+		_, err := runOutput(t, nil, tc.in)
+		if err == nil {
+			t.Fatalf("expected error for missing column %q", tc.col)
+		}
+		if !strings.Contains(err.Error(), tc.col) {
+			t.Fatalf("error should mention %q, got %q", tc.col, err)
+		}
+	}
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	cases := []string{
+		"region,product,qty,price\nnorth,apple,2,1.00\nsouth,pear,x,1.00\n",
+		"region,product,qty,price\nnorth,apple,2,1.00\nsouth,pear,-1,1.00\n",
+		"region,product,qty,price\nnorth,apple,2,1.00\nsouth,pear,1.5,1.00\n",
+	}
+	for _, in := range cases {
+		_, err := runOutput(t, nil, in)
+		if err == nil {
+			t.Fatalf("expected error for bad qty in %q", in)
+		}
+		if !strings.Contains(err.Error(), "line 3") {
+			t.Fatalf("error should mention line 3, got %q", err)
+		}
+	}
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	cases := []string{
+		"region,product,qty,price\nnorth,apple,2,oops\n",
+		"region,product,qty,price\nnorth,apple,2,1.234\n",
+		"region,product,qty,price\nnorth,apple,2,1.2.3\n",
+		"region,product,qty,price\nnorth,apple,2,\n",
+	}
+	for _, in := range cases {
+		_, err := runOutput(t, nil, in)
+		if err == nil {
+			t.Fatalf("expected error for bad price in %q", in)
+		}
+		if !strings.Contains(err.Error(), "line 2") {
+			t.Fatalf("error should mention line 2, got %q", err)
+		}
+	}
+}
+
+func TestReorderedAndExtraColumns(t *testing.T) {
+	in := "price,region,notes,qty,product\n" +
+		"1.10,north,basket,3,apple\n" +
+		"2.00,south,,1,pear\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestFormatTwoDecimals(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"north,apple,1,0.10\n" +
+		"north,banana,1,0.20\n" +
+		"west,cherry,5,1\n" +
+		"west,date,1,100\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	// 0.10+0.20 = 0.30 (exactly two decimals); 5*1 = 5.00; 1*100 = 100.00.
+	want := "west\t6\t105.00\nnorth\t2\t0.30\nTOTAL\t8\t105.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestZeroQtyAndZeroPrice(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"north,apple,0,5.00\n" +
+		"east,pear,7,0.00\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	// Both groups have 0 revenue: tie broken by name ascending.
+	want := "east\t7\t0.00\nnorth\t0\t0.00\nTOTAL\t7\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestHeaderOnlyInput(t *testing.T) {
+	got, err := runOutput(t, nil, "region,product,qty,price\n")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "TOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestEmptyInput(t *testing.T) {
+	_, err := runOutput(t, nil, "")
+	if err == nil {
+		t.Fatal("expected error for empty input")
+	}
+}
+
+func TestShortRowMentionsLine(t *testing.T) {
+	_, err := runOutput(t, nil, "region,product,qty,price\nnorth,apple\n")
+	if err == nil {
+		t.Fatal("expected error for short row")
+	}
+	if !strings.Contains(err.Error(), "line 2") {
+		t.Fatalf("error should mention line 2, got %q", err)
+	}
+}
+
+func TestFormatCents(t *testing.T) {
+	cases := []struct {
+		in   int64
+		want string
+	}{
+		{330, "3.30"},
+		{5, "0.05"},
+		{0, "0.00"},
+		{10500, "105.00"},
+		{-330, "-3.30"},
+		{100, "1.00"},
+	}
+	for _, tc := range cases {
+		if got := formatCents(tc.in); got != tc.want {
+			t.Errorf("formatCents(%d) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
