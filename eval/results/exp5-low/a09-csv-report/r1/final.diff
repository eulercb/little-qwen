+// Command report summarises sales data from a CSV file.
+//
+// It reads a CSV with a header row from in and writes per-group totals
+// (grouped by region or product, selected with --by) plus a final TOTAL
+// line to out. Revenue is kept in integer cents to avoid floating-point
+// drift.
+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// run parses flags from args, reads the sales CSV from in and writes the
+// summary to out. It returns an error if a required column is missing, a
+// qty/price value is invalid, or a flag is malformed.
+func run(args []string, in io.Reader, out io.Writer) error {
+	by, top, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	records, err := readRecords(in)
+	if err != nil {
+		return err
+	}
+	if len(records) == 0 {
+		return fmt.Errorf("input is empty: missing header row")
+	}
+
+	colIdx, err := columnIndexes(records[0])
+	if err != nil {
+		return err
+	}
+
+	groups := make(map[string]*aggregator)
+	totalQty := 0
+	totalCents := int64(0)
+
+	for i, rec := range records[1:] {
+		line := i + 2 // the header is line 1
+		if len(rec) < len(records[0]) {
+			return fmt.Errorf("line %d: expected %d fields, got %d", line, len(records[0]), len(rec))
+		}
+		key, err := fieldAt(rec, colIdx[by], line)
+		if err != nil {
+			return err
+		}
+		qty, err := parseQty(rec, colIdx["qty"], line)
+		if err != nil {
+			return err
+		}
+		priceCents, err := parsePrice(rec, colIdx["price"], line)
+		if err != nil {
+			return err
+		}
+		revenueCents := int64(qty) * priceCents
+
+		agg := groups[key]
+		if agg == nil {
+			agg = &aggregator{}
+			groups[key] = agg
+		}
+		agg.qty += qty
+		agg.cents += revenueCents
+		totalQty += qty
+		totalCents += revenueCents
+	}
+
+	names := make([]string, 0, len(groups))
+	for name := range groups {
+		names = append(names, name)
+	}
+	// Revenue descending, ties by group name ascending.
+	sort.Slice(names, func(i, j int) bool {
+		gi, gj := groups[names[i]], groups[names[j]]
+		if gi.cents != gj.cents {
+			return gi.cents > gj.cents
+		}
+		return names[i] < names[j]
+	})
+	if top > 0 && len(names) > top {
+		names = names[:top]
+	}
+	for _, name := range names {
+		agg := groups[name]
+		fmt.Fprintf(out, "%s\t%d\t%s\n", name, agg.qty, formatCents(agg.cents))
+	}
+	// TOTAL is computed over all rows, not only the printed groups.
+	fmt.Fprintf(out, "TOTAL\t%d\t%s\n", totalQty, formatCents(totalCents))
+	return nil
+}
+
+// main reads the CSV from stdin and writes the summary to stdout.
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, "report:", err)
+		os.Exit(1)
+	}
+}
+
+// parseFlags interprets --by and --top flags. by defaults to "region" and
+// top is 0 when --top is not given (print all groups).
+func parseFlags(args []string) (by string, top int, err error) {
+	by = "region"
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		switch {
+		case arg == "--by":
+			i++
+			if i >= len(args) {
+				return "", 0, fmt.Errorf("--by requires a value")
+			}
+			if v := args[i]; v != "region" && v != "product" {
+				return "", 0, fmt.Errorf("invalid --by value %q (must be region or product)", v)
+			} else {
+				by = v
+			}
+		case strings.HasPrefix(arg, "--by="):
+			v := strings.TrimPrefix(arg, "--by=")
+			if v != "region" && v != "product" {
+				return "", 0, fmt.Errorf("invalid --by value %q (must be region or product)", v)
+			}
+			by = v
+		case arg == "--top":
+			i++
+			if i >= len(args) {
+				return "", 0, fmt.Errorf("--top requires a value")
+			}
+			n, convErr := strconv.Atoi(args[i])
+			if convErr != nil || n < 1 {
+				return "", 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", args[i])
+			}
+			top = n
+		case strings.HasPrefix(arg, "--top="):
+			v := strings.TrimPrefix(arg, "--top=")
+			n, convErr := strconv.Atoi(v)
+			if convErr != nil || n < 1 {
+				return "", 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", v)
+			}
+			top = n
+		default:
+			return "", 0, fmt.Errorf("unknown argument %q", arg)
+		}
+	}
+	return by, top, nil
+}
+
+// aggregator accumulates the total quantity and revenue (in cents) of one
+// group.
+type aggregator struct {
+	qty   int
+	cents int64
+}
+
+// readRecords reads the whole CSV, allowing rows of different lengths
+// (run validates them).
+func readRecords(in io.Reader) ([][]string, error) {
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+	records, err := r.ReadAll()
+	if err != nil {
+		return nil, fmt.Errorf("reading CSV: %w", err)
+	}
+	return records, nil
+}
+
+// columnIndexes maps header names to column indexes and verifies that all
+// required columns are present.
+func columnIndexes(header []string) (map[string]int, error) {
+	idx := make(map[string]int, len(header))
+	for i, name := range header {
+		name = strings.TrimSpace(name)
+		if name == "" {
+			continue
+		}
+		if _, dup := idx[name]; dup {
+			continue // first occurrence wins
+		}
+		idx[name] = i
+	}
+	for _, req := range []string{"region", "product", "qty", "price"} {
+		if _, ok := idx[req]; !ok {
+			return nil, fmt.Errorf("missing required column %q", req)
+		}
+	}
+	return idx, nil
+}
+
+// fieldAt returns a single trimmed field, or an error mentioning the line
+// if the row is too short.
+func fieldAt(rec []string, col, line int) (string, error) {
+	if col < 0 || col >= len(rec) {
+		return "", fmt.Errorf("line %d: missing field", line)
+	}
+	return strings.TrimSpace(rec[col]), nil
+}
+
+// parseQty parses a non-negative integer quantity.
+func parseQty(rec []string, col, line int) (int, error) {
+	v, err := fieldAt(rec, col, line)
+	if err != nil {
+		return 0, err
+	}
+	n, err := strconv.Atoi(v)
+	if err != nil || n < 0 {
+		return 0, fmt.Errorf("line %d: invalid qty %q", line, v)
+	}
+	return n, nil
+}
+
+// parsePrice parses a decimal with at most two decimal places into an
+// integer number of cents.
+func parsePrice(rec []string, col, line int) (int64, error) {
+	v, err := fieldAt(rec, col, line)
+	if err != nil {
+		return 0, err
+	}
+	c, ok := parseCents(v)
+	if !ok {
+		return 0, fmt.Errorf("line %d: invalid price %q", line, v)
+	}
+	return c, nil
+}
+
+// parseCents converts a decimal string (optionally signed, with at most
+// two decimals) to integer cents. It reports ok=false for anything else.
+func parseCents(s string) (int64, bool) {
+	neg := false
+	if strings.HasPrefix(s, "-") {
+		neg = true
+		s = s[1:]
+	} else if strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	if s == "" {
+		return 0, false
+	}
+	whole, frac := s, ""
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		whole, frac = s[:i], s[i+1:]
+	}
+	if len(frac) > 2 || !allDigits(whole) || !allDigits(frac) {
+		return 0, false
+	}
+	w, err := strconv.ParseInt(whole, 10, 64)
+	if err != nil {
+		if whole == "" {
+			w = 0 // e.g. ".50"
+		} else {
+			return 0, false
+		}
+	}
+	var f int64
+	switch len(frac) {
+	case 0:
+	case 1:
+		f = int64(frac[0]-'0') * 10
+	case 2:
+		f, _ = strconv.ParseInt(frac, 10, 64)
+	}
+	c := w*100 + f
+	if neg {
+		return -c, true
+	}
+	return c, true
+}
+
+// allDigits reports whether s consists solely of ASCII digits (the empty
+// string is treated as digits, so callers decide about emptiness).
+func allDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// formatCents renders integer cents with exactly two decimals, e.g.
+// 330 -> "3.30", 5 -> "0.05", -330 -> "-3.30".
+func formatCents(c int64) string {
+	sign := ""
+	if c < 0 {
+		sign = "-"
+		c = -c
+	}
+	return fmt.Sprintf("%s%d.%02d", sign, c/100, c%100)
+}
