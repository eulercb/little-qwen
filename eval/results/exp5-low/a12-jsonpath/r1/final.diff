+package jpath
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestRoot(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	got, err := Query(d, "$")
+	if err != nil || !reflect.DeepEqual(got, []any{d}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestIndexAndNegative(t *testing.T) {
+	d := doc(t, `{"l":[10,20,30]}`)
+	cases := map[string][]any{
+		"$.l[0]":   {10.0},
+		"$.l[2]":   {30.0},
+		"$.l[-1]":  {30.0},
+		"$.l[-3]":  {10.0},
+		"$.l[-4]":  {},
+		"$.l[3]":   {},
+		"$.l[-9]":  {},
+		"$.l[0]x":  nil, // malformed
+	}
+	for path, want := range cases {
+		got, err := Query(d, path)
+		if want == nil {
+			if err == nil {
+				t.Errorf("%s: expected error, got %v", path, got)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("%s: %v", path, err)
+			continue
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: got %v want %v", path, got, want)
+		}
+	}
+}
+
+func TestQuotedKey(t *testing.T) {
+	d := doc(t, `{"a b":1, "c\"d":2, "e\\f":3, "g]h":4}`)
+	cases := map[string][]any{
+		`$["a b"]`:  {1.0},
+		`$["c\"d"]`: {2.0},
+		`$["e\\f"]`: {3.0},
+		`$["g]h"]`:  {4.0},
+		`$["zz"]`:   {},
+	}
+	for path, want := range cases {
+		got, err := Query(d, path)
+		if err != nil {
+			t.Errorf("%s: %v", path, err)
+			continue
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: got %v want %v", path, got, want)
+		}
+	}
+}
+
+func TestWildcard(t *testing.T) {
+	d := doc(t, `{"z":1,"b":{"y":2,"a":3},"arr":[4,5],"s":"x"}`)
+	got, err := Query(d, "$.*")
+	if err != nil || !reflect.DeepEqual(got, []any{[]any{4.0, 5.0}, map[string]any{"y": 2.0, "a": 3.0}, "x", 1.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	got, err = Query(d, "$.arr[*]")
+	if err != nil || !reflect.DeepEqual(got, []any{4.0, 5.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	got, err = Query(d, "$.s.*")
+	if err != nil || !reflect.DeepEqual(got, []any{}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	if got == nil {
+		t.Fatal("empty result must be non-nil")
+	}
+}
+
+func TestRecursive(t *testing.T) {
+	d := doc(t, `{"a":{"b":{"a":2}},"x":[1,{"a":3}]}`)
+	got, err := Query(d, "$..a")
+	if err != nil || !reflect.DeepEqual(got, []any{map[string]any{"b": map[string]any{"a": 2.0}}, 2.0, 3.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	// self-nested match: the matched child is also descended into
+	d2 := doc(t, `{"a":{"a":1,"b":{"a":2}}}`)
+	got, err = Query(d2, "$..a")
+	if err != nil || !reflect.DeepEqual(got, []any{map[string]any{"a": 1.0, "b": map[string]any{"a": 2.0}}, 1.0, 2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestNonMatchingStepsNotErrors(t *testing.T) {
+	d := doc(t, `{"a":[1]}`)
+	for _, p := range []string{"$.a.b", "$.a[5]", "$.a[0].x", "$.nope", "$.a[0][0]"} {
+		got, err := Query(d, p)
+		if err != nil {
+			t.Errorf("%s: %v", p, err)
+			continue
+		}
+		if got == nil || len(got) != 0 {
+			t.Errorf("%s: got %v", p, got)
+		}
+	}
+}
+
+func TestMalformed(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	for _, p := range []string{"", "a.b", "$.", "$[", "$[1", `$["x]`, "$.1abc", "$[abc]", "$[ ]", "$[]", "$[+1]", "$[1.5]", "$..", "$..1abc", `$["a`, "$[x", "$.a..", "$..", "$a"} {
+		got, err := Query(d, p)
+		if err == nil {
+			t.Errorf("%s: expected error, got %v", p, got)
+		}
+		if got != nil {
+			t.Errorf("%s: expected nil result, got %v", p, got)
+		}
+	}
+}
