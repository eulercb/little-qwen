+// Package tmpl implements a tiny text template engine.
+//
+// A template is text with {{ ... }} tags. A tag is a variable name,
+// optionally followed by filters: {{ name | filter | filter:"arg" }}.
+package tmpl
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Render evaluates the template src against data and returns the result.
+//
+// Text outside {{ ... }} tags is copied verbatim; "{{{{" renders as a
+// literal "{{" and does not start a tag. A tag references a name from data
+// (dotted names index nested map[string]any values) and applies zero or more
+// filters left to right.
+func Render(src string, data map[string]any) (string, error) {
+	var out strings.Builder
+	for i := 0; i < len(src); {
+		if !strings.HasPrefix(src[i:], "{{") {
+			out.WriteByte(src[i])
+			i++
+			continue
+		}
+		if strings.HasPrefix(src[i:], "{{{{") {
+			out.WriteString("{{")
+			i += 4
+			continue
+		}
+		rest := src[i+2:]
+		end := strings.Index(rest, "}}")
+		if end < 0 {
+			return "", errors.New("unterminated tag: {{ without }}")
+		}
+		tag, err := parseTag(rest[:end])
+		if err != nil {
+			return "", err
+		}
+		val, err := evalTag(tag, data)
+		if err != nil {
+			return "", err
+		}
+		out.WriteString(val)
+		i += 2 + end + 2
+	}
+	return out.String(), nil
+}
+
+// tag is a parsed {{ ... }} tag: a dotted name and its filters.
+type tag struct {
+	name    string
+	filters []filter
+}
+
+// filter is one applied transformation, with an optional string argument.
+type filter struct {
+	name   string
+	arg    string
+	hasArg bool
+}
+
+// parseTag parses the text between the braces of a tag.
+func parseTag(body string) (*tag, error) {
+	s := strings.TrimSpace(body)
+	if s == "" {
+		return nil, errors.New("empty tag")
+	}
+	pos, name, err := parseName(s, 0)
+	if err != nil {
+		return nil, err
+	}
+	t := &tag{name: name}
+	for {
+		pos = skipSpace(s, pos)
+		if pos >= len(s) {
+			break
+		}
+		if s[pos] != '|' {
+			return nil, fmt.Errorf("bad tag %q: expected | or end of tag", body)
+		}
+		f, n, err := parseFilter(s[pos+1:])
+		if err != nil {
+			return nil, err
+		}
+		pos += 1 + n
+		t.filters = append(t.filters, f)
+	}
+	return t, nil
+}
+
+// parseName reads a name: identifier optionally followed by .field segments.
+// Whitespace around the name and around dots is ignored.
+func parseName(s string, pos int) (int, string, error) {
+	pos = skipSpace(s, pos)
+	start := pos
+	for pos < len(s) && isIdentChar(s[pos]) {
+		pos++
+	}
+	if pos == start || !isIdentStart(s[start]) {
+		return pos, "", errors.New("bad name in tag")
+	}
+	name := s[start:pos]
+	for {
+		save := pos
+		pos = skipSpace(s, pos)
+		if pos >= len(s) || s[pos] != '.' {
+			pos = save
+			break
+		}
+		pos = skipSpace(s, pos+1)
+		start = pos
+		for pos < len(s) && isIdentChar(s[pos]) {
+			pos++
+		}
+		if pos == start || !isIdentStart(s[start]) {
+			return pos, "", errors.New("bad name in tag")
+		}
+		name += "." + s[start:pos]
+	}
+	return pos, name, nil
+}
+
+// parseFilter reads one filter after a '|': an identifier, optionally
+// followed by : and a double-quoted string argument supporting \" and \\
+// escapes. It returns the filter and the number of bytes consumed.
+func parseFilter(s string) (filter, int, error) {
+	pos := skipSpace(s, 0)
+	start := pos
+	for pos < len(s) && isIdentChar(s[pos]) {
+		pos++
+	}
+	if pos == start || !isIdentStart(s[start]) {
+		return filter{}, 0, fmt.Errorf("bad filter in %q", strings.TrimSpace(s))
+	}
+	f := filter{name: s[start:pos]}
+	pos = skipSpace(s, pos)
+	if pos >= len(s) || s[pos] == '|' {
+		return f, pos, nil
+	}
+	if s[pos] != ':' {
+		return filter{}, 0, fmt.Errorf("bad argument for filter %q", f.name)
+	}
+	pos = skipSpace(s, pos+1)
+	if pos >= len(s) || s[pos] != '"' {
+		return filter{}, 0, fmt.Errorf("missing argument for filter %q", f.name)
+	}
+	var b strings.Builder
+	pos++
+	closed := false
+	for pos < len(s) {
+		c := s[pos]
+		if c == '\\' {
+			if pos+1 >= len(s) || (s[pos+1] != '"' && s[pos+1] != '\\') {
+				return filter{}, 0, fmt.Errorf("bad escape in argument for filter %q", f.name)
+			}
+			b.WriteByte(s[pos+1])
+			pos += 2
+			continue
+		}
+		if c == '"' {
+			closed = true
+			pos++
+			break
+		}
+		b.WriteByte(c)
+		pos++
+	}
+	if !closed {
+		return filter{}, 0, fmt.Errorf("unterminated argument for filter %q", f.name)
+	}
+	f.arg = b.String()
+	f.hasArg = true
+	pos = skipSpace(s, pos)
+	if pos < len(s) && s[pos] != '|' {
+		return filter{}, 0, fmt.Errorf("unexpected content after argument for filter %q", f.name)
+	}
+	return f, pos, nil
+}
+
+// evalTag resolves the tag's name in data and applies its filters.
+func evalTag(t *tag, data map[string]any) (string, error) {
+	v, err := lookup(data, t.name)
+	if err != nil {
+		return "", err
+	}
+	s := formatValue(v)
+	for _, f := range t.filters {
+		s, err = applyFilter(f, s)
+		if err != nil {
+			return "", err
+		}
+	}
+	return s, nil
+}
+
+// lookup walks the dotted name through nested map[string]any values.
+// A missing key (or explicit nil) yields nil without an error; indexing a
+// .field into a non-map value is an error naming the full path.
+func lookup(data map[string]any, name string) (any, error) {
+	parts := strings.Split(name, ".")
+	v := any(data)
+	for _, p := range parts {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("cannot index %q into a value that is not a map", name)
+		}
+		nv, exists := m[p]
+		if !exists || nv == nil {
+			return nil, nil
+		}
+		v = nv
+	}
+	return v, nil
+}
+
+// formatValue converts a resolved value to its string form.
+func formatValue(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return v
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	case int, int64, float64:
+		return fmt.Sprint(v)
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// applyFilter applies one filter to a string value.
+func applyFilter(f filter, s string) (string, error) {
+	switch f.name {
+	case "upper":
+		if f.hasArg {
+			return "", fmt.Errorf("extra argument for filter %q", f.name)
+		}
+		return strings.ToUpper(s), nil
+	case "lower":
+		if f.hasArg {
+			return "", fmt.Errorf("extra argument for filter %q", f.name)
+		}
+		return strings.ToLower(s), nil
+	case "trim":
+		if f.hasArg {
+			return "", fmt.Errorf("extra argument for filter %q", f.name)
+		}
+		return strings.TrimSpace(s), nil
+	case "html":
+		if f.hasArg {
+			return "", fmt.Errorf("extra argument for filter %q", f.name)
+		}
+		return htmlEscape(s), nil
+	case "default":
+		if !f.hasArg {
+			return "", fmt.Errorf("missing argument for filter %q", f.name)
+		}
+		if s == "" {
+			return f.arg, nil
+		}
+		return s, nil
+	case "truncate":
+		if !f.hasArg {
+			return "", fmt.Errorf("missing argument for filter %q", f.name)
+		}
+		n, err := strconv.Atoi(f.arg)
+		if err != nil {
+			return "", fmt.Errorf("non-integer argument %q for filter %q", f.arg, f.name)
+		}
+		if n < 0 {
+			return "", fmt.Errorf("negative argument %q for filter %q", f.arg, f.name)
+		}
+		r := []rune(s)
+		if len(r) <= n {
+			return s, nil
+		}
+		return string(r[:n]) + "…", nil
+	default:
+		return "", fmt.Errorf("unknown filter %q", f.name)
+	}
+}
+
+// htmlEscape escapes &, <, >, " and ' for HTML output.
+func htmlEscape(s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		switch c := s[i]; c {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&#34;")
+		case '\'':
+			b.WriteString("&#39;")
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// skipSpace advances past ASCII whitespace.
+func skipSpace(s string, pos int) int {
+	for pos < len(s) && isSpace(s[pos]) {
+		pos++
+	}
+	return pos
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
+
+func isIdentStart(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdentChar(c byte) bool {
+	return isIdentStart(c) || (c >= '0' && c <= '9')
+}
