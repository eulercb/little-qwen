+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRenderBasic(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		data map[string]any
+		want string
+	}{
+		{"plain text", "hello world", nil, "hello world"},
+		{"simple var", "hi {{ name }}!", map[string]any{"name": "World"}, "hi World!"},
+		{"no spaces in tag", "{{name}}", map[string]any{"name": "World"}, "World"},
+		{"padded tag", "{{  name  }}", map[string]any{"name": "World"}, "World"},
+		{"missing var", "a{{ nope }}b", nil, "ab"},
+		{"missing var in data", "a{{ nope }}b", map[string]any{"x": 1}, "ab"},
+		{"nil value", "a{{ x }}b", map[string]any{"x": nil}, "ab"},
+		{"string as is", "[{{ s }}]", map[string]any{"s": "  keep  "}, "[  keep  ]"},
+		{"int", "{{ age }}y", map[string]any{"age": 42}, "42y"},
+		{"int64", "[{{ a }}]", map[string]any{"a": int64(7)}, "[7]"},
+		{"float64", "[{{ a }}-{{ b }}]", map[string]any{"a": float64(3.5), "b": 1}, "[3.5-1]"},
+		{"bool true", "[{{ f }}]", map[string]any{"f": true}, "[true]"},
+		{"bool false", "[{{ f }}]", map[string]any{"f": false}, "[false]"},
+		{"nested map", "{{ user.name }}", map[string]any{"user": map[string]any{"name": "Ann"}}, "Ann"},
+		{"nested missing", "[{{ user.name }}]", map[string]any{"user": map[string]any{}}, "[]"},
+		{"deep nested", "{{ a.b.c }}", map[string]any{"a": map[string]any{"b": map[string]any{"c": "ok"}}}, "ok"},
+		{"dotted whitespace", "{{ user . name }}", map[string]any{"user": map[string]any{"name": "Ann"}}, "Ann"},
+		{"underscore name", "_{{ _v }}", map[string]any{"_v": "x"}, "_x"},
+		{"multiple tags", "{{a}}-{{b}}-{{a}}", map[string]any{"a": "x", "b": 2}, "x-2-x"},
+		{"adjacent braces", "{{a}}{{b}}", map[string]any{"a": "1", "b": "2"}, "12"},
+		{"literal open braces", "a{{{{b", nil, "a{{b"},
+		{"literal open braces only", "{{{{", nil, "{{"},
+		{"literal open braces then tag", "{{{{x}}{{a}}", map[string]any{"a": "Y"}, "{{x}}Y"},
+		{"literal open then text close", "a{{{{ }}b", nil, "a{{ }}b"},
+		{"close braces in text", "a }} b", nil, "a }} b"},
+		{"unicode value", "[{{ s }}]", map[string]any{"s": "héllo"}, "[héllo]"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Render(tt.src, tt.data)
+			if err != nil {
+				t.Fatalf("Render(%q) error: %v", tt.src, err)
+			}
+			if got != tt.want {
+				t.Fatalf("Render(%q) = %q, want %q", tt.src, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRenderFilters(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		data map[string]any
+		want string
+	}{
+		{"upper", "{{ s | upper }}", map[string]any{"s": "AbC"}, "ABC"},
+		{"upper no spaces", "{{s|upper}}", map[string]any{"s": "abc"}, "ABC"},
+		{"padded filter", "{{ s |  upper  }}", map[string]any{"s": "abc"}, "ABC"},
+		{"lower", "{{ s | lower }}", map[string]any{"s": "AbC"}, "abc"},
+		{"trim", "{{ s | trim }}", map[string]any{"s": "  \thi\n "}, "hi"},
+		{"html", "{{ s | html }}", map[string]any{"s": `& < > " '`}, "&amp; &lt; &gt; &#34; &#39;"},
+		{"html keeps rest", "{{ s | html }}", map[string]any{"s": "a&b<c>d"}, "a&amp;b&lt;c&gt;d"},
+		{"default on empty", "{{ x | default:\"N/A\" }}", nil, "N/A"},
+		{"default on missing", "{{ x | default:\"N/A\" }}", map[string]any{"y": 1}, "N/A"},
+		{"default keeps non-empty", "{{ x | default:\"N/A\" }}", map[string]any{"x": "v"}, "v"},
+		{"default empty arg is no-op", "{{ x | default:\"\" }}", nil, ""},
+		{"default arg escapes", `{{ x | default:"a\"b\\c" }}`, nil, `a"b\c`},
+		{"default arg with colon and pipe", `{{ x | default:"a:b|c" }}`, nil, "a:b|c"},
+		{"colon and space padding", `{{ x | default : "Z" }}`, nil, "Z"},
+		{"truncate cuts", "{{ s | truncate:\"5\" }}", map[string]any{"s": "hello world"}, "hello…"},
+		{"truncate exact no ellipsis", "{{ s | truncate:\"5\" }}", map[string]any{"s": "hello"}, "hello"},
+		{"truncate shorter than n", "{{ s | truncate:\"10\" }}", map[string]any{"s": "hi"}, "hi"},
+		{"truncate zero", "{{ s | truncate:\"0\" }}", map[string]any{"s": "abc"}, "…"},
+		{"truncate zero on empty", "[{{ s | truncate:\"0\" }}]", nil, "[]"},
+		{"truncate counts runes", "{{ s | truncate:\"3\" }}", map[string]any{"s": "héllo"}, "hél…"},
+		{"chain trim upper", "{{ s | trim | upper }}", map[string]any{"s": "  ab "}, "AB"},
+		{"chain default upper", "{{ x | default:\"x\" | upper }}", nil, "X"},
+		{"chain html after default", `{{ x | default:"<a>" | html }}`, nil, "&lt;a&gt;"},
+		{"nested with filter", "{{ user.name | upper }}", map[string]any{"user": map[string]any{"name": "ann"}}, "ANN"},
+		{"int with filter", "{{ n | upper }}", map[string]any{"n": 5}, "5"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Render(tt.src, tt.data)
+			if err != nil {
+				t.Fatalf("Render(%q) error: %v", tt.src, err)
+			}
+			if got != tt.want {
+				t.Fatalf("Render(%q) = %q, want %q", tt.src, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRenderErrors(t *testing.T) {
+	tests := []struct {
+		name   string
+		src    string
+		data   map[string]any
+		errSub string
+	}{
+		{"unknown filter", "{{ s | nope }}", map[string]any{"s": "x"}, "nope"},
+		{"missing arg for default", "{{ s | default }}", map[string]any{"s": ""}, "default"},
+		{"missing arg for truncate", "{{ s | truncate }}", map[string]any{"s": ""}, "truncate"},
+		{"extra arg for upper", `{{ s | upper:"x" }}`, map[string]any{"s": "x"}, "upper"},
+		{"extra arg for lower", `{{ s | lower:"x" }}`, map[string]any{"s": "x"}, "lower"},
+		{"extra arg for trim", `{{ s | trim:"x" }}`, map[string]any{"s": "x"}, "trim"},
+		{"extra arg for html", `{{ s | html:"x" }}`, map[string]any{"s": "x"}, "html"},
+		{"truncate non-integer", `{{ s | truncate:"x" }}`, map[string]any{"s": "x"}, "truncate"},
+		{"truncate negative", `{{ s | truncate:"-3" }}`, map[string]any{"s": "x"}, "truncate"},
+		{"unterminated tag", "{{ s", map[string]any{"s": "x"}, ""},
+		{"unterminated tag with content", "a {{ s | upper", map[string]any{"s": "x"}, ""},
+		{"empty tag", "{{ }}", nil, ""},
+		{"empty tag whitespace", "{{    }}", nil, ""},
+		{"bad name digits", "{{ 123 }}", map[string]any{}, ""},
+		{"bad name double dot", "{{ user..name }}", map[string]any{"user": map[string]any{}}, ""},
+		{"bad name trailing dot", "{{ user. }}", map[string]any{"user": map[string]any{}}, ""},
+		{"bad name empty", "{{ .name }}", map[string]any{}, ""},
+		{"index into non-map", "{{ user.name }}", map[string]any{"user": "bob"}, "user.name"},
+		{"index into non-map deep", "{{ user.name.first }}", map[string]any{"user": map[string]any{"name": "bob"}}, "user.name.first"},
+		{"index int field", "{{ n.x }}", map[string]any{"n": 1}, "n.x"},
+		{"unterminated quoted arg", `{{ s | default:"x }}`, map[string]any{"s": ""}, "default"},
+		{"tag with only pipe", "{{ | upper }}", nil, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Render(tt.src, tt.data)
+			if err == nil {
+				t.Fatalf("Render(%q) = %q, want error", tt.src, got)
+			}
+			if got != "" {
+				t.Fatalf("Render(%q) output on error = %q, want empty", tt.src, got)
+			}
+			if tt.errSub != "" && !strings.Contains(err.Error(), tt.errSub) {
+				t.Fatalf("error %q does not contain %q", err.Error(), tt.errSub)
+			}
+		})
+	}
+}
