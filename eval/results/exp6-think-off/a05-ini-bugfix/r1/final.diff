+// indexInlineComment returns the index of an inline comment start (" ;" or " #")
+// in an unquoted value, or -1 if there is none.
+func indexInlineComment(val string) int {
+	for i := 0; i < len(val); i++ {
+		if val[i] == ' ' && i+1 < len(val) && (val[i+1] == ';' || val[i+1] == '#') {
+			return i
+		}
+	}
+	return -1
+}
