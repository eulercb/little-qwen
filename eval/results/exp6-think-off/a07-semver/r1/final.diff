+// Package semver implements Semantic Versioning 2.0.0 parsing and precedence.
+package semver
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version is a semantic version: MAJOR.MINOR.PATCH with optional pre-release
+// and build metadata identifiers.
+type Version struct {
+	Major uint64
+	Minor uint64
+	Patch uint64
+	Pre   []string
+	Build []string
+}
+
+// Parse parses s as a semantic version. An optional leading "v" or "V" is
+// accepted, followed by MAJOR.MINOR.PATCH, an optional -pre.release section,
+// and an optional +build section.
+func Parse(s string) (Version, error) {
+	if s == "" {
+		return Version{}, errors.New("semver: empty version string")
+	}
+	s = strings.TrimPrefix(s, "v")
+	s = strings.TrimPrefix(s, "V")
+
+	var v Version
+	rest := s
+	var err error
+
+	// Separate the optional pre-release and build metadata sections before
+	// parsing the core numeric parts, so that '-' or '+' do not leak into a
+	// component. The first such character in the string starts the section:
+	// "1.0.0-alpha" has its '-' after the patch.
+	preStart := strings.IndexByte(rest, '-')
+	buildStart := strings.IndexByte(rest, '+')
+	switch {
+	case preStart >= 0 && (buildStart < 0 || preStart < buildStart):
+		core := rest[:preStart]
+		preEnd := len(rest)
+		if buildStart > preStart {
+			preEnd = buildStart
+		}
+		v.Pre, err = splitIDs(rest[preStart+1:preEnd], "-")
+		if err != nil {
+			return Version{}, err
+		}
+		rest = core
+		if buildStart > preStart {
+			build, err := splitIDs(s[buildStart+1:], "+")
+			if err != nil {
+				return Version{}, err
+			}
+			v.Build = build
+		} else if buildStart >= 0 {
+			// A '+' before the '-' cannot start a build section; it is an
+			// invalid character in the core version.
+			return Version{}, fmt.Errorf("semver: invalid character '+' in %q", s)
+		}
+	case buildStart >= 0:
+		v.Build, err = splitIDs(rest[buildStart+1:], "+")
+		if err != nil {
+			return Version{}, err
+		}
+		rest = rest[:buildStart]
+	}
+
+	// Core numeric parts.
+	for i, field := range []*uint64{&v.Major, &v.Minor, &v.Patch} {
+		dot := strings.IndexByte(rest, '.')
+		var part string
+		if dot < 0 {
+			part = rest
+			rest = ""
+		} else {
+			part = rest[:dot]
+			rest = rest[dot+1:]
+		}
+		n, err := parseNumericID(part)
+		if err != nil {
+			return Version{}, fmt.Errorf("semver: invalid %s component %q", []string{"major", "minor", "patch"}[i], part)
+		}
+		*field = n
+	}
+	if rest != "" {
+		return Version{}, fmt.Errorf("semver: unexpected trailing characters %q", rest)
+	}
+	return v, nil
+}
+
+// MustParse parses s and panics if it is not a valid semantic version.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+// String returns the canonical form of v without any leading "v".
+func (v Version) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%d.%d.%d", v.Major, v.Minor, v.Patch)
+	if len(v.Pre) > 0 {
+		b.WriteByte('-')
+		b.WriteString(strings.Join(v.Pre, "."))
+	}
+	if len(v.Build) > 0 {
+		b.WriteByte('+')
+		b.WriteString(strings.Join(v.Build, "."))
+	}
+	return b.String()
+}
+
+// Compare compares two versions by SemVer precedence and returns -1 if a < b,
+// 0 if they are equal, and +1 if a > b. Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := compareUint(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	return comparePre(a.Pre, b.Pre)
+}
+
+func compareUint(x, y uint64) int {
+	switch {
+	case x < y:
+		return -1
+	case x > y:
+		return 1
+	default:
+		return 0
+	}
+}
+
+func comparePre(a, b []string) int {
+	// No pre-release means higher precedence than having one.
+	if len(a) == 0 && len(b) == 0 {
+		return 0
+	}
+	if len(a) == 0 {
+		return 1
+	}
+	if len(b) == 0 {
+		return -1
+	}
+	for i := range a {
+		if i >= len(b) {
+			return 1 // longer list with equal prefix is higher
+		}
+		if c := comparePreID(a[i], b[i]); c != 0 {
+			return c
+		}
+	}
+	if len(a) < len(b) {
+		return -1
+	}
+	return 0
+}
+
+func comparePreID(x, y string) int {
+	xNum := isNumeric(x)
+	yNum := isNumeric(y)
+	switch {
+	case xNum && yNum:
+		// Numeric comparison; identifiers are validated during parsing.
+		xi, _ := strconv.ParseUint(x, 10, 64)
+		yi, _ := strconv.ParseUint(y, 10, 64)
+		switch {
+		case xi < yi:
+			return -1
+		case xi > yi:
+			return 1
+		default:
+			return 0
+		}
+	case xNum:
+		return -1 // numeric identifiers always sort before alphanumeric ones
+	case yNum:
+		return 1
+	default:
+		switch {
+		case x < y:
+			return -1
+		case x > y:
+			return 1
+		default:
+			return 0
+		}
+	}
+}
+
+// parseNumericID parses a non-empty decimal integer that must not have a
+// leading zero (except for "0" itself).
+func parseNumericID(s string) (uint64, error) {
+	if s == "" {
+		return 0, errors.New("empty identifier")
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return 0, fmt.Errorf("identifier %q contains non-numeric characters", s)
+		}
+	}
+	if len(s) > 1 && s[0] == '0' {
+		return 0, fmt.Errorf("identifier %q has a leading zero", s)
+	}
+	n, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("identifier %q out of range", s)
+	}
+	return n, nil
+}
+
+// splitIDs splits s on "." into identifiers, each of which must be non-empty
+// and contain only [0-9A-Za-z-]. Numeric identifiers may not have leading
+// zeros. The label names the section for error messages.
+func splitIDs(s, label string) ([]string, error) {
+	if s == "" {
+		return nil, fmt.Errorf("semver: empty %s section", label)
+	}
+	parts := strings.Split(s, ".")
+	out := make([]string, len(parts))
+	for i, p := range parts {
+		if p == "" {
+			return nil, fmt.Errorf("semver: empty identifier in %s section %q", label, s)
+		}
+		for _, c := range p {
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '-') {
+				return nil, fmt.Errorf("semver: invalid character %q in identifier %q of %s section", c, p, label)
+			}
+		}
+		if isNumeric(p) && len(p) > 1 && p[0] == '0' {
+			return nil, fmt.Errorf("semver: numeric identifier %q in %s section has a leading zero", p, label)
+		}
+		out[i] = p
+	}
+	return out, nil
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
