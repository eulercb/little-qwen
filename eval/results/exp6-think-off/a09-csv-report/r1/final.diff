+package main
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func runCapture(t *testing.T, args []string, csv string) (string, error) {
+	t.Helper()
+	var out bytes.Buffer
+	err := run(args, strings.NewReader(csv), &out)
+	return out.String(), err
+}
+
+const sample = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func TestExampleByRegion(t *testing.T) {
+	got, err := runCapture(t, []string{"--by", "region"}, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDefaultIsRegion(t *testing.T) {
+	got, err := runCapture(t, nil, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(got, "north") || !strings.Contains(got, "south") {
+		t.Fatalf("default grouping should be region, got %q", got)
+	}
+}
+
+func TestByProduct(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,apple,2,1.10\nsouth,pear,1,2.00\n"
+	got, err := runCapture(t, []string{"--by", "product"}, csv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "apple\t5\t5.50\npear\t1\t2.00\nTOTAL\t6\t7.50\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestSortRevenueDescTieByName(t *testing.T) {
+	csv := "region,product,qty,price\nb,x,1,5.00\na,x,1,5.00\nc,x,2,2.50\n"
+	got, err := runCapture(t, nil, csv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t1\t5.00\nb\t1\t5.00\nc\t2\t5.00\nTOTAL\t4\t15.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTop(t *testing.T) {
+	csv := "region,product,qty,price\nb,x,1,5.00\na,x,1,5.00\nc,x,2,2.50\n"
+	got, err := runCapture(t, []string{"--top", "2"}, csv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t1\t5.00\nb\t1\t5.00\nTOTAL\t4\t15.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTopLargerThanGroups(t *testing.T) {
+	got, err := runCapture(t, []string{"--top", "10"}, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsAnyOrderAndExtra(t *testing.T) {
+	csv := "date,product,region,note,qty,price\n2024-01-01,apple,north,ok,3,1.10\n2024-01-02,pear,south,ok,1,2\n"
+	got, err := runCapture(t, nil, csv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestMissingColumn(t *testing.T) {
+	for _, missing := range []string{"region", "product", "qty", "price"} {
+		hdr := "region,product,qty,price"
+		parts := strings.Split(hdr, ",")
+		for i, p := range parts {
+			if p == missing {
+				parts[i] = "other"
+			}
+		}
+		csv := strings.Join(parts, ",") + "\nnorth,apple,3,1.10\n"
+		_, err := runCapture(t, nil, csv)
+		if err == nil {
+			t.Fatalf("missing %s: expected error, got nil", missing)
+		}
+		if !strings.Contains(err.Error(), missing) {
+			t.Errorf("missing %s: error %q does not mention column name", missing, err)
+		}
+	}
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,abc,2.00\n"
+	_, err := runCapture(t, nil, csv)
+	if err == nil {
+		t.Fatal("expected error for bad qty")
+	}
+	if !strings.Contains(err.Error(), "line 3") {
+		t.Fatalf("error %q should mention line 3", err)
+	}
+}
+
+func TestNegativeQty(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,-1,1.10\n"
+	_, err := runCapture(t, nil, csv)
+	if err == nil {
+		t.Fatal("expected error for negative qty")
+	}
+	if !strings.Contains(err.Error(), "line 2") {
+		t.Fatalf("error %q should mention line 2", err)
+	}
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,two\n"
+	_, err := runCapture(t, nil, csv)
+	if err == nil {
+		t.Fatal("expected error for bad price")
+	}
+	if !strings.Contains(err.Error(), "line 3") {
+		t.Fatalf("error %q should mention line 3", err)
+	}
+}
+
+func TestInvalidBy(t *testing.T) {
+	_, err := runCapture(t, []string{"--by", "bogus"}, sample)
+	if err == nil {
+		t.Fatal("expected error for invalid --by")
+	}
+}
+
+func TestInvalidTop(t *testing.T) {
+	for _, v := range []string{"0", "-1", "abc"} {
+		_, err := runCapture(t, []string{"--top", v}, sample)
+		if err == nil {
+			t.Fatalf("--top %s: expected error", v)
+		}
+	}
+}
+
+func TestUnknownFlag(t *testing.T) {
+	_, err := runCapture(t, []string{"--wat"}, sample)
+	if err == nil {
+		t.Fatal("expected error for unknown flag")
+	}
+}
+
+func TestZeroQtyAndCentsArithmetic(t *testing.T) {
+	// 0.10*3 + 0.20*3 in floats drifts; integer cents must give exactly 0.90.
+	csv := "region,product,qty,price\nr,a,3,0.10\nr,b,3,0.20\n"
+	got, err := runCapture(t, nil, csv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "r\t6\t0.90\nTOTAL\t6\t0.90\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestEmptyInput(t *testing.T) {
+	got, err := runCapture(t, nil, "region,product,qty,price\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "TOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestNoHeader(t *testing.T) {
+	_, err := runCapture(t, nil, "")
+	if err == nil {
+		t.Fatal("expected error for empty input with no header")
+	}
+}
+
+func Example_run() {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+	var out bytes.Buffer
+	if err := run([]string{"--by", "region"}, strings.NewReader(in), &out); err != nil {
+		fmt.Println("unexpected error:", err)
+		return
+	}
+	fmt.Print(out.String())
+	// Output:
+	// north	3	3.30
+	// south	1	2.00
+	// TOTAL	4	5.30
+}
