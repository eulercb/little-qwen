+package main
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// group holds the aggregated totals for one value of the grouping column.
+type group struct {
+	name   string
+	qty    int64
+	revenue int64 // in cents
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, in io.Reader, out io.Writer) error {
+	by := "region"
+	top := 0
+	for i := 0; i < len(args); i++ {
+		switch args[i] {
+		case "--by":
+			i++
+			if i >= len(args) {
+				return errors.New("--by requires a value")
+			}
+			v := args[i]
+			if v != "region" && v != "product" {
+				return fmt.Errorf("invalid --by value %q: must be region or product", v)
+			}
+			by = v
+		case "--top":
+			i++
+			if i >= len(args) {
+				return errors.New("--top requires a value")
+			}
+			n, err := strconv.Atoi(args[i])
+			if err != nil || n < 1 {
+				return fmt.Errorf("invalid --top value %q: must be an integer >= 1", args[i])
+			}
+			top = n
+		default:
+			return fmt.Errorf("unknown flag %q", args[i])
+		}
+	}
+
+	r := bufio.NewReader(in)
+	header, err := r.ReadString('\n')
+	if err != nil && err != io.EOF {
+		return fmt.Errorf("reading header: %w", err)
+	}
+	colIdx := make(map[string]int)
+	for i, col := range strings.Split(strings.TrimRight(header, "\r\n"), ",") {
+		colIdx[strings.TrimSpace(col)] = i
+	}
+	required := []string{"region", "product", "qty", "price"}
+	for _, c := range required {
+		if _, ok := colIdx[c]; !ok {
+			return fmt.Errorf("missing required column %q", c)
+		}
+	}
+	byIdx := colIdx[by]
+
+	groups := make(map[string]*group)
+	var totalQty int64
+	var totalRevenue int64
+
+	lineNo := 1 // header was line 1
+	scanner := bufio.NewScanner(r)
+	for scanner.Scan() {
+		lineNo++
+		line := strings.TrimRight(scanner.Text(), "\r")
+		if line == "" {
+			continue
+		}
+		fields := strings.Split(line, ",")
+		if len(fields) != len(colIdx) {
+			return fmt.Errorf("line %d: expected %d columns, got %d", lineNo, len(colIdx), len(fields))
+		}
+		qtyStr := strings.TrimSpace(fields[colIdx["qty"]])
+		qty, err := strconv.ParseInt(qtyStr, 10, 64)
+		if err != nil || qty < 0 {
+			return fmt.Errorf("line %d: bad qty value %q", lineNo, qtyStr)
+		}
+		priceCents, err := parseCents(strings.TrimSpace(fields[colIdx["price"]]))
+		if err != nil {
+			return fmt.Errorf("line %d: bad price value %q", lineNo, fields[colIdx["price"]])
+		}
+		key := strings.TrimSpace(fields[byIdx])
+		g := groups[key]
+		if g == nil {
+			g = &group{name: key}
+			groups[key] = g
+		}
+		g.qty += qty
+		g.revenue += qty * priceCents
+		totalQty += qty
+		totalRevenue += qty * priceCents
+	}
+	if err := scanner.Err(); err != nil {
+		return fmt.Errorf("reading input: %w", err)
+	}
+
+	list := make([]*group, 0, len(groups))
+	for _, g := range groups {
+		list = append(list, g)
+	}
+	sort.Slice(list, func(i, j int) bool {
+		if list[i].revenue != list[j].revenue {
+			return list[i].revenue > list[j].revenue
+		}
+		return list[i].name < list[j].name
+	})
+	if top > 0 {
+		if top < len(list) {
+			list = list[:top]
+		}
+	}
+	w := bufio.NewWriter(out)
+	defer w.Flush()
+	for _, g := range list {
+		fmt.Fprintf(w, "%s\t%d\t%.2f\n", g.name, g.qty, float64(g.revenue)/100)
+	}
+	fmt.Fprintf(w, "TOTAL\t%d\t%.2f\n", totalQty, float64(totalRevenue)/100)
+	return nil
+}
+
+// parseCents parses a decimal price with at most two decimals into integer cents.
+func parseCents(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, errors.New("empty price")
+	}
+	neg := false
+	if s[0] == '-' || s[0] == '+' {
+		neg = s[0] == '-'
+		s = s[1:]
+	}
+	intPart := s
+	fracPart := ""
+	if dot := strings.IndexByte(s, '.'); dot >= 0 {
+		intPart = s[:dot]
+		fracPart = s[dot+1:]
+	}
+	if len(fracPart) > 2 {
+		return 0, fmt.Errorf("price %q has more than 2 decimals", s)
+	}
+	if intPart == "" && fracPart == "" {
+		return 0, errors.New("empty price")
+	}
+	i, err := strconv.ParseInt(intPart, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	cents := i * 100
+	for len(fracPart) < 2 {
+		fracPart += "0"
+	}
+	f, err := strconv.ParseInt(fracPart, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	cents += f
+	if neg {
+		cents = -cents
+	}
+	return cents, nil
+}
