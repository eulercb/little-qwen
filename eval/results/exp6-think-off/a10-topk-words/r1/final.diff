+// Package words provides word-frequency utilities.
+package words
+
+import (
+	"io"
+	"sort"
+	"strings"
+	"unicode"
+)
+
+// WordCount is a word together with its occurrence count.
+type WordCount struct {
+	Word  string
+	Count int
+}
+
+// TopK reads r, counts words (case-folded, ignoring stop words), and returns
+// the k most frequent words by count descending, ties broken by word ascending.
+// If there are fewer than k distinct words, all of them are returned.
+// k <= 0 returns an empty non-nil slice. The input is streamed in fixed-size
+// chunks, so very large inputs and long lines are handled without reading
+// everything into memory at once. Any read error from r is returned.
+func TopK(r io.Reader, k int, stop []string) ([]WordCount, error) {
+	if k <= 0 {
+		return []WordCount{}, nil
+	}
+	stopSet := make(map[string]struct{}, len(stop))
+	for _, w := range stop {
+		stopSet[strings.ToLower(w)] = struct{}{}
+	}
+	counts := make(map[string]int)
+	buf := make([]byte, 64*1024)
+	var pending string // trailing word fragment that may continue in the next chunk
+	for {
+		n, err := r.Read(buf)
+		if n > 0 {
+			pending += string(buf[:n])
+			word, rest := splitWord(pending)
+			for word != "" {
+				pending = addWord(word, pending, counts, stopSet)
+				word, rest = splitWord(pending)
+			}
+			pending = rest
+		}
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+	res := make([]WordCount, 0, len(counts))
+	for w, c := range counts {
+		res = append(res, WordCount{Word: w, Count: c})
+	}
+	sort.Slice(res, func(i, j int) bool {
+		if res[i].Count != res[j].Count {
+			return res[i].Count > res[j].Count
+		}
+		return res[i].Word < res[j].Word
+	})
+	if len(res) > k {
+		res = res[:k]
+	}
+	return res, nil
+}
+
+// splitWord returns the leading word of s ("" if s does not start with a word
+// character) and the remainder of s after that word. The returned word is
+// always lowercase; rest is the exact suffix of s, so len(s)-len(rest) bytes
+// were consumed.
+func splitWord(s string) (word, rest string) {
+	i := 0
+	n := len(s)
+	// Skip separators until a letter or digit.
+	for i < n && !isWordChar(s[i]) {
+		i++
+	}
+	start := i
+	for i < n {
+		c := s[i]
+		if isWordChar(c) {
+			i++
+			continue
+		}
+		if c == '\'' {
+			// An apostrophe belongs to the word only when it sits between
+			// two letters (e.g. don't, o'clock).
+			if i > start && i+1 < n && isLetter(s[i+1]) {
+				i++
+				continue
+			}
+			break
+		}
+		break
+	}
+	return strings.ToLower(s[start:i]), s[i:]
+}
+
+// addWord counts word in counts unless it is a stop word. It consumes exactly
+// the same number of bytes from s as splitWord did, returning the remaining
+// suffix of s.
+func addWord(word, s string, counts map[string]int, stopSet map[string]struct{}) string {
+	if _, isStop := stopSet[word]; !isStop {
+		counts[word]++
+	}
+	return s[len(s)-len(word):]
+}
+
+// isWordChar reports whether b is a Unicode letter or digit.
+func isWordChar(b byte) bool {
+	r := rune(b)
+	return unicode.IsLetter(r) || unicode.IsDigit(r)
+}
+
+// isLetter reports whether b is a Unicode letter.
+func isLetter(b byte) bool {
+	return unicode.IsLetter(rune(b))
+}
