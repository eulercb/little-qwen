+package words
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+)
+
+func check(t *testing.T, got []WordCount, want []WordCount) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("len = %d, want %d: %v", len(got), len(want), got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got[%d] = %+v, want %+v (full: %v)", i, got[i], want[i], got)
+		}
+	}
+}
+
+func TestTopKBasic(t *testing.T) {
+	in := "Don't don't DON'T o'clock the cat the dog the"
+	got, err := TopK(strings.NewReader(in), 3, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"don't", 3}, {"the", 3}, {"o'clock", 1}})
+}
+
+func TestTopKStopWordsCaseInsensitive(t *testing.T) {
+	in := "The the THE a A word"
+	got, err := TopK(strings.NewReader(in), 5, []string{"THE", "a"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"word", 1}})
+}
+
+func TestTopKTiesAscending(t *testing.T) {
+	in := "b a c b a c d"
+	got, err := TopK(strings.NewReader(in), 4, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"a", 2}, {"b", 2}, {"c", 2}, {"d", 1}})
+}
+
+func TestTopKFewerThanK(t *testing.T) {
+	got, err := TopK(strings.NewReader("x y"), 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"x", 1}, {"y", 1}})
+}
+
+func TestTopKKZeroAndNegative(t *testing.T) {
+	for _, k := range []int{0, -1} {
+		got, err := TopK(strings.NewReader("a b c"), k, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got == nil || len(got) != 0 {
+			t.Fatalf("k=%d: got %v, want empty non-nil", k, got)
+		}
+	}
+}
+
+func TestTopKApostropheRules(t *testing.T) {
+	in := "'hello' it's 'it's don't o'clock clock"
+	got, err := TopK(strings.NewReader(in), 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 'hello' -> hello; it's counted once (from "it's") and once from "'it's";
+	// don't, o'clock keep their apostrophes; clock separate.
+	want := map[string]int{"hello": 1, "it's": 2, "don't": 1, "o'clock": 1, "clock": 1}
+	if len(got) != len(want) {
+		t.Fatalf("got %v, want counts %v", got, want)
+	}
+	for i, wc := range got {
+		if want[wc.Word] != wc.Count {
+			t.Errorf("got[%d]=%+v does not match %v", i, wc, want)
+		}
+		delete(want, wc.Word)
+	}
+	if len(want) != 0 {
+		t.Errorf("missing words: %v", want)
+	}
+}
+
+func TestTopKUnicodeDigitsLetters(t *testing.T) {
+	in := "café café naïve 42 42 über"
+	got, err := TopK(strings.NewReader(in), 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"café", 2}, {"42", 2}, {"naïve", 1}, {"über", 1}})
+}
+
+type errReader struct{}
+
+func (errReader) Read(p []byte) (int, error) {
+	return 0, errors.New("boom")
+}
+
+func TestTopKReadError(t *testing.T) {
+	_, err := TopK(errReader{}, 3, nil)
+	if err == nil || err.Error() != "boom" {
+		t.Fatalf("err = %v, want boom", err)
+	}
+}
+
+func TestTopKLongLine(t *testing.T) {
+	// One line far larger than any default buffer size.
+	line := strings.Repeat("word ", 1<<20) // ~5MB single line
+	got, err := TopK(strings.NewReader(line), 1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(t, got, []WordCount{{"word", 1 << 20}})
+}
+
+func TestTopKLargeStream(t *testing.T) {
+	var sb strings.Builder
+	for i := 0; i < 1_000_000; i++ {
+		fmt.Fprintf(&sb, "alpha beta gamma delta\n")
+	}
+	got, err := TopK(strings.NewReader(sb.String()), 4, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := 1_000_000
+	check(t, got, []WordCount{{"alpha", n}, {"beta", n}, {"delta", n}, {"gamma", n}})
+}
+
+var _ io.Reader = errReader{}
