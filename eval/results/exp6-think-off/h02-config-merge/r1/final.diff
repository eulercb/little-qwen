+func TestLoadCollectsAllErrors(t *testing.T) {
+	_, err := Load(env(map[string]string{
+		"APP_PORT":    "abc",
+		"APP_DEBUG":   "notabool",
+		"APP_WORKERS": "0",
+		"APP_TIMEOUT": "soon",
+	}))
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	msg := err.Error()
+	for _, name := range []string{"APP_PORT", "APP_DEBUG", "APP_WORKERS", "APP_TIMEOUT"} {
+		if !strings.Contains(msg, name) {
+			t.Errorf("error %q does not mention %s", msg, name)
+		}
+	}
+	var multi interface{ Unwrap() []error }
+	if !errors.As(err, &multi) {
+		t.Fatalf("error is not joinable: %T", err)
+	}
+	if got := len(multi.Unwrap()); got != 4 {
+		t.Fatalf("joined errors = %d, want 4", got)
+	}
+}
