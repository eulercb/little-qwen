+func TestMerge(t *testing.T) {
+	base := Config{Host: "h", Port: 1, Debug: true, Workers: 2, Timeout: time.Minute, Tags: []string{"x"}}
+	override := Config{Port: 2, Timeout: 5 * time.Second, Tags: []string{"y", "z"}}
+	got := Merge(base, override)
+	want := Config{Host: "h", Port: 2, Debug: true, Workers: 2, Timeout: 5 * time.Second, Tags: []string{"y", "z"}}
+	if got.Host != "h" || got.Port != 2 || !got.Debug || got.Workers != 2 || got.Timeout != 5*time.Second {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+	if len(got.Tags) != 2 || got.Tags[0] != "y" || got.Tags[1] != "z" {
+		t.Fatalf("Tags = %v, want [y z]", got.Tags)
+	}
+}
