+func TestLoadTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(map[string]string{
+		"APP_TIMEOUT": "2m5s",
+		"APP_TAGS": " a , b ,,c ",
+	}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != 125*time.Second {
+		t.Fatalf("Timeout = %v, want 2m5s", c.Timeout)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("Tags = %v, want %v", c.Tags, want)
+	}
+	for i := range want {
+		if c.Tags[i] != want[i] {
+			t.Fatalf("Tags = %v, want %v", c.Tags, want)
+		}
+	}
+}
+
+func TestLoadEmptyTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TAGS": " , ,"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(c.Tags) != 0 {
+		t.Fatalf("Tags = %v, want empty", c.Tags)
