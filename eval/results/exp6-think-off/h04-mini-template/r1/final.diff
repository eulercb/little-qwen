@@ -0,0 +1,211 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func mustRender(t *testing.T, src string, data map[string]any) string {
+	t.Helper()
+	out, err := Render(src, data)
+	if err != nil {
+		t.Fatalf("Render(%q) error: %v", src, err)
+	}
+	return out
+}
+
+func wantErr(t *testing.T, src string, data map[string]any, substrs ...string) {
+	t.Helper()
+	out, err := Render(src, data)
+	if err == nil {
+		t.Fatalf("Render(%q) = %q, want error containing %v", src, out, substrs)
+	}
+	for _, s := range substrs {
+		if !strings.Contains(err.Error(), s) {
+			t.Errorf("error %q does not contain %q", err, s)
+		}
+	}
+}
+
+var testdata = map[string]any{
+	"title":  "Hello World",
+	"name":   "  Ann  ",
+	"count":  42,
+	"big":    int64(1000),
+	"pi":     3.5,
+	"ok":     true,
+	"nope":   false,
+	"empty":  "",
+	"nilval": nil,
+	"user": map[string]any{
+		"name": "bob",
+		"age":  30,
+	},
+	"html": `<a href="x">&'`,
+	"long": "abcdefghij",
+}
+
+func TestVerbatimText(t *testing.T) {
+	got := mustRender(t, "plain text\nwith newline", nil)
+	if got != "plain text\nwith newline" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestEscapeSequence(t *testing.T) {
+	got := mustRender(t, `a {{{{ b {{ title }} c`, testdata)
+	want := "a {{ b Hello World c"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestSimpleTag(t *testing.T) {
+	got := mustRender(t, `{{title}}`, testdata)
+	if got != "Hello World" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestWhitespaceIgnored(t *testing.T) {
+	got := mustRender(t, `{{   title   |   upper   }}`, testdata)
+	if got != "HELLO WORLD" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestMissingNameIsEmpty(t *testing.T) {
+	got := mustRender(t, `[{{ghost}}|{{nilval}}]`, testdata)
+	if got != "[]" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestValueFormatting(t *testing.T) {
+	cases := []struct{ tag, want string }{
+		{"{{count}}", "42"},
+		{"{{big}}", "1000"},
+		{"{{pi}}", "3.5"},
+		{"{{ok}}", "true"},
+		{"{{nope}}", "false"},
+	}
+	for _, c := range cases {
+		if got := mustRender(t, c.tag, testdata); got != c.want {
+			t.Errorf("%s = %q, want %q", c.tag, got, c.want)
+		}
+	}
+}
+
+func TestDottedName(t *testing.T) {
+	got := mustRender(t, `{{user.name}} is {{user.age}}`, testdata)
+	if got != "bob is 30" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestDottedNameIntoNonMap(t *testing.T) {
+	wantErr(t, `{{user.name.first}}`, testdata, "user.name.first")
+}
+
+func TestFiltersUpperLowerTrim(t *testing.T) {
+	if got := mustRender(t, `{{name | trim | upper}}`, testdata); got != "ANN" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{title | lower}}`, testdata); got != "hello world" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{ name | trim }}`, testdata); got != "Ann" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestDefaultFilter(t *testing.T) {
+	if got := mustRender(t, `{{empty | default:"N/A"}}`, testdata); got != "N/A" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{title | default:"N/A"}}`, testdata); got != "Hello World" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{ghost | default:"x"}}`, testdata); got != "x" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestTruncateFilter(t *testing.T) {
+	if got := mustRender(t, `{{long | truncate:"3"}}`, testdata); got != "abc…" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{long | truncate:"10"}}`, testdata); got != "abcdefghij" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{long | truncate:"0"}}`, testdata); got != "…" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{short | truncate:"5"}}`, map[string]any{"short": "ab"}); got != "ab" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestHtmlFilter(t *testing.T) {
+	got := mustRender(t, `{{html | html}}`, testdata)
+	want := "&lt;a href=&#34;x&#34;&gt;&amp;&#39;"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestFilterArgEscapes(t *testing.T) {
+	got := mustRender(t, `{{empty | default:"a\"b\\c"}}`, testdata)
+	if got != `a"b\c` {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestChainedFilters(t *testing.T) {
+	got := mustRender(t, `{{name | trim | upper | truncate:"2"}}`, testdata)
+	if got != "AN…" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestMultipleTagsAndText(t *testing.T) {
+	got := mustRender(t, `Hi {{user.name}}, you have {{count}} items.`, testdata)
+	if got != "Hi bob, you have 42 items." {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	cases := []struct {
+		src    string
+		substr string
+	}{
+		{`{{title | bogus}}`, "bogus"},
+		{`{{title | bogus:"x"}}`, "bogus"},
+		{`{{upper:"x"}}`, "upper"},
+		{`{{lower:"y"}}`, "lower"},
+		{`{{trim:"z"}}`, "trim"},
+		{`{{html:"w"}}`, "html"},
+		{`{{default}}`, "default"},
+		{`{{truncate}}`, "truncate"},
+		{`{{truncate:"abc"}}`, "truncate"},
+		{`{{truncate:"-1"}}`, "truncate"},
+		{`{{title |}`, "tag"},
+		{`{{ | upper}}`, "tag"},
+		{`{{}}`, "tag"},
+		{`{{ }}`, "tag"},
+		{`{{ 1bad }}`, "1bad"},
+		{`{{-bad}}`, "-bad"},
+		{`{{ title`, "}}"},
+		{`{{title`, "}}"},
+		{`{{user.name.first}}`, "user.name.first"},
+		{`{{count.first}}`, "count.first"},
+	}
+	for _, c := range cases {
+		wantErr(t, c.src, testdata, c.substr)
+	}
+}
+
+func TestUnterminatedAtEOF(t *testing.T) {
+	wantErr(t, `text {{ title`, testdata, "}}")
+}
