+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func do(t *testing.T, h http.Handler, method, path string, body any) *httptest.ResponseRecorder {
+	t.Helper()
+	var rd *bytes.Buffer
+	if body == nil {
+		rd = bytes.NewBuffer(nil)
+	} else if b, ok := body.(string); ok {
+		rd = bytes.NewBufferString(b)
+	} else {
+		b, err := json.Marshal(body)
+		if err != nil {
+			t.Fatalf("marshal body: %v", err)
+		}
+		rd = bytes.NewBuffer(b)
+	}
+	req := httptest.NewRequest(method, path, rd)
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func TestHealthz(t *testing.T) {
+	h := NewHandler(NewStore())
+	rec := do(t, h, http.MethodGet, "/healthz", nil)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", rec.Code)
+	}
+	if got := rec.Body.String(); got != "ok" {
+		t.Fatalf("body = %q, want %q", got, "ok")
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "text/plain" {
+		t.Fatalf("content-type = %q, want text/plain", ct)
+	}
+	if rec2 := do(t, h, http.MethodPost, "/healthz", nil); rec2.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("POST /healthz status = %d, want 405", rec2.Code)
+	}
+}
+
+func TestCreateNote(t *testing.T) {
+	h := NewHandler(NewStore())
+	rec := do(t, h, http.MethodPost, "/notes", `{"title":"First","body":"hello"}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201; body=%s", rec.Code, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	var n Note
+	if err := json.Unmarshal(rec.Body.Bytes(), &n); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if n.ID != 1 || n.Title != "First" || n.Body != "hello" {
+		t.Fatalf("note = %+v", n)
+	}
+}
+
+func TestCreateNoteRequiresTitle(t *testing.T) {
+	h := NewHandler(NewStore())
+	for _, body := range []string{`{}`, `{"title":""}`, `{"title":"   "}`, `{"body":"x"}`} {
+		rec := do(t, h, http.MethodPost, "/notes", body)
+		if rec.Code != http.StatusBadRequest {
+			t.Fatalf("body %s: status = %d, want 400", body, rec.Code)
+		}
+		var e map[string]string
+		if err := json.Unmarshal(rec.Body.Bytes(), &e); err != nil || e["error"] == "" {
+			t.Fatalf("body %s: error response = %s", body, rec.Body.String())
+		}
+	}
+}
+
+func TestListNotes(t *testing.T) {
+	s := NewStore()
+	h := NewHandler(s)
+	s.Create("Alpha", "one")
+	s.Create("beta", "two")
+	s.Create("Gamma", "three")
+
+	rec := do(t, h, http.MethodGet, "/notes", nil)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", rec.Code)
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q, want application/json", ct)
+	}
+	var notes []Note
+	if err := json.Unmarshal(rec.Body.Bytes(), &notes); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(notes) != 3 {
+		t.Fatalf("len = %d, want 3", len(notes))
+	}
+	for i, wantID := range []int{1, 2, 3} {
+		if notes[i].ID != wantID {
+			t.Fatalf("notes[%d].ID = %d, want %d", i, notes[i].ID, wantID)
+		}
+	}
+}
+
+func TestListEmptyIsArray(t *testing.T) {
+	h := NewHandler(NewStore())
+	rec := do(t, h, http.MethodGet, "/notes", nil)
+	if got := strings.TrimSpace(rec.Body.String()); got != "[]" {
+		t.Fatalf("empty list body = %q, want []", rec.Body.String())
+	}
+}
+
+func TestListFilter(t *testing.T) {
+	s := NewStore()
+	h := NewHandler(s)
+	s.Create("Shopping", "milk and eggs")
+	s.Create("Ideas", "build a house")
+	s.Create("MISC", "buy MILK later")
+
+	rec := do(t, h, http.MethodGet, "/notes?q=milk", nil)
+	var notes []Note
+	if err := json.Unmarshal(rec.Body.Bytes(), &notes); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(notes) != 2 {
+		t.Fatalf("filtered len = %d, want 2: %v", len(notes), notes)
+	}
+}
+
+func TestGetNoteByID(t *testing.T) {
+	s := NewStore()
+	h := NewHandler(s)
+	s.Create("T", "B")
+
+	rec := do(t, h, http.MethodGet, "/notes/1", nil)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", rec.Code)
+	}
+	var n Note
+	if err := json.Unmarshal(rec.Body.Bytes(), &n); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if n.Title != "T" || n.Body != "B" {
+		t.Fatalf("note = %+v", n)
+	}
+
+	if rec := do(t, h, http.MethodGet, "/notes/99", nil); rec.Code != http.StatusNotFound {
+		t.Fatalf("missing note status = %d, want 404", rec.Code)
+	}
+	if rec := do(t, h, http.MethodGet, "/notes/abc", nil); rec.Code != http.StatusBadRequest {
+		t.Fatalf("non-integer id status = %d, want 400", rec.Code)
+	}
+}
+
+func TestDeleteNote(t *testing.T) {
+	s := NewStore()
+	h := NewHandler(s)
+	s.Create("T", "B")
+
+	rec := do(t, h, http.MethodDelete, "/notes/1", nil)
+	if rec.Code != http.StatusNoContent {
+		t.Fatalf("delete status = %d, want 204", rec.Code)
+	}
+	if _, ok := s.Get(1); ok {
+		t.Fatal("note still present after delete")
+	}
+	if rec := do(t, h, http.MethodDelete, "/notes/1", nil); rec.Code != http.StatusNotFound {
+		t.Fatalf("delete missing status = %d, want 404", rec.Code)
+	}
+}
+
+func TestMethodNotAllowed(t *testing.T) {
+	h := NewHandler(NewStore())
+	cases := []struct{ method, path string }{
+		{http.MethodPut, "/notes"},
+		{http.MethodPatch, "/notes/1"},
+		{http.MethodGet, "/notes/1/"}, // trailing slash -> non-integer id
+	}
+	for _, c := range cases[:2] {
+		rec := do(t, h, c.method, c.path, nil)
+		if rec.Code != http.StatusMethodNotAllowed {
+			t.Fatalf("%s %s: status = %d, want 405", c.method, c.path, rec.Code)
+		}
+	}
+}
