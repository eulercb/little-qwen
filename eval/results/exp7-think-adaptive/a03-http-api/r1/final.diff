+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// NewHandler returns an HTTP handler exposing the store over REST.
+func NewHandler(s *Store) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/healthz", healthz)
+	mux.HandleFunc("/notes", func(w http.ResponseWriter, r *http.Request) {
+		notesHandler(w, r, s)
+	})
+	mux.HandleFunc("/notes/", func(w http.ResponseWriter, r *http.Request) {
+		noteByIDHandler(w, r, s)
+	})
+	return mux
+}
+
+func healthz(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		httpError(w, http.StatusMethodNotAllowed, "method not allowed")
+		return
+	}
+	w.Header().Set("Content-Type", "text/plain")
+	w.WriteHeader(http.StatusOK)
+	_, _ = w.Write([]byte("ok"))
+}
+
+// notesHandler handles the collection endpoint /notes.
+func notesHandler(w http.ResponseWriter, r *http.Request, s *Store) {
+	switch r.Method {
+	case http.MethodGet:
+		q := strings.ToLower(r.URL.Query().Get("q"))
+		notes := s.List()
+		out := make([]Note, 0, len(notes))
+		for _, n := range notes {
+			if q == "" || strings.Contains(strings.ToLower(n.Title), q) || strings.Contains(strings.ToLower(n.Body), q) {
+				out = append(out, n)
+			}
+		}
+		writeJSON(w, http.StatusOK, out)
+	case http.MethodPost:
+		var req struct {
+			Title string `json:"title"`
+			Body  string `json:"body"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			httpError(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		if strings.TrimSpace(req.Title) == "" {
+			httpError(w, http.StatusBadRequest, "title is required")
+			return
+		}
+		n := s.Create(req.Title, req.Body)
+		writeJSON(w, http.StatusCreated, n)
+	default:
+		httpError(w, http.StatusMethodNotAllowed, "method not allowed")
+	}
+}
+
+// noteByIDHandler handles /notes/{id} resource endpoints.
+func noteByIDHandler(w http.ResponseWriter, r *http.Request, s *Store) {
+	id, err := strconv.Atoi(strings.TrimPrefix(r.URL.Path, "/notes/"))
+	if err != nil {
+		httpError(w, http.StatusBadRequest, "id must be an integer")
+		return
+	}
+	switch r.Method {
+	case http.MethodGet:
+		n, ok := s.Get(id)
+		if !ok {
+			httpError(w, http.StatusNotFound, "note not found")
+			return
+		}
+		writeJSON(w, http.StatusOK, n)
+	case http.MethodDelete:
+		if !s.Delete(id) {
+			httpError(w, http.StatusNotFound, "note not found")
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	default:
+		httpError(w, http.StatusMethodNotAllowed, "method not allowed")
+	}
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func httpError(w http.ResponseWriter, status int, msg string) {
+	writeJSON(w, status, map[string]string{"error": msg})
+}
