+// cleanValue trims a raw value and applies quoting / inline-comment rules.
+func cleanValue(v string) string {
+	v = strings.TrimSpace(v)
+	// Quoted value: strip the quotes, keep inner whitespace exactly.
+	if len(v) >= 2 && v[0] == '"' {
+		if end := strings.Index(v[1:], `"`); end >= 0 {
+			rest := strings.TrimSpace(v[end+2:])
+			if rest == "" || rest[0] == ';' || rest[0] == '#' {
+				return v[1 : end+1]
+			}
+		}
+	}
+	// Unquoted value: cut at the first " ;" or " #" inline comment.
+	cut := -1
+	for _, marker := range []string{" ;", " #"} {
+		if j := strings.Index(v, marker); j >= 0 && (cut < 0 || j < cut) {
+			cut = j
+		}
+	}
+	if cut >= 0 {
+		v = v[:cut]
+	}
+	return strings.TrimSpace(v)
+}
