+// Package semver implements Semantic Versioning 2.0.0 (https://semver.org/)
+// parsing and precedence rules.
+package semver
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version represents a semantic version: MAJOR.MINOR.PATCH with optional
+// pre-release identifiers and build metadata.
+type Version struct {
+	Major uint64
+	Minor uint64
+	Patch uint64
+	Pre   []string
+	Build []string
+}
+
+// Parse parses s as a semantic version. An optional leading "v" is accepted,
+// e.g. "v1.2.3-rc.1+build.5".
+func Parse(s string) (Version, error) {
+	if strings.HasPrefix(s, "v") {
+		s = s[1:]
+	}
+	if s == "" {
+		return Version{}, errors.New("semver: empty version")
+	}
+
+	// Split off build metadata.
+	core := s
+	build := ""
+	if i := strings.IndexByte(s, '+'); i >= 0 {
+		core, build = s[:i], s[i+1:]
+		if build == "" {
+			return Version{}, errors.New("semver: empty build metadata")
+		}
+	}
+	// Split off pre-release.
+	pre := ""
+	if i := strings.IndexByte(core, '-'); i >= 0 {
+		core, pre = core[:i], core[i+1:]
+		if pre == "" {
+			return Version{}, errors.New("semver: empty pre-release")
+		}
+	}
+
+	parts := strings.Split(core, ".")
+	if len(parts) != 3 {
+		return Version{}, fmt.Errorf("semver: expected MAJOR.MINOR.PATCH, got %q", core)
+	}
+	nums := make([]uint64, 3)
+	for i, p := range parts {
+		n, err := parseNumeric(p, fmt.Sprintf("semver: invalid %s", partName(i)))
+		if err != nil {
+			return Version{}, err
+		}
+		nums[i] = n
+	}
+
+	var preIDs, buildIDs []string
+	if pre != "" {
+		preIDs = strings.Split(pre, ".")
+		for _, id := range preIDs {
+			if err := checkIdent(id, true); err != nil {
+				return Version{}, err
+			}
+		}
+	}
+	if build != "" {
+		buildIDs = strings.Split(build, ".")
+		for _, id := range buildIDs {
+			if err := checkIdent(id, false); err != nil {
+				return Version{}, err
+			}
+		}
+	}
+
+	return Version{Major: nums[0], Minor: nums[1], Patch: nums[2], Pre: preIDs, Build: buildIDs}, nil
+}
+
+// MustParse parses s and panics if it is not a valid semantic version.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+// String returns the canonical version string, without any "v" prefix.
+func (v Version) String() string {
+	s := strconv.FormatUint(v.Major, 10) + "." +
+		strconv.FormatUint(v.Minor, 10) + "." +
+		strconv.FormatUint(v.Patch, 10)
+	if len(v.Pre) > 0 {
+		s += "-" + strings.Join(v.Pre, ".")
+	}
+	if len(v.Build) > 0 {
+		s += "+" + strings.Join(v.Build, ".")
+	}
+	return s
+}
+
+// Compare reports the precedence of two versions: -1 if a < b,
+// 0 if a and b have the same precedence, and +1 if a > b.
+// Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := compareUint(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	return comparePre(a.Pre, b.Pre)
+}
+
+func comparePre(a, b []string) int {
+	// A pre-release version has lower precedence than the same
+	// version without a pre-release.
+	if len(a) == 0 && len(b) == 0 {
+		return 0
+	}
+	if len(a) == 0 {
+		return 1
+	}
+	if len(b) == 0 {
+		return -1
+	}
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if c := compareIdent(a[i], b[i]); c != 0 {
+			return c
+		}
+	}
+	// All preceding identifiers are equal: the shorter list is lower.
+	switch {
+	case len(a) < len(b):
+		return -1
+	case len(a) > len(b):
+		return 1
+	}
+	return 0
+}
+
+func compareIdent(a, b string) int {
+	aNum := isNumeric(a)
+	bNum := isNumeric(b)
+	switch {
+	case aNum && bNum:
+		an, _ := strconv.ParseUint(a, 10, 64)
+		bn, _ := strconv.ParseUint(b, 10, 64)
+		return compareUint(an, bn)
+	case aNum:
+		// Numeric identifiers always have lower precedence than
+		// alphanumeric identifiers.
+		return -1
+	case bNum:
+		return 1
+	default:
+		// Alphanumeric identifiers are compared left to right in
+		// ASCII sort order.
+		return strings.Compare(a, b)
+	}
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func compareUint(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+func partName(i int) string {
+	switch i {
+	case 0:
+		return "major version"
+	case 1:
+		return "minor version"
+	}
+	return "patch version"
+}
+
+// parseNumeric parses a non-negative integer that must not contain
+// leading zeros (e.g. "01" is rejected).
+func parseNumeric(s string, what string) (uint64, error) {
+	if s == "" {
+		return 0, fmt.Errorf("%s: missing or empty", what)
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return 0, fmt.Errorf("%s: invalid character %q in %s", what, c, s)
+		}
+	}
+	if len(s) > 1 && s[0] == '0' {
+		return 0, fmt.Errorf("%s: leading zeros are not allowed in %q", what, s)
+	}
+	n, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("%s: value out of range in %q", what, s)
+	}
+	return n, nil
+}
+
+// checkIdent validates a dot-separated identifier (pre-release or build).
+// Pre-release identifiers must be non-empty, contain only [0-9A-Za-z-],
+// and must not contain leading zeros if entirely numeric.
+func checkIdent(id string, isPre bool) error {
+	if id == "" {
+		return fmt.Errorf("semver: empty identifier in pre-release or build metadata")
+	}
+	for _, c := range id {
+		switch {
+		case c >= '0' && c <= '9':
+		case c >= 'A' && c <= 'Z':
+		case c >= 'a' && c <= 'z':
+		case c == '-':
+		default:
+			return fmt.Errorf("semver: invalid character %q in identifier %q", c, id)
+		}
+	}
+	if isPre && isNumeric(id) && len(id) > 1 && id[0] == '0' {
+		return fmt.Errorf("semver: leading zeros are not allowed in numeric pre-release identifier %q", id)
+	}
+	return nil
+}
