+package main
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+)
+
+func runOutput(t *testing.T, args []string, in string) (string, error) {
+	t.Helper()
+	var out bytes.Buffer
+	err := run(args, strings.NewReader(in), &out)
+	return out.String(), err
+}
+
+const exampleCSV = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func TestExampleByRegion(t *testing.T) {
+	got, err := runOutput(t, []string{"--by", "region"}, exampleCSV)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDefaultIsRegion(t *testing.T) {
+	got, err := runOutput(t, nil, exampleCSV)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestByProduct(t *testing.T) {
+	got, err := runOutput(t, []string{"--by", "product"}, exampleCSV)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestGroupingAggregates(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,2,1.10\nnorth,pear,1,2.00\nsouth,apple,5,0.99\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	// north: 3 qty, 2*1.10 + 2.00 = 4.20; south: 5 qty, 4.95
+	want := "south\t5\t4.95\nnorth\t3\t4.20\nTOTAL\t8\t9.15\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestSortRevenueDescTiesByNameAsc(t *testing.T) {
+	in := "region,product,qty,price\nb,x,1,5.00\na,x,1,5.00\nc,x,2,3.00\nd,x,1,1.00\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "c\t2\t6.00\na\t1\t5.00\nb\t1\t5.00\nd\t1\t1.00\nTOTAL\t5\t17.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTop(t *testing.T) {
+	in := "region,product,qty,price\nb,x,1,5.00\na,x,1,5.00\nc,x,2,3.00\nd,x,1,1.00\n"
+	got, err := runOutput(t, []string{"--top", "2"}, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "c\t2\t6.00\na\t1\t5.00\nTOTAL\t5\t17.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTopLargerThanGroups(t *testing.T) {
+	got, err := runOutput(t, []string{"--top", "10"}, exampleCSV)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsAnyOrderAndExtra(t *testing.T) {
+	in := "date,region,note,price,product,qty\n2024-01-01,north,hi,1.10,apple,3\n2024-01-02,south,ho,2.00,pear,1\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestMissingRequiredColumn(t *testing.T) {
+	for _, missing := range []string{"region", "product", "qty", "price"} {
+		header := "region,product,qty,price"
+		parts := strings.Split(header, ",")
+		for i, p := range parts {
+			if p == missing {
+				parts[i] = "other"
+			}
+		}
+		in := strings.Join(parts, ",") + "\nnorth,apple,3,1.10\n"
+		_, err := runOutput(t, nil, in)
+		if err == nil {
+			t.Fatalf("missing column %s: expected error, got none", missing)
+		}
+		if !strings.Contains(err.Error(), missing) {
+			t.Errorf("missing column %s: error %q does not mention %q", missing, err, missing)
+		}
+	}
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,-1,2.00\n"
+	_, err := runOutput(t, nil, in)
+	if err == nil {
+		t.Fatal("expected error for negative qty")
+	}
+	if !strings.Contains(err.Error(), "line 3") {
+		t.Fatalf("error %q does not mention line 3", err)
+	}
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,two\n"
+	_, err := runOutput(t, nil, in)
+	if err == nil {
+		t.Fatal("expected error for bad price")
+	}
+	if !strings.Contains(err.Error(), "line 3") {
+		t.Fatalf("error %q does not mention line 3", err)
+	}
+}
+
+func TestTooManyDecimalsInPrice(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.105\n"
+	_, err := runOutput(t, nil, in)
+	if err == nil {
+		t.Fatal("expected error for 3-decimal price")
+	}
+	if !strings.Contains(err.Error(), "line 2") {
+		t.Fatalf("error %q does not mention line 2", err)
+	}
+}
+
+func TestIntegerPrice(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,2\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t3\t6.00\nTOTAL\t3\t6.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestZeroQty(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,0,1.10\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "north\t0\t0.00\nTOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestNoRowsStillPrintsTotal(t *testing.T) {
+	got, err := runOutput(t, nil, "region,product,qty,price\n")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "TOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestCentsArithmeticNoDrift(t *testing.T) {
+	// 0.10 + 0.20 style drift: 3 rows of 0.10 must be exactly 0.30.
+	in := "region,product,qty,price\nn,a,1,0.10\nn,b,1,0.10\nn,c,1,0.10\n"
+	got, err := runOutput(t, nil, in)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "n\t3\t0.30\nTOTAL\t3\t0.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestInvalidByValue(t *testing.T) {
+	_, err := runOutput(t, []string{"--by", "colour"}, exampleCSV)
+	if err == nil || !strings.Contains(err.Error(), "--by") {
+		t.Fatalf("expected --by error, got %v", err)
+	}
+}
+
+func TestInvalidTop(t *testing.T) {
+	for _, bad := range []string{"0", "-3", "x"} {
+		_, err := runOutput(t, []string{"--top", bad}, exampleCSV)
+		if err == nil || !strings.Contains(err.Error(), "--top") {
+			t.Fatalf("--top %s: expected --top error, got %v", bad, err)
+		}
+	}
+}
+
+func TestUnknownFlag(t *testing.T) {
+	_, err := runOutput(t, []string{"--bogus"}, exampleCSV)
+	if err == nil || !strings.Contains(err.Error(), "--bogus") {
+		t.Fatalf("expected unknown flag error, got %v", err)
+	}
+}
+
+func TestMissingFlagValue(t *testing.T) {
+	_, err := runOutput(t, []string{"--by"}, exampleCSV)
+	if err == nil {
+		t.Fatal("expected error for dangling --by")
+	}
+}
+
+func TestEmptyInput(t *testing.T) {
+	_, err := runOutput(t, nil, "")
+	if err == nil {
+		t.Fatal("expected error for empty input")
+	}
+}
+
+func TestWriteErrorPropagates(t *testing.T) {
+	err := run(nil, strings.NewReader(exampleCSV), failingWriter{})
+	if err == nil {
+		t.Fatal("expected write error to propagate")
+	}
+}
+
+type failingWriter struct{}
+
+func (failingWriter) Write([]byte) (int, error) { return 0, errors.New("boom") }
