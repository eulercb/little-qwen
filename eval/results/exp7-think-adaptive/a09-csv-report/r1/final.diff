+// Command report summarises sales from CSV on standard input.
+package main
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type config struct {
+	by  string
+	top int // 0 means all groups
+}
+
+func parseFlags(args []string) (config, error) {
+	cfg := config{by: "region"}
+	for i := 0; i < len(args); i++ {
+		switch args[i] {
+		case "--by":
+			if i+1 >= len(args) {
+				return cfg, errors.New("--by requires a value (region or product)")
+			}
+			i++
+			if args[i] != "region" && args[i] != "product" {
+				return cfg, fmt.Errorf("invalid --by value %q (expected region or product)", args[i])
+			}
+			cfg.by = args[i]
+		case "--top":
+			if i+1 >= len(args) {
+				return cfg, errors.New("--top requires a value")
+			}
+			i++
+			n, err := strconv.Atoi(args[i])
+			if err != nil || n < 1 {
+				return cfg, fmt.Errorf("invalid --top value %q (expected integer >= 1)", args[i])
+			}
+			cfg.top = n
+		default:
+			return cfg, fmt.Errorf("unknown flag %q", args[i])
+		}
+	}
+	return cfg, nil
+}
+
+// parseQty parses a non-negative integer quantity.
+func parseQty(s string) (int64, error) {
+	q, err := strconv.Atoi(strings.TrimSpace(s))
+	if err != nil || q < 0 {
+		return 0, fmt.Errorf("bad qty %q", s)
+	}
+	return int64(q), nil
+}
+
+// parsePrice parses a decimal with at most two decimal places into integer cents.
+func parsePrice(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	neg := false
+	if strings.HasPrefix(s, "-") {
+		neg = true
+		s = s[1:]
+	} else if strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	intPart, fracPart := s, ""
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		intPart, fracPart = s[:i], s[i+1:]
+	}
+	if len(fracPart) > 2 {
+		return 0, fmt.Errorf("bad price %q (more than two decimal places)", s)
+	}
+	if !isDigits(intPart) && !isDigits(fracPart) {
+		return 0, fmt.Errorf("bad price %q", s)
+	}
+	iv, err := strconv.ParseInt(intPart, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("bad price %q", s)
+	}
+	for len(fracPart) < 2 {
+		fracPart += "0"
+	}
+	fv, err := strconv.ParseInt(fracPart, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("bad price %q", s)
+	}
+	cents := iv*100 + fv
+	if neg {
+		cents = -cents
+	}
+	return cents, nil
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// formatCents renders integer cents with exactly two decimals.
+func formatCents(c int64) string {
+	sign := ""
+	if c < 0 {
+		sign = "-"
+		c = -c
+	}
+	return fmt.Sprintf("%s%d.%02d", sign, c/100, c%100)
+}
+
+type group struct {
+	qty   int64
+	cents int64
+}
+
+func run(args []string, in io.Reader, out io.Writer) error {
+	cfg, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	// Columns may appear in any order and extras are allowed, so allow
+	// varying record lengths; we only need the required indices.
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+	r.TrimLeadingSpace = true
+
+	header, err := r.Read()
+	if err != nil {
+		return fmt.Errorf("read header: %v", err)
+	}
+	col := make(map[string]int, len(header))
+	for i, name := range header {
+		name = strings.TrimSpace(name)
+		if _, ok := col[name]; !ok {
+			col[name] = i
+		}
+	}
+	required := []string{"region", "product"}
+	for _, name := range required {
+		if _, ok := col[name]; !ok {
+			return fmt.Errorf("missing required column %q", name)
+		}
+	}
+	// The grouping column is one of the required columns, so its
+	// index is already validated; sanity-check it anyway.
+	byIdx, _ := col[cfg.by]
+	regionIdx := col["region"]
+	productIdx := col["product"]
+	need := regionIdx
+	if productIdx > need {
+		need = productIdx
+	}
+	qtyIdx, priceIdx := col["qty"], col["price"]
+	for _, idx := range []int{qtyIdx, priceIdx} {
+		if idx > need {
+			need = idx
+		}
+	}
+
+	groups := make(map[string]*group)
+	var totQty, totCents int64
+
+	for {
+		rec, err := r.Read()
+		if err == io.EOF {
+			break
+		}
+		// 1-based line of this record in the file (header is line 1);
+		// FieldPos accounts for records spanning multiple physical lines.
+		line, _ := r.FieldPos(0)
+		if err != nil {
+			line, _ = err.(*csv.ParseError).Line, 0
+			return fmt.Errorf("line %d: malformed CSV record: %v", line, err)
+		}
+		if len(rec) <= need {
+			return fmt.Errorf("line %d: expected at least %d fields, got %d", line, need+1, len(rec))
+		}
+		qty, err := parseQty(rec[qtyIdx])
+		if err != nil {
+			return fmt.Errorf("line %d: %v", line, err)
+		}
+		price, err := parsePrice(rec[priceIdx])
+		if err != nil {
+			return fmt.Errorf("line %d: %v", line, err)
+		}
+		cents := qty * price
+		name := strings.TrimSpace(rec[byIdx])
+		g := groups[name]
+		if g == nil {
+			g = &group{}
+			groups[name] = g
+		}
+		g.qty += qty
+		g.cents += cents
+		totQty += qty
+		totCents += cents
+	}
+
+	names := make([]string, 0, len(groups))
+	for name := range groups {
+		names = append(names, name)
+	}
+	sort.Slice(names, func(i, j int) bool {
+		a, b := groups[names[i]], groups[names[j]]
+		if a.cents != b.cents {
+			return a.cents > b.cents // revenue descending
+		}
+		return names[i] < names[j] // ties: name ascending
+	})
+
+	if cfg.top > 0 && cfg.top < len(names) {
+		names = names[:cfg.top]
+	}
+	w := newWriter(out)
+	for _, name := range names {
+		g := groups[name]
+		fmt.Fprintf(w, "%s\t%d\t%s\n", name, g.qty, formatCents(g.cents))
+	}
+	fmt.Fprintf(w, "TOTAL\t%d\t%s\n", totQty, formatCents(totCents))
+	return w.err
+}
+
+func newWriter(w io.Writer) *outWriter { return &outWriter{w: w} }
+
+type outWriter struct {
+	w   io.Writer
+	err error
+}
+
+func (o *outWriter) Write(p []byte) (int, error) {
+	if o.err != nil {
+		return len(p), o.err
+	}
+	n, err := o.w.Write(p)
+	if err != nil {
+		o.err = err
+	}
+	return n, o.err
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, "report:", err)
+		os.Exit(1)
+	}
+}
