+package words
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func mustTopK(t *testing.T, input string, k int, stop []string) []WordCount {
+	t.Helper()
+	got, err := TopK(strings.NewReader(input), k, stop)
+	if err != nil {
+		t.Fatalf("TopK(%q): unexpected error %v", input, err)
+	}
+	return got
+}
+
+func assertSame(t *testing.T, got []WordCount, want ...WordCount) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("got %d results %v, want %d %v", len(got), got, len(want), want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("result[%d] = %+v, want %+v (all: %v)", i, got[i], want[i], got)
+		}
+	}
+}
+
+func TestBasicCounts(t *testing.T) {
+	got := mustTopK(t, "the cat sat on the mat", 10, nil)
+	assertSame(t, got,
+		WordCount{"the", 2}, WordCount{"cat", 1}, WordCount{"mat", 1},
+		WordCount{"on", 1}, WordCount{"sat", 1})
+}
+
+func TestCaseFoldingAndStopwords(t *testing.T) {
+	got := mustTopK(t, "The THE the fox jumps. Don't don't DON'T.", 10, []string{"The"})
+	assertSame(t, got,
+		WordCount{"don't", 3}, WordCount{"fox", 1}, WordCount{"jumps", 1})
+}
+
+func TestApostrophes(t *testing.T) {
+	got := mustTopK(t, "o'clock 'tis ''quotes'' it's a'ight 5'6", 10, nil)
+	assertSame(t, got,
+		WordCount{"5'6", 1}, WordCount{"a'ight", 1}, WordCount{"it's", 1},
+		WordCount{"o'clock", 1}, WordCount{"quotes", 1}, WordCount{"tis", 1})
+}
+
+func TestSeparators(t *testing.T) {
+	got := mustTopK(t, "hello-world foo_bar baz:qux (quux) [corge] <grault> @waldo 42-43", 10, nil)
+	assertSame(t, got,
+		WordCount{"42", 1}, WordCount{"43", 1}, WordCount{"bar", 1},
+		WordCount{"baz", 1}, WordCount{"corge", 1}, WordCount{"foo", 1},
+		WordCount{"grault", 1}, WordCount{"hello", 1}, WordCount{"quux", 1},
+		WordCount{"qux", 1})
+}
+
+func TestTieBreaking(t *testing.T) {
+	got := mustTopK(t, "b a b a c", 10, nil)
+	assertSame(t, got,
+		WordCount{"a", 2}, WordCount{"b", 2}, WordCount{"c", 1})
+}
+
+func TestFewerThanK(t *testing.T) {
+	got := mustTopK(t, "one two three", 10, nil)
+	assertSame(t, got,
+		WordCount{"one", 1}, WordCount{"three", 1}, WordCount{"two", 1})
+}
+
+func TestKZeroAndNegative(t *testing.T) {
+	for _, k := range []int{0, -3} {
+		got, err := TopK(strings.NewReader("some words here"), k, nil)
+		if err != nil {
+			t.Fatalf("k=%d: unexpected error %v", k, err)
+		}
+		if got == nil || len(got) != 0 {
+			t.Fatalf("k=%d: got %#v, want empty non-nil slice", k, got)
+		}
+	}
+}
+
+func TestUnicodeLettersDigits(t *testing.T) {
+	got := mustTopK(t, "café café 42 42 naïve über", 10, nil)
+	assertSame(t, got,
+		WordCount{"42", 2}, WordCount{"café", 2}, WordCount{"naïve", 1}, WordCount{"über", 1})
+}
+
+func TestEmptyInput(t *testing.T) {
+	got, err := TopK(strings.NewReader(""), 5, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got == nil || len(got) != 0 {
+		t.Fatalf("got %#v, want empty non-nil", got)
+	}
+}
+
+type errReader struct {
+	data  string
+	off   int
+	limit int // serve at most this many bytes, then fail
+}
+
+func (e *errReader) Read(p []byte) (int, error) {
+	remaining := e.limit - e.off
+	if remaining <= 0 {
+		return 0, errors.New("boom")
+	}
+	if remaining > len(e.data)-e.off {
+		remaining = len(e.data) - e.off
+	}
+	if remaining > len(p) {
+		remaining = len(p)
+	}
+	n := copy(p, e.data[e.off:e.off+remaining])
+	e.off += n
+	return n, nil
+}
+
+func TestReadErrorPropagates(t *testing.T) {
+	r := &errReader{data: "aaa bbb ccc ddd eee fff ggg hhh iii jjj", limit: 10}
+	_, err := TopK(r, 3, nil)
+	if err == nil {
+		t.Fatal("expected read error to be returned")
+	}
+}
+
+func TestLongLine(t *testing.T) {
+	var sb strings.Builder
+	for i := 0; i < 200000; i++ {
+		sb.WriteString("word ")
+	}
+	input := sb.String() // one very long line, ~1MB
+	got := mustTopK(t, input, 1, nil)
+	assertSame(t, got, WordCount{"word", 200000})
+}
