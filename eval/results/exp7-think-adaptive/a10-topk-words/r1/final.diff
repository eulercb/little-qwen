+// Package words provides word counting utilities.
+package words
+
+import (
+	"bufio"
+	"io"
+	"sort"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// WordCount is a word together with the number of times it occurred.
+type WordCount struct {
+	Word  string
+	Count int
+}
+
+// runeReader wraps a *bufio.Reader and adds one-rune lookahead.
+type runeReader struct {
+	br      *bufio.Reader
+	cached  rune
+	hasNext bool
+}
+
+func (r *runeReader) readRune() (rune, error) {
+	if r.hasNext {
+		r.hasNext = false
+		return r.cached, nil
+	}
+	c, _, err := r.br.ReadRune()
+	if err != nil {
+		return c, err
+	}
+	return c, nil
+}
+
+// peekRune returns the next rune without consuming it, or -1 if there is
+// no more input.
+func (r *runeReader) peekRune() rune {
+	if r.hasNext {
+		return r.cached
+	}
+	c, _, err := r.br.ReadRune()
+	if err != nil {
+		return -1
+	}
+	r.cached = c
+	r.hasNext = true
+	return c
+}
+
+// isWordRune reports whether c is a Unicode letter or digit.
+func isWordRune(c rune) bool {
+	if c < 0 {
+		return false
+	}
+	return unicode.IsLetter(c) || unicode.IsDigit(c)
+}
+
+// TopK streams r and returns the k most frequent words, by count descending,
+// ties broken by the word ascending (byte order). A word is a maximal run of
+// Unicode letters or digits that may contain apostrophes between two letters;
+// leading and trailing apostrophes are not part of the word. Words are
+// case-folded with strings.ToLower, and any word in stop (compared
+// case-insensitively) is ignored. If there are fewer than k distinct words,
+// all of them are returned. k <= 0 yields an empty non-nil slice. Any read
+// error from r is returned.
+func TopK(r io.Reader, k int, stop []string) ([]WordCount, error) {
+	if k <= 0 {
+		return []WordCount{}, nil
+	}
+	br := bufio.NewReaderSize(r, 1<<20)
+	rr := &runeReader{br: br}
+	stopSet := make(map[string]struct{}, len(stop))
+	for _, s := range stop {
+		stopSet[strings.ToLower(s)] = struct{}{}
+	}
+	counts := make(map[string]int)
+	buf := make([]byte, 0, 64)
+	inWord := false
+	var last rune // last rune appended to buf when inWord
+
+	flush := func() {
+		if len(buf) == 0 {
+			return
+		}
+		w := strings.ToLower(string(buf))
+		buf = buf[:0]
+		if _, ok := stopSet[w]; ok {
+			return
+		}
+		counts[w]++
+	}
+
+	readErr := error(nil)
+	for {
+		c, err := rr.readRune()
+		if err != nil {
+			readErr = err
+			break
+		}
+		switch {
+		case isWordRune(c):
+			if !inWord {
+				buf = buf[:0]
+				inWord = true
+			}
+			buf = utf8.AppendRune(buf, c)
+			last = c
+		case c == '\'' && inWord && isWordRune(last):
+			if isWordRune(rr.peekRune()) {
+				buf = append(buf, '\'')
+				last = '\''
+			} else {
+				flush()
+				inWord = false
+			}
+		default:
+			flush()
+			inWord = false
+		}
+	}
+	flush()
+	if readErr == io.EOF {
+		readErr = nil
+	}
+
+	res := make([]WordCount, 0, len(counts))
+	for w, c := range counts {
+		res = append(res, WordCount{Word: w, Count: c})
+	}
+	sort.Slice(res, func(i, j int) bool {
+		if res[i].Count != res[j].Count {
+			return res[i].Count > res[j].Count
+		}
+		return res[i].Word < res[j].Word
+	})
+	if len(res) > k {
+		res = res[:k]
+	}
+	return res, readErr
+}
