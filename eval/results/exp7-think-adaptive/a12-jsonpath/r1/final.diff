+package jpath
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestRoot(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	got, err := Query(d, "$")
+	if err != nil || !reflect.DeepEqual(got, []any{d}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestQuotedKeyAndEscapes(t *testing.T) {
+	d := doc(t, `{"a b":{"c\\d":5}}`)
+	got, err := Query(d, `$["a b"]["c\\d"]`)
+	if err != nil || !reflect.DeepEqual(got, []any{5.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestArrayIndex(t *testing.T) {
+	d := doc(t, `[10,20,30]`)
+	for path, want := range map[string][]any{
+		`$[0]`:   {10.0},
+		`$[2]`:   {30.0},
+		`$[-1]`:  {30.0},
+		`$[-3]`:  {10.0},
+		`$[-4]`:  {},
+		`$[3]`:   {},
+		`$[99]`:  {},
+		`$[-99]`: {},
+	} {
+		got, err := Query(d, path)
+		if err != nil || !reflect.DeepEqual(got, want) {
+			t.Fatalf("%s: %v %v", path, got, err)
+		}
+	}
+}
+
+func TestWildcard(t *testing.T) {
+	d := doc(t, `{"b":[3,4],"a":{"x":1,"y":2}}`)
+	got, err := Query(d, "$.*")
+	if err != nil || !reflect.DeepEqual(got, []any{map[string]any{"x": 1.0, "y": 2.0}, []any{3.0, 4.0}}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	got, err = Query(d, "$[*]") // object under [*]: nothing
+	if err != nil || len(got) != 0 {
+		t.Fatalf("%v %v", got, err)
+	}
+	a := doc(t, `[[1],[2]]`)
+	got, err = Query(a, "$[*][*]")
+	if err != nil || !reflect.DeepEqual(got, []any{1.0, 2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	got, err = Query(a, "$.*.*")
+	if err != nil || !reflect.DeepEqual(got, []any{1.0, 2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestRecurse(t *testing.T) {
+	d := doc(t, `{"a":1,"b":{"a":2,"c":{"a":3}},"e":[{"a":4}]}`)
+	got, err := Query(d, "$..a")
+	want := []any{1.0, 2.0, 3.0, 4.0}
+	if err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatalf("%v %v", got, err)
+	}
+	// nested match inside a matched member is also found
+	d2 := doc(t, `{"a":{"a":7}}`)
+	got, err = Query(d2, "$..a")
+	want = []any{map[string]any{"a": 7.0}, 7.0}
+	if err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatalf("%v %v", got, err)
+	}
+	// no match: empty non-nil slice
+	d3 := doc(t, `{"a":1}`)
+	got, err = Query(d3, "$..z")
+	if err != nil || got == nil || len(got) != 0 {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestNoMatchIsNotError(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	for _, p := range []string{`$.missing`, `$.a[0]`, `$.a.x`, `$[0]`} {
+		got, err := Query(d, p)
+		if err != nil || got == nil || len(got) != 0 {
+			t.Fatalf("%s: %v %v", p, got, err)
+		}
+	}
+}
+
+func TestMalformed(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	for _, p := range []string{
+		``, `a.b`, `$.`, `$[`, `$[1`, `$["x]`, `$.1abc`, `$[abc]`,
+		`$`, // ok actually; handled below
+		`$[1x]`, `$[]`, `$.*x`, `$..`, `$...a`, `$["a\n"]`, `$[1]junk`,
+		`$.a.`, `$x`,
+	} {
+		if p == `$` {
+			continue
+		}
+		got, err := Query(d, p)
+		if err == nil || got != nil {
+			t.Fatalf("%q: expected error, got %v %v", p, got, err)
+		}
+	}
+}
