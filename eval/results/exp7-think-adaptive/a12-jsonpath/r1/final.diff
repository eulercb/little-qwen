+// Package jpath implements a tiny path query language over decoded JSON
+// values (map[string]any, []any, string, float64, bool, nil).
+package jpath
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+type stepKind int
+
+const (
+	stMember stepKind = iota
+	stIndex
+	stWildcard
+	stRecurse
+)
+
+type step struct {
+	kind stepKind
+	name string
+	idx  int
+}
+
+// Query evaluates a path against a decoded JSON document and returns the
+// list of matched values. A path that matches nothing yields an empty
+// non-nil slice. Malformed paths yield a non-nil error and a nil result.
+func Query(doc any, path string) ([]any, error) {
+	steps, err := parsePath(path)
+	if err != nil {
+		return nil, err
+	}
+	nodes := []any{doc}
+	for _, s := range steps {
+		nodes = apply(nodes, s)
+	}
+	return nodes, nil
+}
+
+func parsePath(p string) ([]step, error) {
+	if p == "" || p[0] != '$' {
+		return nil, fmt.Errorf("jpath: path must start with '$': %q", p)
+	}
+	i := 1
+	var steps []step
+	for i < len(p) {
+		switch {
+		case p[i] == '.':
+			if i+1 < len(p) && p[i+1] == '.' {
+				i += 2
+				name, next, err := parseName(p, i)
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, step{kind: stRecurse, name: name})
+				i = next
+			} else {
+				i++
+				name, next, err := parseName(p, i)
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, step{kind: stMember, name: name})
+				i = next
+			}
+		case p[i] == '[':
+			i++
+			if i >= len(p) {
+				return nil, fmt.Errorf("jpath: unexpected end of path %q", p)
+			}
+			switch c := p[i]; true {
+			case c == '*':
+				if i+1 >= len(p) || p[i+1] != ']' {
+					return nil, fmt.Errorf("jpath: malformed wildcard in path %q", p)
+				}
+				steps = append(steps, step{kind: stWildcard})
+				i += 2
+			case c == '"':
+				key, next, err := parseQuoted(p, i)
+				if err != nil {
+					return nil, err
+				}
+				if next >= len(p) || p[next] != ']' {
+					return nil, fmt.Errorf("jpath: expected ']' in path %q", p)
+				}
+				steps = append(steps, step{kind: stMember, name: key})
+				i = next + 1
+			case c == '-' || (c >= '0' && c <= '9'):
+				j := i + 1
+				neg := false
+				if p[i] == '-' {
+					neg = true
+					j++
+				}
+				if j >= len(p) || p[j] < '0' || p[j] > '9' {
+					return nil, fmt.Errorf("jpath: malformed index in path %q", p)
+				}
+				v := 0
+				for j < len(p) && p[j] >= '0' && p[j] <= '9' {
+					v = v*10 + int(p[j]-'0')
+					j++
+				}
+				if j >= len(p) || p[j] != ']' {
+					return nil, fmt.Errorf("jpath: expected ']' in path %q", p)
+				}
+				if neg {
+					v = -v
+				}
+				steps = append(steps, step{kind: stIndex, idx: v})
+				i = j + 1
+			default:
+				return nil, fmt.Errorf("jpath: malformed brackets in path %q", p)
+			}
+		default:
+			return nil, fmt.Errorf("jpath: unexpected %q in path %q", p[i], p)
+		}
+	}
+	return steps, nil
+}
+
+func isNameStart(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isNameChar(c byte) bool {
+	return isNameStart(c) || (c >= '0' && c <= '9')
+}
+
+func parseName(p string, i int) (string, int, error) {
+	if i >= len(p) || !isNameStart(p[i]) {
+		return "", 0, fmt.Errorf("jpath: expected member name in path %q", p)
+	}
+	j := i + 1
+	for j < len(p) && isNameChar(p[j]) {
+		j++
+	}
+	return p[i:j], j, nil
+}
+
+// parseQuoted reads a double-quoted key starting at p[i] == '"', supporting
+// \" and \\ escapes. It returns the key and the index just past the closing
+// quote.
+func parseQuoted(p string, i int) (string, int, error) {
+	var b strings.Builder
+	j := i + 1
+	for j < len(p) {
+		c := p[j]
+		if c == '\\' {
+			if j+1 >= len(p) {
+				return "", 0, fmt.Errorf("jpath: dangling escape in path %q", p)
+			}
+			e := p[j+1]
+			if e != '"' && e != '\\' {
+				return "", 0, fmt.Errorf("jpath: unsupported escape in path %q", p)
+			}
+			b.WriteByte(e)
+			j += 2
+			continue
+		}
+		if c == '"' {
+			return b.String(), j + 1, nil
+		}
+		b.WriteByte(c)
+		j++
+	}
+	return "", 0, fmt.Errorf("jpath: unterminated quoted key in path %q", p)
+}
+
+func apply(nodes []any, s step) []any {
+	out := []any{}
+	for _, n := range nodes {
+		switch s.kind {
+		case stMember:
+			if m, ok := n.(map[string]any); ok {
+				if v, ok2 := m[s.name]; ok2 {
+					out = append(out, v)
+				}
+			}
+		case stIndex:
+			if a, ok := n.([]any); ok {
+				i := s.idx
+				if i < 0 {
+					i += len(a)
+				}
+				if i >= 0 && i < len(a) {
+					out = append(out, a[i])
+				}
+			}
+		case stWildcard:
+			if a, ok := n.([]any); ok {
+				out = append(out, a...)
+			} else if m, ok := n.(map[string]any); ok {
+				keys := make([]string, 0, len(m))
+				for k := range m {
+					keys = append(keys, k)
+				}
+				sort.Strings(keys)
+				for _, k := range keys {
+					out = append(out, m[k])
+				}
+			}
+		case stRecurse:
+			collectRecurse(n, s.name, &out)
+		}
+	}
+	return out
+}
+
+// collectRecurse appends the value of member name of node, then recurses
+// into every child (object values in ascending key order, array elements in
+// order), in pre-order.
+func collectRecurse(n any, name string, out *[]any) {
+	switch v := n.(type) {
+	case map[string]any:
+		if m, ok := v[name]; ok {
+			*out = append(*out, m)
+		}
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			collectRecurse(v[k], name, out)
+		}
+	case []any:
+		for _, el := range v {
+			collectRecurse(el, name, out)
+		}
+	}
+}
