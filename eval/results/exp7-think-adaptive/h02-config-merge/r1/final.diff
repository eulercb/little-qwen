+func TestLoadTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(map[string]string{
+		"APP_TIMEOUT": "1m5s",
+		"APP_TAGS": " a , b ,,c ",
+	}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != time.Minute+5*time.Second {
+		t.Fatalf("Timeout = %v", c.Timeout)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("Tags = %#v, want %#v", c.Tags, want)
+	}
+	for i := range want {
+		if c.Tags[i] != want[i] {
+			t.Fatalf("Tags = %#v, want %#v", c.Tags, want)
+		}
+	}
+}
+
+func TestLoadCollectsAllErrors(t *testing.T) {
+	c, err := Load(env(map[string]string{
+		"APP_PORT":    "abc",
+		"APP_DEBUG":   "notabool",
+		"APP_WORKERS": "-2",
+		"APP_TIMEOUT": "soon",
+	}))
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	for _, name := range []string{"APP_PORT", "APP_DEBUG", "APP_WORKERS", "APP_TIMEOUT"} {
+		if !strings.Contains(err.Error(), name) {
+			t.Errorf("error %q does not mention %s", err, name)
+		}
+	}
+	if c.Host != "" || c.Port != 0 || c.Debug || c.Workers != 0 || c.Timeout != 0 || c.Tags != nil {
+		t.Fatalf("config on error = %+v, want zero", c)
+	}}
+
+func TestMerge(t *testing.T) {
+	base := Config{Host: "localhost", Port: 8080, Workers: 4, Timeout: 30 * time.Second, Tags: []string{"x", "y"}}
+	override := Config{Port: 9090, Debug: true, Timeout: time.Hour, Tags: []string{}}
+	m := Merge(base, override)
+	if m.Host != "localhost" || m.Port != 9090 || !m.Debug || m.Workers != 4 || m.Timeout != time.Hour {
+		t.Fatalf("merged = %+v", m)
+	}
+	if m.Tags == nil || len(m.Tags) != 0 {
+		t.Fatalf("Tags = %#v, want non-nil empty", m.Tags)
+	}
+	if base.Tags[0] != "x" || base.Tags[1] != "y" || len(base.Tags) != 2 {
+		t.Fatalf("base Tags modified: %#v", base.Tags)
+	}
+	if override.Tags != nil && len(override.Tags) != 0 {
+		t.Fatalf("override Tags modified: %#v", override.Tags)
+	}
+}
+
