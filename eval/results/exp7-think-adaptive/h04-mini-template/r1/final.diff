+// Package tmpl is a tiny text template engine.
+//
+// Templates are plain text with tags of the form {{ name | filter | ... }}.
+// Names index nested map[string]any values and filters transform the
+// rendered string value.
+package tmpl
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+var htmlReplacer = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&#34;",
+	"'", "&#39;",
+)
+
+// filterArity maps filter names to the number of arguments they take.
+var filterArity = map[string]int{
+	"upper":    0,
+	"lower":    0,
+	"trim":     0,
+	"html":     0,
+	"default":  1,
+	"truncate": 1,
+}
+
+// Render renders src as a template using the values in data.
+func Render(src string, data map[string]any) (string, error) {
+	var out strings.Builder
+	i := 0
+	for i < len(src) {
+		rest := src[i:]
+		if strings.HasPrefix(rest, "{{{{") {
+			// Literal "{{": not the start of a tag.
+			out.WriteString("{{")
+			i += 4
+			continue
+		}
+		if strings.HasPrefix(rest, "{{") {
+			body := rest[2:]
+			end := findTagEnd(body)
+			if end < 0 {
+				return "", fmt.Errorf("unterminated tag (missing %q) at byte %d", "}}", i)
+			}
+			val, err := evalTag(body[:end], data)
+			if err != nil {
+				return "", err
+			}
+			out.WriteString(val)
+			i += 2 + end + 2
+			continue
+		}
+		out.WriteByte(src[i])
+		i++
+	}
+	return out.String(), nil
+}
+
+// findTagEnd returns the offset of the closing "}}" in s, honouring
+// double-quoted filter arguments, or -1 if none exists.
+func findTagEnd(s string) int {
+	inQuote := false
+	escaped := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if inQuote {
+			switch {
+			case escaped:
+				escaped = false
+			case c == '\\':
+				escaped = true
+			case c == '"':
+				inQuote = false
+			}
+			continue
+		}
+		if c == '"' {
+			inQuote = true
+			continue
+		}
+		if c == '}' && i+1 < len(s) && s[i+1] == '}' {
+			return i
+		}
+	}
+	return -1
+}
+
+// evalTag evaluates the body of a single tag.
+func evalTag(body string, data map[string]any) (string, error) {
+	tokens := splitOnPipe(body)
+	name, err := parseName(strings.TrimSpace(tokens[0]))
+	if err != nil {
+		return "", err
+	}
+	val, err := lookup(name, data)
+	if err != nil {
+		return "", err
+	}
+	for _, tok := range tokens[1:] {
+		fn, arg, err := parseFilter(tok)
+		if err != nil {
+			return "", err
+		}
+		arity, ok := filterArity[fn]
+		if !ok {
+			return "", fmt.Errorf("unknown filter %q", fn)
+		}
+		if arg != nil && arity == 0 {
+			return "", fmt.Errorf("extra argument for filter %q", fn)
+		}
+		if arg == nil && arity > 0 {
+			return "", fmt.Errorf("missing argument for filter %q", fn)
+		}
+		argStr := ""
+		if arg != nil {
+			argStr = *arg
+		}
+		val, err = applyFilter(fn, val, argStr)
+		if err != nil {
+			return "", err
+		}
+	}
+	return val, nil
+}
+
+// splitOnPipe splits s on "|" characters that are not inside a
+// double-quoted argument string.
+func splitOnPipe(s string) []string {
+	var parts []string
+	start := 0
+	inQuote := false
+	escaped := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if inQuote {
+			switch {
+			case escaped:
+				escaped = false
+			case c == '\\':
+				escaped = true
+			case c == '"':
+				inQuote = false
+			}
+			continue
+		}
+		if c == '"' {
+			inQuote = true
+			continue
+		}
+		if c == '|' {
+			parts = append(parts, s[start:i])
+			start = i + 1
+		}
+	}
+	parts = append(parts, s[start:])
+	return parts
+}
+
+// parseName validates a name like "user.name" (identifier dotted with
+// identifier segments).
+func parseName(s string) (string, error) {
+	if s == "" {
+		return "", fmt.Errorf("empty tag")
+	}
+	for _, seg := range strings.Split(s, ".") {
+		if !isIdent(seg) {
+			return "", fmt.Errorf("bad name %q", s)
+		}
+	}
+	return s, nil
+}
+
+func isIdent(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		letter := c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+		if i == 0 {
+			if !letter {
+				return false
+			}
+			continue
+		}
+		if !letter && !(c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	return true
+}
+
+// lookup resolves a (possibly dotted) name against data and formats the
+// result. A missing or nil value renders as the empty string.
+func lookup(name string, data map[string]any) (string, error) {
+	segs := strings.Split(name, ".")
+	var cur any
+	if v, ok := data[segs[0]]; ok {
+		cur = v
+	} else {
+		return "", nil
+	}
+	for _, seg := range segs[1:] {
+		if cur == nil {
+			return "", nil
+		}
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return "", fmt.Errorf("cannot index field %q: %q is not a map", seg, name)
+		}
+		if v, ok := m[seg]; ok {
+			cur = v
+		} else {
+			return "", nil
+		}
+	}
+	return formatValue(cur), nil
+}
+
+// formatValue formats a data value as its rendered string.
+func formatValue(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return v
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// parseFilter parses a filter token like 'upper' or 'default:"x"'.
+func parseFilter(tok string) (name string, arg *string, err error) {
+	tok = strings.TrimSpace(tok)
+	if tok == "" {
+		return "", nil, fmt.Errorf("empty filter")
+	}
+	colon := strings.IndexByte(tok, ':')
+	if colon < 0 {
+		return strings.TrimSpace(tok), nil, nil
+	}
+	name = strings.TrimSpace(tok[:colon])
+	a, err := unquoteArg(strings.TrimSpace(tok[colon+1:]))
+	if err != nil {
+		return "", nil, fmt.Errorf("filter %q: %v", name, err)
+	}
+	return name, &a, nil
+}
+
+// unquoteArg parses a double-quoted string, supporting \" and \\ escapes.
+func unquoteArg(s string) (string, error) {
+	if len(s) < 2 || s[0] != '"' {
+		return "", fmt.Errorf("missing argument (expected a double-quoted string)")
+	}
+	var b strings.Builder
+	i := 1
+	for i < len(s) {
+		c := s[i]
+		switch {
+		case c == '"':
+			if i == len(s)-1 {
+				return b.String(), nil
+			}
+			return "", fmt.Errorf("unexpected content after closing quote")
+		case c == '\\':
+			if i+1 >= len(s) {
+				return "", fmt.Errorf("trailing backslash in argument")
+			}
+			n := s[i+1]
+			if n != '"' && n != '\\' {
+				return "", fmt.Errorf("invalid escape %q", "\\"+string(n))
+			}
+			b.WriteByte(n)
+			i++
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return "", fmt.Errorf("unterminated argument string")
+}
+
+// applyFilter applies one filter to a string value.
+func applyFilter(fn, val, arg string) (string, error) {
+	switch fn {
+	case "upper":
+		return strings.ToUpper(val), nil
+	case "lower":
+		return strings.ToLower(val), nil
+	case "trim":
+		return strings.TrimSpace(val), nil
+	case "html":
+		return htmlReplacer.Replace(val), nil
+	case "default":
+		if val == "" {
+			return arg, nil
+		}
+		return val, nil
+	case "truncate":
+		n, err := strconv.Atoi(arg)
+		if err != nil || n < 0 {
+			return "", fmt.Errorf("truncate: argument %q must be a non-negative integer", arg)
+		}
+		rs := []rune(val)
+		if len(rs) <= n {
+			return val, nil
+		}
+		return string(rs[:n]) + "…", nil
+	}
+	panic("unreachable: unapplied filter " + fn)
+}
