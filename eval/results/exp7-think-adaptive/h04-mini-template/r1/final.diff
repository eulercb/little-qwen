@@ -0,0 +1,193 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func mustRender(t *testing.T, src string, data map[string]any) string {
+	t.Helper()
+	got, err := Render(src, data)
+	if err != nil {
+		t.Fatalf("Render(%q) error: %v", src, err)
+	}
+	return got
+}
+
+func wantErr(t *testing.T, src string, data map[string]any, substrs ...string) {
+	t.Helper()
+	got, err := Render(src, data)
+	if err == nil {
+		t.Fatalf("Render(%q) = %q, want error containing %q", src, got, strings.Join(substrs, ","))
+	}
+	for _, s := range substrs {
+		if !strings.Contains(err.Error(), s) {
+			t.Fatalf("error %q does not contain %q", err, s)
+		}
+	}
+	if got != "" {
+		t.Fatalf("Render(%q) output = %q on error, want empty", src, got)
+	}
+}
+
+func TestPlainText(t *testing.T) {
+	got := mustRender(t, "hello world\nline two {single braces are fine}", nil)
+	if got != "hello world\nline two {single braces are fine}" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestBraceEscape(t *testing.T) {
+	data := map[string]any{"user": "bob"}
+	// "{{{{" is a literal "{{" and does not open a tag.
+	got := mustRender(t, `a {{{{user`, data)
+	if got != "a {{user" {
+		t.Fatalf("got %q, want %q", got, "a {{user")
+	}
+	got = mustRender(t, `x {{{{b}}}} y`, data)
+	if got != "x {{b}}}} y" {
+		t.Fatalf("got %q, want %q", got, "x {{b}}}} y")
+	}
+}
+
+func TestBasicValues(t *testing.T) {
+	data := map[string]any{
+		"s":   "world",
+		"i":   7,
+		"i64": int64(8),
+		"f":   1.5,
+		"b":   true,
+		"bf":  false,
+	}
+	got := mustRender(t, `{{ s }}|{{ i }}|{{ i64 }}|{{ f }}|{{ b }}|{{ bf }}`, data)
+	if got != "world|7|8|1.5|true|false" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestMissingAndNil(t *testing.T) {
+	data := map[string]any{"a": nil, "b": ""}
+	got := mustRender(t, `[{{ a }}][{{ b }}][{{ c }}]`, data)
+	if got != "[][][]" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestNestedLookup(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name": "ada",
+			"age":  36,
+		},
+	}
+	got := mustRender(t, `{{ user.name }} is {{ user.age }}`, data)
+	if got != "ada is 36" {
+		t.Fatalf("got %q", got)
+	}
+	// Missing intermediate key renders as empty, no error.
+	got = mustRender(t, `[{user.nope.deep}]`, data)
+	if got != "[]" {
+		t.Fatalf("got %q", got)
+	}
+	// Indexing into a non-map is an error naming the full path.
+	wantErr(t, `{{ user.name.first }}`, data, "user.name.first")
+}
+
+func TestFiltersSimple(t *testing.T) {
+	data := map[string]any{"s": "  Hello  ", "h": "<h>"}
+	cases := map[string]string{
+		`{{ s | upper }}`:         "  HELLO  ",
+		`{{ s | lower }}`:         "  hello  ",
+		`{{ s | trim }}`:          "Hello",
+		`{{ s | trim | upper }}`:  "HELLO",
+		`{{ s | upper | lower }}`: "  hello  ",
+	}
+	for src, want := range cases {
+		if got := mustRender(t, src, data); got != want {
+			t.Errorf("%s: got %q, want %q", src, got, want)
+		}
+	}
+	if got := mustRender(t, `{{ h | html }}`, data); got != "&lt;h&gt;" {
+		t.Fatalf("html: got %q", got)
+	}
+}
+
+func TestHTMLFilter(t *testing.T) {
+	data := map[string]any{"s": `& < > " '`}
+	got := mustRender(t, `{{ s | html }}`, data)
+	if got != "&amp; &lt; &gt; &#34; &#39;" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestDefaultFilter(t *testing.T) {
+	data := map[string]any{"empty": "", "full": "yes"}
+	if got := mustRender(t, `{{ empty | default:"-" }}`, data); got != "-" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{ full | default:"-" }}`, data); got != "yes" {
+		t.Fatalf("got %q", got)
+	}
+	// default supplies a value for a missing name too.
+	if got := mustRender(t, `{{ nope | default:"dflt" }}`, data); got != "dflt" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestTruncateFilter(t *testing.T) {
+	data := map[string]any{"s": "hello"}
+	cases := []struct {
+		src  string
+		want string
+	}{
+		{`{{ s | truncate:"4" }}`, "hell…"},
+		{`{{ s | truncate:"5" }}`, "hello"},
+		{`{{ s | truncate:"10" }}`, "hello"},
+		{`{{ s | truncate:"0" }}`, "…"},
+	}
+	for _, c := range cases {
+		if got := mustRender(t, c.src, data); got != c.want {
+			t.Errorf("%s: got %q, want %q", c.src, got, c.want)
+		}
+	}
+	// Rune-based, not byte-based.
+	if got := mustRender(t, `{{ s | truncate:"2" }}`, map[string]any{"s": "héllo"}); got != "hé…" {
+		t.Fatalf("got %q, want %q", got, "hé…")
+	}
+	wantErr(t, `{{ s | truncate:"-1" }}`, data, "truncate")
+	wantErr(t, `{{ s | truncate:"abc" }}`, data, "truncate")
+}
+
+func TestFilterArgEscapes(t *testing.T) {
+	data := map[string]any{"s": ""}
+	if got := mustRender(t, `{{ s | default:"a\"b" }}`, data); got != `a"b` {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, `{{ s | default:"a\\b" }}`, data); got != `a\b` {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestWhitespaceIgnored(t *testing.T) {
+	data := map[string]any{"name": "  x  "}
+	got := mustRender(t, `{{name|trim}} {{ name | trim }} {{name|default : "y"|upper}}`, data)
+	if got != "x x Y" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	data := map[string]any{"s": "hi", "user": map[string]any{"name": "n"}}
+	wantErr(t, `{{ s | frobnicate }}`, data, "frobnicate")
+	wantErr(t, `{{ s | default }}`, data, "default")
+	wantErr(t, `{{ s | upper:"x" }}`, data, "upper")
+	wantErr(t, `{{ s | truncate:"1" extra }}`, data) // pipe inside? no: this is a bad filter token
+	wantErr(t, `a {{ s`, data)                       // unterminated
+	wantErr(t, `{{ }}`, data)                        // empty tag
+	wantErr(t, `{{   }}`, data)                      // empty tag (whitespace only)
+	wantErr(t, `{{ 1name }}`, data)                  // bad name
+	wantErr(t, `{{ user..name }}`, data)             // bad name (empty segment)
+	wantErr(t, `{{ user. }}`, data)                  // bad name (trailing dot)
+	wantErr(t, `{{ -user }}`, data)                  // bad name
+	wantErr(t, `{{ s | default:"unterminated }}`, data)
+}
