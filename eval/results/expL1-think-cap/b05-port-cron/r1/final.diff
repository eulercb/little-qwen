new file mode 100644
index 0000000..e19797a
--- /dev/null
+++ b/cron/cron.go
@@ -0,0 +1,293 @@
+// Package cron is a Go port of the reference cron-expression library
+// (reference/cron.py), with identical behaviour, including error messages.
+package cron
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Schedule holds a parsed cron expression: five value sets plus the
+// Vixie-cron day-matching flags.
+type Schedule struct {
+	expr    string
+	minute  map[int]bool
+	hour    map[int]bool
+	dom     map[int]bool
+	month   map[int]bool
+	dow     map[int]bool
+	domStar bool
+	dowStar bool
+}
+
+type fieldSpec struct {
+	name string
+	lo   int
+	hi   int
+}
+
+var fieldSpecs = [5]fieldSpec{
+	{"minute", 0, 59},
+	{"hour", 0, 23},
+	{"day-of-month", 1, 31},
+	{"month", 1, 12},
+	{"day-of-week", 0, 6},
+}
+
+var monthNames = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+
+var dayNames = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":   "0 0 1 1 *",
+	"@annually": "0 0 1 1 *",
+	"@monthly":  "0 0 1 * *",
+	"@weekly":   "0 0 * * 0",
+	"@daily":    "0 0 * * *",
+	"@midnight": "0 0 * * *",
+	"@hourly":   "0 * * * *",
+}
+
+// pyRepr formats s the way Python's repr() does for strings, so that
+// error messages match the reference exactly.
+func pyRepr(s string) string {
+	if strings.ContainsRune(s, '\'') && !strings.ContainsRune(s, '"') {
+		return `"` + strings.ReplaceAll(s, `\`, `\\`) + `"`
+	}
+	t := strings.ReplaceAll(s, `\`, `\\`)
+	t = strings.ReplaceAll(t, `'`, `\'`)
+	return "'" + t + "'"
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// value resolves a single token against field idx, mirroring _value().
+func value(tok string, idx int) (int, error) {
+	fs := fieldSpecs[idx]
+	t := strings.ToUpper(tok)
+	switch idx {
+	case 3:
+		for i, m := range monthNames {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	case 4:
+		for i, d := range dayNames {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, fmt.Errorf("%s: invalid value %s", fs.name, pyRepr(tok))
+	}
+	v, _ := strconv.Atoi(tok)
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	if v < fs.lo || v > fs.hi {
+		return 0, fmt.Errorf("%s: value %d out of range %d-%d", fs.name, v, fs.lo, fs.hi)
+	}
+	return v, nil
+}
+
+// parseField parses one comma-separated field, mirroring _field().
+func parseField(text string, idx int) (map[int]bool, error) {
+	fs := fieldSpecs[idx]
+	if text == "" {
+		return nil, fmt.Errorf("%s: empty field", fs.name)
+	}
+	values := make(map[int]bool)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, fmt.Errorf("%s: empty item", fs.name)
+		}
+		step := 1
+		base := item
+		if i := strings.Index(item, "/"); i >= 0 {
+			s := item[i+1:]
+			if !isDigits(s) {
+				return nil, fmt.Errorf("%s: invalid step %s", fs.name, pyRepr(s))
+			}
+			st, _ := strconv.Atoi(s)
+			if st < 1 {
+				return nil, fmt.Errorf("%s: invalid step %s", fs.name, pyRepr(s))
+			}
+			step = st
+			base = item[:i]
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = fs.lo, fs.hi
+		case strings.Contains(base, "-"):
+			k := strings.Index(base, "-")
+			a, b := base[:k], base[k+1:]
+			s, err := value(a, idx)
+			if err != nil {
+				return nil, err
+			}
+			e, err := value(b, idx)
+			if err != nil {
+				return nil, err
+			}
+			if s > e {
+				return nil, fmt.Errorf("%s: range %d-%d is reversed", fs.name, s, e)
+			}
+			start, end = s, e
+		default:
+			s, err := value(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			start = s
+			end = start
+			if strings.Contains(item, "/") {
+				end = fs.hi
+			}
+		}
+		for v := start; v <= end; v += step {
+			values[v] = true
+		}
+	}
+	return values, nil
+}
+
+// Parse parses a cron expression, mirroring parse().
+func Parse(expr string) (*Schedule, error) {
+	original := expr
+	expr = strings.TrimSpace(expr)
+	if strings.HasPrefix(expr, "@") {
+		m, ok := macros[strings.ToLower(expr)]
+		if !ok {
+			return nil, fmt.Errorf("unknown macro %s", pyRepr(expr))
+		}
+		expr = m
+	}
+	parts := strings.Fields(expr)
+	if len(parts) != 5 {
+		return nil, fmt.Errorf("expected 5 fields, got %d", len(parts))
+	}
+	s := &Schedule{expr: strings.TrimSpace(original)}
+	fields := [5]map[int]bool{}
+	for i, p := range parts {
+		v, err := parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+		fields[i] = v
+	}
+	s.minute, s.hour, s.dom, s.month, s.dow = fields[0], fields[1], fields[2], fields[3], fields[4]
+	s.domStar = parts[2] == "*"
+	s.dowStar = parts[4] == "*"
+	return s, nil
+}
+
+// dayOK mirrors _day_ok(): Vixie cron day matching.
+func dayOK(s *Schedule, d time.Time) bool {
+	dow := int(d.Weekday()) // Sunday=0 .. Saturday=6, same as the reference
+	inDom := s.dom[d.Day()]
+	inDow := s.dow[dow]
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first matching time strictly after `after`, in
+// after's location, mirroring next_run().
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	t := time.Date(after.Year(), after.Month(), after.Day(), after.Hour(), after.Minute()+1, 0, 0, loc)
+	limit := after.Add(366 * 5 * 24 * time.Hour)
+	for !t.After(limit) {
+		if !s.month[int(t.Month())] {
+			y, m := t.Year(), int(t.Month())
+			if m == 12 {
+				y, m = y+1, 1
+			} else {
+				m++
+			}
+			t = time.Date(y, time.Month(m), 1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !dayOK(s, t) {
+			t = time.Date(t.Year(), t.Month(), t.Day()+1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !s.hour[t.Hour()] {
+			t = time.Date(t.Year(), t.Month(), t.Day(), t.Hour()+1, 0, 0, 0, loc)
+			continue
+		}
+		if !s.minute[t.Minute()] {
+			t = time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute()+1, 0, 0, loc)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, fmt.Errorf("no match within 5 years for %s", pyRepr(s.expr))
+}
+
+// formatField renders one field's value set, mirroring _fmt().
+func formatField(values map[int]bool, idx int) string {
+	fs := fieldSpecs[idx]
+	size := fs.hi - fs.lo + 1
+	if len(values) == size {
+		return "*"
+	}
+	vs := make([]int, 0, len(values))
+	for v := range values {
+		vs = append(vs, v)
+	}
+	sortInts(vs)
+	var out []string
+	i := 0
+	for i < len(vs) {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		switch {
+		case j-i == 0:
+			out = append(out, strconv.Itoa(vs[i]))
+		case j-i == 1:
+			out = append(out, strconv.Itoa(vs[i]), strconv.Itoa(vs[i+1]))
+		default:
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+func sortInts(vs []int) {
+	for i := 1; i < len(vs); i++ {
+		for j := i; j > 0 && vs[j] < vs[j-1]; j-- {
+			vs[j], vs[j-1] = vs[j-1], vs[j]
+		}
+	}
+}
+
+// String renders the schedule, mirroring describe().
+func (s *Schedule) String() string {
+	return strings.Join([]string{
+		formatField(s.minute, 0),
+		formatField(s.hour, 1),
+		formatField(s.dom, 2),
+		formatField(s.month, 3),
+		formatField(s.dow, 4),
+	}, " ")
+}
diff --git a/cron/cron_test.go b/cron/cron_test.go
