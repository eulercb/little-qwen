+func TestContextCancelReturns(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	const n = 100
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	type res struct {
+		out []int
+		err error
+	}
+	done := make(chan res, 1)
+	go func() {
+		out, err := Map(ctx, in, 4, func(ctx context.Context, x int) (int, error) {
+			select {
+			case <-ctx.Done():
+				return 0, ctx.Err()
+			case <-time.After(100 * time.Millisecond):
+				return x * 10, nil
+			}
+		})
+		done <- res{out, err}
+	}()
+	time.Sleep(20 * time.Millisecond)
+	cancel()
+	select {
+	case r := <-done:
+		if r.out != nil {
+			t.Fatalf("out = %v, want nil", r.out)
+		}
+		if !errors.Is(r.err, context.Canceled) {
+			t.Fatalf("err = %v, want context.Canceled", r.err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Map did not return after ctx cancellation (hang)")
+	}
+}
+
+// Guard against the old behaviour: a cancelled ctx must not leave the pool
+// spinning on work that was never started.
+func TestContextCancelledBeforeStart(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	in := []int{1, 2, 3}
+	type res struct {
+		out []int
+		err error
+	}
+	done := make(chan res, 1)
+	go func() {
+		out, err := Map(ctx, in, 2, func(ctx context.Context, x int) (int, error) {
+			select {
+			case <-ctx.Done():
+				return 0, ctx.Err()
+			case <-time.After(1 * time.Second):
+				return x * 10, nil
+			}
+		})
+		done <- res{out, err}
+	}()
+	select {
+	case r := <-done:
+		if r.out != nil {
+			t.Fatalf("out = %v, want nil", r.out)
+		}
+		if !errors.Is(r.err, context.Canceled) {
+			t.Fatalf("err = %v, want context.Canceled", r.err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Map did not return for already-cancelled ctx (hang)")
+	}
+}
