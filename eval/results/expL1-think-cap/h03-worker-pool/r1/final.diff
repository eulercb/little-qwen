+func TestWorkersLessThanOne(t *testing.T) {
+	out, err := Map(context.Background(), []string{"a", "b"}, -3, func(_ context.Context, s string) (string, error) {
+		return fmt.Sprintf("%s!", s), nil
+	})
+	if err != nil || len(out) != 2 || out[0] != "a!" || out[1] != "b!" {
