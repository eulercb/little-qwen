+// fn deliberately runs longer for larger inputs so that completion order
+// differs from input order; out[i] must still correspond to in[i].
+func TestResultOrder(t *testing.T) {
+	const n = 50
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 4, func(_ context.Context, x int) (int, error) {
+		time.Sleep(time.Duration(x) * 500 * time.Microsecond)
+		return x * 10, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != n {
+		t.Fatalf("len(out) = %d, want %d", len(out), n)
+	}
+	for i, got := range out {
+		if got != in[i]*10 {
+			t.Fatalf("out[%d] = %d, want %d", i, got, in[i]*10)
+		}
+	}
+}
+
+var sentinel = errors.New("boom")
+
+// Failures at 3, 7 and 11; the largest failing index is deliberately made the
+// slowest so a first-arrival implementation would report it.
+func TestLowestIndexError(t *testing.T) {
+	const n = 20
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 4, func(_ context.Context, x int) (int, error) {
+		if x == 3 || x == 7 || x == 11 {
+			if x == 11 {
+				time.Sleep(100 * time.Millisecond)
+			}
+			return 0, sentinel
+		}
+		return x * 10, nil
+	})
+	var ie *IndexError
+	if !errors.As(err, &ie) {
+		t.Fatalf("err = %v, want *IndexError", err)
+	}
+	if ie.Index != 3 {
+		t.Fatalf("Index = %d, want 3", ie.Index)
+	}
+	if !errors.Is(ie.Err, sentinel) {
+		t.Fatalf("Err = %v, want sentinel", ie.Err)
+	}
+	if out != nil {
+		t.Fatalf("out = %v, want nil", out)
+	}
+}
