+// Even if a lower index fails, a higher-index success must not mask the
+// error, and vice versa: success results must not mask a later-arriving
+// lower-index failure.
+func TestErrorArrivingLate(t *testing.T) {
+	const n = 10
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+		if x == 1 {
+			time.Sleep(80 * time.Millisecond) // fail late, after others succeed
+			return 0, sentinel
+		}
+		return x * 10, nil
+	})
+	if out != nil {
+		t.Fatalf("out = %v, want nil", out)
+	}
+	var ie *IndexError
+	if !errors.As(err, &ie) || ie.Index != 1 || !errors.Is(ie.Err, sentinel) {
+		t.Fatalf("err = %v, want *IndexError{Index:1, Err:sentinel}", err)
+	}
+}
