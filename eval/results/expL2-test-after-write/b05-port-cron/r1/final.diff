+// Package cron implements a cron-expression library ported from the
+// Python reference implementation in reference/cron.py.
+//
+// Syntax: five space-separated fields: minute hour day-of-month month day-of-week
+//   minute 0-59, hour 0-23, day-of-month 1-31, month 1-12 (or JAN-DEC),
+//   day-of-week 0-6 (or SUN-SAT; 7 is also Sunday)
+// Each field is a comma-separated list of items. An item is:
+//   *            every value
+//   N            a single value
+//   N-M          an inclusive range (N <= M required)
+//   */S  N-M/S   a step over the full range or over a range (S >= 1)
+//   N/S          from N to the field maximum with step S
+// Names (JAN..DEC, SUN..SAT) are case-insensitive and may be used wherever a number may.
+// Macros: @yearly (= "0 0 1 1 *"), @monthly ("0 0 1 * *"), @weekly ("0 0 * * 0"),
+// @daily ("0 0 * * *"), @hourly ("0 * * * *").
+// Day matching follows Vixie cron: if both day-of-month and day-of-week are restricted
+// (neither field is "*"), a day matches when EITHER matches; otherwise both must match.
+package cron
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// CronError is returned for invalid expressions and unsatisfiable schedules.
+type CronError struct {
+	msg string
+}
+
+func (e *CronError) Error() string { return e.msg }
+
+func cronErr(format string, args ...any) error {
+	return &CronError{msg: fmt.Sprintf(format, args...)}
+}
+
+var fieldSpecs = [5][3]string{
+	{"minute", "0", "59"},
+	{"hour", "0", "23"},
+	{"day-of-month", "1", "31"},
+	{"month", "1", "12"},
+	{"day-of-week", "0", "6"},
+}
+
+var months = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var days = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":    "0 0 1 1 *",
+	"@annually":  "0 0 1 1 *",
+	"@monthly":   "0 0 1 * *",
+	"@weekly":    "0 0 * * 0",
+	"@daily":     "0 0 * * *",
+	"@midnight":  "0 0 * * *",
+	"@hourly":    "0 * * * *",
+}
+
+// Schedule holds a parsed cron expression.
+type Schedule struct {
+	expr     string
+	minute   map[int]bool
+	hour     map[int]bool
+	dom      map[int]bool
+	month    map[int]bool
+	dow      map[int]bool
+	domStar  bool
+	dowStar  bool
+}
+
+// Parse parses expr into a Schedule, mirroring parse() in the reference.
+func Parse(expr string) (*Schedule, error) {
+	original := expr
+	expr = strings.TrimSpace(expr)
+	if strings.HasPrefix(expr, "@") {
+		m, ok := macros[strings.ToLower(expr)]
+		if !ok {
+			return nil, cronErr("unknown macro '%s'", expr)
+		}
+		expr = m
+	}
+	parts := strings.Fields(expr)
+	if len(parts) != 5 {
+		return nil, cronErr("expected 5 fields, got %d", len(parts))
+	}
+	fields := make([]map[int]bool, 5)
+	for i, p := range parts {
+		f, err := parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+		fields[i] = f
+	}
+	s := &Schedule{
+		expr:    strings.TrimSpace(original),
+		minute:  fields[0],
+		hour:    fields[1],
+		dom:     fields[2],
+		month:   fields[3],
+		dow:     fields[4],
+		domStar: parts[2] == "*",
+		dowStar: parts[4] == "*",
+	}
+	return s, nil
+}
+
+func parseValue(tok string, idx int) (int, error) {
+	name := fieldSpecs[idx][0]
+	t := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range months {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range days {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, cronErr("%s: invalid value '%s'", name, tok)
+	}
+	v, _ := atoiDecimal(tok)
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	lo, _ := atoiDecimal(fieldSpecs[idx][1])
+	hi, _ := atoiDecimal(fieldSpecs[idx][2])
+	if v < lo || v > hi {
+		return 0, cronErr("%s: value %d out of range %s-%s", name, v, fieldSpecs[idx][1], fieldSpecs[idx][2])
+	}
+	return v, nil
+}
+
+func parseField(text string, idx int) (map[int]bool, error) {
+	spec := fieldSpecs[idx]
+	name, loS, hiS := spec[0], spec[1], spec[2]
+	lo, _ := atoiDecimal(loS)
+	hi, _ := atoiDecimal(hiS)
+	if text == "" {
+		return nil, cronErr("%s: empty field", name)
+	}
+	values := make(map[int]bool)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, cronErr("%s: empty item", name)
+		}
+		step := 1
+		var base string
+		if strings.Contains(item, "/") {
+			b, s, _ := strings.Cut(item, "/")
+			base = b
+			if !isDigits(s) || atoiDecimalOrZero(s) < 1 {
+				return nil, cronErr("%s: invalid step '%s'", name, s)
+			}
+			step = atoiDecimalOrZero(s)
+		} else {
+			base = item
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = lo, hi
+		case strings.Contains(base, "-"):
+			a, b, _ := strings.Cut(base, "-")
+			va, err := parseValue(a, idx)
+			if err != nil {
+				return nil, err
+			}
+			vb, err := parseValue(b, idx)
+			if err != nil {
+				return nil, err
+			}
+			start, end = va, vb
+			if start > end {
+				return nil, cronErr("%s: range %d-%d is reversed", name, start, end)
+			}
+		default:
+			v, err := parseValue(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			start = v
+			if strings.Contains(item, "/") {
+				end = hi
+			} else {
+				end = v
+			}
+		}
+		for v := start; v <= end; v += step {
+			values[v] = true
+		}
+	}
+	return values, nil
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func atoiDecimalOrZero(s string) int {
+	n := 0
+	for i := 0; i < len(s); i++ {
+		n = n*10 + int(s[i]-'0')
+	}
+	return n
+}
+
+func atoiDecimal(s string) (int, error) {
+	if !isDigits(s) {
+		return 0, fmt.Errorf("not digits: %q", s)
+	}
+	return atoiDecimalOrZero(s), nil
+}
+
+func dayOK(s *Schedule, t time.Time) bool {
+	dow := int(t.Weekday()) // Sunday=0, matching (python weekday()+1)%7
+	inDom := s.dom[t.Day()]
+	inDow := s.dow[dow]
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first time strictly after `after` that matches the
+// schedule, in `after`'s location, mirroring next_run().
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	t := time.Date(after.Year(), after.Month(), after.Day(), after.Hour(), after.Minute(), 0, 0, loc).Add(time.Minute)
+	limit := after.Add(366 * 5 * 24 * time.Hour)
+	for !t.After(limit) {
+		if !s.month[int(t.Month())] {
+			y, m := t.Year(), int(t.Month())
+			if m == 12 {
+				y, m = y+1, 1
+			} else {
+				m++
+			}
+			t = time.Date(y, time.Month(m), 1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !dayOK(s, t) {
+			t = time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, loc).AddDate(0, 0, 1)
+			continue
+		}
+		if !s.hour[t.Hour()] {
+			t = time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), 0, 0, 0, loc).Add(time.Hour)
+			continue
+		}
+		if !s.minute[t.Minute()] {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, cronErr("no match within 5 years for '%s'", s.expr)
+}
+
+func formatField(values map[int]bool, idx int) string {
+	lo, _ := atoiDecimal(fieldSpecs[idx][1])
+	hi, _ := atoiDecimal(fieldSpecs[idx][2])
+	full := true
+	if len(values) == hi-lo+1 {
+		for v := lo; v <= hi; v++ {
+			if !values[v] {
+				full = false
+				break
+			}
+		}
+	} else {
+		full = false
+	}
+	if full {
+		return "*"
+	}
+	vs := make([]int, 0, len(values))
+	for v := range values {
+		vs = append(vs, v)
+	}
+	sortInts(vs)
+	var out []string
+	i := 0
+	for i < len(vs) {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, itoa(vs[i]))
+		} else {
+			out = append(out, itoa(vs[i])+"-"+itoa(vs[j]))
+		}
+		if 0 < j-i && j-i < 2 {
+			for _, v := range vs[i+1 : j+1] {
+				out = append(out, itoa(v))
+			}
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+func sortInts(vs []int) {
+	for i := 1; i < len(vs); i++ {
+		for j := i; j > 0 && vs[j] < vs[j-1]; j-- {
+			vs[j], vs[j-1] = vs[j-1], vs[j]
+		}
+	}
+}
+
+func itoa(v int) string {
+	if v == 0 {
+		return "0"
+	}
+	neg := v < 0
+	if neg {
+		v = -v
+	}
+	var b [20]byte
+	i := len(b)
+	for v > 0 {
+		i--
+		b[i] = byte('0' + v%10)
+		v /= 10
+	}
+	if neg {
+		i--
+		b[i] = '-'
+	}
+	return string(b[i:])
+}
+
+// String renders the schedule, mirroring describe().
+func (s *Schedule) String() string {
+	return strings.Join([]string{
+		formatField(s.minute, 0),
+		formatField(s.hour, 1),
+		formatField(s.dom, 2),
+		formatField(s.month, 3),
+		formatField(s.dow, 4),
+	}, " ")
+}
