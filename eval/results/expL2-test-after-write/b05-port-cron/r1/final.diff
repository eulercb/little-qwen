+package cron
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+)
+
+var locUTC = time.UTC
+var locPlus530 = time.FixedZone("+0530", 5*3600+30*60)
+var locMinus800 = time.FixedZone("-0800", -8*3600)
+
+const isoLayout = time.RFC3339
+
+func mustTime(t *testing.T, s string) time.Time {
+	t.Helper()
+	tt, err := time.Parse(isoLayout, s)
+	if err != nil {
+		t.Fatalf("bad test time %q: %v", s, err)
+	}
+	return tt
+}
+
+func TestParseErrors(t *testing.T) {
+	cases := []struct{ expr, want string }{
+		{"", "expected 5 fields, got 0"},
+		{"   ", "expected 5 fields, got 0"},
+		{"1 2 3", "expected 5 fields, got 3"},
+		{"1 2 3 4 5 6", "expected 5 fields, got 6"},
+		{"* * * *", "expected 5 fields, got 4"},
+		{"60 * * * *", "minute: value 60 out of range 0-59"},
+		{"* 24 * * *", "hour: value 24 out of range 0-23"},
+		{"* * 0 * *", "day-of-month: value 0 out of range 1-31"},
+		{"* * 32 * *", "day-of-month: value 32 out of range 1-31"},
+		{"* * * 13 *", "month: value 13 out of range 1-12"},
+		{"* * * 0 *", "month: value 0 out of range 1-12"},
+		{"* * * * 8", "day-of-week: value 8 out of range 0-6"},
+		{"*/0 * * * *", "minute: invalid step '0'"},
+		{"*/  * * * *", "minute: invalid step ''"},
+		{"*-* * * * *", "minute: invalid value '*'"},
+		{"5-1 * * * *", "minute: range 5-1 is reversed"},
+		{"a * * * *", "minute: invalid value 'a'"},
+		{"1,,2 * * * *", "minute: empty item"},
+		{"1, * * * *", "minute: empty item"},
+		{"* * * xyz *", "month: invalid value 'xyz'"},
+		{"@every", "unknown macro '@every'"},
+		{"5- * * * *", "minute: invalid value ''"},
+		{"-5 * * * *", "minute: invalid value ''"},
+	}
+	for _, c := range cases {
+		s, err := Parse(c.expr)
+		if err == nil {
+			t.Errorf("Parse(%q) = %q, want error %q", c.expr, s, c.want)
+			continue
+		}
+		if err.Error() != c.want {
+			t.Errorf("Parse(%q) error = %q, want %q", c.expr, err, c.want)
+		}
+	}
+}
+
+func TestParseString(t *testing.T) {
+	cases := []struct{ expr, want string }{
+		{"* * * * *", "* * * * *"},
+		{"0 0 1 1 0", "0 0 1 1 0"},
+		{"*/15 0,12 * * mon-fri", "0,15,30,45 0,12 * * 1-5"},
+		{"1-10/2 * * * *", "1,3,5,7,9 * * * *"},
+		{"5-9 * * * *", "5-9 * * * *"},
+		{"5 * * * *", "5 * * * *"},
+		{"30 4 1,15 * 3", "30 4 1,15 * 3"},
+		{"0-30/10 0 * * 0-6", "0,10,20,30 0 * * *"},
+		{"0 12 * jan-mar *", "0 12 * 1-3 *"},
+		{"15,45 8-18/3 10-20/5 2,4 1-5", "15,45 8,11,14,17 10,15,20 2,4 1-5"},
+		{"@YEARLY", "0 0 1 1 *"},
+		{"@midnight", "0 0 * * *"},
+		{"0 0 1 1 7", "0 0 1 1 0"},
+		{"  0 0 * * *  ", "0 0 * * *"},
+	}
+	for _, c := range cases {
+		s, err := Parse(c.expr)
+		if err != nil {
+			t.Errorf("Parse(%q) error: %v", c.expr, err)
+			continue
+		}
+		if got := s.String(); got != c.want {
+			t.Errorf("Parse(%q).String() = %q, want %q", c.expr, got, c.want)
+		}
+	}
+}
+
+func TestNext(t *testing.T) {
+	cases := []struct {
+		expr string
+		after string
+		want  string
+	}{
+		{"0 0 * * *", "2024-01-15T08:05:00Z", "2024-01-16T00:00:00Z"},
+		{"*/15 * * * *", "2024-01-15T08:01:00Z", "2024-01-15T08:15:00Z"},
+		{"*/15 * * * *", "2024-01-15T08:15:00Z", "2024-01-15T08:30:00Z"},
+		{"@hourly", "2024-01-15T08:00:00Z", "2024-01-15T09:00:00Z"},
+		{"0 9 * * 1-5", "2024-01-12T10:00:00Z", "2024-01-15T09:00:00Z"},
+		{"0 0 1 1 *", "2024-01-01T00:00:00Z", "2025-01-01T00:00:00Z"},
+		{"0 0 13 * 5", "2024-06-15T00:00:00Z", "2024-06-21T00:00:00Z"},
+		{"30 23 * * *", "2024-03-01T22:00:00+05:30", "2024-03-01T23:30:00+05:30"},
+		{"0 0 28 2 *", "2021-03-01T00:00:00-08:00", "2022-02-28T00:00:00-08:00"},
+		{"0 0 1 1 0", "2024-07-15T12:34:56Z", "2025-01-01T00:00:00Z"},
+		{"@daily", "2024-02-29T23:59:00Z", "2024-03-01T00:00:00Z"},
+	}
+	for _, c := range cases {
+		s, err := Parse(c.expr)
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", c.expr, err)
+		}
+		after := mustTime(t, c.after)
+		got, err := s.Next(after)
+		if err != nil {
+			t.Errorf("Next(%q, %s) error: %v", c.expr, c.after, err)
+			continue
+		}
+		want := mustTime(t, c.want)
+		if !got.Equal(want) {
+			t.Errorf("Next(%q, %s) = %s, want %s", c.expr, c.after, got, want)
+		}
+		if got.Location() != after.Location() {
+			t.Errorf("Next(%q, %s) location = %v, want %v", c.expr, c.after, got.Location(), after.Location())
+		}
+	}
+}
+
+func TestNextNoMatch(t *testing.T) {
+	s, err := Parse("5 4 31 2 *")
+	if err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	_, err = s.Next(time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC))
+	if err == nil {
+		t.Fatal("want error, got none")
+	}
+	if got, want := err.Error(), "no match within 5 years for '5 4 31 2 *'"; got != want {
+		t.Errorf("error = %q, want %q", got, want)
+	}
+}
+
+// TestAgainstPython runs the reference implementation and checks that the Go
+// port produces identical describe() output and next-run results, including
+// error messages. Skipped if python3 is unavailable.
+func TestAgainstPython(t *testing.T) {
+	py, err := exec.LookPath("python3")
+	if err != nil {
+		t.Skip("python3 not available")
+	}
+	exprs := []string{
+		"* * * * *", "0 0 * * *", "@daily", "@hourly", "@weekly", "@monthly", "@yearly", "@annually", "@midnight",
+		"*/15 * * * *", "*/5 * * * *", "0-30/10 * * * *", "5-9 * * * *", "5/2 * * * *", "59 * * * *",
+		"0,15,30,45 * * * *", "0 0 1 1 0", "59 23 31 12 6", "1-10/2 0,12 * * mon-fri",
+		"0 12 * jan-mar *", "0 9 * * mon,wed,fri", "15,45 8-18/3 10-20/5 2,4 1-5",
+		"0 0 13 * 5", "0 0 13,14 * *", "30 4 1,15 * 3", "0 0 31 2 *",
+		"0 0 * * 7", "0 0 * * sun", "5 4 * * SAT", "0-59/7 0-23/4 1-31/10 1-12/3 0-6/2",
+		"* * 1 2 *", "* * * feb *", "*/2 * * jan,dec *",
+	}
+	zoneOffsets := []string{"", "+05:30", "-08:00", "+00:00"}
+	baseTimes := []string{
+		"2024-01-15T08:05:00", "2024-01-15T08:15:00", "2024-01-15T08:01:00",
+		"2024-06-15T00:00:00", "2024-02-29T23:59:00", "2021-03-01T00:00:00",
+		"2020-12-31T23:59:00", "2024-07-15T12:34:56", "2023-02-27T23:59:00",
+	}
+	var in strings.Builder
+	for _, e := range exprs {
+		for _, z := range zoneOffsets {
+			for _, bt := range baseTimes {
+				in.WriteString(e)
+				in.WriteString("|")
+				in.WriteString(bt)
+				in.WriteString(z)
+				in.WriteString("\n")
+			}
+		}
+	}
+
+	src, err := os.ReadFile("../reference/cron.py")
+	if err != nil {
+		t.Fatalf("read reference: %v", err)
+	}
+	dir := t.TempDir()
+	refPath := dir + string(os.PathSeparator) + "cron.py"
+	// Reference exposes parse/describe/next_run with module-level names.
+	if err := os.WriteFile(refPath, src, 0o644); err != nil {
+		t.Fatalf("write temp reference: %v", err)
+	}
+	script := `import sys, datetime
+sys.path.insert(0, sys.argv[1])
+import cron
+def iso(d):
+    return d.isoformat()
+for line in sys.stdin:
+    line = line.strip()
+    if not line:
+        continue
+    e, base = line.split("|", 1)
+    try:
+        s = cron.parse(e)
+    except cron.CronError as ex:
+        print("P|" + e + "||" + str(ex))
+        continue
+    print("D|" + e + "||" + cron.describe(s))
+    t = datetime.datetime.fromisoformat(base)
+    if t.tzinfo is None:
+        t = t.replace(tzinfo=datetime.timezone.utc)
+    for _ in range(3):
+        after = t
+        try:
+            t = cron.next_run(s, t)
+        except cron.CronError as ex:
+            print("E|" + e + "|" + iso(after) + "|" + str(ex))
+            break
+        print("N|" + e + "|" + iso(after) + "|" + iso(t))
+`
+	scriptPath := dir + string(os.PathSeparator) + "driv.py"
+	if err := os.WriteFile(scriptPath, []byte(script), 0o644); err != nil {
+		t.Fatalf("write driver: %v", err)
+	}
+	cmd := exec.Command(py, scriptPath, dir)
+	cmd.Stdin = strings.NewReader(in.String())
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("python3: %v\n%s", err, out)
+	}
+
+	for _, line := range strings.Split(string(out), "\n") {
+		if line == "" {
+			continue
+		}
+		parts := strings.SplitN(line, "|", 4)
+		if len(parts) != 4 {
+			t.Fatalf("bad python output line %q", line)
+		}
+		tag, expr, afterS, rest := parts[0], parts[1], parts[2], parts[3]
+		s, perr := Parse(expr)
+		switch tag {
+		case "P":
+			if perr == nil || perr.Error() != rest {
+				t.Errorf("Parse(%q) = %v, want python error %q", expr, perr, rest)
+			}
+		case "D":
+			if perr != nil {
+				t.Errorf("Parse(%q) = %v, python parsed fine", expr, perr)
+				continue
+			}
+			if got := s.String(); got != rest {
+				t.Errorf("Parse(%q).String() = %q, python says %q", expr, got, rest)
+			}
+		case "E", "N":
+			if perr != nil {
+				continue
+			}
+			after, err := time.Parse(isoLayout, afterS)
+			if err != nil {
+				t.Fatalf("bad after time %q from python: %v", afterS, err)
+			}
+			got, err := s.Next(after)
+			if tag == "E" {
+				if err == nil || err.Error() != rest {
+					t.Errorf("Next(%q, %s) = %v, want python error %q", expr, after, err, rest)
+				}
+				continue
+			}
+			if err != nil {
+				t.Errorf("Next(%q, %s) = %v, python says %s", expr, after, err, rest)
+				continue
+			}
+			want, _ := time.Parse(isoLayout, rest)
+			if !got.Equal(want) {
+				t.Errorf("Next(%q, %s) = %s, python says %s", expr, after, got, rest)
+			}
+		}
+	}
+}
