+package md
+
+import "testing"
+
+func TestSpecExample(t *testing.T) {
+	in := "# Title #\n\n" +
+		"Some *emphasis* and **strong** text\n" +
+		"with `code` and a [link](http://x.io \"T\").\n\n" +
+		"- one\n- two\n  - nested\n3. three\n"
+	want := "<h1>Title</h1>\n" +
+		"<p>Some <em>emphasis</em> and <strong>strong</strong> text\n" +
+		"with <code>code</code> and a <a href=\"http://x.io\" title=\"T\">link</a>.</p>\n" +
+		"<ul>\n<li>one</li>\n<li>two\n<ul>\n<li>nested</li>\n</ul>\n</li>\n</ul>\n" +
+		"<ol start=\"3\">\n<li>three</li>\n</ol>\n"
+	if got := ToHTML(in); got != want {
+		t.Errorf("spec example:\ngot:\n%q\nwant:\n%q", got, want)
+	}
+}
+
+func TestHeading(t *testing.T) {
+	cases := map[string]string{
+		"# foo\n":        "<h1>foo</h1>\n",
+		"###### six\n":   "<h6>six</h6>\n",
+		"#\n":            "<h1></h1>\n",
+		"# \n":           "<h1></h1>\n",
+		"#foo\n":         "<p>#foo</p>\n",
+		"####### seven\n": "<p>####### seven</p>\n",
+		"## tail ##\n":    "<h2>tail</h2>\n",
+		"## tail#\n":      "<h2>tail#</h2>\n",
+	}
+	for in, want := range cases {
+		if got := ToHTML(in); got != want {
+			t.Errorf("heading %q: got %q want %q", in, got, want)
+		}
+	}
+}
+
+func TestHR(t *testing.T) {
+	cases := map[string]string{
+		"---\n":     "<hr />\n",
+		"----\n":    "<hr />\n",
+		"***\n":     "<hr />\n",
+		"_____\n":   "<hr />\n",
+		"--\n":      "<p>--</p>\n",
+		"- - -\n":   "<ul>\n<li>- -</li>\n</ul>\n",
+		"- x\n":     "<ul>\n<li>x</li>\n</ul>\n",
+	}
+	for in, want := range cases {
+		if got := ToHTML(in); got != want {
+			t.Errorf("hr %q: got %q want %q", in, got, want)
+		}
+	}
+}
+
+func TestParagraph(t *testing.T) {
+	cases := map[string]string{
+		"a\nb\n":     "<p>a\nb</p>\n",
+		"  a\n b\n":  "<p>a\nb</p>\n",
+		"a\n\nb\n":   "<p>a</p>\n<p>b</p>\n",
+		"a\n\n\n\n":  "<p>a</p>\n",
+		"a \nb\n":    "<p>a\nb</p>\n",
+	}
+	for in, want := range cases {
+		if got := ToHTML(in); got != want {
+			t.Errorf("para %q: got %q want %q", in, got, want)
+		}
+	}
+}
+
+func TestCodeBlock(t *testing.T) {
+	cases := map[string]string{
+		"```go\nfunc main() {}\n```\n":  "<pre><code class=\"language-go\">func main() {}\n</code></pre>\n",
+		"```\na <b>\n```\n":            "<pre><code>a &lt;b&gt;\n</code></pre>\n",
+		"```\n```\n":                  "<pre><code></code></pre>\n",
+		"```\nx\n":                     "<pre><code>x\n\n</code></pre>\n",
+		"```\n  spaced\ttab\n```\n":   "<pre><code>  spaced\ttab\n</code></pre>\n",
+	}
+	for in, want := range cases {
+		if got := ToHTML(in); got != want {
+			t.Errorf("code %q: got %q want %q", in, got, want)
+		}
+	}
+}
+
+func TestBlockquote(t *testing.T) {
+	cases := map[string]string{
+		"> hello\n":      "<blockquote>\n<p>hello</p>\n</blockquote>\n",
+		">hello\n":       "<blockquote>\n<p>hello</p>\n</blockquote>\n",
+		"> a\n> b\n":     "<blockquote>\n<p>a\nb</p>\n</blockquote>\n",
+		"> # t\n":        "<blockquote>\n<h1>t</h1>\n</blockquote>\n",
