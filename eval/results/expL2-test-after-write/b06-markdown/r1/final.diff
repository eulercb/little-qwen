+func TestExtra(t *testing.T) {
+	cases := map[string]string{
+		// blockquote containing a list
+		"> - a\n> - b\n": "<blockquote>\n<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n</blockquote>\n",
+		// empty quote marker
+		">\n":            "<blockquote>\n</blockquote>\n",
+		// nested ordered list
+		"- a\n  1. b\n":  "<ul>\n<li>a\n<ol>\n<li>b</li>\n</ol>\n</li>\n</ul>\n",
+		// ordered item with multi-digit number
+		"10. x\n":        "<ol start=\"10\">\n<li>x</li>\n</ol>\n",
+		// `1.` without space is a paragraph
+		"1.x\n":          "<p>1.x</p>\n",
+		// emphasis inside heading and list items
+		"# a *b*\n":      "<h1>a <em>b</em></h1>\n",
+		"- a *b*\n":      "<ul>\n<li>a <em>b</em></li>\n</ul>\n",
+		// strong nesting both orders
+		"__a _b_ c__\n":  "<p><strong>a <em>b</em> c</strong></p>\n",
+		// emphasis then trailing text on same line, hard break mid-block
+		"a  \n*em*\n":    "<p>a<br />\n<em>em</em></p>\n",
+		// autolink in middle of a line
+		"x <https://a.io/p> y\n": "<p>x <a href=\"https://a.io/p\">https://a.io/p</a> y</p>\n",
+		// code block with info word and blank content line
+		"```go\n\nx\n```\n": "<pre><code class=\"language-go\">\nx\n</code></pre>\n",
+		// blockquote with heading inside
+		"> # h\n> p\n":  "<blockquote>\n<h1>h</h1>\n<p>p</p>\n</blockquote>\n",
+		// escape chars
+		"a\\*b\\_c\\[d]\n": "<p>a*b_c[d]</p>\n",
+	}
+	for in, want := range cases {
+		if got := ToHTML(in); got != want {
+			t.Errorf("extra %q:\ngot  %q\nwant %q", in, got, want)
+		}
+	}
+}
