+// Package md implements a small Markdown-subset to HTML converter.
+// The exact block and inline rules are specified in SPEC.md.
+package md
+
+import (
+	"regexp"
+	"strings"
+)
+
+var (
+	headingRe = regexp.MustCompile(`^(#{1,6})( |$)`)
+	hrRe      = regexp.MustCompile(`^(-{3,}|\*{3,}|_{3,})$`)
+	ordItemRe = regexp.MustCompile(`^(\d+)\. `)
+)
+
+// ToHTML converts the Markdown subset described in SPEC.md to HTML.
+func ToHTML(src string) string {
+	lines := splitLines(src)
+	var b strings.Builder
+	for _, blk := range renderBlocks(lines) {
+		b.WriteString(blk)
+	}
+	return b.String()
+}
+
+// splitLines splits src on '\n' and removes a trailing '\r' from each line.
+func splitLines(src string) []string {
+	parts := strings.Split(src, "\n")
+	for i, l := range parts {
+		parts[i] = strings.TrimSuffix(l, "\r")
+	}
+	return parts
+}
+
+// item represents a list item and its possible nested list.
+type item struct {
+	ordered   bool
+	num       int
+	textLines []string
+	nested    []item
+}
+
+func (it *item) text() string { return strings.Join(it.textLines, "\n") }
+
+// itemKind reports whether the line starts a list item at column 0,
+// its number (ordered) and the end index of the marker.
+func itemKind(line string) (isItem, ordered bool, num, end int) {
+	switch {
+	case strings.HasPrefix(line, "- "), strings.HasPrefix(line, "* "), strings.HasPrefix(line, "+ "):
+		return true, false, 0, 2
+	default:
+		if m := ordItemRe.FindStringSubmatchIndex(line); m != nil {
+			return true, true, atoi(line[m[2]:m[3]]), m[1]
+		}
+	}
+	return false, false, 0, 0
+}
+
+// leadingSpaces counts the leading spaces of s.
+func leadingSpaces(s string) int {
+	n := 0
+	for n < len(s) && s[n] == ' ' {
+		n++
+	}
+	return n
+}
+
+// renderBlocks renders the lines as block elements; each returned block
+// ends with '\n'.
+func renderBlocks(lines []string) []string {
+	var out []string
+	var para []string
+	var list []item
+	var quote []string
+	listActive := false // currently inside a list (for continuation lines)
+	flushPara := func() {
+		if len(para) > 0 {
+			out = append(out, "<p>"+renderInline(strings.Join(para, "\n"))+"</p>\n")
+			para = nil
+		}
+	}
+	flushList := func() {
+		if len(list) > 0 {
+			out = append(out, renderList(list))
+			list = nil
+		}
+		listActive = false
+	}
+	flushQuote := func() {
+		if len(quote) > 0 {
+			inner := ""
+			if blocks := renderBlocks(quote); len(blocks) > 0 {
+				inner = strings.Join(blocks, "")
+			}
+			out = append(out, "<blockquote>\n"+inner+"</blockquote>\n")
+			quote = nil
+		}
+	}
+	flushAll := func() { flushPara(); flushList(); flushQuote() }
+
+	for idx := 0; idx < len(lines); {
+		line := lines[idx]
+		idx++
+		isBlank := strings.TrimSpace(line) == ""
+		// A blank line is not a list continuation.
+		if isBlank {
+			flushAll()
+			continue
+		}
+		ls := leadingSpaces(line)
+		// Inside a list, an indented (>=2 spaces) line is a continuation.
+		if listActive && ls >= 2 {
+			trimmed := strings.TrimLeft(line, " ")
+			last := &list[len(list)-1]
+			if isItem, ordered, num, end := itemKind(trimmed); isItem {
+				// Nested list item (one nesting level only).
+				it := item{ordered: ordered, num: num, textLines: []string{trimmed[end:]}}
+				last.nested = append(last.nested, it)
+			} else {
+				target := last
+				if len(last.nested) > 0 {
+					target = &last.nested[len(last.nested)-1]
+				}
+				target.textLines = append(target.textLines, trimmed)
+			}
+			continue
+		}
+
+		trimmed := strings.TrimRight(line, " ")
+
+		// Fenced code block.
+		if strings.HasPrefix(trimmed, "```") {
+			flushAll()
+			info := ""
+			if f := strings.Fields(trimmed[3:]); len(f) > 0 {
+				info = f[0]
+			}
+			var content strings.Builder
+			for idx < len(lines) {
+				l := lines[idx]
+				idx++
+				if strings.TrimRight(l, " ") == "```" {
+					break
+				}
+				content.WriteString(escapeHTML(l))
+				content.WriteByte('\n')
+			}
+			cls := ""
+			if info != "" {
+				cls = ` class="language-` + info + `"`
+			}
+			out = append(out, "<pre><code"+cls+">"+content.String()+"</code></pre>\n")
+			continue
+		}
+
+		if m := headingRe.FindStringSubmatchIndex(line); m != nil {
+			flushAll()
+			hashes := len(line[m[2]:m[3]])
+			rest := line[m[5]:]
+			text := headingText(rest)
+			out = append(out, "<h"+itoa(hashes)+">"+renderInline(text)+"</h"+itoa(hashes)+">\n")
+			continue
+		}
+
+		if hrRe.MatchString(line) {
+			flushAll()
+			out = append(out, "<hr />\n")
+			continue
+		}
+
+		if strings.HasPrefix(line, ">") {
+			flushPara()
+			flushList()
+			rest := line[1:]
+			if strings.HasPrefix(rest, " ") {
+				rest = rest[1:]
+			}
+			quote = append(quote, rest)
+			continue
+		}
+
+		if isItem, ordered, num, end := itemKind(line); isItem {
+			flushPara()
+			flushQuote()
+			if len(list) == 0 || list[len(list)-1].ordered != ordered {
+				flushList()
+				list = []item{}
+			}
+			list = append(list, item{ordered: ordered, num: num, textLines: []string{line[end:]}})
+			listActive = true
+			continue
+		}
+
+		// Plain paragraph line (or a 1-space-indented line, etc.).
+		flushList()
+		flushQuote()
+		para = append(para, strings.TrimLeft(line, " "))
+	}
+	flushAll()
+	return out
+}
+
+// headingText removes trailing spaces and a trailing run of '#' preceded
+// by a space.
+func headingText(s string) string {
+	s = strings.TrimRight(s, " ")
+	if len(s) > 0 && s[len(s)-1] == '#' {
+		j := len(s) - 1
+		for j > 0 && s[j-1] == '#' {
+			j--
+		}
+		if j > 0 && s[j-1] == ' ' {
+			s = strings.TrimRight(s[:j-1], " ")
+		}
+	}
+	return s
+}
+
+func renderList(items []item) string {
+	var b strings.Builder
+	tag := "ul"
+	if items[0].ordered {
+		tag = "ol"
+		if items[0].num != 1 {
+			b.WriteString("<ol start=\"" + itoa(items[0].num) + "\">")
+		} else {
+			b.WriteString("<ol>")
+		}
+	} else {
+		b.WriteString("<ul>")
+	}
+	b.WriteByte('\n')
+	for i := range items {
+		it := &items[i]
+		b.WriteString("<li>")
+		b.WriteString(renderInline(it.text()))
+		if len(it.nested) > 0 {
+			b.WriteByte('\n')
+			b.WriteString(renderList(it.nested))
+		}
+		b.WriteString("</li>\n")
+	}
+	if tag == "ol" {
+		b.WriteString("</ol>")
+	} else {
+		b.WriteString("</ul>")
+	}
+	b.WriteByte('\n')
+	return b.String()
+}
+
+func itoa(n int) string {
+	if n == 0 {
+		return "0"
+	}
+	var d []byte
+	for n > 0 {
+		d = append([]byte{byte('0' + n%10)}, d...)
+		n /= 10
+	}
+	return string(d)
+}
+
+func atoi(s string) int {
+	n := 0
+	for _, c := range s {
+		n = n*10 + int(c-'0')
+	}
+	return n
+}
+
+// --- inline processing ---
+
+var escapeSet = "\\`*_{}[]()#+-.!<>"
+
+func isSpace(c byte) bool { return c == ' ' || c == '\t' }
+
+func isWord(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
+}
+
+func escapeHTML(s string) string {
+	var b strings.Builder
+	for _, c := range s {
+		switch c {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&quot;")
+		default:
+			b.WriteRune(c)
+		}
+	}
+	return b.String()
+}
+
+// renderInline renders a (possibly multi-line) block of inline text.
+func renderInline(s string) string {
+	lines := strings.Split(s, "\n")
+	var out strings.Builder
+	for i, l := range lines {
+		switch {
+		case i < len(lines)-1 && strings.HasSuffix(l, "\\"):
+			out.WriteString(renderInlineLine(l[:len(l)-1]))
+			out.WriteString("<br />\n")
+		case i < len(lines)-1 && strings.TrimRight(l, " ") != l && len(l)-len(strings.TrimRight(l, " ")) >= 2:
+			out.WriteString(renderInlineLine(strings.TrimRight(l, " ")))
+			out.WriteString("<br />\n")
+		case i < len(lines)-1:
+			out.WriteString(renderInlineLine(strings.TrimRight(l, " ")))
+			out.WriteByte('\n')
+		default:
+			out.WriteString(renderInlineLine(strings.TrimRight(l, " ")))
+		}
+	}
+	return out.String()
+}
+
+// renderInlineLine processes the inline syntax of a single line.
+func renderInlineLine(s string) string {
+	var out strings.Builder
+	n := len(s)
+	for i := 0; i < n; i++ {
+		c := s[i]
+		switch c {
+		case '&', '>', '"':
+			out.WriteString(escapeHTML(string(c)))
+		case '<':
+			if rest, ok, advanced := matchAutolink(s, i); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else {
+				out.WriteString("&lt;")
+			}
+		case '\\':
+			if i+1 < n && strings.ContainsRune(escapeSet, rune(s[i+1])) {
+				out.WriteString(escapeHTML(string(s[i+1])))
+				i++
+			} else {
+				out.WriteByte('\\')
+			}
+		case '`':
+			if rest, ok, advanced := matchCodeSpan(s, i); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else {
+				out.WriteByte('`')
+			}
+		case '[':
+			if rest, ok, advanced := matchLink(s, i); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else {
+				out.WriteByte('[')
+			}
+		case '*':
+			if rest, ok, advanced := matchEmph(s, i, 2); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else if rest, ok, advanced := matchEmph(s, i, 1); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else {
+				out.WriteByte('*')
+			}
+		case '_':
+			if rest, ok, advanced := matchEmph(s, i, 2); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else if rest, ok, advanced := matchEmph(s, i, 1); ok {
+				out.WriteString(rest)
+				i += advanced
+			} else {
+				out.WriteByte('_')
+			}
+		default:
+			out.WriteByte(c)
+		}
+	}
+	return out.String()
+}
+
+// matchCodeSpan handles a backtick run starting at i.
+// Returns the rendered span, whether it matched, and the number of
+// characters consumed after the opener (i lands on the last consumed
+// char after adding it).
+func matchCodeSpan(s string, i int) (rendered string, ok bool, advanced int) {
+	n := 0
+	for i+n < len(s) && s[i+n] == '`' {
+		n++
+	}
+	rest := s[i+n:]
+	pos := 0
+	for {
+		k := strings.IndexByte(rest[pos:], '`')
+		if k < 0 {
+			return "", false, 0
+		}
+		j := pos + k
+		run := 0
+		for j+run < len(rest) && rest[j+run] == '`' {
+			run++
+		}
+		if run == n {
+			content := rest[:j]
+			// Remove one space from each end if it starts and ends
+			// with a space and is not only spaces.
+			if len(content) >= 2 && content[0] == ' ' && content[len(content)-1] == ' ' && strings.TrimSpace(content) != "" {
+				content = content[1 : len(content)-1]
+			}
+			return "<code>" + escapeHTML(content) + "</code>", true, n + j + n - 1
+		}
+		pos = j + run // a longer/shorter run cannot close; skip past it
+	}
+}
+
+// matchAutolink handles '<' at i.
+func matchAutolink(s string, i int) (rendered string, ok bool, advanced int) {
+	rest := s[i+1:]
+	for _, scheme := range []string{"http://", "https://"} {
+		if !strings.HasPrefix(rest, scheme) {
+			continue
+		}
+		j := 0
+		for j < len(rest) {
+			c := rest[j]
+			if c == ' ' || c == '<' || c == '>' {
+				break
+			}
+			j++
+		}
+		if j >= len(rest) || rest[j] != '>' {
+			continue
+		}
+		url := rest[:j]
+		return `<a href="` + escapeHTML(url) + `">` + escapeHTML(url) + `</a>`, true, j + 1
+	}
+	return "", false, 0
+}
+
+// matchLink handles '[' at i.
+func matchLink(s string, i int) (rendered string, ok bool, advanced int) {
+	rest := s[i+1:]
+	j := strings.IndexByte(rest, ']')
+	if j < 0 {
+		return "", false, 0
+	}
+	text := rest[:j]
+	rest = rest[j+1:]
+	if !strings.HasPrefix(rest, "(") {
+		return "", false, 0
+	}
+	rest = rest[1:]
+	url := ""
+	j = 0
+	for j < len(rest) && rest[j] != ' ' && rest[j] != ')' {
+		url += string(rest[j])
+		j++
+	}
+	// rest is now the inside of the parens, after the url.
+	title := ""
+	titlePart := 0 // chars between the url and the closing ')'
+	if j < len(rest) && rest[j] == ' ' {
+		k := j + 1
+		for k < len(rest) && rest[k] != '"' && rest[k] != ')' {
+			k++
+		}
+		if k < len(rest) && rest[k] == '"' {
+			end := strings.IndexByte(rest[k+1:], '"')
+			if end < 0 {
+				return "", false, 0 // unterminated title
+			}
+			title = rest[k+1 : k+1+end]
+			titlePart = 1 + 2 + len(title) // space + quotes + title
+			rest = rest[k+1+end+1:]
+		} else {
+			rest = rest[j:]
+		}
+	} else {
+		rest = rest[j:]
+	}
+	if len(url) == 0 || len(rest) == 0 || rest[0] != ')' {
+		return "", false, 0
+	}
+	link := `<a href="` + escapeHTML(url) + `">` + renderInlineLine(text) + `</a>`
+	if title != "" {
+		link = `<a href="` + escapeHTML(url) + `" title="` + escapeHTML(title) + `">` + renderInlineLine(text) + `</a>`
+	}
+	return link, true, len(text) + 2 + len(url) + titlePart + 1
+}
+
+// matchEmph matches an emphasis (**/*) or strong (__) delimiter run
+// of exactly `length` characters starting at i.
+func matchEmph(s string, i, length int) (rendered string, ok bool, advanced int) {
+	ch := s[i]
+	if length == 2 {
+		if i+1 >= len(s) || s[i+1] != ch {
+			return "", false, 0
+		}
+	} else {
+		if i+1 < len(s) && s[i+1] == ch {
+			return "", false, 0
+		}
+	}
+	// Opening delimiter validity.
+	if i+length >= len(s) || isSpace(s[i+length]) {
+		return "", false, 0
+	}
+	if ch == '_' && i > 0 && isWord(s[i-1]) {
+		return "", false, 0
+	}
+	for j := i + length; j < len(s); j++ {
+		if s[j] != ch {
+			continue
+		}
+		run := 0
+		for j+run < len(s) && s[j+run] == ch {
+			run++
+		}
+		if run != length {
+			j += run - 1 // skip past this run (loop advances one)
+			continue
+		}
+		// Closing delimiter validity: preceded by a non-space char;
+		// for '_' also not followed by a word char.
+		if isSpace(s[j-1]) {
+			continue
+		}
+		if ch == '_' && j+run < len(s) && isWord(s[j+run]) {
+			continue
+		}
+		tag := "em"
+		if length == 2 {
+			tag = "strong"
+		}
+		content := s[i+length : j]
+		return "<" + tag + ">" + renderInlineLine(content) + "</" + tag + ">", true, (j + run) - i - 1
+	}
+	return "", false, 0
+}
