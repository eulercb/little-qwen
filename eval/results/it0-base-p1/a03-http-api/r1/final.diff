+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// NewHandler returns an HTTP handler exposing the notes service on s.
+func NewHandler(s *Store) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/healthz", handleHealthz)
+	mux.HandleFunc("/notes", func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			handleListNotes(w, r, s)
+		case http.MethodPost:
+			handleCreateNote(w, r, s)
+		default:
+			writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+	})
+	mux.HandleFunc("/notes/{id}", func(w http.ResponseWriter, r *http.Request) {
+		id, err := parseID(r.PathValue("id"))
+		switch {
+		case err != nil:
+			writeError(w, http.StatusBadRequest, "id must be an integer")
+		case r.Method == http.MethodGet:
+			handleGetNote(w, s, id)
+		case r.Method == http.MethodDelete:
+			handleDeleteNote(w, s, id)
+		default:
+			writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+	})
+	return mux
+}
+
+func handleHealthz(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		return
+	}
+	w.Header().Set("Content-Type", "text/plain")
+	w.WriteHeader(http.StatusOK)
+	fmt.Fprint(w, "ok")
+}
+
+func handleListNotes(w http.ResponseWriter, r *http.Request, s *Store) {
+	notes := s.List()
+	if q := strings.ToLower(r.URL.Query().Get("q")); q != "" {
+		filtered := make([]Note, 0)
+		for _, n := range notes {
+			if strings.Contains(strings.ToLower(n.Title), q) || strings.Contains(strings.ToLower(n.Body), q) {
+				filtered = append(filtered, n)
+			}
+		}
+		notes = filtered
+	}
+	writeJSON(w, http.StatusOK, notes)
+}
+
+func handleCreateNote(w http.ResponseWriter, r *http.Request, s *Store) {
+	var in struct {
+		Title string `json:"title"`
+		Body  string `json:"body"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&in); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid JSON body")
+		return
+	}
+	if strings.TrimSpace(in.Title) == "" {
+		writeError(w, http.StatusBadRequest, "title is required")
+		return
+	}
+	n := s.Create(in.Title, in.Body)
+	writeJSON(w, http.StatusCreated, n)
+}
+
+func handleGetNote(w http.ResponseWriter, s *Store, id int) {
+	n, ok := s.Get(id)
+	if !ok {
+		writeError(w, http.StatusNotFound, "note not found")
+		return
+	}
+	writeJSON(w, http.StatusOK, n)
+}
+
+func handleDeleteNote(w http.ResponseWriter, s *Store, id int) {
+	if !s.Delete(id) {
+		writeError(w, http.StatusNotFound, "note not found")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func parseID(raw string) (int, error) {
+	return strconv.Atoi(raw)
+}
+
+func writeJSON(w http.ResponseWriter, code int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(code)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func writeError(w http.ResponseWriter, code int, msg string) {
+	writeJSON(w, code, struct {
+		Error string `json:"error"`
+	}{Error: msg})
+}
