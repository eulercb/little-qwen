+package semver
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParse(t *testing.T) {
+	tests := []struct {
+		in   string
+		want Version
+		ok   bool
+	}{
+		{"1.2.3", Version{Major: 1, Minor: 2, Patch: 3}, true},
+		{"v1.2.3", Version{Major: 1, Minor: 2, Patch: 3}, true},
+		{"V1.2.3", Version{Major: 1, Minor: 2, Patch: 3}, true},
+		{"0.0.0", Version{}, true},
+		{"1.0.0-alpha", Version{Major: 1, Pre: []string{"alpha"}}, true},
+		{"1.0.0-alpha.1", Version{Major: 1, Pre: []string{"alpha", "1"}}, true},
+		{"1.0.0+build.5", Version{Major: 1, Build: []string{"build", "5"}}, true},
+		{"1.2.3-beta.11+exp.sha.5114f85",
+			Version{Major: 1, Minor: 2, Patch: 3, Pre: []string{"beta", "11"},
+				Build: []string{"exp", "sha", "5114f85"}}, true},
+		{"1.0.0-0", Version{Major: 1, Pre: []string{"0"}}, true},
+		{"1.0.0-x-y-z.9", Version{Major: 1, Pre: []string{"x-y-z", "9"}}, true},
+
+		// Rejected:
+		{"01.2.3", Version{}, false},
+		{"1.02.3", Version{}, false},
+		{"1.2.03", Version{}, false},
+		{"1.0.0-01", Version{}, false},
+		{"1.0.0-01.2", Version{}, false},
+		{"1.0.0-alpha..1", Version{}, false},
+		{"1.0.0-.1", Version{}, false},
+		{"1.0.0+", Version{}, false},
+		{"1.0.0+.", Version{}, false},
+		{"1.2", Version{}, false},
+		{"1.2.3.4", Version{}, false},
+		{"1.2.3-a_b", Version{}, false},
+		{"1.2.3-ä", Version{}, false},
+		{"1.2.3+met a", Version{}, false},
+		{"", Version{}, false},
+	}
+	for _, tt := range tests {
+		got, err := Parse(tt.in)
+		if tt.ok {
+			if err != nil {
+				t.Errorf("Parse(%q) unexpected error: %v", tt.in, err)
+				continue
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("Parse(%q) = %+v, want %+v", tt.in, got, tt.want)
+			}
+		} else if err == nil {
+			t.Errorf("Parse(%q) = %+v, want error", tt.in, got)
+		}
+	}
+}
+
+func TestString(t *testing.T) {
+	tests := []struct {
+		v    Version
+		want string
+	}{
+		{Version{Major: 1, Minor: 2, Patch: 3}, "1.2.3"},
+		{Version{}, "0.0.0"},
+		{Version{Major: 1, Pre: []string{"alpha", "1"}}, "1.0.0-alpha.1"},
+		{Version{Major: 1, Build: []string{"build"}}, "1.0.0+build"},
+		{Version{Major: 2, Minor: 1, Patch: 3, Pre: []string{"beta", "11"},
+			Build: []string{"exp", "sha", "5114f85"}}, "2.1.3-beta.11+exp.sha.5114f85"},
+	}
+	for _, tt := range tests {
+		if got := tt.v.String(); got != tt.want {
+			t.Errorf("String() = %q, want %q", got, tt.want)
+		}
+	}
+}
+
+func TestRoundTrip(t *testing.T) {
+	for _, s := range []string{
+		"1.0.0", "v1.0.0-alpha+001", "1.0.0-rc.1+build.1", "2.0.1-alpha.1.2.3",
+	} {
+		v, err := Parse(s)
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", s, err)
+		}
+		want := v.String()
+		if got, err := Parse(want); err != nil {
+			t.Errorf("Parse(%q) after String(): %v", want, err)
+		} else if got.String() != want {
+			t.Errorf("round trip %q -> %q -> %q", s, want, got.String())
+		}
+	}
+}
+
+func TestCompare(t *testing.T) {
+	// Ordering from the SemVer 2.0.0 spec.
+	sorted := []string{
+		"1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta",
+		"1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0",
+		"1.0.1", "1.1.0", "2.0.0",
+	}
+	versions := make([]Version, len(sorted))
+	for i, s := range sorted {
+		versions[i] = MustParse(s)
+	}
+	for i := range versions {
+		for j := range versions {
+			want := 0
+			if i < j {
+				want = -1
+			} else if i > j {
+				want = 1
+			}
+			if got := Compare(versions[i], versions[j]); got != want {
+				t.Errorf("Compare(%q, %q) = %d, want %d",
+					sorted[i], sorted[j], got, want)
+			}
+		}
+	}
+}
+
+func TestCompareNumericVsAlpha(t *testing.T) {
+	// Numeric identifiers compare numerically, so 2 < 11 (a lexicographic
+	// comparison would give "2" > "11").
+	if got := Compare(MustParse("1.0.0-2"), MustParse("1.0.0-11")); got != -1 {
+		t.Errorf("Compare(1.0.0-2, 1.0.0-11) = %d, want -1 (numeric comparison)", got)
+	}
+	if got := Compare(MustParse("1.0.0-1"), MustParse("1.0.0-alpha")); got != -1 {
+		t.Errorf("numeric identifier should sort below alphanumeric, got %d", got)
+	}
+	// Build metadata is ignored.
+	if got := Compare(MustParse("1.0.0+a"), MustParse("1.0.0+b")); got != 0 {
+		t.Errorf("build metadata should be ignored, got %d", got)
+	}
+	// ASCII lexical order: uppercase sorts before lowercase.
+	if got := Compare(MustParse("1.0.0-Alpha"), MustParse("1.0.0-alpha")); got != -1 {
+		t.Errorf("ASCII lexical order, got %d", got)
+	}
+}
+
+func TestMustParsePanics(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Error("MustParse of invalid version did not panic")
+		}
+	}()
+	MustParse("1.2")
+}
