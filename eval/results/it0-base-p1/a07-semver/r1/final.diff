+// Package semver implements Semantic Versioning 2.0.0 parsing and precedence.
+package semver
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version represents a semantic version: MAJOR.MINOR.PATCH with optional
+// pre-release and build metadata, per https://semver.org/spec/v2.0.0.html
+type Version struct {
+	Major uint64
+	Minor uint64
+	Patch uint64
+	Pre   []string
+	Build []string
+}
+
+// Parse parses s as a semantic version. A leading "v" or "V" prefix is
+// optional. It rejects missing parts, leading zeros in numeric fields and
+// pre-release identifiers, empty identifiers, and characters outside
+// [0-9A-Za-z-] in identifiers.
+func Parse(s string) (Version, error) {
+	s = strings.TrimPrefix(s, "v")
+	s = strings.TrimPrefix(s, "V")
+
+	var v Version
+	rest := s
+
+	// Split off build metadata first (a "+" cannot appear earlier, since the
+	// allowed identifier character set is [0-9A-Za-z-]).
+	if i := strings.IndexByte(rest, '+'); i >= 0 {
+		build, err := parseIdentifiers(rest[i+1:], "+build", false)
+		if err != nil {
+			return Version{}, err
+		}
+		v.Build = build
+		rest = rest[:i]
+	}
+
+	// Split off pre-release. No "-" can appear in the core or the build
+	// metadata, so the first remaining "-" introduces the pre-release.
+	if i := strings.IndexByte(rest, '-'); i >= 0 {
+		pre, err := parseIdentifiers(rest[i+1:], "-pre", true)
+		if err != nil {
+			return Version{}, err
+		}
+		v.Pre = pre
+		rest = rest[:i]
+	}
+
+	core := strings.Split(rest, ".")
+	if len(core) != 3 {
+		return Version{}, fmt.Errorf("invalid semantic version %q: expected MAJOR.MINOR.PATCH", s)
+	}
+	var err error
+	if v.Major, err = parseCorePart(core[0]); err != nil {
+		return Version{}, err
+	}
+	if v.Minor, err = parseCorePart(core[1]); err != nil {
+		return Version{}, err
+	}
+	if v.Patch, err = parseCorePart(core[2]); err != nil {
+		return Version{}, err
+	}
+	return v, nil
+}
+
+// parseCorePart parses a numeric core version part, rejecting leading zeros.
+func parseCorePart(part string) (uint64, error) {
+	if err := checkNoLeadingZero(part); err != nil {
+		return 0, err
+	}
+	n, err := strconv.ParseUint(part, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("invalid numeric component %q", part)
+	}
+	return n, nil
+}
+
+// checkNoLeadingZero reports an error if part has a leading zero.
+func checkNoLeadingZero(part string) error {
+	if len(part) > 1 && part[0] == '0' {
+		return fmt.Errorf("invalid leading zero in numeric component %q", part)
+	}
+	return nil
+}
+
+// parseIdentifiers parses a dot-separated list of identifiers. The prefix
+// (e.g. "+build") is used only for error messages. checkLeadingZero rejects
+// leading zeros in numeric identifiers (required for pre-release only, per
+// the SemVer 2.0.0 spec).
+func parseIdentifiers(s, prefix string, checkLeadingZero bool) ([]string, error) {
+	if s == "" {
+		return nil, fmt.Errorf("%s identifier must not be empty", prefix)
+	}
+	ids := strings.Split(s, ".")
+	for _, id := range ids {
+		if id == "" {
+			return nil, fmt.Errorf("%s identifier must not be empty", prefix)
+		}
+		if isNumeric(id) && checkLeadingZero {
+			if err := checkNoLeadingZero(id); err != nil {
+				return nil, fmt.Errorf("invalid %s identifier %q: %v", prefix, id, err)
+			}
+		}
+		for _, r := range id {
+			if !(r == '-' || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9')) {
+				return nil, fmt.Errorf("invalid character %q in %s identifier %q", r, prefix, id)
+			}
+		}
+	}
+	return ids, nil
+}
+
+// isNumeric reports whether the identifier consists entirely of digits.
+func isNumeric(id string) bool {
+	if id == "" {
+		return false
+	}
+	for _, r := range id {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// MustParse parses s and panics if it fails.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(fmt.Sprintf("semver: %v", err))
+	}
+	return v
+}
+
+// String returns the canonical version string without the "v" prefix.
+func (v Version) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%d.%d.%d", v.Major, v.Minor, v.Patch)
+	if len(v.Pre) > 0 {
+		b.WriteByte('-')
+		b.WriteString(strings.Join(v.Pre, "."))
+	}
+	if len(v.Build) > 0 {
+		b.WriteByte('+')
+		b.WriteString(strings.Join(v.Build, "."))
+	}
+	return b.String()
+}
+
+// Compare compares a and b by SemVer precedence and returns -1, 0 or +1.
+// Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := compareUint(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	// Core versions are equal; precedence depends on pre-release.
+	if len(a.Pre) == 0 && len(b.Pre) == 0 {
+		return 0
+	}
+	if len(a.Pre) == 0 {
+		return 1 // a release > a pre-release of the same version
+	}
+	if len(b.Pre) == 0 {
+		return -1
+	}
+	return comparePre(a.Pre, b.Pre)
+}
+
+// comparePre compares two pre-release identifier lists left to right.
+func comparePre(a, b []string) int {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if c := compareIdentifier(a[i], b[i]); c != 0 {
+			return c
+		}
+	}
+	if len(a) < len(b) {
+		return -1 // shorter list is lower when all preceding are equal
+	}
+	if len(a) > len(b) {
+		return 1
+	}
+	return 0
+}
+
+// compareIdentifier compares two pre-release identifiers: numeric ones
+// numerically, otherwise lexically in ASCII order; numeric < alphanumeric.
+func compareIdentifier(a, b string) int {
+	na, nb := isNumeric(a), isNumeric(b)
+	switch {
+	case na && nb:
+		ak, _ := strconv.ParseUint(a, 10, 64)
+		bk, _ := strconv.ParseUint(b, 10, 64)
+		return compareUint(ak, bk)
+	case na:
+		return -1
+	case nb:
+		return 1
+	default:
+		if a < b {
+			return -1
+		}
+		if a > b {
+			return 1
+		}
+		return 0
+	}
+}
+
+func compareUint(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
