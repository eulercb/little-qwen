+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func doRun(t *testing.T, args []string, input string) (string, error) {
+	t.Helper()
+	var sb strings.Builder
+	err := run(args, strings.NewReader(input), &sb)
+	return sb.String(), err
+}
+
+const sample = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func TestRunByRegion(t *testing.T) {
+	got, err := doRun(t, nil, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunByProduct(t *testing.T) {
+	got, err := doRun(t, []string{"--by", "product"}, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunEqualFlagsForm(t *testing.T) {
+	got, err := doRun(t, []string{"--by=product", "--top=1"}, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "apple\t3\t3.30\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunTop(t *testing.T) {
+	in := "region,product,qty,price\na,x,1,1.00\nb,y,2,2.00\nc,z,3,3.00\n"
+	got, err := doRun(t, []string{"--top", "1"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "c\t3\t9.00\nTOTAL\t6\t14.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunTopLargerThanGroups(t *testing.T) {
+	got, err := doRun(t, []string{"--top", "99"}, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := doRun(t, nil, sample); err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunTieBreakByName(t *testing.T) {
+	in := "region,product,qty,price\nb,x,1,1.00\na,y,1,1.00\n"
+	got, err := doRun(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t1\t1.00\nb\t1\t1.00\nTOTAL\t2\t2.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunShuffledHeaderWithExtraColumns(t *testing.T) {
+	in := "sku,region,qty,price,product\n1,b,2,0.25,tea\n2,a,1,10.00,coke\n"
+	got, err := doRun(t, []string{"--by", "region"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t1\t10.00\nb\t2\t0.50\nTOTAL\t3\t10.50\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunMissingColumn(t *testing.T) {
+	cols := []string{"region", "product", "qty", "price"}
+	for _, col := range cols {
+		var lines []string
+		for _, c := range cols {
+			if c != col {
+				lines = append(lines, c)
+			}
+		}
+		_, err := doRun(t, nil, strings.Join(lines, ",")+"\nnorth,apple,3\n")
+		if err == nil {
+			t.Fatalf("column %s: expected error", col)
+		}
+		if !strings.Contains(err.Error(), col) {
+			t.Fatalf("column %s: error %q does not mention it", col, err)
+		}
+	}
+}
+
+func TestRunBadQty(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,oops,2.00\n"
+	_, err := doRun(t, nil, in)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if !strings.Contains(err.Error(), "line 3") {
+		t.Fatalf("error %q does not mention line 3", err)
+	}
+	if !strings.Contains(err.Error(), "qty") {
+		t.Fatalf("error %q does not mention qty", err)
+	}
+}
+
+func TestRunNegativeQty(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,-1,1.10\n"
+	_, err := doRun(t, nil, in)
+	if err == nil {
+		t.Fatal("expected error for negative qty")
+	}
+	if !strings.Contains(err.Error(), "line 2") {
+		t.Fatalf("error %q does not mention line 2", err)
+	}
+}
+
+func TestRunBadPrice(t *testing.T) {
+	for _, in := range []string{
+		"region,product,qty,price\nnorth,apple,3,1.1\nsouth,pear,1,abc\n",
+		"region,product,qty,price\nnorth,apple,3,1.111\n",
+		"region,product,qty,price\nnorth,apple,3,\n",
+	} {
+		_, err := doRun(t, nil, in)
+		if err == nil {
+			t.Fatalf("input %q: expected error", in)
+		}
+		if !strings.Contains(err.Error(), "line 3") && !strings.Contains(err.Error(), "line 2") {
+			t.Fatalf("input %q: error %q has wrong line number", in, err)
+		}
+	}
+}
+
+func TestRunZeroQtyAndZeroRevenue(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,0,1.10\n"
+	got, err := doRun(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t0\t0.00\nTOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunNoRows(t *testing.T) {
+	got, err := doRun(t, nil, "region,product,qty,price\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "TOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRunFlagErrors(t *testing.T) {
+	cases := [][][]string{
+		{{"--by", "colour"}},
+		{{"--top", "0"}},
+		{{"--top", "-1"}},
+		{{"--top", "x"}},
+		{{"--by"}},
+		{{"--top"}},
+		{{"--bogus"}},
+	}
+	for _, c := range cases {
+		_, err := doRun(t, c[0], sample)
+		if err == nil {
+			t.Fatalf("args %v: expected error", c[0])
+		}
+	}
+}
+
+func TestFormatCents(t *testing.T) {
+	cases := map[int64]string{
+		0:    "0.00",
+		330:  "3.30",
+		500:  "5.00",
+		99:   "0.99",
+		1250: "12.50",
+		-330: "-3.30",
+	}
+	for c, want := range cases {
+		if got := formatCents(c); got != want {
+			t.Errorf("formatCents(%d) = %q, want %q", c, got, want)
+		}
+	}
+}
