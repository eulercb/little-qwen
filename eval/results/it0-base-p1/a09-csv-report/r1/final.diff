+package main
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// main runs the report on stdin and writes to stdout.
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+type group struct {
+	qty   int64
+	cents int64
+}
+
+// run parses args, reads a sales CSV from in and writes the summary to out.
+func run(args []string, in io.Reader, out io.Writer) error {
+	by, top, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	r := csv.NewReader(in)
+	records, err := readRecords(r)
+	if err != nil {
+		return err
+	}
+	if len(records) == 0 {
+		return errors.New("missing required column \"region\"")
+	}
+
+	header := records[0]
+	idx := map[string]int{}
+	for i, name := range header {
+		if _, ok := idx[name]; !ok {
+			idx[name] = i
+		}
+	}
+	for _, col := range []string{"region", "product", "qty", "price"} {
+		if _, ok := idx[col]; !ok {
+			return fmt.Errorf("missing required column %q", col)
+		}
+	}
+
+	groups := map[string]*group{}
+	var totalQty, totalCents int64
+	for i, rec := range records[1:] {
+		line := i + 2 // header is line 1
+
+		qty, err := strconv.ParseInt(rec[idx["qty"]], 10, 64)
+		if err != nil || qty < 0 {
+			return fmt.Errorf("line %d: invalid qty %q", line, rec[idx["qty"]])
+		}
+		cents, err := parseCents(rec[idx["price"]])
+		if err != nil {
+			return fmt.Errorf("line %d: invalid price %q", line, rec[idx["price"]])
+		}
+
+		key := rec[idx[by]]
+		g := groups[key]
+		if g == nil {
+			g = &group{}
+			groups[key] = g
+		}
+		g.qty += qty
+		g.cents += qty * cents
+		totalQty += qty
+		totalCents += qty * cents
+	}
+
+	names := make([]string, 0, len(groups))
+	for name := range groups {
+		names = append(names, name)
+	}
+	sort.Slice(names, func(i, j int) bool {
+		if groups[names[i]].cents != groups[names[j]].cents {
+			return groups[names[i]].cents > groups[names[j]].cents
+		}
+		return names[i] < names[j]
+	})
+	if top > 0 {
+		if top < len(names) {
+			names = names[:top]
+		}
+	}
+	for _, name := range names {
+		fmt.Fprintf(out, "%s\t%d\t%s\n", name, groups[name].qty, formatCents(groups[name].cents))
+	}
+	fmt.Fprintf(out, "TOTAL\t%d\t%s\n", totalQty, formatCents(totalCents))
+	return nil
+}
+
+// readRecords reads all CSV records, translating field-count errors into
+// line-numbered messages. The header is line 1.
+func readRecords(r *csv.Reader) ([][]string, error) {
+	var records [][]string
+	line := 0
+	for {
+		rec, err := r.Read()
+		if err == io.EOF {
+			return records, nil
+		}
+		if err != nil {
+			if e, ok := err.(*csv.ParseError); ok {
+				line = e.Line
+				if e.Err == csv.ErrFieldCount {
+					return nil, fmt.Errorf("line %d: expected %d fields, got %d", line, r.FieldsPerRecord, len(rec))
+				}
+			}
+			return nil, fmt.Errorf("line %d: %v", line+1, err)
+		}
+		line++
+		records = append(records, rec)
+	}
+}
+
+// parseCents parses a decimal with at most 2 fractional digits into integer cents.
+func parseCents(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, errors.New("empty value")
+	}
+	i := 0
+	if s[0] == '-' || s[0] == '+' {
+		i = 1
+	}
+	digitStart := i
+	dot := -1
+	for i < len(s) {
+		if s[i] == '.' {
+			if dot != -1 {
+				return 0, errors.New("multiple decimal points")
+			}
+			dot = i
+		} else if s[i] < '0' || s[i] > '9' {
+			return 0, errors.New("not a number")
+		}
+		i++
+	}
+	if dot == -1 && i == 0 {
+		return 0, errors.New("not a number")
+	}
+	var whole, frac string
+	if dot == -1 {
+		whole = s[digitStart:len(s)]
+		frac = ""
+	} else {
+		whole = s[digitStart:dot]
+		frac = s[dot+1:]
+	}
+	if len(frac) > 2 {
+		return 0, errors.New("more than 2 decimal places")
+	}
+	if whole == "" && frac == "" {
+		return 0, errors.New("not a number")
+	}
+	w, err := strconv.ParseInt(whole, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	f := "00"
+	if len(frac) == 1 {
+		f = frac + "0"
+	} else if len(frac) == 2 {
+		f = frac
+	}
+	fc, err := strconv.ParseInt(f, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	cents := w*100 + fc
+	if s[0] == '-' {
+		cents = -cents
+	}
+	return cents, nil
+}
+
+// formatCents renders integer cents with exactly two decimals, e.g. 330 -> "3.30".
+func formatCents(c int64) string {
+	neg := c < 0
+	if neg {
+		c = -c
+	}
+	s := strconv.FormatInt(c/100, 10) + "." + strconv.FormatInt((c/10)%10, 10) + strconv.FormatInt(c%10, 10)
+	if neg {
+		s = "-" + s
+	}
+	return s
+}
+
+// parseFlags parses --by region|product (default region) and --top N (N >= 1).
+func parseFlags(args []string) (by string, top int, err error) {
+	by = "region"
+	i := 0
+	for i < len(args) {
+		a := args[i]
+		switch {
+		case a == "--by":
+			i++
+			if i >= len(args) {
+				return "", 0, errors.New("--by requires a value (region or product)")
+			}
+			by = args[i]
+		case strings.HasPrefix(a, "--by="):
+			by = a[len("--by="):]
+		case a == "--top":
+			i++
+			if i >= len(args) {
+				return "", 0, errors.New("--top requires a value")
+			}
+			n, err := strconv.Atoi(args[i])
+			if err != nil || n < 1 {
+				return "", 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", args[i])
+			}
+			top = n
+		case strings.HasPrefix(a, "--top="):
+			n, err := strconv.Atoi(a[len("--top="):])
+			if err != nil || n < 1 {
+				return "", 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", a[len("--top="):])
+			}
+			top = n
+		default:
+			return "", 0, fmt.Errorf("unknown flag %q", a)
+		}
+		i++
+	}
+	if by != "region" && by != "product" {
+		return "", 0, fmt.Errorf("invalid --by value %q (must be region or product)", by)
+	}
+	return by, top, nil
+}
