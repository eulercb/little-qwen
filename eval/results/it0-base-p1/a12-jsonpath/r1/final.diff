+// Package jpath implements a tiny path query language over decoded JSON
+// documents (the values produced by encoding/json).
+package jpath
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+)
+
+// A step is one segment of a path after the root `$`.
+type step interface{}
+
+type memberStep struct{ name string }
+type indexStep struct{ i int }
+type starStep struct{}
+type recursiveStep struct{ name string }
+
+// Query evaluates path against doc and returns the matching values.
+func Query(doc any, path string) ([]any, error) {
+	steps, err := parse(path)
+	if err != nil {
+		return nil, err
+	}
+	nodes := []any{doc}
+	for _, st := range steps {
+		nodes = apply(nodes, st)
+	}
+	return nodes, nil
+}
+
+func parse(path string) ([]step, error) {
+	if path == "" || path[0] != '$' {
+		return nil, errors.New("jpath: path must start with '$'")
+	}
+	rest := path[1:]
+	var steps []step
+	for rest != "" {
+		switch rest[0] {
+		case '.':
+			rest = rest[1:]
+			if rest != "" && rest[0] == '.' {
+				// Recursive descent: ..name
+				rest = rest[1:]
+				name, r, err := ident(rest)
+				if err != nil {
+					return nil, fmt.Errorf("jpath: .. must be followed by a name: %s", err)
+				}
+				steps = append(steps, recursiveStep{name: name})
+				rest = r
+				continue
+			}
+			if rest != "" && rest[0] == '*' {
+				steps = append(steps, starStep{})
+				rest = rest[1:]
+				continue
+			}
+			name, r, err := ident(rest)
+			if err != nil {
+				return nil, fmt.Errorf("jpath: invalid member name: %s", err)
+			}
+			steps = append(steps, memberStep{name: name})
+			rest = r
+		case '[':
+			rest = rest[1:]
+			if rest != "" && rest[0] == '*' {
+				if len(rest) < 2 || rest[1] != ']' {
+					return nil, errors.New("jpath: expected ']' after '*'")
+				}
+				steps = append(steps, starStep{})
+				rest = rest[2:]
+				continue
+			}
+			if rest != "" && rest[0] == '"' {
+				key, r, err := quoted(rest)
+				if err != nil {
+					return nil, fmt.Errorf("jpath: invalid quoted key: %s", err)
+				}
+				if r == "" || r[0] != ']' {
+					return nil, errors.New(`jpath: expected ']' after quoted key`)
+				}
+				steps = append(steps, memberStep{name: key})
+				rest = r[1:]
+				continue
+			}
+			// Numeric index, possibly negative.
+			neg := false
+			if rest != "" && rest[0] == '-' {
+				neg = true
+				rest = rest[1:]
+			}
+			d := 0
+			haveDigit := false
+			for rest != "" && rest[0] >= '0' && rest[0] <= '9' {
+				d = d*10 + int(rest[0]-'0')
+				rest = rest[1:]
+				haveDigit = true
+			}
+			if !haveDigit {
+				return nil, errors.New("jpath: invalid index")
+			}
+			if rest == "" || rest[0] != ']' {
+				return nil, errors.New(`jpath: expected ']' after index`)
+			}
+			i := d
+			if neg {
+				i = -i
+			}
+			steps = append(steps, indexStep{i: i})
+			rest = rest[1:]
+		default:
+			return nil, fmt.Errorf("jpath: invalid character %q in path", rest[0])
+		}
+	}
+	if steps == nil {
+		steps = []step{}
+	}
+	return steps, nil
+}
+
+func ident(s string) (name, rest string, err error) {
+	if s == "" || !isIdentStart(s[0]) {
+		return "", "", errors.New("expected [A-Za-z_]")
+	}
+	name = string(s[0])
+	i := 1
+	for i < len(s) && isIdentChar(s[i]) {
+		name += string(s[i])
+		i++
+	}
+	return name, s[i:], nil
+}
+
+func isIdentStart(c byte) bool {
+	return c == '_' || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
+}
+
+func isIdentChar(c byte) bool {
+	return isIdentStart(c) || (c >= '0' && c <= '9')
+}
+
+// quoted parses a double-quoted key starting at s[0] == '"'.
+func quoted(s string) (key, rest string, err error) {
+	// s starts with the opening quote.
+	i := 1
+	var b []byte
+	for i < len(s) {
+		c := s[i]
+		if c == '\\' {
+			if i+1 >= len(s) {
+				return "", "", errors.New("dangling escape")
+			}
+			switch s[i+1] {
+			case '"', '\\':
+				b = append(b, s[i+1])
+			default:
+				return "", "", fmt.Errorf("unsupported escape %q", s[i+1])
+			}
+			i += 2
+			continue
+		}
+		if c == '"' {
+			return string(b), s[i+1:], nil
+		}
+		b = append(b, c)
+		i++
+	}
+	return "", "", errors.New("unterminated quoted key")
+}
+
+func apply(nodes []any, st step) []any {
+	out := []any{}
+	for _, n := range nodes {
+		switch s := st.(type) {
+		case memberStep:
+			if m, ok := n.(map[string]any); ok {
+				if v, ok := m[s.name]; ok {
+					out = append(out, v)
+				}
+			}
+		case indexStep:
+			if a, ok := n.([]any); ok {
+				i := s.i
+				if i < 0 {
+					i += len(a)
+				}
+				if i >= 0 && i < len(a) {
+					out = append(out, a[i])
+				}
+			}
+		case starStep:
+			switch v := n.(type) {
+			case []any:
+				out = append(out, v...)
+			case map[string]any:
+				keys := make([]string, 0, len(v))
+				for k := range v {
+					keys = append(keys, k)
+				}
+				sort.Strings(keys)
+				for _, k := range keys {
+					out = append(out, v[k])
+				}
+			}
+		case recursiveStep:
+			recursiveDescend(n, s.name, &out)
+		}
+	}
+	return out
+}
+
+// recursiveDescend visits n in pre-order, appending the named member of n
+// (if it is an object) and then the named members of every descendant.
+func recursiveDescend(n any, name string, out *[]any) {
+	switch v := n.(type) {
+	case map[string]any:
+		if m, ok := v[name]; ok {
+			*out = append(*out, m)
+		}
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			recursiveDescend(v[k], name, out)
+		}
+	case []any:
+		for _, e := range v {
+			recursiveDescend(e, name, out)
+		}
+	}
+}
