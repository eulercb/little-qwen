+package jpath
+
+import (
+	"reflect"
+	"testing"
+)
+
+func mustQuery(t *testing.T, d any, path string) []any {
+	t.Helper()
+	got, err := Query(d, path)
+	if err != nil {
+		t.Fatalf("Query(%q) error: %v", path, err)
+	}
+	return got
+}
+
+func eq(t *testing.T, got, want []any) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+}
+
+func TestRoot(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	got := mustQuery(t, d, "$")
+	if !reflect.DeepEqual(got, []any{d}) {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestStarObject(t *testing.T) {
+	d := doc(t, `{"b":2,"a":1}`)
+	eq(t, mustQuery(t, d, "$.*"), []any{1.0, 2.0})
+}
+
+func TestStarArray(t *testing.T) {
+	d := doc(t, `[1,2,3]`)
+	eq(t, mustQuery(t, d, "$.*"), []any{1.0, 2.0, 3.0})
+}
+
+func TestStarArrayDotStar(t *testing.T) {
+	d := doc(t, `[[1,2],[3]]`)
+	eq(t, mustQuery(t, d, "$.*.*"), []any{1.0, 2.0, 3.0})
+}
+
+func TestNegativeIndex(t *testing.T) {
+	d := doc(t, `[1,2,3]`)
+	eq(t, mustQuery(t, d, "$[-1]"), []any{3.0})
+	eq(t, mustQuery(t, d, "$[0]"), []any{1.0})
+	eq(t, mustQuery(t, d, "$[-5]"), []any{})
+	eq(t, mustQuery(t, d, "$[5]"), []any{})
+}
+
+func TestIndexOnNonArray(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	eq(t, mustQuery(t, d, "$[0]"), []any{})
+}
+
+func TestMemberMissing(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	eq(t, mustQuery(t, d, "$.b.a"), []any{})
+}
+
+func TestQuotedKey(t *testing.T) {
+	d := doc(t, `{"weird key":"v","q":"x"}`)
+	eq(t, mustQuery(t, d, `$["weird key"]`), []any{"v"})
+	eq(t, mustQuery(t, d, `$["q"]`), []any{"x"})
+	// Escapes.
+	d2 := doc(t, `{"a\"b\\c":"v"}`)
+	eq(t, mustQuery(t, d2, `$["a\"b\\c"]`), []any{"v"})
+}
+
+func TestRecursive(t *testing.T) {
+	d := doc(t, `{"x":{"y":1},"z":[{"y":2},{"y":3}]}`)
+	eq(t, mustQuery(t, d, "$..y"), []any{1.0, 2.0, 3.0})
+	eq(t, mustQuery(t, d, "$..z"), []any{[]any{map[string]any{"y": 2.0}, map[string]any{"y": 3.0}}})
+	eq(t, mustQuery(t, d, "$..nope"), []any{})
+}
+
+func TestRecursiveOnArray(t *testing.T) {
+	d := doc(t, `[{"a":1},{"b":{"a":2}}]`)
+	eq(t, mustQuery(t, d, "$..a"), []any{1.0, 2.0})
+}
+
+func TestNoMatchEmptyNonNil(t *testing.T) {
+	d := doc(t, `{"a":1}`)
+	got := mustQuery(t, d, "$.missing")
+	if got == nil {
+		t.Fatal("want empty non-nil slice")
+	}
+	if len(got) != 0 {
+		t.Fatalf("want empty, got %v", got)
+	}
+}
+
+func TestMalformed(t *testing.T) {
+	d := doc(t, `{"a":{"b":1}}`)
+	for _, p := range []string{
+		"$.", "$[", "$[1", `$["x]`, `$.1abc`, "$[abc]", "a.b", "", ".",
+		"$..", `$["x`, "$[0", "$[+1]", "$[1a]", "$.", "a", "$[x]",
+	} {
+		got, err := Query(d, p)
+		if err == nil {
+			t.Errorf("path %q: want error, got %v", p, got)
+		}
+		if got != nil {
+			t.Errorf("path %q: want nil result, got %v", p, got)
+		}
+	}
+}
