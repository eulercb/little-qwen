 // Package lru implements a least-recently-used cache.
 package lru
 
-// Cache is an LRU cache. TODO: implement.
+// Cache is a generic LRU cache with a fixed capacity. It is not safe for
+// concurrent use.
 type Cache[K comparable, V any] struct {
+	capacity int
+	items    map[K]*node[K, V]
+	list     *dlist[K, V]
+	// OnEvict, if non-nil, is called when a key is evicted because of
+	// capacity (not on Remove or update).
+	OnEvict func(key K, value V)
+}
+
+type node[K comparable, V any] struct {
+	key   K
+	value V
+	prev  *node[K, V]
+	next  *node[K, V]
+}
+
+// dlist is a doubly linked list with sentinel head/tail so all pointer
+// manipulations are O(1) without nil checks.
+type dlist[K comparable, V any] struct {
+	head *node[K, V] // most recently used side
+	tail *node[K, V] // least recently used side
+}
+
+func newDlist[K comparable, V any]() *dlist[K, V] {
+	h := &node[K, V]{}
+	t := &node[K, V]{}
+	h.next = t
+	t.prev = h
+	return &dlist[K, V]{head: h, tail: t}
+}
+
+func (l *dlist[K, V]) remove(n *node[K, V]) {
+	n.prev.next = n.next
+	n.next.prev = n.prev
+	n.prev = nil
+	n.next = nil
+}
+
+// pushFront inserts n at the most recently used side.
+func (l *dlist[K, V]) pushFront(n *node[K, V]) {
+	n.prev = l.head
+	n.next = l.head.next
+	l.head.next.prev = n
+	l.head.next = n
+}
+
+// popTail removes and returns the least recently used node.
+func (l *dlist[K, V]) popTail() *node[K, V] {
+	n := l.tail.prev
+	l.remove(n)
+	return n
+}
+
+// New creates an LRU cache with the given capacity.
+// It panics if capacity < 1.
+func New[K comparable, V any](capacity int) *Cache[K, V] {
+	if capacity < 1 {
+		panic("lru: capacity must be >= 1")
+	}
+	return &Cache[K, V]{
+		capacity: capacity,
+		items:    make(map[K]*node[K, V], capacity),
+		list:     newDlist[K, V](),
+	}
+}
+
+// Get returns the value for key, reporting whether it was present.
+// A successful or missed lookup that finds the key marks it as most
+// recently used.
+func (c *Cache[K, V]) Get(key K) (V, bool) {
+	n, ok := c.items[key]
+	if !ok {
+		var zero V
+		return zero, false
+	}
+	c.list.remove(n)
+	c.list.pushFront(n)
+	return n.value, true
+}
+
+// Put inserts or updates key. In either case the key becomes most
+// recently used. If the cache is full and the key is new, the least
+// recently used key is evicted first (triggering OnEvict if set).
+func (c *Cache[K, V]) Put(key K, value V) {
+	if n, ok := c.items[key]; ok {
+		n.value = value
+		c.list.remove(n)
+		c.list.pushFront(n)
+		return
+	}
+	if len(c.items) >= c.capacity {
+		oldest := c.list.popTail()
+		delete(c.items, oldest.key)
+		if c.OnEvict != nil {
+			c.OnEvict(oldest.key, oldest.value)
+		}
+	}
+	n := &node[K, V]{key: key, value: value}
+	c.items[key] = n
+	c.list.pushFront(n)
+}
+
+// Len returns the number of items currently in the cache.
+func (c *Cache[K, V]) Len() int {
+	return len(c.items)
+}
+
+// Keys returns the cache keys ordered from most to least recently used.
+func (c *Cache[K, V]) Keys() []K {
+	keys := make([]K, 0, len(c.items))
+	for n := c.list.head.next; n != c.list.tail; n = n.next {
+		keys = append(keys, n.key)
+	}
+	return keys
+}
+
+// Remove deletes key from the cache and reports whether it was present.
+func (c *Cache[K, V]) Remove(key K) bool {
+	n, ok := c.items[key]
+	if !ok {
+		return false
+	}
+	c.list.remove(n)
+	delete(c.items, key)
+	return true
 }
