+func TestGetMiss(t *testing.T) {
+	c := New[int, string](3)
+	if v, ok := c.Get(1); ok || v != "" {
+		t.Fatalf("Get(1) = %q,%v; want \"\",false", v, ok)
+	}
+}
+
+func TestEvictsLeastRecentlyUsed(t *testing.T) {
+	c := New[int, string](2)
+	c.Put(1, "one")
+	c.Put(2, "two")
+	// Touch 1 so 2 becomes least recently used.
+	if _, ok := c.Get(1); !ok {
+		t.Fatal("Get(1) = false")
+	}
+	c.Put(3, "three")
+	if _, ok := c.Get(2); ok {
+		t.Fatal("key 2 should have been evicted")
+	}
+	if v, ok := c.Get(1); !ok || v != "one" {
+		t.Fatalf("Get(1) = %q,%v; want one,true", v, ok)
+	}
+	if v, ok := c.Get(3); !ok || v != "three" {
+		t.Fatalf("Get(3) = %q,%v; want three,true", v, ok)
+	}
+	if c.Len() != 2 {
+		t.Fatalf("Len() = %d; want 2", c.Len())
+	}
+}
+
+func TestUpdateDoesNotEvict(t *testing.T) {
+	c := New[int, string](1)
+	c.Put(1, "one")
+	c.Put(1, "one-v2")
+	if v, ok := c.Get(1); !ok || v != "one-v2" {
+		t.Fatalf("Get(1) = %q,%v; want one-v2,true", v, ok)
+	}
+	if c.Len() != 1 {
+		t.Fatalf("Len() = %d; want 1", c.Len())
+	}
+}
+
+func TestUpdateMarksMostRecentlyUsed(t *testing.T) {
+	var evicted []int
+	c := New[int, string](2)
+	c.OnEvict = func(k int, _ string) { evicted = append(evicted, k) }
+	c.Put(1, "one")
+	c.Put(2, "two")
+	c.Put(1, "one-v2") // reuses key 1, making 2 least recently used.
+	c.Put(3, "three")
+	if len(evicted) != 1 || evicted[0] != 2 {
+		t.Fatalf("evicted = %v; want [2]", evicted)
+	}
+	if v, ok := c.Get(1); !ok || v != "one-v2" {
+		t.Fatalf("Get(1) = %q,%v; want one-v2,true", v, ok)
+	}
+}
+
+func TestKeysOrder(t *testing.T) {
+	c := New[string, int](3)
+	c.Put("a", 1)
+	c.Put("b", 2)
+	c.Put("c", 3)
+	// Recency: b (put), a (get), c (put) -> after get(a): a,c,b; after
+	// put(b): b,a,c.
+	c.Get("a")
+	c.Put("b", 20) // re-touch b
+	got := c.Keys()
+	want := []string{"b", "a", "c"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Keys() = %v; want %v", got, want)
+	}
+}
+
+func TestKeysEmpty(t *testing.T) {
+	c := New[int, int](2)
+	if got := c.Keys(); len(got) != 0 {
+		t.Fatalf("Keys() = %v; want empty", got)
+	}
+}
+
+func TestRemove(t *testing.T) {
+	var evicted []int
+	c := New[int, int](2)
+	c.OnEvict = func(k int, _ int) { evicted = append(evicted, k) }
+	c.Put(1, 10)
+	c.Put(2, 20)
+	if !c.Remove(1) {
+		t.Fatal("Remove(1) = false; want true")
+	}
+	if c.Remove(1) {
+		t.Fatal("Remove(1) again = true; want false")
+	}
+	if c.Remove(42) {
+		t.Fatal("Remove(42) = true; want false")
+	}
+	if c.Len() != 1 {
+		t.Fatalf("Len() = %d; want 1", c.Len())
+	}
+	c.Put(3, 30) // must not evict 2 because removal freed space.
+	if _, ok := c.Get(2); !ok {
+		t.Fatal("key 2 missing after non-capacity eviction path")
+	}
+	if len(evicted) != 0 {
+		t.Fatalf("OnEvict called %v on Remove; want none", evicted)
+	}
+}
+
+func TestOnEvictNotCalledOnUpdateOrRemove(t *testing.T) {
+	var calls int
+	c := New[string, int](1)
+	c.OnEvict = func(string, int) { calls++ }
+	c.Put("a", 1)
+	c.Put("a", 2) // update
+	if calls != 0 {
+		t.Fatalf("OnEvict called %d times on update", calls)
+	}
+	c.Put("b", 3) // triggers one capacity eviction
+	if calls != 1 {
+		t.Fatalf("OnEvict calls = %d; want 1", calls)
+	}
+	calls = 0
+	c.Put("a", 5) // capacity eviction of b, not an OnEvict-for-Remove case.
+	if calls != 1 {
+		t.Fatalf("OnEvict calls after capacity evict = %d; want 1", calls)
+	}
+	calls = 0
+	if !c.Remove("a") || calls != 0 {
+		t.Fatalf("OnEvict calls after Remove = %d; want 0", calls)
+	}
+}
+
+func TestReinsertAfterEviction(t *testing.T) {
+	c := New[int, int](1)
+	c.Put(1, 10)
+	c.Put(2, 20) // evicts 1
+	c.Put(1, 11)
+	if v, ok := c.Get(1); !ok || v != 11 {
+		t.Fatalf("Get(1) = %d,%v; want 11,true", v, ok)
+	}
+	if _, ok := c.Get(2); ok {
+		t.Fatal("key 2 should have been evicted")
+	}
+	if c.Len() != 1 {
+		t.Fatalf("Len() = %d; want 1", c.Len())
+	}
+}
diff --git a/lru/zz_hidden_test.go b/lru/zz_hidden_test.go
