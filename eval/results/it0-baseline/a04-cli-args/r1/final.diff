@@ -14,3 +19,127 @@ type Config struct {
 	Tags    []string
 	Args    []string
 }
+
+// Parse parses the command line arguments.
+func Parse(args []string) (Config, error) {
+	cfg := Config{Count: 1, Output: "-"}
+
+	setCount := func(flag, v string) error {
+		n, err := strconv.Atoi(v)
+		if err != nil {
+			return fmt.Errorf("flag %s: invalid value %q: not an integer: %w", flag, v, ErrUsage)
+		}
+		if n < 0 {
+			return fmt.Errorf("flag %s: invalid value %q: must be >= 0: %w", flag, v, ErrUsage)
+		}
+		cfg.Count = n
+		return nil
+	}
+
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+
+		// A lone "-" is a positional argument; "--" ends option parsing.
+		if arg == "-" {
+			cfg.Args = append(cfg.Args, arg)
+			continue
+		}
+		if arg == "--" {
+			cfg.Args = append(cfg.Args, args[i+1:]...)
+			break
+		}
+		if arg[0] != '-' {
+			cfg.Args = append(cfg.Args, arg)
+			continue
+		}
+		if arg[1] == '-' { // long flag
+			name, value, hasValue := arg[2:], "", false
+			if eq := strings.IndexByte(name, '='); eq >= 0 {
+				name, value, hasValue = name[:eq], name[eq+1:], true
+			}
+			switch name {
+			case "verbose":
+				if hasValue {
+					return cfg, fmt.Errorf("flag --verbose: unexpected value %q: %w", value, ErrUsage)
+				}
+				cfg.Verbose = true
+			case "count":
+				if !hasValue {
+					v, consume, err := takeValue("--count", args[i+1:])
+					if err != nil {
+						return cfg, err
+					}
+					value, i = v, i+consume
+				}
+				if err := setCount(arg, value); err != nil {
+					return cfg, err
+				}
+			case "output":
+				if !hasValue {
+					v, consume, err := takeValue("--output", args[i+1:])
+					if err != nil {
+						return cfg, err
+					}
+					value, i = v, i+consume
+				}
+				cfg.Output = value
+			case "tag":
+				if !hasValue {
+					v, consume, err := takeValue("--tag", args[i+1:])
+					if err != nil {
+						return cfg, err
+					}
+					value, i = v, i+consume
+				}
+				cfg.Tags = append(cfg.Tags, value)
+			default:
+				return cfg, fmt.Errorf("unknown flag --%s: %w", name, ErrUsage)
+			}
+			continue
+		}
+
+		// Short flag cluster, e.g. -vv or -n5.
+		cluster := arg[1:]
+		for j := 0; j < len(cluster); j++ {
+			switch c := cluster[j]; c {
+			case 'v':
+				cfg.Verbose = true
+			case 'n', 'o':
+				longName := "-n"
+				if c == 'o' {
+					longName = "-o"
+				}
+				var value string
+				if j+1 < len(cluster) { // e.g. -n5 or -n=5
+					value = strings.TrimPrefix(cluster[j+1:], "=")
+					j = len(cluster) // consume the rest of the cluster
+				} else {
+					v, consume, err := takeValue(longName, args[i+1:])
+					if err != nil {
+						return cfg, err
+					}
+					value, i = v, i+consume
+				}
+				if c == 'n' {
+					if err := setCount(arg, value); err != nil {
+						return cfg, err
+					}
+				} else {
+					cfg.Output = value
+				}
+			default:
+				return cfg, fmt.Errorf("unknown flag -%c: %w", c, ErrUsage)
+			}
+		}
+	}
+
+	return cfg, nil
+}
+
+// takeValue returns the first element of rest, or an error if rest is empty.
+func takeValue(name string, rest []string) (string, int, error) {
+	if len(rest) == 0 {
+		return "", 0, fmt.Errorf("flag %s: missing value: %w", name, ErrUsage)
+	}
+	return rest[0], 1, nil
+}
