+// Package semver implements Semantic Versioning 2.0.0 parsing and precedence.
+//
+// See https://semver.org for the specification.
+package semver
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version is a parsed semantic version.
+type Version struct {
+	Major uint64
+	Minor uint64
+	Patch uint64
+	Pre   []string
+	Build []string
+}
+
+// Parse parses s as a semantic version. An optional leading "v" is accepted.
+// The version must have MAJOR.MINOR.PATCH numeric parts without leading
+// zeros. Pre-release and build identifiers must be non-empty, contain only
+// [0-9A-Za-z-], and numeric pre-release identifiers must not have leading
+// zeros. Build metadata is parsed but ignored by Compare.
+func Parse(s string) (Version, error) {
+	var v Version
+	rest := s
+	if strings.HasPrefix(rest, "v") {
+		rest = rest[1:]
+	}
+	// Split off build metadata.
+	if i := strings.IndexByte(rest, '+'); i >= 0 {
+		meta := rest[i+1:]
+		rest = rest[:i]
+		ids := strings.Split(meta, ".")
+		for _, id := range ids {
+			if err := checkIdentifier(id, false); err != nil {
+				return Version{}, fmt.Errorf("semver: invalid build metadata in %q: %w", s, err)
+			}
+		}
+		v.Build = ids
+	}
+	// Split off pre-release.
+	if i := strings.IndexByte(rest, '-'); i >= 0 {
+		pre := rest[i+1:]
+		rest = rest[:i]
+		ids := strings.Split(pre, ".")
+		for _, id := range ids {
+			if err := checkIdentifier(id, true); err != nil {
+				return Version{}, fmt.Errorf("semver: invalid pre-release in %q: %w", s, err)
+			}
+		}
+		v.Pre = ids
+	}
+	// Core numeric parts.
+	parts := strings.Split(rest, ".")
+	if len(parts) != 3 {
+		return Version{}, fmt.Errorf("semver: invalid version %q: expected MAJOR.MINOR.PATCH", s)
+	}
+	nums := make([]uint64, 3)
+	for i, p := range parts {
+		if err := checkNumeric(p); err != nil {
+			return Version{}, fmt.Errorf("semver: invalid version %q: %w", s, err)
+		}
+		n, err := strconv.ParseUint(p, 10, 64)
+		if err != nil {
+			return Version{}, fmt.Errorf("semver: invalid version %q: %w", s, err)
+		}
+		nums[i] = n
+	}
+	v.Major, v.Minor, v.Patch = nums[0], nums[1], nums[2]
+	return v, nil
+}
+
+// MustParse is like Parse but panics if s is invalid.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+// String returns the canonical string form of v, without the "v" prefix.
+func (v Version) String() string {
+	s := strconv.FormatUint(v.Major, 10) + "." +
+		strconv.FormatUint(v.Minor, 10) + "." +
+		strconv.FormatUint(v.Patch, 10)
+	if len(v.Pre) > 0 {
+		s += "-" + strings.Join(v.Pre, ".")
+	}
+	if len(v.Build) > 0 {
+		s += "+" + strings.Join(v.Build, ".")
+	}
+	return s
+}
+
+// Compare returns -1, 0, or +1 if a is lower than, equal to, or higher
+// than b in semantic version precedence. Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := compareUint(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := compareUint(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	return comparePre(a.Pre, b.Pre)
+}
+
+func compareUint(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// comparePre compares pre-release identifier lists. A version without a
+// pre-release has higher precedence than the same version with one.
+// Identifiers are compared left to right: numeric identifiers numerically,
+// alphanumeric identifiers by ASCII order, numeric identifiers always lower
+// than alphanumeric ones, and a shorter list is lower when all preceding
+// identifiers are equal.
+func comparePre(a, b []string) int {
+	if len(a) == 0 && len(b) == 0 {
+		return 0
+	}
+	if len(a) == 0 {
+		return 1 // no pre-release outranks a pre-release
+	}
+	if len(b) == 0 {
+		return -1
+	}
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if c := compareIdentifier(a[i], b[i]); c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(a) < len(b):
+		return -1
+	case len(a) > len(b):
+		return 1
+	default:
+		return 0
+	}
+}
+
+func compareIdentifier(a, b string) int {
+	an := isNumeric(a)
+	bn := isNumeric(b)
+	switch {
+	case an && bn:
+		return compareUint(parseUint(a), parseUint(b))
+	case an && !bn:
+		return -1
+	case !an && bn:
+		return 1
+	default:
+		switch {
+		case a < b:
+			return -1
+		case a > b:
+			return 1
+		default:
+			return 0
+		}
+	}
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func parseUint(s string) uint64 {
+	var n uint64
+	for i := 0; i < len(s); i++ {
+		n = n*10 + uint64(s[i]-'0')
+	}
+	return n
+}
+
+func checkNumeric(s string) error {
+	if s == "" {
+		return fmt.Errorf("missing numeric part")
+	}
+	for i, c := range s {
+		if c < '0' || c > '9' {
+			return fmt.Errorf("invalid character %q in numeric part %q", c, s)
+		}
+		if i == 0 && c == '0' && len(s) > 1 {
+			return fmt.Errorf("leading zero in numeric part %q", s)
+		}
+	}
+	return nil
+}
+
+func checkIdentifier(s string, pre bool) error {
+	if s == "" {
+		return fmt.Errorf("empty identifier")
+	}
+	for _, c := range s {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '-') {
+			return fmt.Errorf("invalid character %q in identifier %q", c, s)
+		}
+	}
+	if pre && len(s) > 1 && s[0] == '0' && s[1] >= '0' && s[1] <= '9' && isNumeric(s) {
+		return fmt.Errorf("leading zero in numeric pre-release identifier %q", s)
+	}
+	return nil
+}
