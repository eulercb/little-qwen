@@ -0,0 +1,194 @@
+package semver
+
+import (
+	"testing"
+)
+
+func TestParseValid(t *testing.T) {
+	tests := []struct {
+		in   string
+		maj  uint64
+		min  uint64
+		pat  uint64
+		pre  []string
+		bild []string
+	}{
+		{"1.2.3", 1, 2, 3, nil, nil},
+		{"v1.2.3", 1, 2, 3, nil, nil},
+		{"0.0.0", 0, 0, 0, nil, nil},
+		{"1.0.0-alpha", 1, 0, 0, []string{"alpha"}, nil},
+		{"1.0.0-0", 1, 0, 0, []string{"0"}, nil},
+		{"1.0.0-0.3.7", 1, 0, 0, []string{"0", "3", "7"}, nil},
+		{"1.0.0-x.7.z.92", 1, 0, 0, []string{"x", "7", "z", "92"}, nil},
+		{"1.0.0-alpha-1", 1, 0, 0, []string{"alpha-1"}, nil},
+		{"1.0.0+20130313144700", 1, 0, 0, nil, []string{"20130313144700"}},
+		{"1.0.0-beta+exp.sha.5114f85", 1, 0, 0, []string{"beta"}, []string{"exp", "sha", "5114f85"}},
+		{"v1.0.0-rc.1+build.5", 1, 0, 0, []string{"rc", "1"}, []string{"build", "5"}},
+		{"10.20.30", 10, 20, 30, nil, nil},
+	}
+	for _, tc := range tests {
+		v, err := Parse(tc.in)
+		if err != nil {
+			t.Errorf("Parse(%q) unexpected error: %v", tc.in, err)
+			continue
+		}
+		if v.Major != tc.maj || v.Minor != tc.min || v.Patch != tc.pat {
+			t.Errorf("Parse(%q) = %v, want %d.%d.%d", tc.in, v, tc.maj, tc.min, tc.pat)
+		}
+		if !equalStrs(v.Pre, tc.pre) {
+			t.Errorf("Parse(%q).Pre = %v, want %v", tc.in, v.Pre, tc.pre)
+		}
+		if !equalStrs(v.Build, tc.bild) {
+			t.Errorf("Parse(%q).Build = %v, want %v", tc.in, v.Build, tc.bild)
+		}
+	}
+}
+
+func TestParseInvalid(t *testing.T) {
+	invalid := []string{
+		"",                 // empty
+		"v",                // only the prefix
+		"1",                // missing parts
+		"1.2",              // missing parts
+		"1.2.3.4",          // extra part
+		"01.2.3",           // leading zero major
+		"1.02.3",           // leading zero minor
+		"1.2.03",           // leading zero patch
+		"1.2.3-01",         // leading zero in numeric pre-release id
+		"1.2.3-alpha..1",   // empty identifier
+		"1.2.3..4",         // empty core identifier
+		"1.2.3-alpha_beta", // invalid character
+		"1.2.3+b_ui-ld",    // invalid character in build
+		"1.2.3-+",          // empty pre and build
+		"1.2.3-beta+",      // trailing empty build id
+		"v1.2.3-",          // trailing empty pre id
+		"-1.2.3",           // bad prefix
+		"1.2.-3",           // leading dash in core
+		"1..3",             // empty minor
+	}
+	for _, in := range invalid {
+		if _, err := Parse(in); err == nil {
+			t.Errorf("Parse(%q) succeeded, want error", in)
+		}
+	}
+}
+
+func equalStrs(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestString(t *testing.T) {
+	tests := []struct {
+		in   string
+		want string
+	}{
+		{"1.2.3", "1.2.3"},
+		{"v1.2.3", "1.2.3"},
+		{"1.0.0-alpha", "1.0.0-alpha"},
+		{"1.0.0-alpha.1", "1.0.0-alpha.1"},
+		{"1.0.0+build.5", "1.0.0+build.5"},
+		{"1.0.0-rc.1+b.2", "1.0.0-rc.1+b.2"},
+	}
+	for _, tc := range tests {
+		v, err := Parse(tc.in)
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", tc.in, err)
+		}
+		got := v.String()
+		if got != tc.want {
+			t.Errorf("String of %q = %q, want %q", tc.in, got, tc.want)
+		}
+		// Round-trip must be stable.
+		v2, err := Parse(got)
+		if err != nil {
+			t.Fatalf("re-parse of %q: %v", got, err)
+		}
+		if v2.String() != got {
+			t.Errorf("round-trip of %q changed to %q", got, v2.String())
+		}
+	}
+}
+
+func TestCompare(t *testing.T) {
+	// The canonical example ordering from the SemVer spec.
+	order := []string{
+		"1.0.0-alpha",
+		"1.0.0-alpha.1",
+		"1.0.0-alpha.beta",
+		"1.0.0-beta",
+		"1.0.0-beta.2",
+		"1.0.0-beta.11",
+		"1.0.0-rc.1",
+		"1.0.0",
+	}
+	for i := 0; i < len(order); i++ {
+		for j := i + 1; j < len(order); j++ {
+			a := MustParse(order[i])
+			b := MustParse(order[j])
+			if got := Compare(a, b); got != -1 {
+				t.Errorf("Compare(%s, %s) = %d, want -1", a, b, got)
+			}
+			if got := Compare(b, a); got != 1 {
+				t.Errorf("Compare(%s, %s) = %d, want 1", b, a, got)
+			}
+		}
+	}
+}
+
+func TestCompareEquality(t *testing.T) {
+	pairs := [][2]string{
+		{"1.2.3", "1.2.3"},
+		{"v1.2.3", "1.2.3"},
+		{"1.0.0+build.1", "1.0.0+build.2"}, // build metadata ignored
+		{"1.0.0-alpha+exp", "1.0.0-alpha+exp.sha"},
+	}
+	for _, p := range pairs {
+		a, errA := Parse(p[0])
+		b, errB := Parse(p[1])
+		if errA != nil || errB != nil {
+			t.Fatalf("parse %q / %q: %v / %v", p[0], p[1], errA, errB)
+		}
+		if got := Compare(a, b); got != 0 {
+			t.Errorf("Compare(%s, %s) = %d, want 0", a, b, got)
+		}
+	}
+}
+
+func TestCompareNumericParts(t *testing.T) {
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"2.0.0", "1.9.9", 1},
+		{"1.2.0", "1.10.0", -1}, // 2 < 10 numerically
+		{"1.0.2", "1.0.10", -1},
+		{"1.0.0", "2.0.0-alpha", -1},
+		{"1.0.0", "1.0.1-alpha", -1},
+		{"1.0.1-alpha", "1.0.1", -1}, // pre-release lower than release
+		{"1.0.0-1", "1.0.0-2", -1},   // numeric pre ids numerically
+		{"1.0.0-1", "1.0.0-alpha", -1},
+	}
+	for _, tc := range cases {
+		a, b := MustParse(tc.a), MustParse(tc.b)
+		if got := Compare(a, b); got != tc.want {
+			t.Errorf("Compare(%s, %s) = %d, want %d", tc.a, tc.b, got, tc.want)
+		}
+	}
+}
+
+func TestMustParsePanics(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Error("MustParse(1.2) did not panic")
+		}
+	}()
+	MustParse("1.2")
+}
