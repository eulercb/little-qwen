@@ -0,0 +1,208 @@
+package ratelimit
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeClock is a manually advanced clock for tests.
+type fakeClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func newFakeClock() *fakeClock { return &fakeClock{now: time.Unix(0, 0)} }
+
+func (c *fakeClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+// Advance moves the fake clock forward.
+func (c *fakeClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.now = c.now.Add(d)
+}
+
+func newTestLimiter(rate float64, burst int) (*Limiter, *fakeClock) {
+	clk := newFakeClock()
+	return New(rate, burst, clk), clk
+}
+
+func TestPanicOnBadArgs(t *testing.T) {
+	clk := newFakeClock()
+	for _, tc := range []struct {
+		name  string
+		rate  float64
+		burst int
+	}{
+		{"zero rate", 0, 5},
+		{"negative rate", -1, 5},
+		{"zero burst", 10, 0},
+		{"negative burst", 10, -3},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			defer func() {
+				if recover() == nil {
+					t.Fatalf("New(%v, %v) did not panic", tc.rate, tc.burst)
+				}
+			}()
+			New(tc.rate, tc.burst, clk)
+		})
+	}
+}
+
+func TestNewWithNilClock(t *testing.T) {
+	l := New(1, 1, nil)
+	if got := l.Tokens(); got != 1 {
+		t.Fatalf("Tokens() = %v, want 1", got)
+	}
+}
+
+func TestStartsFull(t *testing.T) {
+	l, _ := newTestLimiter(1, 5)
+	if got := l.Tokens(); got != 5 {
+		t.Fatalf("Tokens() = %v, want 5", got)
+	}
+}
+
+func TestAllowDrains(t *testing.T) {
+	l, clk := newTestLimiter(1, 3) // 1 token/sec, burst 3
+	for i := 0; i < 3; i++ {
+		if !l.Allow() {
+			t.Fatalf("Allow %d: got false, want true", i+1)
+		}
+	}
+	if l.Allow() {
+		t.Fatal("Allow after burst drained: got true, want false")
+	}
+	clk.Advance(1 * time.Second)
+	if !l.Allow() {
+		t.Fatal("Allow after 1s refill: got false, want true")
+	}
+	if l.Allow() {
+		t.Fatal("second Allow without refill: got true, want false")
+	}
+}
+
+func TestFractionalRefill(t *testing.T) {
+	l, clk := newTestLimiter(10, 1) // 10 tokens/sec
+	l.Allow()
+	if l.Allow() {
+		t.Fatal("immediately after drain: got true, want false")
+	}
+	clk.Advance(100 * time.Millisecond) // +1 token
+	if !l.Allow() {
+		t.Fatal("after 100ms at 10/sec: got false, want true")
+	}
+	clk.Advance(50 * time.Millisecond) // +0.5 token
+	if l.Allow() {
+		t.Fatal("after only 0.5 refilled: got true, want false")
+	}
+}
+
+func TestCapAtBurst(t *testing.T) {
+	l, clk := newTestLimiter(1, 2)
+	clk.Advance(1 * time.Hour)
+	if got := l.Tokens(); got != 2 {
+		t.Fatalf("Tokens() after long idle = %v, want 2 (capped)", got)
+	}
+}
+
+func TestAllowN(t *testing.T) {
+	l, _ := newTestLimiter(1, 3)
+	if !l.AllowN(2) {
+		t.Fatal("AllowN(2) on full bucket: got false, want true")
+	}
+	if !l.AllowN(1) {
+		t.Fatal("AllowN(1) after 2 taken: got false, want true")
+	}
+	if l.AllowN(1) {
+		t.Fatal("AllowN(1) on empty bucket: got true, want false")
+	}
+	if l.AllowN(4) {
+		t.Fatal("AllowN(4) > burst: got true, want false")
+	}
+	if !l.AllowN(0) {
+		t.Fatal("AllowN(0): got false, want true")
+	}
+	if !l.AllowN(-5) {
+		t.Fatal("AllowN(-5): got false, want true")
+	}
+	if got := l.Tokens(); got != 0 {
+		t.Fatalf("Tokens() after AllowN(0/-5) = %v, want 0", got)
+	}
+}
+
+func TestReserve(t *testing.T) {
+	l, _ := newTestLimiter(1, 2)
+	if w := l.Reserve(); w != 0 {
+		t.Fatalf("Reserve with token available: wait = %v, want 0", w)
+	}
+	w := l.Reserve() // 1 token left -> immediate
+	if w != 0 {
+		t.Fatalf("Reserve with 1 token left: wait = %v, want 0", w)
+	}
+	w = l.Reserve() // empty, rate 1/s -> wait 1s
+	if w != 1*time.Second {
+		t.Fatalf("Reserve on empty bucket: wait = %v, want 1s", w)
+	}
+	if got := l.Tokens(); got != -1 {
+		t.Fatalf("Tokens() after overdraw = %v, want -1", got)
+	}
+}
+
+func TestReserveFractionalWait(t *testing.T) {
+	l, clk := newTestLimiter(4, 1) // 4 tokens/sec
+	l.Allow()
+	clk.Advance(150 * time.Millisecond) // 0.6 tokens refilled
+	w := l.Reserve()
+	if w != 100*time.Millisecond { // (1-0.6)/4 = 0.1s
+		t.Fatalf("Reserve wait = %v, want 100ms", w)
+	}
+	// Overdrawn balance means the token is gone.
+	if l.Allow() {
+		t.Fatal("Allow after negative balance: got true, want false")
+	}
+	// The reserved token was consumed, leaving a negative balance: not
+	// immediately available again.
+	clk.Advance(100 * time.Millisecond) // balance back to 0
+	if l.Allow() {
+		t.Fatal("Allow with 0 balance: got true, want false")
+	}
+	// 1.4 more tokens at 4/s (350ms) brings the balance to 1.
+	clk.Advance(250 * time.Millisecond)
+	if got := l.Tokens(); got != 1 {
+		t.Fatalf("Tokens() = %v, want 1", got)
+	}
+	if !l.Allow() {
+		t.Fatal("Allow with 1 token: got false, want true")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	l, _ := newTestLimiter(100, 10)
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		allowed int
+	)
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if l.AllowN(1) {
+				mu.Lock()
+				allowed++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	if allowed != 10 {
+		t.Fatalf("concurrent allowed = %d, want 10 (burst)", allowed)
+	}
+}
