+package ratelimit
+
+import (
+	"sync"
+	"time"
+)
+
+// Limiter is a token-bucket rate limiter. Tokens refill continuously at
+// rate tokens per second, capped at burst. Safe for concurrent use.
+type Limiter struct {
+	rate  float64
+	burst int
+	clk   Clock
+
+	mu     sync.Mutex
+	tokens float64
+	last   time.Time
+}
+
+// New creates a Limiter that adds rate tokens per second, up to burst.
+// The bucket starts full. If clk is nil the real clock is used.
+// It panics if rate <= 0 or burst < 1.
+func New(rate float64, burst int, clk Clock) *Limiter {
+	if rate <= 0 {
+		panic("ratelimit: rate must be positive")
+	}
+	if burst < 1 {
+		panic("ratelimit: burst must be at least 1")
+	}
+	if clk == nil {
+		clk = RealClock
+	}
+	now := clk.Now()
+	return &Limiter{
+		rate:   rate,
+		burst:  burst,
+		clk:    clk,
+		tokens: float64(burst),
+		last:   now,
+	}
+}
+
+// refill adds tokens accumulated since the last operation.
+// Callers must hold l.mu.
+func (l *Limiter) refill(now time.Time) {
+	elapsed := now.Sub(l.last)
+	if elapsed <= 0 {
+		return
+	}
+	l.last = now
+	l.tokens += elapsed.Seconds() * l.rate
+	if l.tokens > float64(l.burst) {
+		l.tokens = float64(l.burst)
+	}
+}
+
+// Allow takes one token if available and reports whether it was allowed.
+func (l *Limiter) Allow() bool {
+	return l.AllowN(1)
+}
+
+// AllowN atomically takes n tokens if all are available.
+// n > burst always returns false; n <= 0 returns true and takes nothing.
+func (l *Limiter) AllowN(n int) bool {
+	if n <= 0 {
+		return true
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if n > l.burst {
+		return false
+	}
+	l.refill(l.clk.Now())
+	if l.tokens >= float64(n) {
+		l.tokens -= float64(n)
+		return true
+	}
+	return false
+}
+
+// Tokens reports the currently available tokens after refilling up to now.
+func (l *Limiter) Tokens() float64 {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.refill(l.clk.Now())
+	return l.tokens
+}
+
+// Reserve takes one token now even if that makes the balance negative and
+// returns how long the caller must wait until that token would have been
+// available (0 if one was available immediately).
+func (l *Limiter) Reserve() time.Duration {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	now := l.clk.Now()
+	l.refill(now)
+	var wait time.Duration
+	if l.tokens < 1 {
+		wait = time.Duration((1 - l.tokens) / l.rate * float64(time.Second))
+	}
+	l.tokens--
+	l.last = now
+	return wait
+}
diff --git a/ratelimit/limiter_test.go b/ratelimit/limiter_test.go
