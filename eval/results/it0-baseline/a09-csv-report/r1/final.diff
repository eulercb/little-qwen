+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func runInput(t *testing.T, args []string, csvText string) (string, error) {
+	t.Helper()
+	var buf bytes.Buffer
+	err := run(args, strings.NewReader(csvText), &buf)
+	return buf.String(), err
+}
+
+func expectError(t *testing.T, args []string, csvText string, substrs ...string) {
+	t.Helper()
+	_, err := runInput(t, args, csvText)
+	if err == nil {
+		t.Fatalf("expected error, got nil")
+	}
+	for _, s := range substrs {
+		if !strings.Contains(err.Error(), s) {
+			t.Fatalf("error %q does not contain %q", err, s)
+		}
+	}
+}
+
+func expectOutput(t *testing.T, args []string, csvText string, want string) {
+	t.Helper()
+	got, err := runInput(t, args, csvText)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got != want {
+		t.Fatalf("output mismatch:\ngot:\n%q\nwant:\n%q", got, want)
+	}
+}
+
+const example = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func TestByRegionExample(t *testing.T) {
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	expectOutput(t, []string{"--by", "region"}, example, want)
+}
+
+func TestDefaultByIsRegion(t *testing.T) {
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	expectOutput(t, nil, example, want)
+}
+
+func TestByEqualsForm(t *testing.T) {
+	expectOutput(t, []string{"--by=region"}, example, "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n")
+}
+
+func TestByProduct(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,apple,1,0.50\nsouth,pear,2,1.00\n"
+	want := "apple\t4\t3.80\npear\t2\t2.00\nTOTAL\t6\t5.80\n"
+	expectOutput(t, []string{"--by", "product"}, csv, want)
+}
+
+func TestShuffledAndExtraColumns(t *testing.T) {
+	csv := "note,price,product,qty,region\nx,1.10,apple,3,north\ny,2.00,pear,1,south\n"
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	expectOutput(t, nil, csv, want)
+}
+
+func TestTiesByNameAscending(t *testing.T) {
+	csv := "region,product,qty,price\nzeta,apple,1,2.00\nalpha,pear,2,1.00\nmid,pear,2,1.00\n"
+	want := "alpha\t2\t2.00\nmid\t2\t2.00\nzeta\t1\t2.00\nTOTAL\t5\t6.00\n"
+	expectOutput(t, nil, csv, want)
+}
+
+func TestZeroQtyAndZeroPrice(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,0,1.00\nsouth,pear,5,0.00\n"
+	want := "north\t0\t0.00\nsouth\t5\t0.00\nTOTAL\t5\t0.00\n"
+	expectOutput(t, nil, csv, want)
+}
+
+func TestTopOne(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+	want := "north\t3\t3.30\nTOTAL\t4\t5.30\n"
+	expectOutput(t, []string{"--by", "region", "--top", "1"}, csv, want)
+}
+
+func TestTopGreaterThanGroupCount(t *testing.T) {
+	csv := example
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	expectOutput(t, []string{"--by", "region", "--top=10"}, csv, want)
+}
+
+func TestMissingColumnMentioned(t *testing.T) {
+	csv := "region,product,qty\nnorth,apple,3\n"
+	expectError(t, nil, csv, "price")
+	expectError(t, nil, "product,qty,price\napple,3,1.00\n", "region")
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,x,2.00\n"
+	expectError(t, nil, csv, "line 3")
+}
+
+func TestNegativeQtyMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,-1,1.10\n"
+	expectError(t, nil, csv, "line 2")
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.005\n"
+	expectError(t, nil, csv, "line 3")
+}
+
+func TestInvalidByValue(t *testing.T) {
+	expectError(t, []string{"--by", "city"}, example, "region or product")
+	expectError(t, []string{"--by=city"}, example, "region or product")
+}
+
+func TestInvalidTop(t *testing.T) {
+	expectError(t, []string{"--top", "0"}, example, "--top")
+	expectError(t, []string{"--top", "-2"}, example, "--top")
+	expectError(t, []string{"--top", "abc"}, example, "--top")
+	expectError(t, []string{"--top"}, example, "--top")
+	expectError(t, []string{"--by"}, example, "--by")
+}
+
+func TestUnknownFlag(t *testing.T) {
+	expectError(t, []string{"--bogus"}, example, "unknown flag")
+}
+
+func TestShortRowMentionsLine(t *testing.T) {
+	csv := "region,product,qty,price\nnorth,apple,3,1.10\nsouth\n"
+	expectError(t, nil, csv, "line 3")
+}
+
+func TestEmptyInputHasNoHeader(t *testing.T) {
+	expectError(t, nil, "", "header")
+}
