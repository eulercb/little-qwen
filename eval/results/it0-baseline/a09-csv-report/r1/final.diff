+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// group aggregates one sales group in integer cents.
+type group struct {
+	name    string
+	qty     int
+	revenue int // cents
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, in io.Reader, out io.Writer) error {
+	by, top, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+
+	header, err := r.Read()
+	if err != nil {
+		return fmt.Errorf("reading header: %v", err)
+	}
+	col := make(map[string]int, len(header))
+	for i, h := range header {
+		h = strings.TrimSpace(h)
+		if _, ok := col[h]; !ok {
+			col[h] = i
+		}
+	}
+	for _, name := range []string{"region", "product", "qty", "price"} {
+		if _, ok := col[name]; !ok {
+			return fmt.Errorf("missing required column: %s", name)
+		}
+	}
+	maxIdx := 0
+	for _, name := range []string{"region", "product", "qty", "price"} {
+		if col[name] > maxIdx {
+			maxIdx = col[name]
+		}
+	}
+
+	keyIdx := col[by]
+	qtyIdx, priceIdx := col["qty"], col["price"]
+
+	groups := make(map[string]*group)
+	totalQty := 0
+	totalRevenue := 0
+	lineNo := 1 // header is line 1
+	for {
+		rec, err := r.Read()
+		lineNo++
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return fmt.Errorf("line %d: %v", lineNo, err)
+		}
+		if len(rec) <= maxIdx {
+			return fmt.Errorf("line %d: expected %d fields, got %d", lineNo, maxIdx+1, len(rec))
+		}
+
+		q, err := parseQty(strings.TrimSpace(rec[qtyIdx]))
+		if err != nil {
+			return fmt.Errorf("line %d: %v", lineNo, err)
+		}
+		cents, err := parseCents(strings.TrimSpace(rec[priceIdx]))
+		if err != nil {
+			return fmt.Errorf("line %d: %v", lineNo, err)
+		}
+
+		key := strings.TrimSpace(rec[keyIdx])
+		g := groups[key]
+		if g == nil {
+			g = &group{name: key}
+			groups[key] = g
+		}
+		g.qty += q
+		g.revenue += cents * q
+		totalQty += q
+		totalRevenue += cents * q
+	}
+
+	names := make([]string, 0, len(groups))
+	for name := range groups {
+		names = append(names, name)
+	}
+	sort.Slice(names, func(i, j int) bool {
+		gi, gj := groups[names[i]], groups[names[j]]
+		if gi.revenue != gj.revenue {
+			return gi.revenue > gj.revenue
+		}
+		return gi.name < gj.name
+	})
+
+	if top > 0 && top < len(names) {
+		names = names[:top]
+	}
+	for _, name := range names {
+		g := groups[name]
+		fmt.Fprintf(out, "%s\t%d\t%.2f\n", g.name, g.qty, float64(g.revenue)/100)
+	}
+	fmt.Fprintf(out, "TOTAL\t%d\t%.2f\n", totalQty, float64(totalRevenue)/100)
+	return nil
+}
+
+func parseFlags(args []string) (by string, top int, err error) {
+	by, top = "region", 0
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case a == "--by":
+			if i+1 >= len(args) {
+				return "", 0, fmt.Errorf("--by requires a value (region or product)")
+			}
+			i++
+			by = args[i]
+		case strings.HasPrefix(a, "--by="):
+			by = strings.TrimPrefix(a, "--by=")
+		case a == "--top":
+			if i+1 >= len(args) {
+				return "", 0, fmt.Errorf("--top requires a value")
+			}
+			i++
+			top, err = parseTop(args[i])
+			if err != nil {
+				return "", 0, err
+			}
+		case strings.HasPrefix(a, "--top="):
+			top, err = parseTop(strings.TrimPrefix(a, "--top="))
+			if err != nil {
+				return "", 0, err
+			}
+		default:
+			return "", 0, fmt.Errorf("unknown flag: %s", a)
+		}
+	}
+	if by != "region" && by != "product" {
+		return "", 0, fmt.Errorf("invalid --by value %q: must be region or product", by)
+	}
+	return by, top, nil
+}
+
+func parseTop(s string) (int, error) {
+	n, err := strconv.Atoi(s)
+	if err != nil || n < 1 {
+		return 0, fmt.Errorf("invalid --top value %q: must be an integer >= 1", s)
+	}
+	return n, nil
+}
+
+// parseQty parses a non-negative integer quantity.
+func parseQty(s string) (int, error) {
+	n, err := strconv.Atoi(s)
+	if err != nil || n < 0 {
+		return 0, fmt.Errorf("invalid qty %q: must be an integer >= 0", s)
+	}
+	return n, nil
+}
+
+// parseCents converts a decimal price with at most 2 decimal places into integer cents.
+func parseCents(s string) (int, error) {
+	neg := strings.HasPrefix(s, "-")
+	if neg || strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	intPart := s
+	decPart := ""
+	if dot := strings.IndexByte(s, '.'); dot >= 0 {
+		intPart, decPart = s[:dot], s[dot+1:]
+	}
+	if intPart == "" && decPart == "" {
+		return 0, fmt.Errorf("invalid price %q", s)
+	}
+	if !isDigits(intPart) {
+		return 0, fmt.Errorf("invalid price %q", s)
+	}
+	if len(decPart) > 2 || !isDigits(decPart) {
+		return 0, fmt.Errorf("invalid price %q: at most 2 decimal places", s)
+	}
+	intVal, _ := strconv.Atoi(intPart)
+	cents := intVal * 100
+	if len(decPart) == 1 {
+		cents += 10 * int(decPart[0]-'0')
+	} else if len(decPart) == 2 {
+		cents += int(decPart[0]-'0')*10 + int(decPart[1]-'0')
+	}
+	if neg {
+		cents = -cents
+	}
+	return cents, nil
+}
+
+func isDigits(s string) bool {
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
