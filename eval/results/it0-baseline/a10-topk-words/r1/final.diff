+// Package words provides word-frequency analysis over text streams.
+package words
+
+import (
+	"bufio"
+	"io"
+	"sort"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// WordCount pairs a word with its number of occurrences.
+type WordCount struct {
+	Word  string
+	Count int
+}
+
+// TopK streams the reader r, counts word occurrences and returns the k most
+// frequent words. Words are maximal runs of Unicode letters or digits,
+// optionally containing an apostrophe between two letters (e.g. "don't");
+// leading and trailing apostrophes are not part of a word. Words are
+// lower-cased with strings.ToLower; words in stop (compared case
+// insensitively) are ignored.
+//
+// The result is ordered by count descending, ties broken by word ascending
+// (byte order). If there are fewer than k distinct words, all of them are
+// returned. k <= 0 returns an empty non-nil slice.
+//
+// The input is processed in a streaming fashion: only one read buffer plus
+// the map of distinct words is held in memory, so arbitrarily large inputs
+// and arbitrarily long lines are handled. Any read error from r is returned.
+func TopK(r io.Reader, k int, stop []string) ([]WordCount, error) {
+	if k <= 0 {
+		return []WordCount{}, nil
+	}
+
+	stopSet := make(map[string]struct{}, len(stop))
+	for _, w := range stop {
+		stopSet[strings.ToLower(w)] = struct{}{}
+	}
+
+	counts := make(map[string]int, 4096)
+	var wordBuf []rune
+	wordActive := false
+	pendingApostrophe := false
+
+	endWord := func() {
+		if !wordActive {
+			return
+		}
+		if pendingApostrophe {
+			// A trailing apostrophe never became an internal one.
+			wordBuf = wordBuf[:len(wordBuf)-1]
+		}
+		wordActive = false
+		pendingApostrophe = false
+		if len(wordBuf) > 0 {
+			w := strings.ToLower(string(wordBuf))
+			if _, isStop := stopSet[w]; !isStop {
+				counts[w]++
+			}
+		}
+		wordBuf = wordBuf[:0]
+	}
+
+	process := func(data []byte) {
+		for len(data) > 0 {
+			rn, size := utf8.DecodeRune(data)
+			data = data[size:]
+			isWordChar := unicode.IsLetter(rn) || unicode.IsDigit(rn)
+			switch {
+			case isWordChar:
+				if !wordActive {
+					wordBuf = wordBuf[:0]
+					wordActive = true
+				} else if pendingApostrophe && !unicode.IsLetter(rn) {
+					// An apostrophe counts only between two letters;
+					// a digit does not confirm it, so the word ends.
+					endWord()
+					wordBuf = wordBuf[:0]
+					wordActive = true
+				} else {
+					pendingApostrophe = false
+				}
+				wordBuf = append(wordBuf, rn)
+			case rn == '\'' && wordActive && !pendingApostrophe &&
+				unicode.IsLetter(wordBuf[len(wordBuf)-1]):
+				// Possibly an internal apostrophe; confirmed only if the
+				// next rune turns out to be a letter.
+				wordBuf = append(wordBuf, rn)
+				pendingApostrophe = true
+			default:
+				endWord()
+			}
+		}
+	}
+
+	const chunkSize = 1 << 20
+	br := bufio.NewReaderSize(r, chunkSize)
+	buf := make([]byte, chunkSize)
+	var tail []byte // a possibly-incomplete trailing UTF-8 sequence
+
+	for {
+		n, rerr := br.Read(buf)
+		if n > 0 {
+			var data []byte
+			if len(tail) > 0 {
+				// Copy into a fresh slice: tail may alias buf, which the
+				// next read would overwrite.
+				data = make([]byte, len(tail)+n)
+				copy(data, tail)
+				copy(data[len(tail):], buf[:n])
+				tail = nil
+			} else {
+				data = buf[:n]
+			}
+			complete, rest := splitComplete(data)
+			if len(rest) > 0 {
+				// Copy: rest may alias buf, which the next read reuses.
+				tail = make([]byte, len(rest))
+				copy(tail, rest)
+			}
+			process(complete)
+		}
+		if rerr == io.EOF {
+			if len(tail) > 0 {
+				process(tail)
+			}
+			break
+		}
+		if rerr != nil {
+			return nil, rerr
+		}
+	}
+	endWord()
+
+	res := make([]WordCount, 0, len(counts))
+	for w, c := range counts {
+		res = append(res, WordCount{Word: w, Count: c})
+	}
+	sort.Slice(res, func(i, j int) bool {
+		if res[i].Count != res[j].Count {
+			return res[i].Count > res[j].Count
+		}
+		return res[i].Word < res[j].Word
+	})
+	if len(res) > k {
+		res = res[:k]
+	}
+	return res, nil
+}
+
+// splitComplete splits data into the longest prefix that consists of complete
+// UTF-8 sequences and the trailing bytes that may be an incomplete final
+// sequence (to be prepended to the next chunk).
+func splitComplete(data []byte) (complete, rest []byte) {
+	for off := len(data) - 1; off >= 0; off-- {
+		b := data[off]
+		if b&0xC0 == 0x80 { // continuation byte: keep looking backwards
+			continue
+		}
+		// b starts a sequence (or is an invalid byte): find its length.
+		expected := 1
+		switch {
+		case b&0x80 == 0:
+			expected = 1
+		case b&0xE0 == 0xC0:
+			expected = 2
+		case b&0xF0 == 0xE0:
+			expected = 3
+		case b&0xF8 == 0xF0:
+			expected = 4
+		}
+		if expected > len(data)-off {
+			return data[:off], data[off:]
+		}
+		return data, nil
+	}
+	return data, nil
+}
