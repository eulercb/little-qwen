+// Package jpath implements a tiny path query language over decoded JSON
+// values (the shapes produced by encoding/json).
+package jpath
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// Query evaluates path against the decoded JSON document doc and returns
+// the matched values. An empty match set yields a non-nil empty slice.
+func Query(doc any, path string) ([]any, error) {
+	steps, err := parsePath(path)
+	if err != nil {
+		return nil, err
+	}
+	cur := []any{doc}
+	for _, st := range steps {
+		cur = apply(cur, st)
+	}
+	return cur, nil
+}
+
+type stepKind int
+
+const (
+	stepMember stepKind = iota
+	stepIndex
+	stepWildcard
+	stepRecurse
+)
+
+type step struct {
+	kind stepKind
+	name string
+	idx  int
+}
+
+func parsePath(path string) ([]step, error) {
+	if len(path) == 0 || path[0] != '$' {
+		return nil, errors.New("jpath: path must start with $")
+	}
+	i := 1
+	var steps []step
+	for i < len(path) {
+		switch path[i] {
+		case '.':
+			if i+1 < len(path) && path[i+1] == '.' {
+				name, j, err := ident(path, i+2)
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, step{kind: stepRecurse, name: name})
+				i = j
+			} else if i+1 < len(path) && path[i+1] == '*' {
+				steps = append(steps, step{kind: stepWildcard})
+				i += 2
+			} else {
+				name, j, err := ident(path, i+1)
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, step{kind: stepMember, name: name})
+				i = j
+			}
+		case '[':
+			st, j, err := bracket(path, i+1)
+			if err != nil {
+				return nil, err
+			}
+			steps = append(steps, st)
+			i = j
+		default:
+			return nil, fmt.Errorf("jpath: unexpected character %q at position %d", path[i], i)
+		}
+	}
+	return steps, nil
+}
+
+// ident parses an identifier [A-Za-z_][A-Za-z0-9_]* at position i; it must
+// match at least one character.
+func ident(s string, i int) (string, int, error) {
+	if i >= len(s) {
+		return "", 0, fmt.Errorf("jpath: expected name at position %d", i)
+	}
+	start := i
+	for i < len(s) {
+		c := s[i]
+		if c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
+			break
+		}
+		return "", 0, fmt.Errorf("jpath: expected name at position %d", i)
+	}
+	for i < len(s) {
+		c := s[i]
+		if c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
+			i++
+		} else {
+			break
+		}
+	}
+	return s[start:i], i, nil
+}
+
+// bracket parses the content of a bracket expression starting at position i
+// (the character right after '[') and returns the parsed step plus the
+// position right after the matching ']'.
+func bracket(s string, i int) (step, int, error) {
+	if i < len(s) && s[i] == '"' {
+		key, j, err := quoted(s, i)
+		if err != nil {
+			return step{}, 0, err
+		}
+		if j >= len(s) || s[j] != ']' {
+			return step{}, 0, errors.New("jpath: missing ] after quoted key")
+		}
+		return step{kind: stepMember, name: key}, j + 1, nil
+	}
+	j := i
+	for j < len(s) && s[j] != ']' {
+		if s[j] == '\\' {
+			// A backslash outside a quoted string is not valid content.
+			return step{}, 0, errors.New("jpath: invalid escape in bracket expression")
+		}
+		j++
+	}
+	if j >= len(s) {
+		return step{}, 0, errors.New("jpath: missing ]")
+	}
+	content := s[i:j]
+	if content == "*" {
+		return step{kind: stepWildcard}, j + 1, nil
+	}
+	n, err := strconv.Atoi(content)
+	if err != nil {
+		return step{}, 0, fmt.Errorf("jpath: invalid index %q", content)
+	}
+	return step{kind: stepIndex, idx: n}, j + 1, nil
+}
+
+// quoted parses a double-quoted string starting at i (s[i] == '"'),
+// supporting \" and \\ escapes.
+func quoted(s string, i int) (string, int, error) {
+	var b strings.Builder
+	i++
+	for i < len(s) {
+		c := s[i]
+		if c == '"' {
+			return b.String(), i + 1, nil
+		}
+		if c == '\\' {
+			if i+1 >= len(s) {
+				return "", 0, errors.New("jpath: unterminated escape in quoted key")
+			}
+			e := s[i+1]
+			if e != '"' && e != '\\' {
+				return "", 0, errors.New("jpath: invalid escape in quoted key")
+			}
+			b.WriteByte(e)
+			i += 2
+			continue
+		}
+		b.WriteByte(c)
+		i++
+	}
+	return "", 0, errors.New("jpath: unterminated quoted key")
+}
+
+func apply(in []any, st step) []any {
+	res := []any{}
+	switch st.kind {
+	case stepMember:
+		for _, n := range in {
+			if m, ok := n.(map[string]any); ok {
+				if v, ok := m[st.name]; ok {
+					res = append(res, v)
+				}
+			}
+		}
+	case stepIndex:
+		for _, n := range in {
+			arr, ok := n.([]any)
+			if !ok {
+				continue
+			}
+			i := st.idx
+			if i < 0 {
+				i += len(arr)
+			}
+			if i >= 0 && i < len(arr) {
+				res = append(res, arr[i])
+			}
+		}
+	case stepWildcard:
+		for _, n := range in {
+			switch v := n.(type) {
+			case []any:
+				res = append(res, v...)
+			case map[string]any:
+				res = append(res, objectValues(v)...)
+			}
+		}
+	case stepRecurse:
+		for _, n := range in {
+			res = append(res, recurse(n, st.name)...)
+		}
+	}
+	return res
+}
+
+// objectValues returns the object's values ordered by key ascending.
+func objectValues(m map[string]any) []any {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	vals := make([]any, 0, len(keys))
+	for _, k := range keys {
+		vals = append(vals, m[k])
+	}
+	return vals
+}
+
+// recurse collects the `name` member of node and of every descendant, in
+// pre-order (a node's own match first, then its children; object children
+// ordered by key, array children in order).
+func recurse(node any, name string) []any {
+	res := []any{}
+	switch v := node.(type) {
+	case map[string]any:
+		if m, ok := v[name]; ok {
+			res = append(res, m)
+		}
+		for _, child := range objectValues(v) {
+			res = append(res, recurse(child, name)...)
+		}
+	case []any:
+		for _, child := range v {
+			res = append(res, recurse(child, name)...)
+		}
+	}
+	return res
+}
