+			}
+			return out[i].ID < out[j].ID
+		})
 	default:
 		return nil, fmt.Errorf("unknown sort key %q", o.SortBy)
 	}
 	return out, nil
 }
+
+func hasAllTags(t model.Task, want []string) bool {
+	have := make(map[string]bool, len(t.Tags))
+	for _, tag := range t.Tags {
+		have[tag] = true
+	}
+	for _, tag := range want {
+		if !have[tag] {
+			return false
+		}
+	}
+	return true
+}
