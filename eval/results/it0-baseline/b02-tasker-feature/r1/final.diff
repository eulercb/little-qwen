+func TestVersionMigration(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "v1.json")
+	v1 := `{"version":1,"next_id":2,"tasks":[{"id":1,"title":"a","priority":2,"done":false,"created":"2026-01-02T00:00:00Z"}]}`
+	if err := os.WriteFile(p, []byte(v1), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(p)
+	if err != nil {
+		t.Fatalf("version-1 file must load: %v", err)
+	}
+	all := s.All()
+	if len(all) != 1 || all[0].Title != "a" || all[0].Due != nil || len(all[0].Tags) != 0 {
+		t.Fatalf("version-1 task not loaded as-is: %+v", all)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := os.ReadFile(p)
+	if !strings.Contains(string(data), `"version": 2`) {
+		t.Fatalf("saved file must be version 2: %s", data)
+	}
+}
