+// tagRe matches a normalised tag.
+var tagRe = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)
+
+// NormalizeTags trims and lower-cases each tag, de-duplicates and sorts
+// them. It returns ErrBadTag if any tag does not match
+// ^[a-z0-9][a-z0-9-]*$ after normalisation.
+func NormalizeTags(tags []string) ([]string, error) {
+	seen := make(map[string]bool)
+	var out []string
+	for _, tag := range tags {
+		tag = strings.ToLower(strings.TrimSpace(tag))
+		if !tagRe.MatchString(tag) {
+			return nil, ErrBadTag
+		}
+		if !seen[tag] {
+			seen[tag] = true
+			out = append(out, tag)
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
