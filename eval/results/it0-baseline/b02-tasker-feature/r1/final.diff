+package cli
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tasker/internal/model"
+)
+
+func TestFormatTask(t *testing.T) {
+	due := time.Date(2026, 4, 15, 0, 0, 0, 0, time.UTC)
+	cases := []struct {
+		task model.Task
+		want string
+	}{
+		{model.Task{ID: 1, Title: "plain", Priority: 3}, "#1 [ ] P3 plain"},
+		{model.Task{ID: 2, Title: "tagged", Priority: 1, Tags: []string{"home", "money"}}, "#2 [ ] P1 tagged [home,money]"},
+		{model.Task{ID: 4, Title: "file taxes", Priority: 2, Due: &due, Tags: []string{"home", "money"}},
+			"#4 [ ] P2 file taxes (due 2026-04-15) [home,money]"},
+		{model.Task{ID: 5, Title: "done", Priority: 2, Done: true, Due: &due},
+			"#5 [x] P2 done (due 2026-04-15)"},
+	}
+	for _, c := range cases {
+		if got := FormatTask(c.task); got != c.want {
+			t.Errorf("FormatTask: %q, want %q", got, c.want)
+		}
+	}
+}
+
+func TestAddTagDue(t *testing.T) {
+	h := newHarness(t) // now = 2026-03-10
+	out, _, code := h.run("add", "-p", "2", "--tag", "HOME", "--tag", "home", "--due=2026-04-15", "file", "taxes")
+	if code != 0 || out != "added #1\n" {
+		t.Fatalf("%q %d", out, code)
+	}
+	if out, _, _ := h.run("list"); out != "#1 [ ] P2 file taxes (due 2026-04-15) [home]\n" {
+		t.Fatalf("list: %q", out)
+	}
+	// usage errors, exit 2
+	if _, _, code := h.run("add", "--due", "2026-13-01", "x"); code != 2 {
+		t.Fatalf("bad due date must be usage error, got %d", code)
+	}
+	if _, _, code := h.run("add", "--due", "not-a-date", "x"); code != 2 {
+		t.Fatalf("unparseable due must be usage error, got %d", code)
+	}
+	if _, _, code := h.run("add", "--tag", "Bad Tag", "x"); code != 2 {
+		t.Fatalf("bad tag must be usage error, got %d", code)
+	}
+	if _, _, code := h.run("add", "--flag", "x"); code != 2 {
+		t.Fatalf("unknown flag must be usage error, got %d", code)
+	}
+}
+
+func TestListFilters(t *testing.T) {
+	h := newHarness(t) // now = 2026-03-10
+	h.run("add", "--tag", "home", "--tag", "money", "--due", "2026-04-15", "file", "taxes")
+	h.run("add", "--tag=home", "--due=2026-03-09", "water", "plants")
+	h.run("add", "--tag", "work", "write", "report")
+	h.run("done", "1")
+
+	out, _, code := h.run("list")
+	want := "#2 [ ] P3 water plants (due 2026-03-09) [home]\n#3 [ ] P3 write report [work]\n"
+	if code != 0 || out != want {
+		t.Fatalf("list: %q %d", out, code)
+	}
+	// --tag (repeatable, ALL must match; done tasks hidden)
+	if out, _, _ = h.run("list", "--tag", "home"); out != "#2 [ ] P3 water plants (due 2026-03-09) [home]\n" {
+		t.Fatalf("list --tag: %q", out)
+	}
+	if out, _, _ = h.run("list", "--tag=home", "--tag", "money"); out != "" {
+		t.Fatalf("list --tag x2: %q", out)
+	}
+	if out, _, _ = h.run("list", "--tag", "HOME", "--tag", "money", "--all"); out != "#1 [x] P3 file taxes (due 2026-04-15) [home,money]\n" {
+		t.Fatalf("list --tag x2 --all (case-insensitive): %q", out)
+	}
+	// --overdue: strictly before 2026-03-10, not done
+	if out, _, _ = h.run("list", "--overdue"); out != "#2 [ ] P3 water plants (due 2026-03-09) [home]\n" {
+		t.Fatalf("list --overdue: %q", out)
+	}
+	if out, _, _ = h.run("list", "--overdue", "--all"); out != "#2 [ ] P3 water plants (due 2026-03-09) [home]\n" {
+		t.Fatalf("list --overdue --all: %q", out)
+	}
+	// --sort due: due dates ascending, no due last, ties by ID
+	out, _, _ = h.run("list", "--all", "--sort", "due")
+	want = "#2 [ ] P3 water plants (due 2026-03-09) [home]\n#1 [x] P3 file taxes (due 2026-04-15) [home,money]\n#3 [ ] P3 write report [work]\n"
+	if out != want {
+		t.Fatalf("list --sort due: %q", out)
+	}
+}
+
+func TestEditTagsDue(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "home", "--due", "2026-03-09", "x")
+	out, _, code := h.run("edit", "1", "--tag", "money", "--untag", "home", "--due", "none")
+	if code != 0 || out != "updated #1\n" {
+		t.Fatalf("%q %d", out, code)
+	}
+	if out, _, _ = h.run("list"); out != "#1 [ ] P3 x [money]\n" {
+		t.Fatalf("list after edit: %q", out)
+	}
+	// untag of a missing tag is fine
+	if _, _, code := h.run("edit", "1", "--untag", "nope"); code != 0 {
+		t.Fatalf("untag missing: %d", code)
+	}
+	// setting and clearing the due date
+	if _, _, code := h.run("edit", "1", "--due=2026-05-01"); code != 0 {
+		t.Fatalf("edit --due: %d", code)
+	}
+	if out, _, _ := h.run("list"); out != "#1 [ ] P3 x (due 2026-05-01) [money]\n" {
+		t.Fatalf("list after due: %q", out)
+	}
+	if _, _, code := h.run("edit", "1", "--due", "bogus"); code != 2 {
+		t.Fatalf("bad due on edit must be usage error, got %d", code)
+	}
+	if _, _, code := h.run("edit", "1", "--tag", "Bad Tag"); code != 2 {
+		t.Fatalf("bad tag on edit must be usage error, got %d", code)
+	}
+}
+
+func TestTagsCommand(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "home", "--tag", "money", "a")
+	h.run("add", "--tag", "home", "b")
+	h.run("add", "--tag", "work", "c")
+	h.run("done", "3")
+	out, _, code := h.run("tags")
+	if code != 0 || out != "home 2\nmoney 1\n" {
+		t.Fatalf("tags: %q %d", out, code)
+	}
+	if _, _, code := h.run("tags", "--all"); code != 2 {
+		t.Fatalf("tags takes no arguments: %d", code)
+	}
+}
+
+func TestUsageMessageMentionsTags(t *testing.T) {
+	h := newHarness(t)
+	_, err, code := h.run()
+	if code != 2 || !strings.Contains(err, "tags") {
+		t.Fatalf("code %d, stderr %q", code, err)
+	}
+}
