@@ -0,0 +1,34 @@
+package server
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"example.com/kv/proto"
+	"example.com/kv/store"
+)
+
+func TestDebug(t *testing.T) {
+	l, _ := net.Listen("tcp", "127.0.0.1:0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s := store.New(nil)
+	go Serve(ctx, l, s)
+	c, _ := net.Dial("tcp", l.Addr().String())
+	br := bufio.NewReader(c)
+	go func() {
+		for i := 0; i < 6; i++ {
+			time.Sleep(500 * time.Millisecond)
+			c.Write([]byte("PING\n"))
+			c.SetReadDeadline(time.Now().Add(3 * time.Second))
+			line, err := br.ReadString('\n')
+			t.Logf("read: %q err=%v", line, err)
+		}
+	}()
+	time.Sleep(3 * time.Second)
+	// direct Exec for sanity
+	t.Logf("direct: %q", proto.Exec(s, "GET x"))
+}
diff --git a/server/server.go b/server/server.go
new file mode 100644
index 0000000..2018a04
--- /dev/null
+++ b/server/server.go
@@ -0,0 +1,144 @@
+// Package server serves the line protocol over TCP connections.
+package server
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"strings"
+	"sync"
+
+	"example.com/kv/proto"
+	"example.com/kv/store"
+)
+
+// maxLineBytes is the maximum request line length; longer lines are an
+// error and the connection is closed.
+const maxLineBytes = 64 * 1024
+
+// Serve accepts TCP connections on l and serves the protocol against s
+// until ctx is cancelled. On cancellation it closes the listener, closes
+// open connections, waits for the connection goroutines to finish and
+// returns nil.
+func Serve(ctx context.Context, l net.Listener, s *store.Store) error {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	var (
+		wg    sync.WaitGroup
+		mu    sync.Mutex
+		conns = make(map[net.Conn]struct{})
+	)
+
+	accepted := make(chan struct{})
+	go func() {
+		defer close(accepted)
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			conns[c] = struct{}{}
+			mu.Unlock()
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				serveConn(ctx, c, s)
+				mu.Lock()
+				delete(conns, c)
+				mu.Unlock()
+			}()
+		}
+	}()
+
+	<-ctx.Done()
+	l.Close()
+	mu.Lock()
+	for c := range conns {
+		c.Close()
+	}
+	mu.Unlock()
+	wg.Wait()
+	<-accepted
+	return nil
+}
+
+// serveConn serves a single connection until the peer closes it, the
+// connection errors, QUIT is received or ctx is cancelled. It always
+// closes the connection on return.
+func serveConn(ctx context.Context, c net.Conn, s *store.Store) {
+	defer c.Close()
+	br := bufio.NewReaderSize(c, 8*1024)
+	w := bufio.NewWriterSize(c, 8*1024)
+	for {
+		line, over, ok := readLine(br)
+		if !ok {
+			return
+		}
+		if over {
+			if _, err := w.WriteString("-ERR line too long\n"); err != nil {
+				return
+			}
+			if err := w.Flush(); err != nil {
+				return
+			}
+			return
+		}
+		if isQuit(line) {
+			if _, err := w.WriteString("+BYE\n"); err != nil {
+				return
+			}
+			if err := w.Flush(); err != nil {
+				return
+			}
+			return
+		}
+		if _, err := w.WriteString(proto.Exec(s, line)); err != nil {
+			return
+		}
+		if err := w.Flush(); err != nil {
+			return
+		}
+		if ctx.Err() != nil {
+			return
+		}
+	}
+}
+
+// readLine reads one '\n'-terminated line (a trailing '\r' is stripped).
+// ok is false if the connection closed or errored. over is true if the
+// line exceeded maxLineBytes; the remainder of the line is still drained.
+func readLine(br *bufio.Reader) (line string, over, ok bool) {
+	var buf []byte
+	for {
+		b, err := br.ReadByte()
+		if err != nil {
+			return "", false, false
+		}
+		if b == '\n' {
+			break
+		}
+		if len(buf) < maxLineBytes {
+			buf = append(buf, b)
+		} else {
+			over = true
+		}
+	}
+	line = string(buf)
+	if strings.HasSuffix(line, "\r") {
+		line = line[:len(line)-1]
+	}
+	return line, over, true
+}
+
+// isQuit reports whether the (non-empty, non-too-long) line is a QUIT
+// command, matching the first token case-insensitively.
+func isQuit(line string) bool {
+	for i := 0; i < len(line); i++ {
+		if line[i] == ' ' || line[i] == '\t' {
+			return strings.ToLower(line[:i]) == "quit"
+		}
+	}
+	return strings.ToLower(line) == "quit"
+}
