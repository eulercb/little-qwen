+package proto
+
+import (
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+type fakeClock struct{ now time.Time }
+
+func (c *fakeClock) tick() time.Time { return c.now }
+func (c *fakeClock) advance(d time.Duration) { c.now = c.now.Add(d) }
+
+func newTest(t *testing.T) (*store.Store, *fakeClock) {
+	t.Helper()
+	cl := &fakeClock{now: time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)}
+	return store.New(cl.tick), cl
+}
+
+func expect(t *testing.T, s *store.Store, line, want string) {
+	t.Helper()
+	got := Exec(s, line)
+	if got != want {
+		t.Errorf("Exec(%q) = %q, want %q", line, got, want)
+	}
+}
+
+func TestPing(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "PING", "+PONG\n")
+	expect(t, s, "ping", "+PONG\n")
+	expect(t, s, "PING\n", "+PONG\n")
+	expect(t, s, "PING\r\n", "+PONG\n")
+	expect(t, s, "PING extra", "-ERR wrong number of arguments for 'ping'\n")
+}
+
+func TestSetGet(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "SET k v", "+OK\n")
+	expect(t, s, "GET k", "$v\n")
+	expect(t, s, "GET missing", "$nil\n")
+	expect(t, s, "get k", "$v\n")
+	expect(t, s, "GET k extra", "-ERR wrong number of arguments for 'get'\n")
+	expect(t, s, "SET onlykey", "-ERR wrong number of arguments for 'set'\n")
+}
+
+func TestQuoting(t *testing.T) {
+	s, _ := newTest(t)
+	// Values written bare when they need no quoting.
+	expect(t, s, `SET a b`, "+OK\n")
+	expect(t, s, "GET a", "$b\n")
+	// Quoted input.
+	expect(t, s, `SET a "hello world"`, "+OK\n")
+	expect(t, s, "GET a", `$"hello world"\n`)
+	// Empty value round-trips as $""
+	expect(t, s, `SET a ""`, "+OK\n")
+	expect(t, s, "GET a", `$""\n`)
+	// Quote, backslash and newline escapes.
+	expect(t, s, `SET a "x\"y"`, "+OK\n")
+	expect(t, s, "GET a", `$"x\"y"\n`)
+	expect(t, s, `SET a "x\\y"`, "+OK\n")
+	expect(t, s, "GET a", `$"x\\y"\n`)
+	expect(t, s, `SET a "x\ny"`, "+OK\n")
+	expect(t, s, "GET a", `$"x\ny"\n`)
+	// Tab triggers quoting (the literal tab is preserved inside quotes).
+	expect(t, s, "SET a \"x\\ty\"", "+OK\n")
+	expect(t, s, "GET a", `$"x\\ty"\n`) // \ and t are literal in the value
+}
+
+func TestTabValue(t *testing.T) {
+	s, _ := newTest(t)
+	// A literal tab inside quotes is stored verbatim.
+	expect(t, s, "SET a \"x\t\"", "+OK\n")
+	expect(t, s, "GET a", `$"x`+"\t"+`"\n`)
+	// A value with a space in a key.
+	expect(t, s, `SET "my key" v`, "+OK\n")
+	expect(t, s, `GET "my key"`, "$v\n")
+	expect(t, s, "GET my", "$nil\n")
+}
+
+func TestTokenising(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "SET\ta\tb", "+OK\n")
+	expect(t, s, "GET  a   ", "$b\n")
+	expect(t, s, "   ", "-ERR empty command\n")
+	expect(t, s, "", "-ERR empty command\n")
+	expect(t, s, `SET k "unterminated`, "-ERR syntax error\n")
+	expect(t, s, `SET k "a" b`, "-ERR wrong number of arguments for 'set'\n")
+}
+
+func TestSetEX(t *testing.T) {
+	s, cl := newTest(t)
+	expect(t, s, "SET k v EX 5", "+OK\n")
+	expect(t, s, "TTL k", ":5\n")
+	cl.advance(1200 * time.Millisecond)
+	expect(t, s, "TTL k", ":4\n") // 3.8s remaining rounds up
+	expect(t, s, "SET k v EX -1", "-ERR syntax error\n")
+	expect(t, s, "SET k v EX zero", "-ERR value is not an integer\n")
+	expect(t, s, "SET k v EX", "-ERR wrong number of arguments for 'set'\n")
+	expect(t, s, "SET k v XX 5", "-ERR syntax error\n")
+	expect(t, s, "SET k v ex 5", "+OK\n") // option is case-insensitive
+}
+
+func TestDelExistsExpirePersist(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "SET a 1", "+OK\n")
+	expect(t, s, "SET b 2", "+OK\n")
+	expect(t, s, "SET c 3", "+OK\n")
+	expect(t, s, "DEL a b c", ":3\n")
+	expect(t, s, "DEL a", ":0\n")
+	expect(t, s, "DEL", "-ERR wrong number of arguments for 'del'\n")
+	expect(t, s, "SET a 1", "+OK\n")
+	expect(t, s, "EXISTS a", ":1\n")
+	expect(t, s, "EXISTS b", ":0\n")
+	expect(t, s, "EXISTS a b", "-ERR wrong number of arguments for 'exists'\n")
+	expect(t, s, "EXPIRE a 10", ":1\n")
+	expect(t, s, "EXPIRE b 10", ":0\n")
+	expect(t, s, "EXPIRE a", "-ERR wrong number of arguments for 'expire'\n")
+	expect(t, s, "EXPIRE a x", "-ERR value is not an integer\n")
+	expect(t, s, "PERSIST a", ":1\n")
+	expect(t, s, "PERSIST a", ":0\n")
+	expect(t, s, "PERSIST b", ":0\n")
+}
+
+func TestTTL(t *testing.T) {
+	s, cl := newTest(t)
+	expect(t, s, "TTL missing", ":-2\n")
+	expect(t, s, "SET a 1", "+OK\n")
+	expect(t, s, "TTL a", ":-1\n")
+	expect(t, s, "SET a 1 EX 5", "+OK\n")
+	expect(t, s, "TTL a", ":5\n")
+	cl.advance(1200 * time.Millisecond)
+	expect(t, s, "TTL a", ":4\n") // 3.8s remaining -> rounded up to 4
+	cl.advance(400 * time.Millisecond) // 3.4s remaining
+	expect(t, s, "TTL a", ":4\n")
+}
+
+func TestIncr(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "INCR n", ":1\n")
+	expect(t, s, "INCR n", ":2\n")
+	expect(t, s, "INCRBY n 3", ":5\n")
+	expect(t, s, "INCRBY n -5", ":0\n")
+	expect(t, s, "SET x foo", "+OK\n")
+	expect(t, s, "INCR x", "-ERR value is not an integer\n")
+	expect(t, s, "INCRBY x 2", "-ERR value is not an integer\n")
+	expect(t, s, "INCRBY x 1.5", "-ERR value is not an integer\n")
+	expect(t, s, "INCR x y", "-ERR wrong number of arguments for 'incr'\n")
+	expect(t, s, "INCRBY x", "-ERR wrong number of arguments for 'incrby'\n")
+}
+
+func TestKeys(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "SET a 1", "+OK\n")
+	expect(t, s, "SET ab 2", "+OK\n")
+	expect(t, s, "SET c 3", "+OK\n")
+	expect(t, s, "KEYS *", "*3\n$a\n$ab\n$c\n")
+	expect(t, s, "KEYS a?", "*1\n$ab\n")
+	expect(t, s, "KEYS z*", "*0\n")
+	expect(t, s, "KEYS", "-ERR wrong number of arguments for 'keys'\n")
+}
+
+func TestDBSize(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "DBSIZE", ":0\n")
+	expect(t, s, "SET a 1", "+OK\n")
+	expect(t, s, "SET b 2", "+OK\n")
+	expect(t, s, "DBSIZE", ":2\n")
+	expect(t, s, "DBSIZE x", "-ERR wrong number of arguments for 'dbsize'\n")
+}
+
+func TestErrors(t *testing.T) {
+	s, _ := newTest(t)
+	expect(t, s, "FOO", "-ERR unknown command 'FOO'\n")
+	expect(t, s, "foo bar", "-ERR unknown command 'foo'\n")
+	expect(t, s, `GET "a b" c`, "-ERR wrong number of arguments for 'get'\n")
+}
