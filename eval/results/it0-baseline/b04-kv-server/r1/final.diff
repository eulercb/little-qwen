index 0000000..fff12e2
--- /dev/null
+++ b/proto/proto.go
@@ -0,0 +1,249 @@
+// Package proto implements the line protocol: it parses one request line
+// and renders one response, both as single lines of text.
+package proto
+
+import (
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// Exec parses one request line against store s and returns the full
+// response, including the trailing newline.
+func Exec(s *store.Store, line string) string {
+	line = strings.TrimSuffix(line, "\n")
+	line = strings.TrimSuffix(line, "\r")
+	toks, ok := tokenize(line)
+	if !ok {
+		return "-ERR syntax error\n"
+	}
+	if len(toks) == 0 {
+		return "-ERR empty command\n"
+	}
+	name := toks[0]
+	args := toks[1:]
+	switch strings.ToLower(name) {
+	case "ping":
+		if len(args) != 0 {
+			return wrongArgs("ping")
+		}
+		return "+PONG\n"
+	case "set":
+		if len(args) != 2 && len(args) != 4 {
+			return wrongArgs("set")
+		}
+		var ttl time.Duration
+		if len(args) == 4 {
+			if strings.ToLower(args[2]) != "ex" {
+				return "-ERR syntax error\n"
+			}
+			sec, err := strconv.ParseInt(args[3], 10, 64)
+			if err != nil {
+				return "-ERR value is not an integer\n"
+			}
+			if sec <= 0 {
+				return "-ERR syntax error\n"
+			}
+			ttl = time.Duration(sec) * time.Second
+		}
+		s.Set(args[0], args[1], ttl)
+		return "+OK\n"
+	case "get":
+		if len(args) != 1 {
+			return wrongArgs("get")
+		}
+		if v, ok := s.Get(args[0]); ok {
+			return stringResp(v)
+		}
+		return "$nil\n"
+	case "del":
+		if len(args) < 1 {
+			return wrongArgs("del")
+		}
+		return ":" + strconv.Itoa(s.Del(args...)) + "\n"
+	case "exists":
+		if len(args) != 1 {
+			return wrongArgs("exists")
+		}
+		return boolInt(s.Exists(args[0]))
+	case "expire":
+		if len(args) != 2 {
+			return wrongArgs("expire")
+		}
+		sec, err := strconv.ParseInt(args[1], 10, 64)
+		if err != nil {
+			return "-ERR value is not an integer\n"
+		}
+		return boolInt(s.Expire(args[0], time.Duration(sec)*time.Second))
+	case "persist":
+		if len(args) != 1 {
+			return wrongArgs("persist")
+		}
+		return boolInt(s.Persist(args[0]))
+	case "ttl":
+		if len(args) != 1 {
+			return wrongArgs("ttl")
+		}
+		d := s.TTL(args[0])
+		if d < 0 {
+			return ":" + strconv.FormatInt(int64(d), 10) + "\n"
+		}
+		sec := (int64(d) + int64(time.Second) - 1) / int64(time.Second)
+		return ":" + strconv.FormatInt(sec, 10) + "\n"
+	case "incr":
+		if len(args) != 1 {
+			return wrongArgs("incr")
+		}
+		return incrResp(s, args[0], 1)
+	case "incrby":
+		if len(args) != 2 {
+			return wrongArgs("incrby")
+		}
+		n, err := strconv.ParseInt(args[1], 10, 64)
+		if err != nil {
+			return "-ERR value is not an integer\n"
+		}
+		return incrResp(s, args[0], n)
+	case "keys":
+		if len(args) != 1 {
+			return wrongArgs("keys")
+		}
+		keys := s.Keys(args[0])
+		var b strings.Builder
+		b.WriteString("*")
+		b.WriteString(strconv.Itoa(len(keys)))
+		b.WriteByte('\n')
+		for _, k := range keys {
+			b.WriteString(stringResp(k))
+		}
+		return b.String()
+	case "dbsize":
+		if len(args) != 0 {
+			return wrongArgs("dbsize")
+		}
+		return ":" + strconv.Itoa(s.Len()) + "\n"
+	default:
+		return "-ERR unknown command '" + name + "'\n"
+	}
+}
+
+func wrongArgs(name string) string {
+	return "-ERR wrong number of arguments for '" + strings.ToLower(name) + "'\n"
+}
+
+func boolInt(b bool) string {
+	if b {
+		return ":1\n"
+	}
+	return ":0\n"
+}
+
+func incrResp(s *store.Store, key string, by int64) string {
+	v, err := s.Incr(key, by)
+	if err != nil {
+		return "-ERR value is not an integer\n"
+	}
+	return ":" + strconv.FormatInt(v, 10) + "\n"
+}
+
+// stringResp renders a bulk-string response. Values containing a space,
+// tab, '"', '\', newline, or empty values are written double-quoted with
+// escapes; otherwise they are written bare.
+func stringResp(v string) string {
+	if v == "" {
+		return `$""\n`
+	}
+	if !needsQuoting(v) {
+		return "$" + v + "\n"
+	}
+	var b strings.Builder
+	b.WriteString(`$"`)
+	for i := 0; i < len(v); i++ {
+		switch c := v[i]; c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteString(`"\n`)
+	return b.String()
+}
+
+func needsQuoting(v string) bool {
+	for i := 0; i < len(v); i++ {
+		switch v[i] {
+		case ' ', '\t', '"', '\\', '\n':
+			return true
+		}
+	}
+	return false
+}
+
+// tokenize splits a request line into tokens. Tokens are separated by one
+// or more spaces/tabs. A token may be double-quoted; inside quotes the
+// escapes \" \\ and \n are supported and all other characters are literal.
+// An unterminated quote makes ok false.
+func tokenize(line string) ([]string, bool) {
+	var toks []string
+	var cur strings.Builder
+	inToken := false
+	i := 0
+	for i < len(line) {
+		c := line[i]
+		switch {
+		case c == ' ' || c == '\t':
+			if inToken {
+				toks = append(toks, cur.String())
+				cur.Reset()
+				inToken = false
+			}
+			i++
+		case c == '"' && !inToken:
+			i++ // skip the opening quote
+			var b strings.Builder
+			terminated := false
+			for i < len(line) {
+				q := line[i]
+				if q == '\\' && i+1 < len(line) {
+					switch line[i+1] {
+					case '"', '\\':
+						b.WriteByte(line[i+1])
+					case 'n':
+						b.WriteByte('\n')
+					default:
+						b.WriteByte('\\')
+						b.WriteByte(line[i+1])
+					}
+					i += 2
+					continue
+				}
+				if q == '"' {
+					i++
+					terminated = true
+					break
+				}
+				b.WriteByte(q)
+				i++
+			}
+			if !terminated {
+				return nil, false
+			}
+			toks = append(toks, b.String())
+		default:
+			inToken = true
+			cur.WriteByte(c)
+			i++
+		}
+	}
+	if inToken {
+		toks = append(toks, cur.String())
+	}
+	return toks, true
+}
