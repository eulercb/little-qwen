+func TestConcurrent(t *testing.T) {
+	s, _ := newTestStore(t)
+	done := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			defer func() { done <- struct{}{} }()
+			key := "k"
+			if i%2 == 1 {
+				key = "n"
+			}
+			for j := 0; j < 100; j++ {
+				s.Set(key, "v", time.Second)
+				s.Get(key)
+				s.Exists(key)
+				s.Del(key)
+				s.Incr("n", 1)
+				s.Keys("*")
+				s.Len()
+				s.TTL(key)
+			}
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+}
