+func TestKeysGlob(t *testing.T) {
+	s, _ := newTestStore(t)
+	for _, k := range []string{"user1", "user2", "admin", "user/foo", "a/b/c"} {
+		s.Set(k, "v", 0)
+	}
+	check := func(pattern string, want ...string) {
+		t.Helper()
+		got := s.Keys(pattern)
+		if len(got) != len(want) {
+			t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+			}
+		}
+	}
+	check("*", "a/b/c", "admin", "user/foo", "user1", "user2")
+	check("user*", "user/foo", "user1", "user2") // * matches '/'
+	check("user?", "user1", "user2")
+	check("u*1", "user1")
+	check("ad[mi]in", "admin")
+	check("user[0-9]", "user1", "user2")
+	check("user[^/x]", "user1", "user2")
+	check("user[!/x]", "user1", "user2")
+	check("a/b/c", "a/b/c")
+	check("a\\/b\\/c", "a/b/c")
+	check("user\\/*", "user/foo")
+	check("a/*/c", "a/b/c")
+	check("nope*", )
+	check("", )
+}
