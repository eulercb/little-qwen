+package server
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// start begins a server on a fresh port. It returns the address, a cancel
+// function and a channel that receives Serve's return value.
+func start(t *testing.T) (string, context.CancelFunc, <-chan error) {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	errc := make(chan error, 1)
+	go func() { errc <- Serve(ctx, l, store.New(nil)) }()
+	return l.Addr().String(), cancel, errc
+}
+
+// client is a test-side protocol client with a persistent reader.
+type client struct {
+	c  net.Conn
+	br *bufio.Reader
+}
+
+func dial(t *testing.T, addr string) *client {
+	t.Helper()
+	c, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.SetDeadline(time.Now().Add(10 * time.Second))
+	return &client{c: c, br: bufio.NewReader(c)}
+}
+
+// expectLine writes req (which must end with '\n') and checks the full
+// response.
+func expectLine(t *testing.T, cl *client, req, want string) {
+	t.Helper()
+	cl.c.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := cl.c.Write([]byte(req)); err != nil {
+		t.Fatalf("write %q: %v", req, err)
+	}
+	got, err := readResponse(t, cl)
+	if err != nil {
+		t.Fatalf("read response to %q: %v", req, err)
+	}
+	if got != want {
+		t.Fatalf("response to %q = %q, want %q", req, got, want)
+	}
+}
+
+// readResponse reads a full response (an array spans multiple lines).
+func readResponse(t *testing.T, cl *client) (string, error) {
+	t.Helper()
+	first, err := cl.br.ReadString('\n')
+	if err != nil {
+		return "", err
+	}
+	out := first
+	if strings.HasPrefix(first, "*") {
+		var n int
+		if _, err := fmt.Sscanf(first, "*%d", &n); err != nil {
+			return "", err
+		}
+		for i := 0; i < n; i++ {
+			line, err := cl.br.ReadString('\n')
+			if err != nil {
+				return "", err
+			}
+			out += line
+		}
+	}
+	return out, nil
+}
+
+// expectClosed verifies that the server side of the connection is closed
+// (no further data, and eventually an error).
+func expectClosed(t *testing.T, cl *client) {
+	t.Helper()
+	cl.c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	buf := make([]byte, 1)
+	for {
+		n, err := cl.c.Read(buf)
+		if err != nil {
+			return
+		}
+		if n > 0 {
+			t.Fatal("expected connection close, got data")
+		}
+	}
+}
+
+func TestServeRoundTrip(t *testing.T) {
+	addr, _, _ := start(t)
+	cl := dial(t, addr)
+	expectLine(t, cl, "PING\n", "+PONG\n")
+	expectLine(t, cl, "PING\r\n", "+PONG\n")
+	expectLine(t, cl, "SET hello \"world wide web\"\n", "+OK\n")
+	expectLine(t, cl, "GET hello\n", `$"world wide web"\n`)
+	expectLine(t, cl, "DBSIZE\n", ":1\n")
+	expectLine(t, cl, "KEYS *\n", "*1\n$hello\n")
+	expectLine(t, cl, "QUIT\n", "+BYE\n")
+	// The server must have closed the connection.
+	expectClosed(t, cl)
+}
+
+func TestServeMultipleClients(t *testing.T) {
+	addr, _, _ := start(t)
+	c1 := dial(t, addr)
+	c2 := dial(t, addr)
+	expectLine(t, c1, "SET a 1\n", "+OK\n")
+	expectLine(t, c2, "GET a\n", "$1\n")
+	expectLine(t, c1, "QUIT\n", "+BYE\n")
+	// The other client keeps working.
+	expectLine(t, c2, "PING\n", "+PONG\n")
+	expectLine(t, c2, "QUIT\n", "+BYE\n")
+}
+
+func TestServeLongLine(t *testing.T) {
+	addr, _, _ := start(t)
+	cl := dial(t, addr)
+	long := strings.Repeat("a", 70*1024) + "\n"
+	cl.c.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := cl.c.Write([]byte(long)); err != nil {
+		t.Fatal(err)
+	}
+	got, err := readResponse(t, cl)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "-ERR line too long\n" {
+		t.Fatalf("response = %q", got)
+	}
+	// Connection is closed afterwards.
+	expectClosed(t, cl)
+	// A line of exactly 64 KiB is still accepted.
+	cl2 := dial(t, addr)
+	ok := "PING" + strings.Repeat(" ", 64*1024-4) + "\n"
+	expectLine(t, cl2, ok, "+PONG\n")
+}
+
+func TestServeCancel(t *testing.T) {
+	addr, cancel, errc := start(t)
+	cl := dial(t, addr)
+	expectLine(t, cl, "PING\n", "+PONG\n")
+	cancel()
+	select {
+	case err := <-errc:
+		if err != nil {
+			t.Fatalf("Serve returned %v, want nil", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Serve did not return after cancel")
+	}
+}
diff --git a/store/store.go b/store/store.go
new file mode 100644
index 0000000..efe4b48
--- /dev/null
+++ b/store/store.go
@@ -0,0 +1,383 @@
+// Package store implements a thread-safe in-memory key-value store with
+// per-key expiry, glob key matching and JSON snapshots.
+package store
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+)
+
+// ErrNotInteger is returned by Incr when the stored value is not a
+// base-10 int64.
+var ErrNotInteger = errors.New("value is not an integer")
+
+// Clock returns the current time.
+type Clock func() time.Time
+
+type entry struct {
+	value  string
+	exp    time.Time
+	hasExp bool
+}
+
+// Store is a key-value store safe for concurrent use.
+type Store struct {
+	mu    sync.Mutex
+	clock Clock
+	m     map[string]entry
+}
+
+// New creates a Store. A nil clock uses time.Now.
+func New(clock Clock) *Store {
+	if clock == nil {
+		clock = time.Now
+	}
+	return &Store{clock: clock, m: make(map[string]entry)}
+}
+
+// isLive reports whether key exists and is not expired. Caller must hold s.mu.
+func (s *Store) isLive(key string) bool {
+	e, ok := s.m[key]
+	if !ok {
+		return false
+	}
+	if e.hasExp && !s.clock().Before(e.exp) {
+		return false
+	}
+	return true
+}
+
+// Set stores value under key. ttl <= 0 means no expiry; it always replaces
+// both the value and the ttl.
+func (s *Store) Set(key, value string, ttl time.Duration) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := entry{value: value}
+	if ttl > 0 {
+		e.exp = s.clock().Add(ttl)
+		e.hasExp = true
+	}
+	s.m[key] = e
+}
+
+// Get returns the value for key, or ok = false if the key is missing or
+// expired.
+func (s *Store) Get(key string) (string, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.isLive(key) {
+		return "", false
+	}
+	return s.m[key].value, true
+}
+
+// Del removes the given keys and returns the number of keys that existed
+// and were removed.
+func (s *Store) Del(keys ...string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for _, k := range keys {
+		if s.isLive(k) {
+			delete(s.m, k)
+			n++
+		}
+	}
+	return n
+}
+
+// Exists reports whether key is present and not expired.
+func (s *Store) Exists(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.isLive(key)
+}
+
+// Expire sets the expiry of key. It returns false if the key is missing;
+// ttl <= 0 deletes the key and returns true.
+func (s *Store) Expire(key string, ttl time.Duration) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.isLive(key) {
+		return false
+	}
+	if ttl <= 0 {
+		delete(s.m, key)
+		return true
+	}
+	e := s.m[key]
+	e.exp = s.clock().Add(ttl)
+	e.hasExp = true
+	s.m[key] = e
+	return true
+}
+
+// Persist removes the expiry of key. It returns true only if the key existed
+// and had an expiry.
+func (s *Store) Persist(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.m[key]
+	if !ok || !e.hasExp || !s.isLive(key) {
+		return false
+	}
+	e.exp = time.Time{}
+	e.hasExp = false
+	s.m[key] = e
+	return true
+}
+
+// TTL returns -2 if the key is missing, -1 if it has no expiry, otherwise
+// the remaining time (> 0).
+func (s *Store) TTL(key string) time.Duration {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.m[key]
+	if !ok || !s.isLive(key) {
+		return -2
+	}
+	if !e.hasExp {
+		return -1
+	}
+	return e.exp.Sub(s.clock())
+}
+
+// Incr adds by to the integer stored under key (a missing key counts as 0)
+// and returns the new value. The existing ttl is kept. ErrNotInteger is
+// returned if the current value is not a base-10 int64.
+func (s *Store) Incr(key string, by int64) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var cur int64
+	e, live := s.m[key]
+	live = live && s.isLive(key)
+	if live {
+		v, err := strconv.ParseInt(e.value, 10, 64)
+		if err != nil {
+			return 0, ErrNotInteger
+		}
+		cur = v
+	} else {
+		e = entry{}
+	}
+	e.value = strconv.FormatInt(cur+by, 10)
+	s.m[key] = e
+	return cur + by, nil
+}
+
+// Keys returns the live keys matching the glob pattern, sorted ascending.
+// The pattern supports '*' (any run of characters, including '/'), '?'
+// (exactly one character), '[...]' sets and ranges with optional '^'/'!'
+// negation, and '\x' escaping. The whole key must match.
+func (s *Store) Keys(pattern string) []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var out []string
+	for k := range s.m {
+		if s.isLive(k) && globMatch(k, pattern) {
+			out = append(out, k)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// Len returns the number of live keys.
+func (s *Store) Len() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for k := range s.m {
+		if s.isLive(k) {
+			n++
+		}
+	}
+	return n
+}
+
+type snapshotEntry struct {
+	Key   string `json:"k"`
+	Value string `json:"v"`
+	Exp   int64  `json:"exp"`
+}
+
+type snapshot struct {
+	Version int             `json:"version"`
+	Entries []snapshotEntry `json:"entries"`
+}
+
+// Save writes a JSON snapshot of the store:
+// {"version":1,"entries":[{"k":...,"v":...,"exp":<unix-ms or 0>},...]}
+// with entries sorted by key. Expired keys are omitted.
+func (s *Store) Save(w io.Writer) error {
+	s.mu.Lock()
+	entries := make([]snapshotEntry, 0)
+	for k, e := range s.m {
+		if !s.isLive(k) {
+			continue
+		}
+		se := snapshotEntry{Key: k, Value: e.value}
+		if e.hasExp {
+			se.Exp = e.exp.UnixMilli()
+		}
+		entries = append(entries, se)
+	}
+	s.mu.Unlock()
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Key < entries[j].Key })
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	if err := enc.Encode(snapshot{Version: 1, Entries: entries}); err != nil {
+		return err
+	}
+	buf.Truncate(buf.Len() - 1) // drop the trailing newline
+	_, err := buf.WriteTo(w)
+	return err
+}
+
+// Load replaces all contents with the snapshot read from r. Other versions
+// are rejected with an error, and entries already expired at load time are
+// dropped.
+func (s *Store) Load(r io.Reader) error {
+	var snap snapshot
+	if err := json.NewDecoder(r).Decode(&snap); err != nil {
+		return err
+	}
+	if snap.Version != 1 {
+		return fmt.Errorf("unsupported snapshot version %d", snap.Version)
+	}
+	now := s.clock()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	m := make(map[string]entry, len(snap.Entries))
+	for _, se := range snap.Entries {
+		if se.Exp > 0 {
+			dl := time.UnixMilli(se.Exp)
+			if !now.Before(dl) {
+				continue
+			}
+			m[se.Key] = entry{value: se.Value, exp: dl, hasExp: true}
+		} else {
+			m[se.Key] = entry{value: se.Value}
+		}
+	}
+	s.m = m
+	return nil
+}
+
+// globMatch reports whether key matches the glob pattern exactly.
+func globMatch(key, pat string) bool {
+	for {
+		if pat == "" {
+			return key == ""
+		}
+		switch pat[0] {
+		case '*':
+			pat = strings.TrimLeft(pat, "*")
+			if pat == "" {
+				return true
+			}
+			for i := 0; i < len(key); i++ {
+				_, n := utf8.DecodeRuneInString(key[i:])
+				if globMatch(key[i+n:], pat) {
+					return true
+				}
+			}
+			return globMatch("", pat)
+		case '\\':
+			if len(pat) < 2 || key == "" {
+				return false
+			}
+			pr, pn := utf8.DecodeRuneInString(pat[1:])
+			kr, kn := utf8.DecodeRuneInString(key)
+			if kr != pr {
+				return false
+			}
+			key, pat = key[kn:], pat[1+pn:]
+		case '?':
+			if key == "" {
+				return false
+			}
+			_, n := utf8.DecodeRuneInString(key)
+			key, pat = key[n:], pat[1:]
+		case '[':
+			consumed := 1 // the '[' itself
+			rest := pat[1:]
+			if rest == "" {
+				return false
+			}
+			negate := false
+			if rest[0] == '^' || rest[0] == '!' {
+				negate = true
+				rest = rest[1:]
+				consumed++
+			}
+			if rest == "" {
+				return false
+			}
+			start := 0
+			if rest[0] == ']' {
+				start = 1 // a leading ']' is a literal member
+			}
+			closeIdx := bytes.IndexByte([]byte(rest[start:]), ']')
+			if closeIdx < 0 {
+				// An unclosed bracket is a literal '['.
+				if key == "" || key[0] != '[' {
+					return false
+				}
+				key = key[1:]
+				pat = pat[1:]
+				continue
+			}
+			members := rest[start : start+closeIdx]
+			if key == "" {
+				return false
+			}
+			r, n := utf8.DecodeRuneInString(key)
+			if memberMatches(r, members) == negate {
+				return false
+			}
+			key = key[n:]
+			pat = pat[consumed+start+closeIdx+1:]
+		default:
+			if key == "" {
+				return false
+			}
+			pr, pn := utf8.DecodeRuneInString(pat)
+			kr, kn := utf8.DecodeRuneInString(key)
+			if kr != pr {
+				return false
+			}
+			key, pat = key[kn:], pat[pn:]
+		}
+	}
+}
+
+// memberMatches reports whether r is in the bracket member expression
+// (ranges like a-z and single characters).
+func memberMatches(r rune, members string) bool {
+	i := 0
+	for i < len(members) {
+		m, n := utf8.DecodeRuneInString(members[i:])
+		if m == '-' && i > 0 && i+n < len(members) {
+			lo, _ := utf8.DecodeRuneInString(members[i-1:])
+			hi, _ := utf8.DecodeRuneInString(members[i+n:])
+			if r >= lo && r <= hi {
+				return true
+			}
+			i += 2 * n // skip the range upper bound
+		} else if r == m {
+			return true
+		}
+		i += n
+	}
+	return false
+}
diff --git a/store/store_test.go b/store/store_test.go
new file mode 100644
index 0000000..b4b0d65
--- /dev/null
+++ b/store/store_test.go
@@ -0,0 +1,287 @@
+package store
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+type fakeClock struct{ now time.Time }
+
+func (c *fakeClock) tick() time.Time { return c.now }
+func (c *fakeClock) advance(d time.Duration) { c.now = c.now.Add(d) }
+
+func newTestStore(t *testing.T) (*Store, *fakeClock) {
+	t.Helper()
+	cl := &fakeClock{now: time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)}
+	return New(cl.tick), cl
+}
+
+func TestSetGet(t *testing.T) {
+	s, _ := newTestStore(t)
+	if v, ok := s.Get("k"); ok || v != "" {
+		t.Fatalf("missing key: got %q, %v", v, ok)
+	}
+	s.Set("k", "v", 0)
+	if v, ok := s.Get("k"); !ok || v != "v" {
+		t.Fatalf("Get = %q, %v", v, ok)
+	}
+	// Set replaces both value and ttl.
+	s.Set("k", "v2", time.Minute)
+	if v, ok := s.Get("k"); !ok || v != "v2" {
+		t.Fatalf("after replace: %q, %v", v, ok)
+	}
+	s.Set("k", "v3", 0)
+	if got := s.TTL("k"); got != -1 {
+		t.Fatalf("TTL after re-set without ttl = %v, want -1", got)
+	}
+}
+
+func TestExpiry(t *testing.T) {
+	s, cl := newTestStore(t)
+	s.Set("k", "v", time.Second)
+	if !s.Exists("k") {
+		t.Fatal("exists before expiry")
+	}
+	cl.advance(500 * time.Millisecond)
+	if !s.Exists("k") {
+		t.Fatal("exists before deadline")
+	}
+	cl.advance(501 * time.Millisecond) // now >= deadline
+	if s.Exists("k") {
+		t.Fatal("expired key should behave as missing")
+	}
+	if _, ok := s.Get("k"); ok {
+		t.Fatal("Get on expired key")
+	}
+	if s.Len() != 0 {
+		t.Fatalf("Len counts expired key: %d", s.Len())
+	}
+	if keys := s.Keys("*"); len(keys) != 0 {
+		t.Fatalf("Keys includes expired: %v", keys)
+	}
+}
+
+func TestDel(t *testing.T) {
+	s, _ := newTestStore(t)
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 0)
+	s.Set("c", "3", time.Second)
+	if n := s.Del("a", "b", "z"); n != 2 {
+		t.Fatalf("Del = %d, want 2", n)
+	}
+	if n := s.Del("a"); n != 0 {
+		t.Fatalf("Del again = %d, want 0", n)
+	}
+}
+
+func TestExpirePersist(t *testing.T) {
+	s, cl := newTestStore(t)
+	if s.Expire("missing", time.Second) {
+		t.Fatal("Expire on missing key")
+	}
+	s.Set("k", "v", 0)
+	if s.Persist("k") {
+		t.Fatal("Persist without expiry should be false")
+	}
+	if !s.Expire("k", time.Minute) {
+		t.Fatal("Expire existing")
+	}
+	if got := s.TTL("k"); got <= 0 || got > time.Minute {
+		t.Fatalf("TTL = %v", got)
+	}
+	if !s.Persist("k") {
+		t.Fatal("Persist with expiry should be true")
+	}
+	if got := s.TTL("k"); got != -1 {
+		t.Fatalf("TTL after persist = %v", got)
+	}
+	// ttl <= 0 deletes the key.
+	s.Expire("k", time.Minute)
+	if !s.Expire("k", 0) {
+		t.Fatal("Expire ttl=0 should delete and return true")
+	}
+	if s.Exists("k") {
+		t.Fatal("key should be deleted")
+	}
+	// Expired key: Expire reports missing.
+	s.Set("e", "v", time.Second)
+	cl.advance(2 * time.Second)
+	if s.Expire("e", time.Minute) {
+		t.Fatal("Expire on expired key should be false")
+	}
+}
+
+func TestTTL(t *testing.T) {
+	s, cl := newTestStore(t)
+	if got := s.TTL("nope"); got != -2 {
+		t.Fatalf("TTL missing = %v, want -2", got)
+	}
+	s.Set("a", "1", 0)
+	if got := s.TTL("a"); got != -1 {
+		t.Fatalf("TTL no expiry = %v, want -1", got)
+	}
+	s.Set("b", "1", time.Second)
+	cl.advance(200 * time.Millisecond)
+	if got := s.TTL("b"); got != 800*time.Millisecond {
+		t.Fatalf("TTL = %v, want 800ms", got)
+	}
+}
+
+func TestIncr(t *testing.T) {
+	s, _ := newTestStore(t)
+	if v, err := s.Incr("n", 5); err != nil || v != 5 {
+		t.Fatalf("Incr new = %d, %v", v, err)
+	}
+	if v, err := s.Incr("n", -2); err != nil || v != 3 {
+		t.Fatalf("Incr = %d, %v", v, err)
+	}
+	if v, err := s.Incr("n", 7); err != nil || v != 10 {
+		t.Fatalf("Incr = %d, %v", v, err)
+	}
+	s.Set("x", "abc", 0)
+	if _, err := s.Incr("x", 1); !errors.Is(err, ErrNotInteger) {
+		t.Fatalf("Incr non-integer err = %v", err)
+	}
+	// Existing ttl is kept.
+	s, cl := newTestStore(t)
+	s.Set("t", "1", time.Second)
+	cl.advance(500 * time.Millisecond)
+	s.Incr("t", 1)
+	if got := s.TTL("t"); got != 500*time.Millisecond {
+		t.Fatalf("TTL after incr = %v, want 500ms", got)
+	}
+}
