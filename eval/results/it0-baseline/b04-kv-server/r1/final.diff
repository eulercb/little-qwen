+func TestSaveLoad(t *testing.T) {
+	s, cl := newTestStore(t)
+	s.Set("b", "2", 30*time.Second)
+	s.Set("a", "1", 0)
+	s.Set("gone", "x", time.Second) // expires at 1s; clock is at 0
+	cl.advance(2 * time.Second) // "gone" is now expired
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatal(err)
+	}
+	exp := `{"version":1,"entries":[{"k":"a","v":"1","exp":0},{"k":"b","v":"2","exp":1704067230000}]}`
+	if buf.String() != exp {
+		t.Fatalf("Save output:\n%s\nwant:\n%s", buf.String(), exp)
+	}
+	// Round-trip into a fresh store.
+	s2, _ := newTestStore(t)
+	if err := s2.Load(strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	if v, ok := s2.Get("a"); !ok || v != "1" {
+		t.Fatalf("loaded a = %q, %v", v, ok)
+	}
+	if v, ok := s2.Get("b"); !ok || v != "2" {
+		t.Fatalf("loaded b = %q, %v", v, ok)
+	}
+	if got := s2.TTL("b"); got <= 0 || got > 30*time.Second {
+		t.Fatalf("TTL(b) = %v", got)
+	}
+	if s2.Exists("gone") {
+		t.Fatal("expired entry should be dropped")
+	}
+	if n := s2.Len(); n != 2 {
+		t.Fatalf("Len = %d", n)
+	}
+	// Load replaces all contents.
+	s.Set("z", "9", 0)
+	if err := s.Load(strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	if s.Exists("z") || s.Len() != 2 {
+		t.Fatalf("Load should replace contents; Len=%d", s.Len())
+	}
+	// Wrong version rejected.
+	if err := s.Load(strings.NewReader(`{"version":2,"entries":[]}`)); err == nil {
+		t.Fatal("expected error for version 2")
+	}
+	// Expired at load time (clock has moved past the 30s deadline? no) —
+	// simulate by building a snapshot whose exp is in the past.
+	other, cl := newTestStore(t)
+	cl.advance(60 * time.Second)
+	if err := other.Load(strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	if other.Exists("b") {
+		t.Fatal("entry expired at load time should be dropped")
+	}
+}
