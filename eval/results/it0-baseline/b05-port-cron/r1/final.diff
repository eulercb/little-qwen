@@ -0,0 +1,410 @@
+// Package cron implements a cron-expression parser and next-run calculator,
+// ported from the Python reference in reference/cron.py with identical
+// behaviour, including error messages.
+package cron
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// fields describes the five cron fields: name, low bound, high bound.
+var fields = [5]struct {
+	name string
+	lo   int
+	hi   int
+}{
+	{"minute", 0, 59},
+	{"hour", 0, 23},
+	{"day-of-month", 1, 31},
+	{"month", 1, 12},
+	{"day-of-week", 0, 6},
+}
+
+var months = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var dayNames = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":    "0 0 1 1 *",
+	"@annually":  "0 0 1 1 *",
+	"@monthly":   "0 0 1 * *",
+	"@weekly":    "0 0 * * 0",
+	"@daily":     "0 0 * * *",
+	"@midnight":  "0 0 * * *",
+	"@hourly":    "0 * * * *",
+}
+
+// field is a parsed cron field: the sorted unique values it accepts.
+type field struct {
+	vals []int // sorted, unique
+	size int   // hi+1 of the field
+}
+
+func (f *field) contains(v int) bool {
+	if v < 0 || v >= f.size {
+		return false
+	}
+	// vals is sorted; linear scan is fine (fields are small)
+	for _, x := range f.vals {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+// Schedule holds a parsed cron expression.
+type Schedule struct {
+	expr  string
+	min   *field
+	hour  *field
+	dom   *field
+	month *field
+	dow   *field
+	domStar, dowStar bool
+}
+
+// Parse parses a cron expression. The accepted syntax and the error messages
+// match the Python reference exactly.
+func Parse(expr string) (*Schedule, error) {
+	// Python stores original.strip(); the macro is resolved on the stripped form.
+	expr = strings.TrimSpace(expr)
+	if strings.HasPrefix(expr, "@") {
+		m, ok := macros[strings.ToLower(expr)]
+		if !ok {
+			return nil, fmt.Errorf("unknown macro %s", pyRepr(expr))
+		}
+		expr = m
+	}
+	parts := strings.Fields(expr)
+	if len(parts) != 5 {
+		return nil, fmt.Errorf("expected 5 fields, got %d", len(parts))
+	}
+	f := make([]*field, 5)
+	for i, p := range parts {
+		var err error
+		f[i], err = parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return &Schedule{
+		expr:    expr,
+		min:     f[0],
+		hour:    f[1],
+		dom:     f[2],
+		month:   f[3],
+		dow:     f[4],
+		domStar: parts[2] == "*",
+		dowStar: parts[4] == "*",
+	}, nil
+}
+
+// Next returns the first matching time strictly after after, in after's
+// location. If no match exists within 5 years, an error is returned.
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	// t = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+	t := after.Truncate(time.Minute).Add(time.Minute)
+	limit := after.Add(366 * 5 * 24 * time.Hour)
+	for !t.After(limit) {
+		if !s.month.contains(int(t.Month())) {
+			if t.Month() == 12 {
+				t = time.Date(t.Year()+1, 1, 1, 0, 0, 0, 0, loc)
+			} else {
+				t = time.Date(t.Year(), t.Month()+1, 1, 0, 0, 0, 0, loc)
+			}
+			continue
+		}
+		if !s.dayOK(t) {
+			_, m, d := t.Date()
+			t = time.Date(t.Year(), m, d+1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !s.hour.contains(t.Hour()) {
+			_, m, d := t.Date()
+			t = time.Date(t.Year(), m, d, t.Hour()+1, 0, 0, 0, loc)
+			continue
+		}
+		if !s.min.contains(t.Minute()) {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, fmt.Errorf("no match within 5 years for %s", pyRepr(s.expr))
+}
+
+func (s *Schedule) dayOK(d time.Time) bool {
+	dow := int(d.Weekday()) // Sunday=0, matching (weekday()+1) % 7
+	inDom := s.dom.contains(d.Day())
+	inDow := s.dow.contains(dow)
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// String renders the schedule like the Python describe().
+func (s *Schedule) String() string {
+	return strings.Join([]string{
+		formatField(s.min.vals, 0),
+		formatField(s.hour.vals, 1),
+		formatField(s.dom.vals, 2),
+		formatField(s.month.vals, 3),
+		formatField(s.dow.vals, 4),
+	}, " ")
+}
+
+// parseField parses one field of a cron expression.
+func parseField(text string, idx int) (*field, error) {
+	def := fields[idx]
+	if text == "" {
+		return nil, fmt.Errorf("%s: empty field", def.name)
+	}
+	set := make(map[int]bool)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, fmt.Errorf("%s: empty item", def.name)
+		}
+		step := 1
+		base := item
+		if i := strings.Index(item, "/"); i >= 0 {
+			st := item[i+1:]
+			if !pyIsDigit(st) {
+				return nil, fmt.Errorf("%s: invalid step %s", def.name, pyRepr(st))
+			}
+			v, ok := pyInt(st)
+			if !ok || v < 1 {
+				return nil, fmt.Errorf("%s: invalid step %s", def.name, pyRepr(st))
+			}
+			step = v
+			base = item[:i]
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = def.lo, def.hi
+		case strings.Contains(base, "-"):
+			a, b := base[:strings.Index(base, "-")], base[strings.Index(base, "-")+1:]
+			var err error
+			start, err = pyValue(a, idx)
+			if err != nil {
+				return nil, err
+			}
+			end, err = pyValue(b, idx)
+			if err != nil {
+				return nil, err
+			}
+			if start > end {
+				return nil, fmt.Errorf("%s: range %d-%d is reversed", def.name, start, end)
+			}
+		default:
+			var err error
+			start, err = pyValue(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			end = start
+			if strings.Contains(item, "/") {
+				end = def.hi
+			}
+		}
+		for v := start; v <= end; v += step {
+			set[v] = true
+		}
+	}
+	vals := make([]int, 0, len(set))
+	for v := range set {
+		vals = append(vals, v)
+	}
+	sortInts(vals)
+	return &field{vals: vals, size: def.hi + 1}, nil
+}
+
+// pyValue mirrors Python's _value: resolve a single value token.
+func pyValue(tok string, idx int) (int, error) {
+	def := fields[idx]
+	t := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range months {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range dayNames {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !pyIsDigit(tok) {
+		return 0, fmt.Errorf("%s: invalid value %s", def.name, pyRepr(tok))
+	}
+	v, ok := pyInt(tok)
+	if !ok {
+		return 0, fmt.Errorf("invalid literal for int() with base 10: %s", pyRepr(tok))
+	}
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	if v < def.lo || v > def.hi {
+		return 0, fmt.Errorf("%s: value %d out of range %d-%d", def.name, v, def.lo, def.hi)
+	}
+	return v, nil
+}
+
+// pyIsDigit mirrors str.isdigit(): at least one character, all of them
+// decimal digits (category Nd) or "digit" numerals (category No with a
+// defined decimal value).
+func pyIsDigit(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if unicode.Is(unicode.Nd, r) {
+			continue
+		}
+		if !isNoDigit(r) {
+			return false
+		}
+	}
+	return true
+}
+
+// isNoDigit reports whether r is a category-No character with a defined
+// decimal value (the "digit" numerics: superscript/subscript digits,
+// circled digits and roman numerals i..x).
+func isNoDigit(r rune) bool {
+	if unicode.Is(unicode.No, r) {
+		switch {
+		case r == 0x2070 || (r >= 0x2074 && r <= 0x2079): // ⁰ ²-⁹
+			return true
+		case r >= 0x2080 && r <= 0x2089: // ₀-₉
+			return true
+		case r >= 0x2170 && r <= 0x217A: // ⅰ-ⅺ
+			return true
+		case r >= 0x2460 && r <= 0x2473: // ①-⑱
+			return true
+		case r == 0x24EA: // ⓪
+			return true
+		}
+	}
+	return false
+}
+
+// pyInt mimics int(s) on a digit-only string. ok is false when Python's
+// int() would raise (e.g. the token contains a non-decimal "digit" like ²).
+func pyInt(tok string) (int, bool) {
+	v := 0
+	for _, r := range tok {
+		var d int
+		if r >= '0' && r <= '9' {
+			d = int(r - '0')
+		} else if unicode.Is(unicode.Nd, r) {
+			d = ndValue(r)
+			if d < 0 {
+				return 0, false
+			}
+		} else {
+			return 0, false
+		}
+		v = v*10 + d
+	}
+	return v, true
+}
+
+// ndBlocks are the Unicode Nd (decimal digit) blocks; each is a run of
+// sequential digits 0-9 starting at the low value.
+var ndBlocks = [][2]rune{
+	{0x0660, 0x0669}, {0x06F0, 0x06F9}, {0x07C0, 0x07C9},
+	{0x0966, 0x096F}, {0x09E6, 0x09EF}, {0x0A66, 0x0A6F},
+	{0x0AE6, 0x0AEF}, {0x0B66, 0x0B6F}, {0x0BE6, 0x0BEF},
+	{0x0C66, 0x0C6F}, {0x0CE6, 0x0CEF}, {0x0D66, 0x0D6F},
+	{0x0E50, 0x0E59}, {0x1040, 0x1049}, {0x1090, 0x1099},
+	{0x17E0, 0x17E9}, {0x1810, 0x1819}, {0x1946, 0x194F},
+	{0x19D0, 0x19D9}, {0x1A80, 0x1A89}, {0x1A90, 0x1A99},
+	{0x1B50, 0x1B59}, {0x1BB0, 0x1BB9}, {0x1C40, 0x1C49},
+	{0x1C50, 0x1C59}, {0xA62C, 0xA634}, {0xA62D, 0xA634},
+	{0xA8D0, 0xA8D9}, {0xA900, 0xA909}, {0xA9D0, 0xA9D9},
+	{0xA9F0, 0xA9F9}, {0xAA60, 0xAA69}, {0xABF0, 0xABF9},
+	{0x11066, 0x1106F}, {0x110F0, 0x110F9}, {0xFF10, 0xFF19},
+	{0x10140, 0x10149}, {0x102E0, 0x102E9}, {0x10320, 0x10329},
+	{0x104A0, 0x104A9}, {0x10A60, 0x10A69}, {0x10D30, 0x10D39},
+	{0x11080, 0x11089}, {0x11090, 0x11099}, {0x12450, 0x12459},
+	{0x12470, 0x12479},
+}
+
+// ndValue returns the decimal value of a Unicode decimal-digit rune, or -1
+// if the rune is not a known Nd digit.
+func ndValue(r rune) int {
+	for _, b := range ndBlocks {
+		if r >= b[0] && r < b[0]+10 {
+			return int(r - b[0])
+		}
+	}
+	return -1
+}
+
+// pyRepr renders s like Python's repr() for strings.
+func pyRepr(s string) string {
+	var b strings.Builder
+	b.WriteByte('\'')
+	for _, r := range s {
+		switch r {
+		case '\'':
+			b.WriteString(`\'`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		case '\r':
+			b.WriteString(`\r`)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('\'')
+	return b.String()
+}
+
+// formatField mirrors Python's _fmt.
+func formatField(vs []int, idx int) string {
+	def := fields[idx]
+	if len(vs) == def.hi-def.lo+1 && len(vs) > 0 && vs[0] == def.lo && vs[len(vs)-1] == def.hi {
+		return "*"
+	}
+	out := make([]string, 0, len(vs))
+	i := 0
+	for i < len(vs) {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			// run of 1 or 2 values: emit each individually
+			for _, v := range vs[i : j+1] {
+				out = append(out, strconv.Itoa(v))
+			}
+		} else {
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+func sortInts(xs []int) {
+	for i := 1; i < len(xs); i++ {
+		for j := i; j > 0 && xs[j-1] > xs[j]; j-- {
+			xs[j-1], xs[j] = xs[j], xs[j-1]
+		}
+	}
+}
