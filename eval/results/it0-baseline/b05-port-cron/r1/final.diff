@@ -0,0 +1,265 @@
+package cron
+
+import (
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestParseErrors(t *testing.T) {
+	cases := []struct {
+		expr string
+		err  string
+	}{
+		{"5", "expected 5 fields, got 1"},
+		{"1 2 3 4 5 6", "expected 5 fields, got 6"},
+		{"", "expected 5 fields, got 0"},
+		{"@nope", "unknown macro '@nope'"},
+		{"@Foo", "unknown macro '@Foo'"},
+		{"60 * * * *", "minute: value 60 out of range 0-59"},
+		{"* 24 * * *", "hour: value 24 out of range 0-23"},
+		{"* * 0 * *", "day-of-month: value 0 out of range 1-31"},
+		{"* * * 0 *", "month: value 0 out of range 1-12"},
+		{"* * * 13 *", "month: value 13 out of range 1-12"},
+		{"* * * * 8", "day-of-week: value 8 out of range 0-6"},
+		{"a * * * *", "minute: invalid value 'a'"},
+		{"* * * * *x", "day-of-week: invalid value '*x'"},
+		{"*/0 * * * *", "minute: invalid step '0'"},
+		{"*/ * * * *", "minute: invalid step ''"},
+		{"5/0 * * * *", "minute: invalid step '0'"},
+		{"1/2/3 * * * *", "minute: invalid step '2/3'"},
+		{"5- * * * *", "minute: invalid value ''"},
+		{"*-1 * * * *", "minute: invalid value ''"},
+		{"5-3 * * * *", "minute: range 5-3 is reversed"},
+		{"5-15-20 * * * *", "minute: invalid value '15-20'"},
+		{"1,,2 * * * *", "minute: empty item"},
+		{"1, * * * *", "minute: empty item"},
+		{"* * mon * *", "day-of-month: invalid value 'mon'"},
+		{"* * * * jan", "day-of-week: invalid value 'jan'"},
+		{"* * * may,foo *", "month: invalid value 'foo'"},
+		{"* * * * SUN", "day-of-week: invalid value 'SUN'... "}, // placeholder, fixed below
+	}
+	// "SUN" in day-of-week is a valid name; correct case:
+	cases[26] = struct {
+		expr string
+		err  string
+	}{"* * * * 31", "day-of-week: value 31 out of range 0-6"}
+
+	for _, tc := range cases {
+		_, err := Parse(tc.expr)
+		if err == nil {
+			t.Errorf("Parse(%q): expected error, got nil", tc.expr)
+			continue
+		}
+		if err.Error() != tc.err {
+			t.Errorf("Parse(%q) error = %q, want %q", tc.expr, err.Error(), tc.err)
+		}
+	}
+}
+
+func checkString(t *testing.T, s *Schedule, want string) {
+	t.Helper()
+	if got := s.String(); got != want {
+		t.Errorf("String() = %q, want %q", got, want)
+	}
+}
+
+func TestParseNamesAndMacros(t *testing.T) {
+	if _, err := Parse("0 0 * * jan"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Parse("0 0 * * JAN"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Parse("0 0 * * 7"); err != nil {
+		t.Fatal(err)
+	}
+	macroStrings := [][2]string{
+		{"@yearly", "0 0 1 1 *"},
+		{"@annually", "0 0 1 1 *"},
+		{"@monthly", "0 0 1 * *"},
+		{"@weekly", "0 0 * * 0"},
+		{"@daily", "0 0 * * *"},
+		{"@midnight", "0 0 * * *"},
+		{"@hourly", "0 * * * *"},
+		{"@YEARLY", "0 0 1 1 *"},
+		{"@Daily", "0 0 * * *"},
+	}
+	for _, m := range macroStrings {
+		s, err := Parse(m[0])
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", m[0], err)
+		}
+		checkString(t, s, m[1])
+	}
+}
+
+func TestString(t *testing.T) {
+	checks := [][2]string{
+		{"*/15 * * * *", "0,15,30,45 * * * *"},
+		{"5-10 * * * *", "5-10 * * * *"},
+		{"5,6 * * * *", "5,6 * * * *"},
+		{"1-2 * * * *", "1,2 * * * *"},
+		{"7 * * * *", "7 * * * *"},
+		{"* * * * *", "* * * * *"},
+		{"1-59/7 * * * *", "1,8,15,22,29,36,43,50,57 * * * *"},
+		{"0-59 * * * *", "* * * * *"},
+		{"1,3,5-7,9 * * * *", "1,3,5-7,9 * * * *"},
+		{"0 0 * * 7", "0 0 * * 0"},
+		{"5 4 31 2 *", "5 4 31 2 *"},
+		{"15 10,11 1,15 * MON,WED,FRIDAY", "15 10,11 1,15 * 1,3,5"},
+	}
+	for _, c := range checks {
+		s, err := Parse(c[0])
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", c[0], err)
+		}
+		checkString(t, s, c[1])
+	}
+}
+
+func mkTime(s string) time.Time {
+	t, err := time.Parse("2006-01-02T15:04:05", s)
+	if err != nil {
+		panic(err)
+	}
+	return t
+}
+
+func TestNext(t *testing.T) {
+	cases := []struct {
+		expr  string
+		after string
+		want  string
+	}{
+		{"*/15 * * * *", "2024-01-15T10:23:45", "2024-01-15T10:30:00"},
+		{"*/15 * * * *", "2024-01-15T10:30:00", "2024-01-15T10:45:00"},
+		{"5 4 * * *", "2024-02-29T04:05:00", "2024-03-01T04:05:00"},
+		{"0 0 1 1 *", "2024-06-15T00:00:00", "2025-01-01T00:00:00"},
+		{"0 0 * * 0", "2024-01-15T10:00:00", "2024-01-21T00:00:00"}, // 2024-01-15 is a Monday
+		{"59 23 * * *", "2024-01-31T23:59:30", "2024-02-01T23:59:00"},
+	}
+	for _, c := range cases {
+		s, err := Parse(c.expr)
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", c.expr, err)
+		}
+		got, err := s.Next(mkTime(c.after))
+		if err != nil {
+			t.Fatalf("Next(%q, %q): %v", c.expr, c.after, err)
+		}
+		if want := mkTime(c.want); !got.Equal(want) {
+			t.Errorf("Next(%q, %q) = %v, want %v", c.expr, c.after, got, want)
+		}
+	}
+}
+
+func TestNextNoMatch(t *testing.T) {
+	// Feb 31 never exists.
+	s, err := Parse("30 4 31 2 *")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = s.Next(mkTime("2024-01-01T00:00:00"))
+	if err == nil {
+		t.Fatal("expected no-match error")
+	}
+	if err.Error() != "no match within 5 years for '30 4 31 2 *'" {
+		t.Fatalf("error = %q", err.Error())
+	}
+}
+
+func TestVixieDaySemantics(t *testing.T) {
+	// Both dom and dow restricted: EITHER matches.
+	// 2024-01-04 is a Thursday.
+	s, err := Parse("0 0 15 * 1") // 15th of month OR Monday
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Next(mkTime("2024-01-05T00:00:00")) // Jan 5 2024 is a Friday
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := mkTime("2024-01-08T00:00:00"); !got.Equal(want) {
+		t.Fatalf("OR-semantics: got %v, want %v", got, want)
+	}
+	// dom restricted, dow restricted, no star: still OR (Vixie).
+	// First Friday on or after 2024-01-04 is Jan 5.
+	s2, err := Parse("0 0 15 * fri")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got2, err := s2.Next(mkTime("2024-01-04T00:00:00"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := mkTime("2024-01-05T00:00:00"); !got2.Equal(want) {
+		t.Fatalf("OR-semantics 2: got %v, want %v", got2, want)
+	}
+}
+
+// runRef runs the Python reference CLI and returns its stdout and stderr.
+func runRef(args ...string) (string, string) {
+	full := append([]string{"python3", "../reference/cron.py"}, args...)
+	cmd := exec.Command(full[0], full[1:]...)
+	out, err := cmd.Output()
+	stderr := ""
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			stderr = string(ee.Stderr)
+		} else {
+			return "", err.Error()
+		}
+	}
+	return string(out), stderr
+}
+
+func TestDiffAgainstPython(t *testing.T) {
+	if _, err := exec.LookPath("python3"); err != nil {
+		t.Skip("python3 not available")
+	}
+	exprs := []string{
+		"*/15 * * * *", "5 4 * * *", "0 0 1 1 *", "@hourly", "@daily", "@weekly",
+		"5-10,30 8-18 1,15 * 0,6", "15 10,11 1,15 * MON,WED,FRIDAY",
+		"0 0 31 * *", "0 0 1 * 7", "30 4 31 2 *", "0 0 31 2,4,6,9,11 *",
+		"0 0 30 4,6,9,11 *", "59 23 * * *", "0 12/6 * * 1-5",
+		"30 4 * FEB,APR *", "0 0 * jan,jul 1", "1/20 * * * *", "5-1/3 * * * *",
+		"1,2,3 4,5 6,7 8,9 0,1,2", "0 0 29 2 *", "0 0 28-31 2,3 *",
+		"0 0 31 4,6,9,11 *", "* * 31 2 *",
+	}
+	iso, ns := "2024-01-15T10:23:45", "4"
+	n, _ := strconv.Atoi(ns)
+	for _, e := range exprs {
+		want, pyErr := runRef(e, iso, n)
+		s, goErr := Parse(e)
+		var got strings.Builder
+		if goErr != nil {
+			got.WriteString("error: " + goErr.Error())
+		} else {
+			got.WriteString(s.String())
+			got.WriteByte('\n')
+			ts, err := time.Parse("2006-01-02T15:04:05", iso)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < n; i++ {
+				ts, err = s.Next(ts)
+				if err != nil {
+					got.WriteString("error: " + err.Error())
+					break
+				}
+				got.WriteString(ts.UTC().Format("2006-01-02T15:04:05") + "+00:00")
+				got.WriteByte('\n')
+			}
+		}
+		if strings.Contains(pyErr, "Traceback") {
+			// reference raised a non-CronError exception; nothing to compare
+			continue
+		}
+		if strings.TrimSpace(got.String()) != strings.TrimSpace(want) {
+			t.Errorf("mismatch for %q:\ngo: %q\npy: %q", e, got.String(), want)
+		}
+	}
+}
