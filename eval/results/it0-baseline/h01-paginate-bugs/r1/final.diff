+
+// Exact multiple of the page size must not produce an extra empty page.
+func TestTotalPagesExactMultiple(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5, 6}, 3, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.TotalPages != 2 {
+		t.Fatalf("TotalPages = %d, want 2", p.TotalPages)
+	}
+	if !p.HasPrev || p.HasNext {
+		t.Fatalf("HasPrev=%v HasNext=%v, want true/false", p.HasPrev, p.HasNext)
+	}
+	if len(p.Items) != 3 || p.Items[0] != 4 || p.Items[2] != 6 {
+		t.Fatalf("Items = %v, want [4 5 6]", p.Items)
+	}
+}
+
+// The last page of a non-multiple must contain its trailing item.
+func TestLastPageNotTruncated(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Items) != 1 || p.Items[0] != 5 {
+		t.Fatalf("Items = %v, want [5]", p.Items)
+	}
+	if p.TotalPages != 3 || p.HasNext || !p.HasPrev {
+		t.Fatalf("TotalPages=%d HasNext=%v HasPrev=%v, want 3/false/true", p.TotalPages, p.HasNext, p.HasPrev)
+	}
+}
+
+// Pages past the end must return an empty page, not panic.
+func TestPagePastEnd(t *testing.T) {
+	p, err := Get([]int{1, 2, 3}, 2, 100)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Items) != 0 {
+		t.Fatalf("Items = %v, want empty", p.Items)
+	}
+	if p.Number != 100 || p.TotalPages != 2 || !p.HasPrev || p.HasNext {
+		t.Fatalf("page = %+v, want Number=100 TotalPages=2 HasPrev=true HasNext=false", p)
+	}
+}
+
+// An empty input has no pages; asking for page 1 must be an empty page.
+func TestEmptyInput(t *testing.T) {
+	p, err := Get([]int{}, 5, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Items) != 0 || p.TotalPages != 0 || p.HasNext || p.HasPrev {
+		t.Fatalf("page = %+v", p)
+	}
+}
+
+// The returned page must not alias the input slice.
+func TestNoInputAliasing(t *testing.T) {
+	in := []int{1, 2, 3, 4}
+	p, err := Get(in, 2, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.Items[0] = 99
+	if in[0] != 1 {
+		t.Fatalf("input mutated: %v", in)
+	}
+}
+
+func TestBadArgs(t *testing.T) {
+	if _, err := Get([]int{1}, 0, 1); !errors.Is(err, ErrBadSize) {
+		t.Fatalf("err = %v, want ErrBadSize", err)
+	}
+	if _, err := Get([]int{1}, 1, 0); !errors.Is(err, ErrBadPage) {
+		t.Fatalf("err = %v, want ErrBadPage", err)
+	}
+	if _, err := All([]int{1}, -1); !errors.Is(err, ErrBadSize) {
+		t.Fatalf("err = %v, want ErrBadSize", err)
+	}
+}
+
+func TestAll(t *testing.T) {
+	pages, err := All([]int{1, 2, 3, 4, 5, 6}, 3)
+	if err != nil || len(pages) != 2 {
+		t.Fatalf("pages = %v, err = %v", pages, err)
+	}
+	if len(pages[0]) != 3 || len(pages[1]) != 3 {
+		t.Fatalf("pages = %v", pages)
+	}
+	// Modifying a page must not affect the input.
+	in := []int{1, 2, 3, 4, 5, 6}
+	pages, err = All(in, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pages[1][0] = 99
+	if in[3] != 4 {
+		t.Fatalf("input mutated: %v", in)
+	}
+	if empty, err := All([]int{}, 3); err != nil || len(empty) != 0 {
+		t.Fatalf("empty = %v, err = %v", empty, err)
+	}
+}
