+func TestLoadTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TIMEOUT": "1m30s", "APP_TAGS": "a, b ,,c,"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != 90*time.Second {
+		t.Fatalf("Timeout = %v", c.Timeout)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("Tags = %v", c.Tags)
+	}
+	for i := range want {
+		if c.Tags[i] != want[i] {
+			t.Fatalf("Tags = %v", c.Tags)
+		}
+	}
+}
+
+func TestLoadDefaultsForTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != 30*time.Second {
+		t.Fatalf("Timeout = %v", c.Timeout)
+	}
+	if c.Tags != nil {
+		t.Fatalf("Tags = %v", c.Tags)
+	}
+}
+
+func TestLoadCollectsAllErrors(t *testing.T) {
+	_, err := Load(env(map[string]string{
+		"APP_PORT":    "99999",
+		"APP_DEBUG":   "notabool",
+		"APP_WORKERS": "0",
+		"APP_TIMEOUT": "soon",
+	}))
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	for _, name := range []string{"APP_PORT", "APP_DEBUG", "APP_WORKERS", "APP_TIMEOUT"} {
+		if !strings.Contains(err.Error(), name) {
+			t.Errorf("error %q does not mention %s", err, name)
+		}
+	}
+}
+
+func TestLoadEmptyTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TAGS": " , "}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(c.Tags) != 0 {
+		t.Fatalf("Tags = %v", c.Tags)
+	}
+}
+
+func TestMerge(t *testing.T) {
+	base := Config{Host: "localhost", Port: 8080, Workers: 4, Timeout: 30 * time.Second, Tags: []string{"base"}}
+	ov := Config{Port: 9000, Timeout: time.Minute, Tags: []string{"x"}}
+	m := Merge(base, ov)
+	if m.Host != "localhost" || m.Port != 9000 || m.Workers != 4 || m.Timeout != time.Minute {
+		t.Fatalf("%+v", m)
+	}
+	if len(m.Tags) != 1 || m.Tags[0] != "x" {
+		t.Fatalf("Tags = %v", m.Tags)
+	}
+	// arguments untouched
+	if len(base.Tags) != 1 || base.Tags[0] != "base" || base.Timeout != 30*time.Second {
+		t.Fatalf("base mutated: %+v", base)
+	}
+	if len(ov.Tags) != 1 || ov.Tags[0] != "x" {
+		t.Fatalf("override mutated: %+v", ov)
+	}
+}
+
+func TestMergeEmptyNonNilTags(t *testing.T) {
+	base := Config{Host: "h", Port: 1, Tags: []string{"a", "b"}}
