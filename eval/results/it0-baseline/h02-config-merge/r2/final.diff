+func TestLoadDefaultsNewFields(t *testing.T) {
+	c, err := Load(env(nil))
+	if err != nil || c.Timeout != 30*time.Second || c.Tags != nil {
+		t.Fatalf("%+v %v", c, err)
+	}
+}
+
+func TestLoadTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TIMEOUT": "1.5m", "APP_TAGS": " a ,b,, c "}))
+	if err != nil || c.Timeout != 90*time.Second {
+		t.Fatalf("%+v %v", c, err)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("tags = %v, want %v", c.Tags, want)
+	}
+	for i := range want {
+		if c.Tags[i] != want[i] {
+			t.Fatalf("tags = %v, want %v", c.Tags, want)
+		}
+	}
+}
+
+func TestLoadCollectsAllErrors(t *testing.T) {
+	c, err := Load(env(map[string]string{
+		"APP_PORT":    "99999",
+		"APP_DEBUG":   "notabool",
+		"APP_WORKERS": "0",
+		"APP_TIMEOUT": "soon",
+	}))
+	if err == nil {
+		t.Fatal("expected error, got nil")
+	}
+	if c.Host != "" || c.Port != 0 || c.Debug || c.Workers != 0 || c.Timeout != 0 || c.Tags != nil {
+		t.Fatalf("expected zero Config on error, got %+v", c)
+	}
+	msg := err.Error()
+	for _, name := range []string{"APP_PORT", "APP_DEBUG", "APP_WORKERS", "APP_TIMEOUT"} {
+		if !strings.Contains(msg, name) {
+			t.Errorf("error %q does not mention %s", msg, name)
+		}
+	}
+	var multi interface{ Unwrap() []error }
+	if !errors.As(err, &multi) {
+		t.Fatalf("error should be a joined multi-error, got %v", err)
+	}
+	if len(multi.Unwrap()) != 4 {
+		t.Fatalf("joined %d errors, want 4", len(multi.Unwrap()))
+	}
+}
+
+func TestMergeOverridesNonZero(t *testing.T) {
+	base := Config{Host: "localhost", Port: 8080, Timeout: 30 * time.Second, Tags: []string{"a", "b"}}
+	override := Config{Port: 9000, Debug: true, Timeout: time.Second, Tags: []string{"x"}}
+	got := Merge(base, override)
+	if got.Host != "localhost" || got.Port != 9000 || !got.Debug || got.Workers != 0 ||
+		got.Timeout != time.Second || len(got.Tags) != 1 || got.Tags[0] != "x" {
+		t.Fatalf("unexpected merged config %+v", got)
+	}
+}
+
+func TestMergeZeroOverrideKeepsBase(t *testing.T) {
+	base := Config{Host: "h", Port: 8080, Debug: true, Workers: 4, Timeout: 30 * time.Second, Tags: []string{"a"}}
+	got := Merge(base, Config{})
+	if got.Host != base.Host || got.Port != base.Port || got.Debug != base.Debug ||
+		got.Workers != base.Workers || got.Timeout != base.Timeout ||
+		len(got.Tags) != len(base.Tags) || got.Tags[0] != "a" {
+		t.Fatalf("zero override changed base: %+v vs %+v", got, base)
+	}
+}
+
+func TestMergeEmptyNonNilTagsReplace(t *testing.T) {
+	base := Config{Host: "h", Tags: []string{"a", "b"}}
+	override := Config{Host: "h", Tags: []string{}}
+	got := Merge(base, override)
+	if len(got.Tags) != 0 {
+		t.Fatalf("non-nil empty override Tags should replace base, got %v", got.Tags)
+	}
+	if got.Host != "h" {
+		t.Fatalf("host = %q, want %q", got.Host, "h")
+	}
+}
+
+func TestMergeDoesNotModifyArguments(t *testing.T) {
+	base := Config{Host: "h", Tags: []string{"a", "b"}}
+	override := Config{Port: 1, Tags: []string{"x"}}
+	baseBefore := append([]string(nil), base.Tags...)
+	overrideBefore := append([]string(nil), override.Tags...)
+	Merge(base, override)
+	if len(override.Tags) != len(overrideBefore) {
+		t.Fatalf("override Tags mutated: %v", override.Tags)
+	}
+	if len(base.Tags) != 2 {
+		t.Fatalf("base Tags length mutated: %v", base.Tags)
+	}
+	for i, s := range baseBefore {
+		if base.Tags[i] != s {
+			t.Fatalf("base Tags mutated: %v", base.Tags)
+		}
+	}
+}
