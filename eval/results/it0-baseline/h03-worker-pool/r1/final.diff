+// Results must be returned in input order even when they complete out of
+// order and concurrency makes completion order vary.
+func TestOrderWithManyWorkers(t *testing.T) {
+	in := make([]int, 100)
+	for i := range in {
+		in[i] = i
+	}
+	out, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+		// Lower indices finish slower, so results arrive out of order.
+		time.Sleep(time.Duration(200-x) * time.Microsecond)
+		return x * x, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != len(in) {
+		t.Fatalf("len(out) = %d, want %d", len(out), len(in))
+	}
+	for i, got := range out {
+		want := in[i] * in[i]
+		if got != want {
+			t.Fatalf("out[%d] = %d, want %d", i, got, want)
+		}
+	}
+}
+
+// A failing input whose result arrives LATER must win over one whose result
+// arrives earlier; Map must report the lowest failing index.
+func TestErrorIsLowestIndex(t *testing.T) {
+	in := make([]int, 200)
+	for i := range in {
+		in[i] = i
+	}
+	var active atomic.Int32
+	var maxExecuted atomic.Int32
+	base := runtime.NumGoroutine()
+	out, err := Map(context.Background(), in, 4, func(_ context.Context, x int) (int, error) {
+		active.Add(1)
+		defer active.Add(-1)
+		if int32(x) > maxExecuted.Load() {
+			maxExecuted.Store(int32(x))
+		}
+		switch x {
+		case 3, 7, 11: // higher failing indices fail sooner, so they arrive first
+			d := time.Duration(20-2*(x-3)) * time.Millisecond
+			if d > 0 {
+				time.Sleep(d)
+			}
+			return 0, fmt.Errorf("input %d failed", x)
+		default:
+			time.Sleep(time.Millisecond)
+			return x, nil
+		}
+	})
+	if out != nil {
+		t.Fatalf("out = %v, want nil on error", out)
+	}
+	var ie *IndexError
+	if !errors.As(err, &ie) {
+		t.Fatalf("err = %v, want *IndexError", err)
+	}
+	if ie.Index != 3 {
+		t.Fatalf("Index = %d, want 3", ie.Index)
+	}
+	if got := ie.Err.Error(); got != "input 3 failed" {
+		t.Fatalf("wrapped err = %q, want %q", got, "input 3 failed")
+	}
+	// Map must stop handing out new inputs on the first failure.
+	waitFor(t, 5*time.Second, func() bool { return active.Load() == 0 })
+	if int(maxExecuted.Load()) >= 100 {
+		t.Fatalf("max executed input = %d, want well below 200 (work not stopped)", maxExecuted.Load())
+	}
+	waitFor(t, 5*time.Second, func() bool { return runtime.NumGoroutine() <= base })
+}
