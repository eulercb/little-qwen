+func TestCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	in := make([]int, 200)
+	for i := range in {
+		in[i] = i
+	}
+	var active atomic.Int32
+	base := runtime.NumGoroutine()
+	type outcome struct {
+		out []int
+		err error
+	}
+	done := make(chan outcome, 1)
+	go func() {
+		out, err := Map(ctx, in, 4, func(c context.Context, x int) (int, error) {
+			active.Add(1)
+			defer active.Add(-1)
+			// Cooperate with cancellation: block until ctx is done.
+			<-c.Done()
+			return 0, nil
+		})
+		done <- outcome{out, err}
+	}()
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		cancel()
+	}()
+	select {
+	case res := <-done:
+		if !errors.Is(res.err, context.Canceled) {
+			t.Fatalf("err = %v, want context.Canceled", res.err)
+		}
+		if res.out != nil {
+			t.Fatalf("out = %v, want nil", res.out)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("Map did not return after context cancellation")
+	}
+	// Map must wait for running calls to return, then let all goroutines exit.
+	waitFor(t, 5*time.Second, func() bool { return active.Load() == 0 })
+	waitFor(t, 5*time.Second, func() bool { return runtime.NumGoroutine() <= base })
+}
+
+// If the context is already cancelled before Map is called, Map must return
+// promptly without running the whole batch.
+func TestAlreadyCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var ran atomic.Int32
+	out, err := Map(ctx, make([]int, 50), 2, func(_ context.Context, x int) (int, error) {
+		ran.Add(1)
+		select {
+		case <-ctx.Done():
+			return 0, nil
+		}
+	})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+	if out != nil {
+		t.Fatalf("out = %v, want nil", out)
+	}
+	if ran.Load() > 2 {
+		t.Fatalf("fn ran %d times on a pre-cancelled ctx, want at most workers", ran.Load())
+	}
+}
+
+func waitFor(t *testing.T, timeout time.Duration, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for condition")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
