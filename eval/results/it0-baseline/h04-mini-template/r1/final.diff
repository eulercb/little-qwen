+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRenderText(t *testing.T) {
+	got, err := Render("Hello, world!\nNo tags here.}}", nil)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if want := "Hello, world!\nNo tags here.}}"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRenderLiteralBraces(t *testing.T) {
+	got, err := Render("a{{{{ }}b{{{{{c}}d", map[string]any{"c": "C"})
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if want := "a{{ }}b{{{c}}d"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRenderBasic(t *testing.T) {
+	data := map[string]any{
+		"name":  "World",
+		"count": 42,
+		"ratio": 1.5,
+		"ok":    true,
+		"no":    false,
+		"none":  nil,
+	}
+	cases := []struct {
+		src, want string
+	}{
+		{"{{name}}", "World"},
+		{"{{ name }}", "World"},
+		{"{{name|}}", "World"},
+		{"{{name|}}", "World"},
+		{"{{   name   }}", "World"},
+		{"{{count}}", "42"},
+		{"{{ratio}}", "1.5"},
+		{"{{ok}}", "true"},
+		{"{{no}}", "false"},
+		{"{{none}}", ""},
+		{"{{missing}}", ""},
+		{"{{ missing }}", ""},
+		{"[{{name}}/{{count}}]", "[World/42]"},
+	}
+	for _, tc := range cases {
+		got, err := Render(tc.src, data)
+		if err != nil {
+			t.Errorf("Render(%q) error: %v", tc.src, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("Render(%q) = %q, want %q", tc.src, got, tc.want)
+		}
+	}
+}
+
+func TestRenderNested(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name":  "Bob",
+			"email": "bob@example.com",
+		},
+	}
+	cases := []struct {
+		src, want string
+	}{
+		{"{{user.name}}", "Bob"},
+		{"{{ user.name }}", "Bob"},
+		{"{{user.email}}", "bob@example.com"},
+		{"{{user.missing}}", ""},
+		{"{{missing.name}}", ""},
+		{"{{missing.name.first}}", ""},
+	}
+	for _, tc := range cases {
+		got, err := Render(tc.src, data)
+		if err != nil {
+			t.Errorf("Render(%q) error: %v", tc.src, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("Render(%q) = %q, want %q", tc.src, got, tc.want)
+		}
+	}
+}
+
+func TestRenderNestedErrors(t *testing.T) {
+	data := map[string]any{
+		"user": "just a string",
+		"deep": map[string]any{"mid": 3.14},
+	}
+	cases := []struct {
+		src, wantSub string
+	}{
+		{"{{user.name}}", "user.name"},
+		{"{{user.name.first}}", "user.name.first"},
+		{"{{deep.mid.real}}", "deep.mid.real"},
+	}
+	for _, tc := range cases {
+		out, err := Render(tc.src, data)
+		if err == nil {
+			t.Errorf("Render(%q) = %q, expected error containing %q", tc.src, out, tc.wantSub)
+			continue
+		}
+		if out != "" {
+			t.Errorf("Render(%q) output = %q, want empty", tc.src, out)
+		}
+		if !strings.Contains(err.Error(), tc.wantSub) {
+			t.Errorf("Render(%q) error = %q, want it to contain %q", tc.src, err, tc.wantSub)
+		}
+	}
+}
+
+func TestRenderFilters(t *testing.T) {
+	data := map[string]any{
+		"name":  "  MiXeD  ",
+		"word":  "hello",
+		"empty": "",
+		"html":  `<a href="x">&'</a>`,
+	}
+	cases := []struct {
+		src, want string
+	}{
+		{"{{name|upper}}", "  MIXED  "},
+		{"{{name|lower}}", "  mixed  "},
+		{"{{name|trim}}", "MiXeD"},
+		{"{{name | trim | upper }}", "MIXED"},
+		{"{{name|trim|upper|lower}}", "mixed"},
+		{"{{empty|default:\"-\"}}", "-"},
+		{"{{name|default:\"-\"}}", "  MiXeD  "},
+		{"{{missing|default:\"x\"}}", "x"},
+		{"{{word|truncate:\"2\"}}", "he…"},
+		{"{{word|truncate:\"5\"}}", "hello"},
+		{"{{word|truncate:\"0\"}}", "…"},
+		{"{{html|html}}", "&lt;a href=&#34;x&#34;&gt;&amp;&#39;&lt;/a&gt;"},
+		{"{{html|html|upper}}", "&LT;A HREF=&#34;X&#34;&GT;&AMP;&#39;&LT;/A&GT;"},
+		{"{{empty|default:\"a\\\"b\\\\c\"}}", "a\"b\\c"},
+	}
+	for _, tc := range cases {
+		got, err := Render(tc.src, data)
+		if err != nil {
+			t.Errorf("Render(%q) error: %v", tc.src, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("Render(%q) = %q, want %q", tc.src, got, tc.want)
+		}
+	}
+}
+
+func TestRenderFilterErrors(t *testing.T) {
+	data := map[string]any{"name": "x"}
+	cases := []struct {
+		src, wantSub string
+	}{
+		{"{{name|uppr}}", "uppr"},
+		{"{{name|uppr:\"a\"}}", "uppr"},
+		{"{{name|upper:\"x\"}}", "upper"},
+		{"{{name|trim:1}}", "trim"},
+		{"{{name|default}}", "default"},
+		{"{{name|default:\"a\" b}}", "default"},
+		{"{{name|default:\"a", "unterminated"}, // no closing }}
+		{"{{name|truncate}}", "truncate"},
+		{"{{name|truncate:\"abc\"}}", "truncate"},
+		{"{{name|truncate:\"-1\"}}", "truncate"},
+	}
+	for _, tc := range cases {
+		out, err := Render(tc.src, data)
+		if err == nil {
+			t.Errorf("Render(%q) = %q, expected error", tc.src, out)
+			continue
+		}
+		if out != "" {
+			t.Errorf("Render(%q) output = %q, want empty", tc.src, out)
+		}
+		if tc.wantSub != "" && !strings.Contains(err.Error(), tc.wantSub) {
+			t.Errorf("Render(%q) error = %q, want it to contain %q", tc.src, err, tc.wantSub)
+		}
+	}
+}
+
+func TestRenderTagErrors(t *testing.T) {
+	data := map[string]any{"name": "x"}
+	cases := []string{
+		"{{name",           // unterminated tag
+		"{{",               // unterminated tag
+		"{{ }}",            // empty tag
+		"{{   }}",          // empty tag
+		"{{1abc}}",         // bad name
+		"{{}}",             // empty tag
+		"{{|upper}}",       // bad name
+		"{{name| | uppr}}", // unknown filter in the middle
+	}
+	for _, src := range cases {
+		out, err := Render(src, data)
+		if err == nil {
+			t.Errorf("Render(%q) = %q, expected error", src, out)
+			continue
+		}
+		if out != "" {
+			t.Errorf("Render(%q) output = %q, want empty", src, out)
+		}
+	}
+
+	// specific messages
+	if _, err := Render("{{ }}", data); err == nil || !strings.Contains(err.Error(), "empty tag") {
+		t.Errorf("want an empty-tag error, got %v", err)
+	}
+	if _, err := Render("{{name", data); err == nil || !strings.Contains(err.Error(), "unterminated") {
+		t.Errorf("want an unterminated-tag error, got %v", err)
+	}
+	if _, err := Render("{{1abc}}", data); err == nil || !strings.Contains(err.Error(), "bad name") {
+		t.Errorf("want a bad-name error, got %v", err)
+	}
+}
+
+func TestRenderErrorsReturnEmptyOutput(t *testing.T) {
+	got, err := Render("ok {{name|nope}} bad", map[string]any{"name": "x"})
+	if err == nil || !strings.Contains(err.Error(), "nope") {
+		t.Fatalf("err = %v, want unknown-filter error", err)
+	}
+	if got != "" {
+		t.Fatalf("output = %q, want empty", got)
+	}
+}
+
+func TestRenderUnquotedArgument(t *testing.T) {
+	data := map[string]any{"name": ""}
+	if _, err := Render(`{{name|default:x}}`, data); err == nil {
+		t.Fatal("expected error for unquoted argument")
+	}
+}
