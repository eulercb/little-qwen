+// Package tmpl implements a tiny text template engine.
+//
+// A template is plain text that may contain tags of the form
+//
+//	{{ name | filter | filter:"arg" }}
+//
+// where name resolves a value from a data map (with optional .field
+// segments for nested maps) and filters are applied left to right to the
+// resulting string. The sequence {{{{ renders a literal {{ and does not
+// start a tag.
+package tmpl
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Render renders src using data and returns the resulting text.
+func Render(src string, data map[string]any) (string, error) {
+	var out strings.Builder
+	for i := 0; i < len(src); {
+		if src[i] == '{' && i+1 < len(src) && src[i+1] == '{' {
+			if i+4 <= len(src) && src[i+2] == '{' && src[i+3] == '{' {
+				// {{{{ renders a literal {{ and is not a tag.
+				out.WriteString("{{")
+				i += 4
+				continue
+			}
+			end := strings.Index(src[i+2:], "}}")
+			if end < 0 {
+				return "", fmt.Errorf("unterminated tag starting at %d", i)
+			}
+			val, err := renderTag(src[i+2:i+2+end], data)
+			if err != nil {
+				return "", err
+			}
+			out.WriteString(val)
+			i += end + 4
+			continue
+		}
+		out.WriteByte(src[i])
+		i++
+	}
+	return out.String(), nil
+}
+
+// renderTag renders a single tag body (the text between {{ and }}).
+func renderTag(body string, data map[string]any) (string, error) {
+	p := &tagParser{s: strings.TrimSpace(body)}
+	if p.i >= len(p.s) {
+		return "", fmt.Errorf("empty tag")
+	}
+	name, err := p.parseName()
+	if err != nil {
+		return "", err
+	}
+	v, err := resolve(data, name)
+	if err != nil {
+		return "", err
+	}
+	s := formatValue(v)
+	for {
+		p.skipSpace()
+		if p.i >= len(p.s) {
+			break
+		}
+		if p.s[p.i] != '|' {
+			return "", fmt.Errorf("unexpected character %q in tag", p.s[p.i])
+		}
+		p.i++
+		s, err = p.applyFilter(s)
+		if err != nil {
+			return "", err
+		}
+	}
+	return s, nil
+}
+
+// filterSpec describes a filter: whether it requires exactly one quoted
+// argument and how it transforms its string input.
+type filterSpec struct {
+	needsArg bool
+	fn       func(value, arg string) (string, error)
+}
+
+var htmlEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&#34;",
+	"'", "&#39;",
+)
+
+var filters = map[string]filterSpec{
+	"upper": {false, func(v, _ string) (string, error) {
+		return strings.ToUpper(v), nil
+	}},
+	"lower": {false, func(v, _ string) (string, error) {
+		return strings.ToLower(v), nil
+	}},
+	"trim": {false, func(v, _ string) (string, error) {
+		return strings.TrimSpace(v), nil
+	}},
+	"html": {false, func(v, _ string) (string, error) {
+		return htmlEscaper.Replace(v), nil
+	}},
+	"default": {true, func(v, arg string) (string, error) {
+		if v == "" {
+			return arg, nil
+		}
+		return v, nil
+	}},
+	"truncate": {true, func(v, arg string) (string, error) {
+		n, err := strconv.Atoi(arg)
+		if err != nil {
+			return "", fmt.Errorf("truncate: argument %q is not an integer", arg)
+		}
+		if n < 0 {
+			return "", fmt.Errorf("truncate: argument %q must not be negative", arg)
+		}
+		r := []rune(v)
+		if len(r) <= n {
+			return v, nil
+		}
+		return string(r[:n]) + "\u2026", nil
+	}},
+}
+
+// resolve looks up name (with optional .field segments) in data. A missing
+// or nil value resolves to nil; indexing a .field into a non-nil value that
+// is not a map is an error.
+func resolve(data map[string]any, name string) (any, error) {
+	parts := strings.Split(name, ".")
+	v, ok := data[parts[0]]
+	if !ok || v == nil {
+		v = nil
+	}
+	for _, part := range parts[1:] {
+		m, isMap := v.(map[string]any)
+		if !isMap {
+			if v == nil {
+				// The value was missing; it stays empty, no error.
+				continue
+			}
+			return nil, fmt.Errorf("indexing %s into a value that is not a map", name)
+		}
+		nv, ok := m[part]
+		if !ok || nv == nil {
+			v = nil
+			continue
+		}
+		v = nv
+	}
+	return v, nil
+}
+
+// formatValue renders a resolved value as a string.
+func formatValue(v any) string {
+	switch x := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return x
+	case bool:
+		if x {
+			return "true"
+		}
+		return "false"
+	case int, int64, float64:
+		return fmt.Sprint(x)
+	default:
+		return fmt.Sprint(x)
+	}
+}
+
+// tagParser is a small position-based parser over a tag body.
+type tagParser struct {
+	s string
+	i int
+}
+
+func (p *tagParser) skipSpace() {
+	for p.i < len(p.s) && (p.s[p.i] == ' ' || p.s[p.i] == '\t') {
+		p.i++
+	}
+}
+
+func isIdentStart(c byte) bool {
+	return c == '_' || 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z'
+}
+
+func isIdent(c byte) bool {
+	return isIdentStart(c) || '0' <= c && c <= '9'
+}
+
+// parseName parses name[.field...].
+func (p *tagParser) parseName() (string, error) {
+	p.skipSpace()
+	if p.i >= len(p.s) || !isIdentStart(p.s[p.i]) {
+		return "", fmt.Errorf("bad name in tag %q", p.s)
+	}
+	var name strings.Builder
+	for p.i < len(p.s) && isIdent(p.s[p.i]) {
+		name.WriteByte(p.s[p.i])
+		p.i++
+	}
+	for p.i < len(p.s) && p.s[p.i] == '.' {
+		p.i++
+		if p.i >= len(p.s) || !isIdentStart(p.s[p.i]) {
+			return "", fmt.Errorf("bad name in tag %q", p.s)
+		}
+		name.WriteByte('.')
+		for p.i < len(p.s) && isIdent(p.s[p.i]) {
+			name.WriteByte(p.s[p.i])
+			p.i++
+		}
+	}
+	return name.String(), nil
+}
+
+// parseIdent parses a bare identifier.
+func (p *tagParser) parseIdent() (string, error) {
+	if p.i >= len(p.s) || !isIdentStart(p.s[p.i]) {
+		return "", fmt.Errorf("expected an identifier, tag body is %q", p.s)
+	}
+	start := p.i
+	for p.i < len(p.s) && isIdent(p.s[p.i]) {
+		p.i++
+	}
+	return p.s[start:p.i], nil
+}
+
+// parseArg parses a double-quoted argument supporting \" and \\ escapes.
+func (p *tagParser) parseArg() (string, error) {
+	if p.i >= len(p.s) || p.s[p.i] != '"' {
+		return "", fmt.Errorf("missing argument")
+	}
+	p.i++
+	var b strings.Builder
+	for p.i < len(p.s) {
+		c := p.s[p.i]
+		if c == '"' {
+			p.i++
+			return b.String(), nil
+		}
+		if c == '\\' {
+			if p.i+1 >= len(p.s) {
+				return "", fmt.Errorf("unterminated argument")
+			}
+			n := p.s[p.i+1]
+			if n != '"' && n != '\\' {
+				return "", fmt.Errorf("invalid escape in argument")
+			}
+			b.WriteByte(n)
+			p.i += 2
+			continue
+		}
+		b.WriteByte(c)
+		p.i++
+	}
+	return "", fmt.Errorf("unterminated argument")
+}
+
+// applyFilter parses and applies one filter to s.
+func (p *tagParser) applyFilter(s string) (string, error) {
+	p.skipSpace()
+	fn, err := p.parseIdent()
+	if err != nil {
+		return "", fmt.Errorf("invalid filter: %v", err)
+	}
+	spec, ok := filters[fn]
+	if !ok {
+		return "", fmt.Errorf("unknown filter %q", fn)
+	}
+	p.skipSpace()
+	hasArg := p.i < len(p.s) && p.s[p.i] == ':'
+	if hasArg {
+		p.i++
+		p.skipSpace()
+	}
+	var arg string
+	if hasArg {
+		arg, err = p.parseArg()
+		if err != nil {
+			return "", fmt.Errorf("filter %q: %v", fn, err)
+		}
+	}
+	if spec.needsArg != hasArg {
+		verb := "missing"
+		if !spec.needsArg {
+			verb = "extra"
+		}
+		return "", fmt.Errorf("filter %q: %s argument", fn, verb)
+	}
+	if !spec.needsArg {
+		return spec.fn(s, "")
+	}
+	return spec.fn(s, arg)
+}
diff --git a/tmpl/tmpl_test.go b/tmpl/tmpl_test.go
new file mode 100644
index 0000000..530562a
