@@ -0,0 +1,101 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRender(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		data map[string]any
+		want string
+		err  string // expected error substring; empty means no error
+	}{
+		{name: "text only", src: "hello world", data: nil, want: "hello world"},
+		{name: "empty template", src: "", data: nil, want: ""},
+		{name: "no data map", src: "x {{ a }} y", data: nil, want: "x  y"},
+		{name: "simple value", src: "{{ name }}", data: map[string]any{"name": "Ada"}, want: "Ada"},
+		{name: "whitespace ignored", src: "{{  name  }}", data: map[string]any{"name": "Ada"}, want: "Ada"},
+		{name: "missing name", src: "a {{ nope }} b", data: map[string]any{}, want: "a  b"},
+		{name: "explicit nil", src: "a {{ x }} b", data: map[string]any{"x": nil}, want: "a  b"},
+		{name: "int", src: "{{ n }}", data: map[string]any{"n": 42}, want: "42"},
+		{name: "int64", src: "{{ n }}", data: map[string]any{"n": int64(7)}, want: "7"},
+		{name: "float64", src: "{{ f }}", data: map[string]any{"f": 1.5}, want: "1.5"},
+		{name: "bool true", src: "{{ b }}", data: map[string]any{"b": true}, want: "true"},
+		{name: "bool false", src: "{{ b }}", data: map[string]any{"b": false}, want: "false"},
+		{name: "nested", src: "{{ user.name }}",
+			data: map[string]any{"user": map[string]any{"name": "Bob", "age": 30}}, want: "Bob"},
+		{name: "nested missing", src: "{{ user.name }}", data: map[string]any{"user": map[string]any{}}, want: ""},
+		{name: "nested deep missing", src: "{{ user.name.first }}",
+			data: map[string]any{"user": map[string]any{}}, want: ""},
+		{name: "literal braces", src: "a{{{{b", data: nil, want: "a{{b"},
+		{name: "literal braces in tag", src: "{{{{ name }}", data: map[string]any{"name": "x"}, want: "{{ name }}"},
+		{name: "two values", src: "{{ a }} and {{ b }}",
+			data: map[string]any{"a": "x", "b": "y"}, want: "x and y"},
+
+		{name: "upper", src: "{{ s | upper }}", data: map[string]any{"s": "Hello"}, want: "HELLO"},
+		{name: "lower", src: "{{ s | lower }}", data: map[string]any{"s": "Hello"}, want: "hello"},
+		{name: "trim", src: "{{ s | trim }}", data: map[string]any{"s": "  a b  "}, want: "a b"},
+		{name: "trim unicode", src: "{{ s | trim }}", data: map[string]any{"s": " \t hi\n"}, want: "hi"},
+		{name: "default on empty", src: `{{ s | default:"x" }}`, data: map[string]any{"s": ""}, want: "x"},
+		{name: "default on missing", src: `{{ s | default:"x" }}`, data: map[string]any{}, want: "x"},
+		{name: "default keeps value", src: `{{ s | default:"x" }}`, data: map[string]any{"s": "y"}, want: "y"},
+		{name: "truncate cuts", src: `{{ s | truncate:"2" }}`, data: map[string]any{"s": "hello"}, want: "he\u2026"},
+		{name: "truncate exact length", src: `{{ s | truncate:"3" }}`, data: map[string]any{"s": "hel"}, want: "hel"},
+		{name: "truncate zero", src: `{{ s | truncate:"0" }}`, data: map[string]any{"s": "hi"}, want: "\u2026"},
+		{name: "truncate zero empty", src: `{{ s | truncate:"0" }}`, data: map[string]any{}, want: ""},
+		{name: "truncate counts runes", src: `{{ s | truncate:"2" }}`, data: map[string]any{"s": "héllö"}, want: "hé\u2026"},
+		{name: "html", src: `{{ s | html }}`,
+			data: map[string]any{"s": `<a href="x">&'</a>`}, want: `&lt;a href=&#34;x&#34;&gt;&amp;&#39;&lt;/a&gt;`},
+		{name: "html no double escape", src: `{{ s | html }}`, data: map[string]any{"s": "&amp;"}, want: "&amp;amp;"},
+		{name: "chained filters", src: "{{ s | upper | trim }}", data: map[string]any{"s": "  a  "}, want: "A"},
+		{name: "chained default then upper", src: `{{ s | default:"hi" | upper }}`, data: map[string]any{"s": ""}, want: "HI"},
+		{name: "whitespace around pipes", src: `{{s| trim |default : "x"}}`, data: map[string]any{"s": "  "}, want: "x"},
+		{name: "escaped quote in arg", src: `{{ s | default:"a\"b" }}`, data: map[string]any{}, want: `a"b`},
+		{name: "escaped backslash in arg", src: `{{ s | default:"a\\b" }}`, data: map[string]any{}, want: `a\b`},
+		{name: "pipe in arg", src: `{{ s | default:"a|b" }}`, data: map[string]any{}, want: "a|b"},
+
+		{name: "err unknown filter", src: `{{ s | nope }}`, data: map[string]any{"s": "x"}, err: "nope"},
+		{name: "err extra arg", src: `{{ s | upper:"x" }}`, data: map[string]any{"s": "x"}, err: "upper"},
+		{name: "err missing arg", src: `{{ s | default }}`, data: map[string]any{"s": "x"}, err: "default"},
+		{name: "err truncate non integer", src: `{{ s | truncate:"a" }}`, data: map[string]any{"s": "x"}, err: "truncate"},
+		{name: "err truncate negative", src: `{{ s | truncate:"-1" }}`, data: map[string]any{"s": "x"}, err: "truncate"},
+		{name: "err unterminated tag", src: `{{ name`, data: nil, err: "unterminated"},
+		{name: "err unterminated tag 2", src: `a {{ name b`, data: nil, err: "unterminated"},
+		{name: "err empty tag", src: `{{ }}`, data: nil, err: "empty"},
+		{name: "err empty tag braces", src: `{{}}`, data: nil, err: "empty"},
+		{name: "err bad name", src: `{{ 123 }}`, data: nil, err: "name"},
+		{name: "err bad name dot", src: `{{ a.1 }}`, data: nil, err: "name"},
+		{name: "err bad filter name", src: `{{ s | 1 }}`, data: map[string]any{"s": "x"}, err: "filter"},
+		{name: "err non-map index", src: `{{ user.name.first }}`,
+			data: map[string]any{"user": map[string]any{"name": "s"}}, err: "user.name.first"},
+		{name: "err non-map index top", src: `{{ user.first }}`,
+			data: map[string]any{"user": "s"}, err: "user.first"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Render(tc.src, tc.data)
+			if tc.err == "" {
+				if err != nil {
+					t.Fatalf("Render(%q, %v) = %q, unexpected error: %v", tc.src, tc.data, got, err)
+				}
+				if got != tc.want {
+					t.Errorf("Render(%q, %v) = %q, want %q", tc.src, tc.data, got, tc.want)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("Render(%q, %v) = %q, expected error containing %q, got none", tc.src, tc.data, got, tc.err)
+			}
+			if !strings.Contains(err.Error(), tc.err) {
+				t.Errorf("error %q does not contain %q", err, tc.err)
+			}
+			if got != "" {
+				t.Errorf("output on error = %q, want empty", got)
+			}
+		})
+	}
+}
