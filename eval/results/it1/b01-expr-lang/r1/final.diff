--- /dev/null
+++ b/expr/ast.go
@@ -0,0 +1,55 @@
+package expr
+
+import "fmt"
+
+// node is an internal AST node produced by the parser.
+type node interface {
+	evaluate(vars map[string]float64) (float64, *Error)
+}
+
+type numNode struct {
+	pos int
+	val float64
+}
+
+func (n *numNode) evaluate(map[string]float64) (float64, *Error) { return n.val, nil }
+
+type varNode struct {
+	pos  int
+	name string
+}
+
+func (n *varNode) evaluate(vars map[string]float64) (float64, *Error) {
+	v, ok := vars[n.name]
+	if !ok {
+		return 0, &Error{Pos: n.pos, Msg: fmt.Sprintf("unknown variable %q", n.name)}
+	}
+	return v, nil
+}
+
+type unaryNode struct {
+	pos     int
+	op      string
+	operand node
+}
+
+type binaryNode struct {
+	pos   int
+	op    string
+	left  node
+	right node
+}
+
+type ternaryNode struct {
+	pos  int
+	cond node
+	then node
+	els  node
+}
+
+type callNode struct {
+	pos  int
+	name string
+	fn   *builtin
+	args []node
+}
