+package expr
+
+import "fmt"
+
+// Error is the error type returned by all API functions.
+type Error struct {
+	Pos int // 0-based byte offset in the source where the problem is
+	Msg string
+}
+
+func (e *Error) Error() string { return fmt.Sprintf("%d: %s", e.Pos, e.Msg) }
diff --git a/expr/eval.go b/expr/eval.go
new file mode 100644
index 0000000..8cbe870
--- /dev/null
+++ b/expr/eval.go
@@ -0,0 +1,213 @@
+package expr
+
+import (
+	"fmt"
+	"math"
+)
+
+// builtin describes a built-in function: arity bounds and implementation.
+// For fixed-arity functions minArity == maxArity; for min/max, maxArity < 0
+// means "unbounded".
+type builtin struct {
+	minArity int
+	maxArity int
+	call     func(args []float64, pos int) (float64, *Error)
+}
+
+func checkArity(name string, minArg, maxArg, got, pos int) *Error {
+	if maxArg < 0 {
+		if got < minArg {
+			return &Error{Pos: pos, Msg: fmt.Sprintf("function %q expects at least %d argument, got %d", name, minArg, got)}
+		}
+		return nil
+	}
+	if got < minArg || got > maxArg {
+		return &Error{Pos: pos, Msg: fmt.Sprintf("function %q expects %d arguments, got %d", name, minArg, got)}
+	}
+	return nil
+}
+
+var builtins = map[string]*builtin{
+	"abs": {1, 1, func(a []float64, _ int) (float64, *Error) {
+		return math.Abs(a[0]), nil
+	}},
+	"sqrt": {1, 1, func(a []float64, pos int) (float64, *Error) {
+		if a[0] < 0 {
+			return 0, &Error{Pos: pos, Msg: "sqrt of negative number"}
+		}
+		return math.Sqrt(a[0]), nil
+	}},
+	"round": {1, 1, func(a []float64, _ int) (float64, *Error) {
+		return math.Round(a[0]), nil
+	}},
+	"clamp": {3, 3, func(a []float64, _ int) (float64, *Error) {
+		return math.Min(math.Max(a[0], a[1]), a[2]), nil
+	}},
+	"min": {1, -1, func(a []float64, _ int) (float64, *Error) {
+		v := a[0]
+		for _, x := range a[1:] {
+			v = math.Min(v, x)
+		}
+		return v, nil
+	}},
+	"max": {1, -1, func(a []float64, _ int) (float64, *Error) {
+		v := a[0]
+		for _, x := range a[1:] {
+			v = math.Max(v, x)
+		}
+		return v, nil
+	}},
+}
+
+// truthy reports whether v is non-zero.
+func truthy(v float64) bool { return v != 0 }
+
+func boolVal(v float64) float64 {
+	if truthy(v) {
+		return 1
+	}
+	return 0
+}
+
+func (p *Program) Eval(vars map[string]float64) (float64, error) {
+	v, err := p.root.evaluate(vars)
+	if err != nil {
+		return 0, err
+	}
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return 0, &Error{Pos: 0, Msg: "result is not finite"}
+	}
+	return v, nil
+}
+
+func (n *unaryNode) evaluate(vars map[string]float64) (float64, *Error) {
+	v, err := n.operand.evaluate(vars)
+	if err != nil {
+		return 0, err
+	}
+	switch n.op {
+	case "-":
+		return -v, nil
+	case "+":
+		return +v, nil
+	case "!":
+		if v == 0 {
+			return 1, nil
+		}
+		return 0, nil
+	}
+	panic("unreachable: bad unary op")
+}
+
+func (n *binaryNode) evaluate(vars map[string]float64) (float64, *Error) {
+	switch n.op {
+	case "&&":
+		l, err := n.left.evaluate(vars)
+		if err != nil {
+			return 0, err
+		}
+		if !truthy(l) {
+			return 0, nil
+		}
+		r, err := n.right.evaluate(vars)
+		if err != nil {
+			return 0, err
+		}
+		return boolVal(r), nil
+	case "||":
+		l, err := n.left.evaluate(vars)
+		if err != nil {
+			return 0, err
+		}
+		if truthy(l) {
+			return 1, nil
+		}
+		r, err := n.right.evaluate(vars)
+		if err != nil {
+			return 0, err
+		}
+		return boolVal(r), nil
+	}
+	l, err := n.left.evaluate(vars)
+	if err != nil {
+		return 0, err
+	}
+	r, err := n.right.evaluate(vars)
+	if err != nil {
+		return 0, err
+	}
+	switch n.op {
+	case "+":
+		return l + r, nil
+	case "-":
+		return l - r, nil
+	case "*":
+		return l * r, nil
+	case "/":
+		if r == 0 {
+			return 0, &Error{Pos: n.pos, Msg: "division by zero"}
+		}
+		return l / r, nil
+	case "%":
+		if r == 0 {
+			return 0, &Error{Pos: n.pos, Msg: "division by zero"}
+		}
+		return math.Mod(l, r), nil
+	case "^":
+		return math.Pow(l, r), nil
+	case "==":
+		if l == r {
+			return 1, nil
+		}
+		return 0, nil
+	case "!=":
+		if l != r {
+			return 1, nil
+		}
+		return 0, nil
+	case "<":
+		if l < r {
+			return 1, nil
+		}
+		return 0, nil
+	case "<=":
+		if l <= r {
+			return 1, nil
+		}
+		return 0, nil
+	case ">":
+		if l > r {
+			return 1, nil
+		}
+		return 0, nil
+	case ">=":
+		if l >= r {
+			return 1, nil
+		}
+		return 0, nil
+	}
+	panic("unreachable: bad binary op")
+}
+
+func (n *ternaryNode) evaluate(vars map[string]float64) (float64, *Error) {
+	c, err := n.cond.evaluate(vars)
+	if err != nil {
+		return 0, err
+	}
+	if truthy(c) {
+		return n.then.evaluate(vars)
+	}
+	return n.els.evaluate(vars)
+}
+
+func (n *callNode) evaluate(vars map[string]float64) (float64, *Error) {
+	args := make([]float64, len(n.args))
+	for i, a := range n.args {
+		v, err := a.evaluate(vars)
+		if err != nil {
+			return 0, err
+		}
+		args[i] = v
+	}
+	return n.fn.call(args, n.pos)
+}
diff --git a/expr/expr.go b/expr/expr.go
new file mode 100644
index 0000000..d382baf
--- /dev/null
+++ b/expr/expr.go
@@ -0,0 +1,73 @@
+package expr
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Program is a compiled expression, ready for repeated evaluation.
+type Program struct {
+	root node
+	vars []string
+}
+
+// Vars returns the sorted, de-duplicated variable names referenced by the program.
+func (p *Program) Vars() []string {
+	out := make([]string, len(p.vars))
+	copy(out, p.vars)
+	return out
+}
+
+// Compile parses src once. It returns a *Error on syntax errors.
+func Compile(src string) (*Program, error) {
+	toks, err := tokenize(src)
+	if err != nil {
+		return nil, err
+	}
+	p := &parser{toks: toks, srcLen: len(src)}
+	root, err := p.parseExpr()
+	if err != nil {
+		return nil, err
+	}
+	if !p.atEOF() {
+		t := p.peek()
+		return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unexpected token %q", t.text)}
+	}
+	m := map[string]bool{}
+	collectVars(root, m)
+	names := make([]string, 0, len(m))
+	for name := range m {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return &Program{root: root, vars: names}, nil
+}
+
+// Eval evaluates a source expression once with the given variables.
+func Eval(src string, vars map[string]float64) (float64, error) {
+	p, err := Compile(src)
+	if err != nil {
+		return 0, err
+	}
+	return p.Eval(vars)
+}
+
+func collectVars(n node, m map[string]bool) {
+	switch v := n.(type) {
+	case *varNode:
+		m[v.name] = true
+	case *unaryNode:
+		collectVars(v.operand, m)
+	case *binaryNode:
+		collectVars(v.left, m)
+		collectVars(v.right, m)
+	case *ternaryNode:
+		collectVars(v.cond, m)
+		collectVars(v.then, m)
+		collectVars(v.els, m)
+	case *callNode:
+		for _, a := range v.args {
+			collectVars(a, m)
+		}
+	}
+}
