+func TestVersionMigration(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "t.json")
+	v1 := `{"version": 1, "next_id": 2, "tasks": [
+		{"id": 1, "title": "old", "priority": 3, "done": false, "created": "2026-01-01T00:00:00Z"}]}`
+	if err := os.WriteFile(p, []byte(v1), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := s.All()
+	if len(all) != 1 || all[0].Title != "old" || len(all[0].Tags) != 0 || all[0].Due != nil {
+		t.Fatalf("%+v", all)
+	}
+	due := time.Date(2026, 4, 15, 0, 0, 0, 0, time.UTC)
+	if _, err := s.Add(model.Task{Title: "new", Priority: 2, Tags: []string{"home"}, Due: &due}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), `"version": 2`) {
+		t.Fatalf("saved file is not version 2: %s", data)
+	}
+	s2, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := s2.All()[1]
+	if got.ID != 2 || strings.Join(got.Tags, ",") != "home" || got.Due == nil || !got.Due.Equal(due) {
+		t.Fatalf("%+v", got)
+	}
+}
