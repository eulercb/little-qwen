+	}
+	got, err := Apply(ts, Options{Overdue: true, Today: today})
+	if err != nil || ids(got) != "1" {
+		t.Fatalf("got %v err %v, want 1", got, err)
+	}
+	// even with --all, overdue tasks must be open
+	got, _ = Apply(ts, Options{Overdue: true, IncludeDone: true, Today: today})
+	if ids(got) != "1" {
+		t.Fatalf("got %v, want 1", got)
+	}
+}
+
+func TestApplySortDue(t *testing.T) {
+	ts := []model.Task{
+		{ID: 3, Due: dueDate(t, "2026-03-10")},
+		{ID: 2},
+		{ID: 1, Due: dueDate(t, "2026-03-01")},
+		{ID: 4, Due: dueDate(t, "2026-03-01")}, // same due as 1: tie by ID
+	}
+	got, err := Apply(ts, Options{SortBy: "due"})
+	if err != nil || ids(got) != "1432" {
+		t.Fatalf("got %v err %v, want 1432", got, err)
+	}
+}
