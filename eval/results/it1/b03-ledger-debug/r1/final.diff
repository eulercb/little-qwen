-	return int64(float64(amount) * rate), nil
+	// Recover the exact decimal representation of the rate (e.g. 1.0825 ->
+	// 10825/10000) to avoid float rounding errors.
+	s := strconv.FormatFloat(rate, 'f', rateScale, 64)
+	num := s
+	den := int64(1)
+	if i := len(s) - 1 - rateScale; i >= 0 && s[i] == '.' {
+		num = s[:i] + s[i+1:]
+		den = 1
+		for i = 0; i < rateScale; i++ {
+			den *= 10
+		}
+	}
+	n, err := strconv.ParseInt(num, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("invalid rate %q: %w", s, err)
+	}
+	return roundHalfToEven(amount * n, den), nil
+}
+
+// roundHalfToEven rounds n/d (d > 0) to the nearest integer, ties to even.
+func roundHalfToEven(n, d int64) int64 {
+	sign := int64(1)
+	if n < 0 {
+		sign = -1
+		n = -n
+	}
+	q, r := n/d, n%d
+	switch {
+	case 2*r > d:
+		q++
+	case 2*r == d:
+		if q%2 == 1 {
+			q++
+		}
+	}
+	return sign * q
 }
 
