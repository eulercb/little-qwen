+func TestKeysGlob(t *testing.T) {
+	s := newStore(newFakeClock())
+	s.Set("user:1", "a", 0)
+	s.Set("user:2", "b", 0)
+	s.Set("user:10", "c", 0)
+	s.Set("item/1", "d", 0)
+	s.Set("apple", "e", 0)
+
+	if got := s.Keys("*"); len(got) != 5 {
+		t.Fatalf("Keys(*) = %v", got)
+	}
+	if got := s.Keys("user:*"); len(got) != 3 || got[0] != "user:1" || got[1] != "user:10" || got[2] != "user:2" {
+		t.Fatalf("Keys(user:*) = %v, want sorted [user:1 user:10 user:2]", got)
+	}
+	// * must match '/'
+	if got := s.Keys("item/*"); len(got) != 1 || got[0] != "item/1" {
+		t.Fatalf("Keys(item/*) = %v", got)
+	}
+	if got := s.Keys("user:?"); len(got) != 2 {
+		t.Fatalf("Keys(user:?) = %v", got)
+	}
+	if got := s.Keys("user:1?"); len(got) != 1 || got[0] != "user:10" {
+		t.Fatalf("Keys(user:1?) = %v", got)
+	}
+	if got := s.Keys("user:[12]"); len(got) != 2 {
+		t.Fatalf("Keys(user:[12]) = %v", got)
+	}
+	if got := s.Keys("user:[0-2]"); len(got) != 2 || got[0] != "user:1" || got[1] != "user:2" {
+		t.Fatalf("Keys(user:[0-2]) = %v", got)
+	}
+	if got := s.Keys("user:[!1]"); len(got) != 1 || got[0] != "user:2" {
+		t.Fatalf("Keys(user:[!1]) = %v", got)
+	}
+	if got := s.Keys("user:[^1]"); len(got) != 1 || got[0] != "user:2" {
+		t.Fatalf("Keys(user:[^1]) = %v", got)
+	}
+	s3 := newStore(newFakeClock())
+	s3.Set("user::", "f", 0)
+	if got := s3.Keys(`user:\:1`); len(got) != 0 {
+		t.Fatalf(`Keys(user:\:1) = %v, want empty`, got)
+	}
+	if got := s3.Keys(`user:\:`); len(got) != 1 || got[0] != "user::" {
+		t.Fatalf(`Keys(user:\:) = %v, want [user::]`, got)
+	}
+	if got := s.Keys("a?ple"); len(got) != 1 || got[0] != "apple" {
+		t.Fatalf("Keys(a?gle) = %v", got)
+	}
+	if got := s.Keys("a[bc]le"); len(got) != 0 {
+		t.Fatalf("Keys(a[bc]le) = %v, want empty", got)
+	}
+	if got := s.Keys(""); len(got) != 0 {
+		t.Fatalf(`Keys("") = %v, want empty`, got)
+	}
+	// expired keys are excluded
+	c := newFakeClock()
+	s2 := newStore(c)
+	s2.Set("k1", "v", time.Second)
+	s2.Set("k2", "v", 0)
+	c.Add(time.Minute)
+	if got := s2.Keys("*"); len(got) != 1 || got[0] != "k2" {
+		t.Fatalf("Keys after expiry = %v", got)
+	}
+}
