@@ -0,0 +1,262 @@
+// Package proto implements the line protocol: it parses one request line
+// against a *store.Store and returns the full response line(s), including
+// the trailing newline.
+package proto
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// errProtocol is an internal error for quoting/syntax problems.
+var errProtocol = errors.New("protocol error")
+
+// Exec parses one request line and returns the full response (including the
+// trailing "\n").
+func Exec(s *store.Store, line string) string {
+	toks, err := tokenize(line)
+	if err != nil {
+		return "-ERR syntax error\n"
+	}
+	if len(toks) == 0 {
+		return "-ERR empty command\n"
+	}
+	args := toks[1:]
+	switch strings.ToLower(toks[0]) {
+	case "ping":
+		if len(args) != 0 {
+			return wrongArgs("ping")
+		}
+		return "+PONG\n"
+	case "set":
+		switch len(args) {
+		case 2:
+			s.Set(args[0], args[1], 0)
+			return "+OK\n"
+		case 4:
+			if !isEx(args[2]) {
+				return "-ERR syntax error\n"
+			}
+			sec, ok := positiveInt(args[3])
+			if !ok {
+				return "-ERR syntax error\n"
+			}
+			s.Set(args[0], args[1], time.Duration(sec)*time.Second)
+			return "+OK\n"
+		default:
+			return wrongArgs("set")
+		}
+	case "get":
+		if len(args) != 1 {
+			return wrongArgs("get")
+		}
+		if v, ok := s.Get(args[0]); ok {
+			return formatValue(v)
+		}
+		return "$nil\n"
+	case "del":
+		if len(args) < 1 {
+			return wrongArgs("del")
+		}
+		return ":" + strconv.Itoa(s.Del(args...)) + "\n"
+	case "exists":
+		if len(args) != 1 {
+			return wrongArgs("exists")
+		}
+		return intReply(s.Exists(args[0]))
+	case "expire":
+		if len(args) != 2 {
+			return wrongArgs("expire")
+		}
+		sec, ok := base10Int(args[1])
+		if !ok {
+			return "-ERR value is not an integer\n"
+		}
+		return intReply(s.Expire(args[0], time.Duration(sec)*time.Second))
+	case "persist":
+		if len(args) != 1 {
+			return wrongArgs("persist")
+		}
+		return intReply(s.Persist(args[0]))
+	case "ttl":
+		if len(args) != 1 {
+			return wrongArgs("ttl")
+		}
+		d := s.TTL(args[0])
+		switch {
+		case d == -2*time.Second:
+			return ":-2\n"
+		case d == -1*time.Second:
+			return ":-1\n"
+		default:
+			return ":" + strconv.FormatInt(ceilSeconds(d), 10) + "\n"
+		}
+	case "incr":
+		if len(args) != 1 {
+			return wrongArgs("incr")
+		}
+		return incrReply(s, args[0], 1)
+	case "incrby":
+		if len(args) != 2 {
+			return wrongArgs("incrby")
+		}
+		n, ok := base10Int(args[1])
+		if !ok {
+			return "-ERR value is not an integer\n"
+		}
+		return incrReply(s, args[0], n)
+	case "keys":
+		if len(args) != 1 {
+			return wrongArgs("keys")
+		}
+		ks := s.Keys(args[0])
+		var b strings.Builder
+		b.WriteString("*")
+		b.WriteString(strconv.Itoa(len(ks)))
+		b.WriteByte('\n')
+		for i := 0; i < len(ks); i++ {
+			b.WriteString(formatValue(ks[i]))
+		}
+		return b.String()
+	case "dbsize":
+		if len(args) != 0 {
+			return wrongArgs("dbsize")
+		}
+		return ":" + strconv.Itoa(s.Len()) + "\n"
+	default:
+		return "-ERR unknown command '" + toks[0] + "'\n"
+	}
+}
+
+// ceilSeconds rounds a positive duration up to whole seconds (1.2s -> 2).
+func ceilSeconds(d time.Duration) int64 {
+	return (d.Nanoseconds() + int64(time.Second) - 1) / int64(time.Second)
+}
+
+// isEx reports whether t is the SET option "EX" (case-insensitive).
+func isEx(t string) bool {
+	return strings.EqualFold(t, "EX")
+}
+
+func positiveInt(t string) (int64, bool) {
+	v, err := strconv.ParseInt(t, 10, 64)
+	if err != nil || v <= 0 {
+		return 0, false
+	}
+	return v, true
+}
+
+func base10Int(t string) (int64, bool) {
+	v, err := strconv.ParseInt(t, 10, 64)
+	if err != nil {
+		return 0, false
+	}
+	return v, true
+}
+
+func intReply(b bool) string {
+	if b {
+		return ":1\n"
+	}
+	return ":0\n"
+}
+
+func incrReply(s *store.Store, key string, by int64) string {
+	v, err := s.Incr(key, by)
+	if err != nil {
+		return "-ERR value is not an integer\n"
+	}
+	return ":" + strconv.FormatInt(v, 10) + "\n"
+}
+
+func wrongArgs(name string) string {
+	return "-ERR wrong number of arguments for '" + name + "'\n"
+}
+
+// tokenize splits a request line into tokens separated by one or more
+// spaces/tabs. A token may be double-quoted; inside quotes \" \\ and \n are
+// escapes. A missing token produces no error; an unterminated quote is a
+// protocol error.
+func tokenize(line string) ([]string, error) {
+	var toks []string
+	i, n := 0, len(line)
+	for i < n {
+		c := line[i]
+		switch {
+		case c == ' ' || c == '\t':
+			i++
+		case c == '"':
+			i++
+			var b strings.Builder
+			closed := false
+			for i < n {
+				d := line[i]
+				if d == '\\' {
+					if i+1 >= n {
+						return nil, errProtocol
+					}
+					e := line[i+1]
+					if e != '"' && e != '\\' && e != 'n' {
+						return nil, errProtocol
+					}
+					if e == 'n' {
+						b.WriteByte('\n')
+					} else {
+						b.WriteByte(e)
+					}
+					i += 2
+					continue
+				}
+				if d == '"' {
+					closed = true
+					i++
+					break
+				}
+				b.WriteByte(d)
+				i++
+			}
+			if !closed {
+				return nil, errProtocol
+			}
+			toks = append(toks, b.String())
+		default:
+			j := i
+			for j < n && line[j] != ' ' && line[j] != '\t' {
+				j++
+			}
+			toks = append(toks, line[i:j])
+			i = j
+		}
+	}
+	return toks, nil
+}
+
+// formatValue writes a $string reply. Values containing a space, tab, quote,
+// backslash or newline (and the empty value) are quoted with escapes.
+func formatValue(v string) string {
+	if v != "" && !strings.ContainsAny(v, " \t\"\\\n") {
+		return "$" + v + "\n"
+	}
+	var b strings.Builder
+	b.WriteByte('$')
+	b.WriteByte('"')
+	for i := 0; i < len(v); i++ {
+		switch c := v[i]; c {
+		case '"', '\\':
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		case '\n':
+			b.WriteByte('\\')
+			b.WriteByte('n')
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte('"')
+	b.WriteByte('\n')
+	return b.String()
+}
diff --git a/proto/proto_test.go b/proto/proto_test.go
