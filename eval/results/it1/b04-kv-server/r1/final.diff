+func TestMatchUnit(t *testing.T) {
+	cases := []struct{ pattern, key string; want bool }{
+		{"*", "anything/here", true},
+		{"*", "", true},
+		{"a*b", "a", false},
+		{"a*b", "aXb", true},
+		{"a*b", "ab", true},
+		{"a*b", "ba", false},
+		{"**", "x", true},
+		{"a*bc", "abc", true},
+		{"a?c", "abc", true},
+		{"a?c", "ac", false},
+		{"[abc]x", "bx", true},
+		{"[abc]x", "dx", false},
+		{"[a-c]x", "bx", true},
+		{"[a-c]x", "dx", false},
+		{"[^a]x", "bx", true},
+		{"[^a]x", "ax", false},
+		{"[!a]x", "bx", true},
+		{"[!a]x", "ax", false},
+		{`a\b`, "ab", true},
+		{`a\b`, `a\b`, false},
+		{"a", "a", true},
+		{"a", "ab", false},
+		{"a", "b", false},
+		{"", "", true},
+	}
+	for _, tc := range cases {
+		if got := Match(tc.pattern, tc.key); got != tc.want {
+			t.Errorf("Match(%q, %q) = %v, want %v", tc.pattern, tc.key, got, tc.want)
+		}
+	}
+}
