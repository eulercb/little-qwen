+func TestExpiry(t *testing.T) {
+	c := newFakeClock()
+	s := newStore(c)
+	s.Set("a", "1", time.Second)
+	s.Set("b", "2", 0)
+	if s.Len() != 2 {
+		t.Fatalf("Len = %d, want 2", s.Len())
+	}
+	c.Add(time.Second) // now == deadline for a -> expired
+	if s.Exists("a") {
+		t.Fatal("a should be expired at deadline")
+	}
+	if _, ok := s.Get("a"); ok {
+		t.Fatal("a should be missing after expiry")
+	}
+	if got := s.Len(); got != 1 {
+		t.Fatalf("Len after expiry = %d, want 1", got)
+	}
+	if got := s.Del("a"); got != 0 {
+		t.Fatalf("Del expired = %d, want 0", got)
+	}
+	if got := s.Del("b"); got != 1 {
+		t.Fatalf("Del b = %d, want 1", got)
+	}
+}
+
+func TestExpirePersist(t *testing.T) {
+	c := newFakeClock()
+	s := newStore(c)
+	if s.Expire("nope", time.Second) {
+		t.Fatal("Expire on missing key = true")
+	}
+	s.Set("a", "1", 0)
+	if !s.Expire("a", 5*time.Second) {
+		t.Fatal("Expire on live key = false")
+	}
+	if d := s.TTL("a"); d != 5*time.Second {
+		t.Fatalf("TTL = %v, want 5s", d)
+	}
+	if d := s.TTL("missing"); d != -2*time.Second {
+		t.Fatalf("TTL(missing) = %v, want -2s", d)
+	}
+	if !s.Persist("a") {
+		t.Fatal("Persist on key with expiry = false")
+	}
+	if d := s.TTL("a"); d != -1*time.Second {
+		t.Fatalf("TTL after Persist = %v, want -1s", d)
+	}
+	if s.Persist("a") {
+		t.Fatal("Persist on key without expiry = true")
+	}
+	if !s.Expire("a", 0) {
+		t.Fatal("Expire ttl<=0 should delete key and return true")
+	}
+	if s.Exists("a") {
+		t.Fatal("a should be deleted")
+	}
+}
