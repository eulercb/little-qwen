+func TestIncr(t *testing.T) {
+	c := newFakeClock()
+	s := newStore(c)
+	if v, err := s.Incr("n", 1); err != nil || v != 1 {
+		t.Fatalf("Incr missing = %d, %v", v, err)
+	}
+	if v, err := s.Incr("n", 10); err != nil || v != 11 {
+		t.Fatalf("Incr existing = %d, %v", v, err)
+	}
+	s.Set("n", "5", 0)
+	if v, err := s.Incr("n", -3); err != nil || v != 2 {
+		t.Fatalf("Incr negative = %d, %v", v, err)
+	}
+	// keeps existing ttl
+	s.Set("x", "1", 3*time.Second)
+	s.Incr("x", 1)
+	if d := s.TTL("x"); d != 3*time.Second {
+		t.Fatalf("TTL after Incr = %v, want 3s", d)
+	}
+	// ttl <= 0 (no expiry) is also kept
+	s.Set("x", "1", 0)
+	s.Incr("x", 1)
+	if d := s.TTL("x"); d != -1*time.Second {
+		t.Fatalf("TTL after Incr no-expiry = %v, want -1s", d)
+	}
+	s.Set("s", "abc", 0)
+	if _, err := s.Incr("s", 1); !errors.Is(err, ErrNotInteger) {
+		t.Fatalf("Incr non-int err = %v, want ErrNotInteger", err)
+	}
+}
