+func TestConcurrent(t *testing.T) {
+	s := newStore(newFakeClock())
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				k := "key" + itoa(int64(j%50))
+				s.Set(k, itoa(int64(i*j)), 0)
+				s.Get(k)
+				s.Incr(k, 1)
+				s.Keys("*")
+				s.Len()
+				s.Del("temp")
+			}
+		}(i)
+	}
+	wg.Wait()
+}
