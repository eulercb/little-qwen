+func TestSaveLoad(t *testing.T) {
+	c := newFakeClock()
+	s := newStore(c)
+	s.Set("b", "2", 10*time.Second)
+	s.Set("a", "1", 0)
+	s.Set("exp", "gone", time.Millisecond)
+	c.Add(5 * time.Second) // exp is dead, b has 5s left
+
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+	want := `{"version":1,"entries":[{"k":"a","v":"1","exp":0},{"k":"b","v":"2","exp":`
+	expireMS := c.Now().UnixMilli() + 5000
+	if !strings.HasPrefix(buf.String(), want+itoa(expireMS)+"}]}") {
+		t.Fatalf("Save output = %s, want prefix %s...1}]", buf.String(), want+itoa(expireMS))
+	}
+
+	c.Add(5 * time.Second) // b now expired too
+	s2 := New(c.Now)
+	if err := s2.Load(&buf); err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if got, ok := s2.Get("a"); !ok || got != "1" {
+		t.Fatalf("Load: a = %q, %v", got, ok)
+	}
+	if s2.Exists("b") {
+		t.Fatal("Load should drop entries already expired at load time")
+	}
+	if s2.Len() != 1 {
+		t.Fatalf("Len after load = %d, want 1", s2.Len())
+	}
+
+	// version mismatch
+	var bad bytes.Buffer
+	bad.WriteString(`{"version":2,"entries":[]}`)
+	if err := s2.Load(&bad); err == nil {
+		t.Fatal("Load of version 2 should fail")
+	}
+	// invalid JSON
+	var notjson bytes.Buffer
+	notjson.WriteString("nope")
+	if err := s2.Load(&notjson); err == nil {
+		t.Fatal("Load of invalid JSON should fail")
+	}
+}
