@@ -0,0 +1,225 @@
+package cron
+
+import (
+	"bufio"
+	"fmt"
+	"math/rand"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+const diffScript = `
+import sys, importlib.util
+from datetime import datetime, timezone
+spec = importlib.util.spec_from_file_location("refcron", "reference/cron.py")
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+for line in sys.stdin:
+    line = line.strip()
+    if not line:
+        continue
+    expr, start, n = line.split("|")
+    t = datetime.fromisoformat(start)
+    if t.tzinfo is None:
+        t = t.replace(tzinfo=timezone.utc)
+    try:
+        s = m.parse(expr)
+        print(m.describe(s))
+        for _ in range(int(n)):
+            t = m.next_run(s, t)
+            print(t.isoformat())
+    except m.CronError as e:
+        print("error: " + str(e))
+    except BaseException as e:
+        print("error: UNCAUGHT " + repr(e))
+    print("---")
+`
+
+// runDifferential compares the Go implementation against the Python
+// reference on numCases random inputs.
+func runDifferential(t *testing.T, seed int64, numCases int) {
+	t.Helper()
+	rng := rand.New(rand.NewSource(seed))
+
+	// item for a field with the given bounds.
+	randValue := func(lo, hi int) int { return lo + rng.Intn(hi-lo+1) }
+	randItem := func(lo, hi int, names []string) string {
+		v := func() int { return randValue(lo, hi) }
+		choices := []func() string{
+			func() string { return "*" },
+			func() string { return strconv.Itoa(v()) },
+			func() string {
+				a, b := v(), v()
+				if a > b {
+					a, b = b, a
+				}
+				if a == b {
+					return strconv.Itoa(a)
+				}
+				if rng.Intn(3) == 0 {
+					return fmt.Sprintf("%d-%d", a, b)
+				}
+				return fmt.Sprintf("%d-%d/%d", a, b, 1+rng.Intn(6))
+			},
+			func() string {
+				s := 1 + rng.Intn(8)
+				switch rng.Intn(3) {
+				case 0:
+					return "*/" + strconv.Itoa(s)
+				case 1:
+					return fmt.Sprintf("%d/%d", v(), s)
+				default:
+					return fmt.Sprintf("%d-%d/%d", v(), v(), s)
+				}
+			},
+			func() string { // reversed / out of range / bad step / names
+				switch rng.Intn(6) {
+				case 0:
+					a, b := v(), v()
+					if a < b {
+						a, b = b, a
+					}
+					return fmt.Sprintf("%d-%d", a, b) // reversed when a>b
+				case 1:
+					return strconv.Itoa(v() + hi + 1) // out of range
+				case 2:
+					return "*/0"
+				case 3:
+					if len(names) > 0 {
+						return names[rng.Intn(len(names))]
+					}
+					return strconv.Itoa(v())
+				case 4:
+					if len(names) > 0 {
+						return fmt.Sprintf("%s-%s/%d", names[len(names)-1], names[0], 2)
+					}
+					return "*/2"
+				default:
+					return "junk"
+				}
+			},
+		}
+		return choices[rng.Intn(len(choices))]()
+	}
+	randField := func(lo, hi int, names []string) string {
+		parts := make([]string, 1+rng.Intn(3))
+		for i := range parts {
+			parts[i] = randItem(lo, hi, names)
+		}
+		return strings.Join(parts, ",")
+	}
+	monthNames := []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+	dayNames := []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+	randExpr := func() string {
+		switch rng.Intn(10) {
+		case 0:
+			return []string{"@yearly", "@monthly", "@weekly", "@daily", "@hourly", "@midnight", "@annually"}[rng.Intn(7)]
+		default:
+			f := []string{
+				randField(0, 59, nil),
+				randField(0, 23, nil),
+				randField(1, 31, nil),
+				randField(1, 12, monthNames),
+				randField(0, 6, dayNames),
+			}
+			return strings.Join(f, " ")
+		}
+	}
+	randStart := func() string {
+		y := 2000 + rng.Intn(105)
+		mo := 1 + rng.Intn(12)
+		d := 1 + rng.Intn(28)
+		s := fmt.Sprintf("%04d-%02d-%02dT%02d:%02d:%02d", y, mo, d, rng.Intn(24), rng.Intn(60), rng.Intn(60))
+		if rng.Intn(3) == 0 {
+			s += fmt.Sprintf(".%06d", rng.Intn(1000000))
+		}
+		return s
+	}
+
+	cmd := exec.Command("python3", "-c", diffScript)
+	cmd.Dir = ".."
+	cmd.Env = append(cmd.Environ(), "PYTHONDONTWRITEBYTECODE=1")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 1<<20), 1<<20)
+
+	type tri struct {
+		expr, start string
+		n           int
+	}
+	tris := make([]tri, 0, numCases)
+	for i := 0; i < numCases; i++ {
+		tris = append(tris, tri{randExpr(), randStart(), 1 + rng.Intn(5)})
+	}
+	for _, tr := range tris {
+		fmt.Fprintf(stdin, "%s|%s|%d\n", tr.expr, tr.start, tr.n)
+	}
+	stdin.Close()
+
+	failures := 0
+	for i, tr := range tris {
+		var want []string
+		for {
+			if !scanner.Scan() {
+				t.Fatalf("python ended early at case %d (%s|%s)", i, tr.expr, tr.start)
+			}
+			if scanner.Text() == "---" {
+				break
+			}
+			want = append(want, scanner.Text())
+		}
+		s, err := Parse(tr.expr)
+		var got []string
+		if err != nil {
+			got = []string{"error: " + err.Error()}
+		} else {
+			start, err := time.Parse("2006-01-02T15:04:05.999999", tr.start)
+			if err != nil {
+				start, err = time.Parse("2006-01-02T15:04:05", tr.start)
+				if err != nil {
+					t.Fatalf("bad start %q: %v", tr.start, err)
+				}
+			}
+			got = append(got, s.String())
+			tt := start
+			for j := 0; j < tr.n; j++ {
+				tt, err = s.Next(tt)
+				if err != nil {
+					got = append(got, "error: "+err.Error())
+					break
+				}
+				got = append(got, pyISO(tt))
+			}
+		}
+		if strings.Join(got, "\n") != strings.Join(want, "\n") {
+			failures++
+			if failures <= 5 {
+				t.Errorf("case %d (%s|%s n=%d):\n got %v\nwant %v", i, tr.expr, tr.start, tr.n, got, want)
+			}
+		}
+	}
+	if err := cmd.Wait(); err != nil {
+		t.Fatalf("python exited: %v", err)
+	}
+	if failures > 5 {
+		t.Errorf("and %d more mismatches", failures-5)
+	}
+}
+
+func TestDifferential(t *testing.T) {
+	runDifferential(t, 1, 250)
+	runDifferential(t, 42, 250)
+}
