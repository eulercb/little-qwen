+// Package cron implements a five-field cron expression parser and
+// next-run calculator. It is a port of reference/cron.py with identical
+// behaviour, including error messages.
+package cron
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// CronError is returned by Parse and Next for all syntax and matching errors.
+type CronError struct{ msg string }
+
+func (e *CronError) Error() string { return e.msg }
+
+func newCronError(format string, args ...interface{}) error {
+	return &CronError{msg: fmt.Sprintf(format, args...)}
+}
+
+type fieldSpec struct {
+	name string
+	lo   int
+	hi   int
+}
+
+var fields = [5]fieldSpec{
+	{"minute", 0, 59},
+	{"hour", 0, 23},
+	{"day-of-month", 1, 31},
+	{"month", 1, 12},
+	{"day-of-week", 0, 6},
+}
+
+var months = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+
+var days = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":   "0 0 1 1 *",
+	"@annually": "0 0 1 1 *",
+	"@monthly":  "0 0 1 * *",
+	"@weekly":   "0 0 * * 0",
+	"@daily":    "0 0 * * *",
+	"@midnight": "0 0 * * *",
+	"@hourly":   "0 * * * *",
+}
+
+// repr mimics Python's str repr for the strings that can appear in error
+// messages: single quotes unless the text contains a single quote (and no
+// double quote), in which case double quotes; backslashes are escaped.
+func repr(s string) string {
+	if !strings.ContainsAny(s, `'\`) {
+		return "'" + s + "'"
+	}
+	if !strings.Contains(s, "'") {
+		return "'" + strings.ReplaceAll(s, `\`, `\\`) + "'"
+	}
+	if !strings.Contains(s, `"`) {
+		return `"` + s + `"`
+	}
+	esc := strings.NewReplacer(`\`, `\\`, `'`, `\'`)
+	return "'" + esc.Replace(s) + "'"
+}
+
+// isDigits reports whether s is non-empty and consists only of decimal digits,
+// mirroring Python's str.isdigit.
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// value converts one token to its numeric value for field idx, like _value.
+func value(tok string, idx int) (int, error) {
+	spec := fields[idx]
+	t := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range months {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range days {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, newCronError("%s: invalid value %s", spec.name, repr(tok))
+	}
+	v, err := strconv.Atoi(tok)
+	if err != nil {
+		// tok holds a number that does not fit in int64, so it is
+		// certainly above the field maximum; print it as a digit string
+		// (leading zeros stripped), which equals Python's int rendering.
+		vStr := strings.TrimLeft(tok, "0")
+		if vStr == "" {
+			vStr = "0"
+		}
+		return 0, newCronError("%s: value %s out of range %d-%d", spec.name, vStr, spec.lo, spec.hi)
+	}
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	if v < spec.lo || v > spec.hi {
+		return 0, newCronError("%s: value %d out of range %d-%d", spec.name, v, spec.lo, spec.hi)
+	}
+	return v, nil
+}
+
+// fieldSet is a set of values bounded by the largest field range (0-59).
+type fieldSet [64]bool
+
+func (s *fieldSet) add(v int) { s[v] = true }
+
+func (s fieldSet) contains(v int) bool {
+	if v < 0 || v >= 64 {
+		return false
+	}
+	return s[v]
+}
+
+// full reports whether s holds exactly every value from lo through hi.
+func (s fieldSet) full(lo, hi int) bool {
+	for v := lo; v <= hi; v++ {
+		if !s[v] {
+			return false
+		}
+	}
+	return true
+}
+
+// field parses one field of a cron expression, like _field.
+func field(text string, idx int) (fieldSet, error) {
+	spec := fields[idx]
+	if text == "" {
+		return fieldSet{}, newCronError("%s: empty field", spec.name)
+	}
+	var values fieldSet
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return fieldSet{}, newCronError("%s: empty item", spec.name)
+		}
+		step := 1
+		var base string
+		if slash := strings.IndexByte(item, '/'); slash >= 0 {
+			s := item[slash+1:]
+			if !isDigits(s) {
+				return fieldSet{}, newCronError("%s: invalid step %s", spec.name, repr(s))
+			}
+			v, err := strconv.Atoi(s)
+			if err != nil {
+				// Step overflows int64; like Python's unbounded int, it
+				// simply means the range yields only its start value.
+				step = 1 << 62
+			} else if v < 1 {
+				return fieldSet{}, newCronError("%s: invalid step %s", spec.name, repr(s))
+			} else {
+				step = v
+			}
+			base = item[:slash]
+		} else {
+			base = item
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = spec.lo, spec.hi
+		case strings.Contains(base, "-"):
+			dash := strings.IndexByte(base, '-')
+			a, b := base[:dash], base[dash+1:]
+			var err error
+			start, err = value(a, idx)
+			if err != nil {
+				return fieldSet{}, err
+			}
+			end, err = value(b, idx)
+			if err != nil {
+				return fieldSet{}, err
+			}
+			if start > end {
+				return fieldSet{}, newCronError("%s: range %d-%d is reversed", spec.name, start, end)
+			}
+		default:
+			var err error
+			start, err = value(base, idx)
+			if err != nil {
+				return fieldSet{}, err
+			}
+			if strings.Contains(item, "/") {
+				end = spec.hi
+			} else {
+				end = start
+			}
+		}
+		for v := start; v <= end; v += step {
+			values.add(v)
+		}
+	}
+	return values, nil
+}
+
+// Schedule holds a parsed cron expression.
+type Schedule struct {
+	expr    string
+	minute  fieldSet
+	hour    fieldSet
+	dom     fieldSet
+	month   fieldSet
+	dow     fieldSet
+	domStar bool
+	dowStar bool
+}
+
+// Parse parses expr into a Schedule. The accepted syntax and error messages
+// match the reference parse().
+func Parse(expr string) (*Schedule, error) {
+	original := expr
+	expr = strings.TrimSpace(expr)
+	if strings.HasPrefix(expr, "@") {
+		e, ok := macros[strings.ToLower(expr)]
+		if !ok {
+			return nil, newCronError("unknown macro %s", repr(expr))
+		}
+		expr = e
+	}
+	parts := strings.Fields(expr)
+	if len(parts) != 5 {
+		return nil, newCronError("expected 5 fields, got %d", len(parts))
+	}
+	fieldsOut := make([]fieldSet, 5)
+	for i, p := range parts {
+		f, err := field(p, i)
+		if err != nil {
+			return nil, err
+		}
+		fieldsOut[i] = f
+	}
+	return &Schedule{
+		expr:    original,
+		minute:  fieldsOut[0],
+		hour:    fieldsOut[1],
+		dom:     fieldsOut[2],
+		month:   fieldsOut[3],
+		dow:     fieldsOut[4],
+		domStar: parts[2] == "*",
+		dowStar: parts[4] == "*",
+	}, nil
+}
+
+// dayOk reports whether calendar date d matches the day constraints, following
+// Vixie cron semantics (like _day_ok).
+func (s *Schedule) dayOk(d time.Time) bool {
+	dow := int(d.Weekday()) // Sunday=0 .. Saturday=6, same convention as the reference
+	inDom := s.dom.contains(d.Day())
+	inDow := s.dow.contains(dow)
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first time strictly after `after` that matches the
+// schedule, in after's location, like next_run.
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	midnight := func(t time.Time) time.Time {
+		return time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, loc)
+	}
+	t := time.Date(after.Year(), after.Month(), after.Day(), after.Hour(), after.Minute(), 0, 0, loc).Add(time.Minute)
+	limit := after.AddDate(0, 0, 366*5)
+	for !t.After(limit) {
+		if !s.month.contains(int(t.Month())) {
+			y, m := t.Year(), int(t.Month())
+			if m == 12 {
+				y, m = y+1, 1
+			} else {
+				m++
+			}
+			t = time.Date(y, time.Month(m), 1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !s.dayOk(t) {
+			t = midnight(t).Add(24 * time.Hour)
+			continue
+		}
+		if !s.hour.contains(t.Hour()) {
+			t = t.Add(-time.Duration(t.Minute()) * time.Minute).Add(time.Hour)
+			continue
+		}
+		if !s.minute.contains(t.Minute()) {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, newCronError("no match within 5 years for %s", repr(s.expr))
+}
+
+// fmtField renders one field the way the reference _fmt does.
+func fmtField(values fieldSet, idx int) string {
+	spec := fields[idx]
+	if values.full(spec.lo, spec.hi) {
+		return "*"
+	}
+	var vs []int
+	for v := spec.lo; v <= spec.hi; v++ {
+		if values[v] {
+			vs = append(vs, v)
+		}
+	}
+	out := make([]string, 0, len(vs))
+	i := 0
+	for i < len(vs) {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, strconv.Itoa(vs[i]))
+		} else {
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		if j-i > 0 && j-i < 2 {
+			for k := i + 1; k <= j; k++ {
+				out = append(out, strconv.Itoa(vs[k]))
+			}
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+// String renders the schedule the way the reference describe() does.
+func (s *Schedule) String() string {
+	return strings.Join([]string{
+		fmtField(s.minute, 0),
+		fmtField(s.hour, 1),
+		fmtField(s.dom, 2),
+		fmtField(s.month, 3),
+		fmtField(s.dow, 4),
+	}, " ")
+}
