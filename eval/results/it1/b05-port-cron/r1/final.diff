+++ b/cron/cron_test.go
@@ -0,0 +1,215 @@
+package cron
+
+import (
+	"fmt"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// runPython invokes the reference CLI from the repository root.
+func runPython(t *testing.T, args ...string) string {
+	t.Helper()
+	cmd := exec.Command("python3", append([]string{"reference/cron.py"}, args...)...)
+	cmd.Dir = ".."
+	cmd.Env = append(cmd.Environ(), "PYTHONDONTWRITEBYTECODE=1")
+	out, err := cmd.CombinedOutput()
+	if err != nil && len(out) == 0 {
+		t.Fatalf("python3 reference/cron.py %v failed: %v", args, err)
+	}
+	return string(out)
+}
+
+// parseStart parses the ISO-TIME strings used in the tests (naive, like
+// Python's datetime.fromisoformat).
+func parseStart(t *testing.T, s string) time.Time {
+	t.Helper()
+	layouts := []string{"2006-01-02T15:04:05.999999", "2006-01-02T15:04:05"}
+	for _, l := range layouts {
+		if x, err := time.Parse(l, s); err == nil {
+			return x.UTC()
+		}
+	}
+	t.Fatalf("cannot parse start time %q", s)
+	return time.Time{}
+}
+
+// pyISO formats a Go time the way Python's isoformat() prints the reference
+// output (UTC rendered as +00:00, six fractional digits when nonzero).
+func pyISO(x time.Time) string {
+	s := x.UTC().Format("2006-01-02T15:04:05")
+	if n := x.UTC().Nanosecond(); n != 0 {
+		s += fmt.Sprintf(".%06d", n/1000)
+	}
+	return s + "+00:00"
+}
+
+func TestParseErrors(t *testing.T) {
+	exprs := []string{
+		"",
+		"   ",
+		"1",
+		"1 2 3 4",
+		"1 2 3 4 5 6",
+		"@foo",
+		"@FOO",
+		"60 * * * *",
+		"* 24 * * *",
+		"* * 0 * *",
+		"* * 32 * *",
+		"* * * 13 *",
+		"* * * * 7", // valid: 7 == Sunday
+		"* * * * 8",
+		"5-1 * * * *",
+		"1-5-6 * * * *",
+		"*/0 * * * *",
+		"*/a * * * *",
+		"5/* * * * *",
+		"1,,2 * * * *",
+		",1 * * * *",
+		"1, * * * *",
+		"abc * * * *",
+		"1.5 * * * *",
+		"-1 * * * *",
+		"* * -1 * *",
+		"* * * FOO *",
+		"* * * 13-1 *",
+		"61 25 32 13 8",
+		"JAN * * * *",
+		"1/2/3 * * * *",
+		"*/1.5 * * * *",
+		"  0 0 * * *  ",
+		"0 0 * * 7",
+		"*-* * * * *",
+		"2-3/0 * * * *",
+		"0 0 * * sun",
+		"0 0 * 13 *",
+		"0 0 32 * *",
+	}
+	for _, e := range exprs {
+		e := e
+		t.Run("expr"+strconv.Quote(e), func(t *testing.T) {
+			want := runPython(t, e)
+			s, err := Parse(e)
+			var got string
+			if err != nil {
+				got = "error: " + err.Error() + "\n"
+			} else {
+				got = s.String() + "\n"
+			}
+			if got != want {
+				t.Fatalf("Parse(%q):\n got %q\nwant %q", e, got, want)
+			}
+		})
+	}
+}
+
+// TestNext runs the CLI with a start time and N and compares the output,
+// which is the describe() line plus the next N runs.
+func TestNext(t *testing.T) {
+	cases := []struct {
+		expr, start string
+		n           int
+	}{
+		{"* * * * *", "2024-01-15T10:30:59.123456", 3},
+		{"0 0 * * *", "2024-01-15T10:30:59", 5},
+		{"0 0 1 1 *", "2024-01-15T10:30:59", 3},
+		{"0 0 1 * *", "2024-02-29T23:59:59", 4},
+		{"30 4 1,15 * 5", "2024-03-01T00:00:00", 6},
+		{"0 12 * * 1-5", "2024-03-30T13:00:00", 4},
+		{"*/15 * * * *", "2024-05-06T01:47:02", 5},
+		{"0 0 30 2 *", "2021-03-01T00:00:00", 2},
+		{"0 0 29,30,31 4 *", "2024-04-29T01:00:00", 3},
+		{"5 4 * * mon", "2024-01-01T00:00:00", 3},
+		{"0 0 * * sun", "2024-12-28T00:00:00", 3},
+		{"@daily", "2024-07-04T23:00:00", 2},
+		{"@yearly", "2024-12-31T23:30:00", 2},
+		{"@monthly", "2024-11-30T12:00:00", 2},
+		{"@weekly", "2024-01-06T10:00:00", 2},
+		{"@hourly", "2024-06-15T09:01:01", 2},
+		{"15 10,14 * * *", "2024-02-29T10:16:00", 3},
+		{"0-59/10 0 1 1 1", "2024-01-01T00:05:00", 4},
+		{"59 23 31 * *", "2024-06-30T12:00:00", 4},
+		{"0 0 * * *", "2100-03-01T00:00:00", 2},
+		{"0 0 1 1 *", "2096-02-29T10:00:00", 2},
+		{"*/5 */6 * JAN,DEC *", "2024-06-15T09:30:00", 4},
+		{"5/3 1/12 * * 0", "2024-01-05T02:00:00", 3},
+		{"30 14 13 * 6", "2024-08-01T00:00:00", 5}, // dom+dow OR semantics
+		{"0 0 * * *", "2024-11-03T08:30:00", 2},
+		{"0 0 * * 0", "2024-01-01T00:00:00", 2},
+	}
+	for _, c := range cases {
+		c := c
+		t.Run(strconv.Quote(c.expr)+"@"+c.start, func(t *testing.T) {
+			want := runPython(t, c.expr, c.start, strconv.Itoa(c.n))
+			s, err := Parse(c.expr)
+			var got string
+			if err != nil {
+				got = "error: " + err.Error() + "\n"
+			} else {
+				var b strings.Builder
+				b.WriteString(s.String())
+				b.WriteByte('\n')
+				tt := parseStart(t, c.start)
+				for i := 0; i < c.n; i++ {
+					tt, err = s.Next(tt)
+					if err != nil {
+						b.WriteString("error: " + err.Error() + "\n")
+						break
+					}
+					b.WriteString(pyISO(tt))
+					b.WriteByte('\n')
+				}
+				got = b.String()
+			}
+			if got != want {
+				t.Fatalf("Next(%q, %q, %d):\n got %q\nwant %q", c.expr, c.start, c.n, got, want)
+			}
+		})
+	}
+}
+
+// TestString checks String() against the reference describe() output.
+func TestString(t *testing.T) {
+	exprs := []string{
+		"* * * * *",
+		"5 * * * *",
+		"1,2 * * * *",
+		"1,2,3 * * * *",
+		"1,2,3,4 * * * *",
+		"0,10,20,30,40,50 * * * *",
+		"0,59 * * * *",
+		"5-7 * * * *",
+		"*/15 * * * *",
+		"*/1 * * * *",
+		"5/2 * * * *",
+		"1-3/2 * * * *",
+		"0,5,10-12,20-21,30/10 * * * *",
+		"@daily",
+		"@monthly",
+		"0 0 1 * *",
+		"0 0 * * 0",
+		"30 4 1,15 * 5",
+		"0 0 * 1,3-5,12 *",
+		"1-6 * * 2,4 1-5",
+		"5-20/3 10-14 * * 0",
+		"2 0 30 2 *",
+		"0 12 1,2 1-12 0-6",
+		"59/2 * * * *",
+	}
+	for _, e := range exprs {
+		e := e
+		t.Run(strconv.Quote(e), func(t *testing.T) {
+			want := strings.TrimSuffix(runPython(t, e), "\n")
+			s, err := Parse(e)
+			if err != nil {
+				t.Fatalf("Parse(%q) failed: %v", e, err)
+			}
+			if s.String() != want {
+				t.Fatalf("String() of %q: got %q want %q", e, s.String(), want)
+			}
+		})
+	}
+}
