+package md
+
+import "testing"
+
+func TestSpecExample(t *testing.T) {
+	in := "# Title #\n\nSome *emphasis* and **strong** text\nwith `code` and a [link](http://x.io \"T\").\n\n- one\n- two\n  - nested\n3. three\n"
+	want := "<h1>Title</h1>\n" +
+		"<p>Some <em>emphasis</em> and <strong>strong</strong> text\nwith <code>code</code> and a <a href=\"http://x.io\" title=\"T\">link</a>.</p>\n" +
+		"<ul>\n<li>one</li>\n<li>two\n<ul>\n<li>nested</li>\n</ul>\n</li>\n</ul>\n" +
+		"<ol start=\"3\">\n<li>three</li>\n</ol>\n"
+	if got := ToHTML(in); got != want {
+		t.Errorf("got:\n%q\nwant:\n%q", got, want)
+	}
+}
+
+func TestBlocks(t *testing.T) {
+	tests := []struct {
+		in   string
+		want string
+	}{
+		{"# Title #", "<h1>Title</h1>\n"},
+		{"# Title  ##", "<h1>Title</h1>\n"},
+		{"#", "<h1></h1>\n"},
+		{"# ", "<h1></h1>\n"},
+		{"## two\n### three\n#### four\n##### five\n###### six", "<h2>two</h2>\n<h3>three</h3>\n<h4>four</h4>\n<h5>five</h5>\n<h6>six</h6>\n"},
+		{"####### seven", "<p>####### seven</p>\n"},
+		{"#foo", "<p>#foo</p>\n"},
+		{"---", "<hr />\n"},
+		{"***", "<hr />\n"},
+		{"___", "<hr />\n"},
+		{"----", "<hr />\n"},
+		{"--", "<p>--</p>\n"},
+		{"- -", "<p>- -</p>\n"},
+		{"a\n\nb", "<p>a</p>\n<p>b</p>\n"},
+		{"a\nb\n  c", "<p>a\nb\nc</p>\n"},
+		{"a\nb\n\nc", "<p>a\nb</p>\n<p>c</p>\n"},
+		{"a\n# h", "<p>a</p>\n<h1>h</h1>\n"},
+		{"a\n- x", "<p>a</p>\n<ul>\n<li>x</li>\n</ul>\n"},
+		{"```", "<pre><code></code></pre>\n"},
+		{"```\na\nb\n```", "<pre><code>a\nb\n</code></pre>\n"},
+		{"```go\na & <b>\n```", "<pre><code class=\"language-go\">a &amp; &lt;b&gt;\n</code></pre>\n"},
+		{"```\na\nb", "<pre><code>a\nb\n</code></pre>\n"},
+		{"```\na\n``` \n", "<pre><code>a\n</code></pre>\n"},
+		{"> q", "<blockquote>\n<p>q</p>\n</blockquote>\n"},
+		{">q", "<blockquote>\n<p>q</p>\n</blockquote>\n"},
+		{"> a\n> b", "<blockquote>\n<p>a\nb</p>\n</blockquote>\n"},
+		{"> # h\n> p", "<blockquote>\n<h1>h</h1>\n<p>p</p>\n</blockquote>\n"},
+		{"para\n> quote", "<p>para</p>\n<blockquote>\n<p>quote</p>\n</blockquote>\n"},
+		{"- a\n- b\n* c\n+ d", "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d</li>\n</ul>\n"},
+		{"- a\n1. b", "<ul>\n<li>a</li>\n</ul>\n<ol>\n<li>b</li>\n</ol>\n"},
+		{"1. a\n2. b\n3. c", "<ol>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n</ol>\n"},
+		{"3. a\n4. b", `<ol start="3">` + "\n<li>a</li>\n<li>b</li>\n</ol>\n"},
+		{"1. a\n\n2. b", "<ol>\n<li>a</li>\n</ol>\n<ol start=\"2\">\n<li>b</li>\n</ol>\n"},
+		{"- a\n  - n1\n  - n2", "<ul>\n<li>a\n<ul>\n<li>n1</li>\n<li>n2</li>\n</ul>\n</li>\n</ul>\n"},
+		{"- a\n  text", "<ul>\n<li>a\ntext</li>\n</ul>\n"},
+		{"- a\n    - n", "<ul>\n<li>a\n<ul>\n<li>n</li>\n</ul>\n</li>\n</ul>\n"},
+		{"- a\n      - n", "<ul>\n<li>a\n- n</li>\n</ul>\n"},
+		{"1. a\n  - n", "<ol>\n<li>a\n<ul>\n<li>n</li>\n</ul>\n</li>\n</ol>\n"},
+		{"- a\n- b\n  - n", "<ul>\n<li>a</li>\n<li>b\n<ul>\n<li>n</li>\n</ul>\n</li>\n</ul>\n"},
+		{"- a\n\n- b", "<ul>\n<li>a</li>\n</ul>\n<ul>\n<li>b</li>\n</ul>\n"},
+		{"- a", "<ul>\n<li>a</li>\n</ul>\n"},
+		{"-x", "<p>-x</p>\n"},
+		{"1.x", "<p>1.x</p>\n"},
+	}
+	for _, tt := range tests {
+		if got := ToHTML(tt.in); got != tt.want {
+			t.Errorf("ToHTML(%q) =\n%q\nwant:\n%q", tt.in, got, tt.want)
+		}
+	}
+}
