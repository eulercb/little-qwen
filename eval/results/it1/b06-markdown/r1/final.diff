+func TestInline(t *testing.T) {
+	tests := []struct {
+		in   string
+		want string
+	}{
+		{"a *b* c", "a <em>b</em> c\n"},
+		{"a*b*c", "a<em>b</em>c\n"},
+		{"*a b*", "<em>a b</em>\n"},
+		{"*a", "*a\n"},
+		{"a*", "a*\n"},
+		{"**a**", "<strong>a</strong>\n"},
+		{"__a__", "<strong>a</strong>\n"},
+		{"_a_", "<em>a</em>\n"},
+		{"snake_case_name", "snake_case_name\n"},
+		{"a_b_c", "a_b_c\n"},
+		{"foo_bar baz", "foo_bar baz\n"},
+		{"**a *b* c**", "<strong>a <em>b</em> c</strong>\n"},
+		{"`a < b`", "<code>a &lt; b</code>\n"},
+		{"`a` and `b`", "<code>a</code> and <code>b</code>\n"},
+		{"`unterminated", "`unterminated\n"},
+		{"``a`b``", "<code>a`b</code>\n"},
+		{"` a `", "<code>a</code>\n"},
+		{"`  `", "<code>  </code>\n"},
+		{"<http://x.io>", `<a href="http://x.io">http://x.io</a>` + "\n"},
+		{"<https://x.io/p>", `<a href="https://x.io/p">https://x.io/p</a>` + "\n"},
+		{"<ftp://x.io>", "&lt;ftp://x.io&gt;\n"},
+		{"<a b>", "&lt;a b&gt;\n"},
+		{"[t](http://u)", `<a href="http://u">t</a>` + "\n"},
+		{"[t](http://u \"T\")", `<a href="http://u" title="T">t</a>` + "\n"},
+		{"[a *b*](http://u)", `<a href="http://u">a <em>b</em></a>` + "\n"},
+		{"[t](u v)", "[t](u v)\n"},
+		{"[t] (u)", "[t] (u)\n"},
+		{"[t](u)", "[t](u)\n"},
+		{"[t](u v w)", "[t](u v w)\n"},
+		{"[t](u \"T\" x)", "[t](u &quot;T&quot; x)\n"},
+		{"&<>\", \"&lt;&gt;&quot;\n"},
+		{"a\\*b", "a*b\n"},
+		{"\\*", "*\n"},
+		{"\\x", "\\x\n"},
+		{"a  \nb", "a<br />\nb\n"},
+		{"a   \nb", "a<br />\nb\n"},
+		{"a\nb", "a\nb\n"},
+		{"a\\", "a\n"},
+		{"a\\\nb", "a<br />\nb\n"},
+		{"a b  ", "a b\n"},
+		{"a\\n", "a\\n\n"},
+	}
+	for _, tt := range tests {
+		if got := ToHTML(tt.in); got != tt.want {
+			t.Errorf("ToHTML(%q) =\n%q\nwant:\n%q", tt.in, got, tt.want)
+		}
+	}
