+// Package md implements a Markdown-subset to HTML converter.
+// See SPEC.md at the repository root for the exact conversion rules.
+package md
+
+import (
+	"strings"
+)
+
+// ToHTML converts a Markdown-subset document to HTML.
+func ToHTML(src string) string {
+	lines := splitLines(src)
+	var out strings.Builder
+	for _, b := range parseBlocks(lines) {
+		out.WriteString(b)
+		out.WriteByte('\n')
+	}
+	return out.String()
+}
+
+func splitLines(src string) []string {
+	lines := strings.Split(src, "\n")
+	for i, l := range lines {
+		lines[i] = strings.TrimSuffix(l, "\r")
+	}
+	return lines
+}
+
+// ---------- blocks ----------
+
+func isBlank(l string) bool {
+	return l == "" || l == strings.TrimSpace(l)
+}
+
+func leadingSpaces(l string) int {
+	i := 0
+	for i < len(l) && l[i] == ' ' {
+		i++
+	}
+	return i
+}
+
+// parseBlocks renders top-level blocks; each block string has no trailing newline.
+func parseBlocks(lines []string) []string {
+	var out []string
+	i := 0
+	n := len(lines)
+	for i < n {
+		l := lines[i]
+		if isBlank(l) {
+			i++
+			continue
+		}
+		if strings.HasPrefix(l, "```") {
+			info := firstWord(l[3:])
+			i++
+			var content []string
+			for i < n && strings.TrimRight(lines[i], " ") != "```" {
+				content = append(content, lines[i])
+				i++
+			}
+			i++ // closing fence or end of input
+			out = append(out, codeBlockHTML(info, content))
+			continue
+		}
+		if h, ok := headingHTML(l); ok {
+			out = append(out, h)
+			i++
+			continue
+		}
+		if isRule(l) {
+			out = append(out, "<hr />")
+			i++
+			continue
+		}
+		if strings.HasPrefix(l, ">") {
+			var q []string
+			for i < n && strings.HasPrefix(lines[i], ">") {
+				q = append(q, dropQuote(lines[i]))
+				i++
+			}
+			out = append(out, "<blockquote>\n"+blocksToHTML(q)+"</blockquote>")
+			continue
+		}
+		if isItemMarker(l) {
+			tops, consumed := collectList(lines, i)
+			out = append(out, listHTML(tops))
+			i += consumed
+			continue
+		}
+		// paragraph: runs until a blank line or a non-paragraph line
+		var p []string
+		for i < n {
+			l2 := lines[i]
+			if _, ok := isHeadingLine(l2); ok {
+				break
+			}
+			if isBlank(l2) || strings.HasPrefix(l2, "```") || isRule(l2) ||
+				strings.HasPrefix(l2, ">") || isItemMarker(l2) {
+				break
+			}
+			p = append(p, l2)
+			i++
+		}
+		text := stripLeading(strings.Join(p, "\n"))
+		out = append(out, "<p>"+inline(text)+"</p>")
+	}
+	return out
+}
+
+func blocksToHTML(lines []string) string {
+	return strings.Join(parseBlocks(lines), "\n")
+}
+
+func firstWord(s string) string {
+	f := strings.Fields(s)
+	if len(f) == 0 {
+		return ""
+	}
+	return f[0]
+}
+
+func codeBlockHTML(info string, content []string) string {
+	var b strings.Builder
+	b.WriteString("<pre><code")
+	if info != "" {
+		b.WriteString(` class="`)
+		b.WriteString(escapeText(info))
+		b.WriteByte('"')
+	}
+	b.WriteString(">")
+	for _, c := range content {
+		b.WriteString(escapeText(c))
+		b.WriteByte('\n')
+	}
+	b.WriteString("</code></pre>")
+	return b.String()
+}
+
+// isHeadingLine reports whether l is a heading line and returns its level.
+func isHeadingLine(l string) (int, bool) {
+	n := 0
+	for n < len(l) && l[n] == '#' {
+		n++
+	}
+	if n < 1 || n > 6 {
+		return 0, false
+	}
+	if n < len(l) && l[n] != ' ' {
+		return 0, false
+	}
+	return n, true
+}
+
+func headingHTML(l string) (string, bool) {
+	level, ok := isHeadingLine(l)
+	if !ok {
+		return "", false
+	}
+	text := ""
+	if level < len(l) {
+		text = l[level+1:]
+	}
+	text = strings.TrimRight(text, " ")
+	for {
+		j := len(text)
+		for j > 0 && text[j-1] == '#' {
+			j--
+		}
+		if j == len(text) || j == 0 || text[j-1] != ' ' {
+			break
+		}
+		text = strings.TrimRight(text[:j], " ")
+	}
+	tag := "h" + string(rune('0'+byte(level)))
+	return "<" + tag + ">" + inline(text) + "</" + tag + ">", true
+}
+
+// isRule reports a horizontal rule line: 3+ of one of -, * or _, no other chars.
+func isRule(l string) bool {
+	if len(l) < 3 {
+		return false
+	}
+	c := l[0]
+	if c != '-' && c != '*' && c != '_' {
+		return false
+	}
+	for i := 1; i < len(l); i++ {
+		if l[i] != c {
+			return false
+		}
+	}
+	return true
+}
+
+func dropQuote(l string) string {
+	l = l[1:]
+	if strings.HasPrefix(l, " ") {
+		l = l[1:]
+	}
+	return l
+}
+
+// ---------- lists ----------
+
+const (
+	kindUnordered = iota
+	kindOrdered
+)
+
+type itemLine struct {
+	text   string
+	num    string // ordered marker number, "" for unordered
+	kind   int
+	nested []itemLine // nested items (one level)
+}
+
+func isItemMarker(l string) bool {
+	if strings.HasPrefix(l, "- ") || strings.HasPrefix(l, "* ") || strings.HasPrefix(l, "+ ") {
+		return true
+	}
+	idx := strings.IndexByte(l, '.')
+	if idx < 1 {
+		return false
+	}
+	for i := 0; i < idx; i++ {
+		if l[i] < '0' || l[i] > '9' {
+			return false
+		}
+	}
+	return idx+1 < len(l) && l[idx+1] == ' '
+}
+
+// parseItem strips the marker from an item line (assumed valid).
+func parseItem(l string) itemLine {
+	if strings.HasPrefix(l, "- ") || strings.HasPrefix(l, "* ") || strings.HasPrefix(l, "+ ") {
+		return itemLine{text: l[2:], kind: kindUnordered}
+	}
+	idx := strings.IndexByte(l, '.')
+	return itemLine{text: l[idx+2:], num: l[:idx], kind: kindOrdered}
+}
+
+// collectList consumes consecutive item lines (with continuations) starting at i.
+func collectList(lines []string, i int) ([]itemLine, int) {
+	var tops []itemLine
+	var lastNest []itemLine
+	lastNestIndent := -1
+	startKind := -1
+	n := len(lines)
+	for i < n {
+		l := lines[i]
+		sp := leadingSpaces(l)
+		if sp == 0 {
+			if !isItemMarker(l) || isBlank(l) {
+				break
+			}
+			it := parseItem(l)
+			if startKind == -1 {
+				startKind = it.kind
+			}
+			if it.kind != startKind {
+				break // a different kind starts a new list
+			}
+			tops = append(tops, it)
+			lastNest = nil
+			lastNestIndent = -1
+			i++
+			continue
+		}
+		if sp >= 2 && len(tops) > 0 {
+			s := l[min(sp, 4):]
+			if isItemMarker(s) {
+				it := parseItem(s)
+				lastNest = append(lastNest, it)
+				lastNestIndent = sp
+				tops[len(tops)-1].nested = lastNest
+				i++
+				continue
+			}
+			plain := strings.TrimLeft(l, " ")
+			if len(lastNest) > 0 && sp >= lastNestIndent+2 {
+				last := len(lastNest) - 1
+				lastNest[last].text += "\n" + plain
+				tops[len(tops)-1].nested = lastNest
+			} else {
+				tops[len(tops)-1].text += "\n" + plain
+			}
+			i++
+			continue
+		}
+		break
+	}
+	return tops, i - 0
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+// listHTML renders a group of same-kind items.
+func listHTML(items []itemLine) string {
+	tag := "ul"
+	if items[0].kind == kindOrdered {
+		tag = "ol"
+		if items[0].num != "1" {
+			tag = `ol start="` + items[0].num + `"`
+		}
+	}
+	var parts []string
+	for _, it := range items {
+		parts = append(parts, itemHTML(it))
+	}
+	closeTag := "ul"
+	if items[0].kind == kindOrdered {
+		closeTag = "ol"
+	}
+	return "<" + tag + ">\n" + strings.Join(parts, "\n") + "\n</" + closeTag + ">"
+}
+
+func itemHTML(it itemLine) string {
+	var b strings.Builder
+	b.WriteString("<li>")
+	b.WriteString(inline(it.text))
+	groups := nestedGroups(it.nested)
+	for _, g := range groups {
+		b.WriteString("\n")
+		b.WriteString(listHTML(g))
+	}
+	if len(groups) > 0 {
+		b.WriteString("\n")
+	}
+	b.WriteString("</li>")
+	return b.String()
+}
+
+// nestedGroups splits nested items into consecutive same-kind groups.
+func nestedGroups(nested []itemLine) [][]itemLine {
+	var groups [][]itemLine
+	for _, it := range nested {
+		if len(groups) > 0 && groups[len(groups)-1][0].kind == it.kind {
+			groups[len(groups)-1] = append(groups[len(groups)-1], it)
+		} else {
+			groups = append(groups, []itemLine{it})
+		}
+	}
+	return groups
+}
+
+// stripLeading removes leading spaces from each line of a multiline string.
+func stripLeading(s string) string {
+	lines := strings.Split(s, "\n")
+	for i, l := range lines {
+		lines[i] = strings.TrimLeft(l, " ")
+	}
+	return strings.Join(lines, "\n")
+}
+
+// ---------- inline ----------
+
+// escapeText HTML-escapes &, <, > and ".
+func escapeText(s string) string {
+	r := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", `"`, "&quot;")
+	return r.Replace(s)
+}
+
+// escapeAttr escapes attribute values (href, title).
+func escapeAttr(s string) string {
+	r := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", `"`, "&quot;")
+	return r.Replace(s)
+}
+
+var escSet = "\\`*_{}[]()#+-.!<>"
+
+// inline processes the inline syntax of a (possibly multiline) text.
+func inline(s string) string {
+	lines := strings.Split(s, "\n")
+	for i, l := range lines {
+		br := false
+		if i < len(lines)-1 {
+			if strings.HasSuffix(l, `\`) {
+				br = true
+				l = l[:len(l)-1]
+			} else if trailingSpaceCount(l) >= 2 {
+				br = true
+			}
+		}
+		l = strings.TrimRight(l, " ")
+		if br {
+			l += "<br />"
+		}
+		lines[i] = inlineLine(l)
+	}
+	return strings.Join(lines, "\n")
+}
+
+func trailingSpaceCount(s string) int {
+	n := 0
+	for i := len(s) - 1; i >= 0 && s[i] == ' '; i-- {
+		n++
+	}
+	return n
+}
+
+type openMark struct {
+	pos int
+	ln  int
+	ch  byte
+}
+
+// emphPass handles strong/emphasis. It repeatedly finds the leftmost opener
+// that has a matching closer, renders it (recursing into the inner text),
+// and continues after the pair; unmatched markers stay literal.
+func emphPass(s string) string {
+	return emphPassLinks(s, true)
+}
+
+func emphPassLinks(s string, links bool) string {
+	var out strings.Builder
+	i := 0
+	for i < len(s) {
+		p, L := nextRun(s, i)
+		if p < 0 {
+			out.WriteString(inlineNoEmphLinks(s[i:], links))
+			break
+		}
+		c := s[p]
+		ln := runLen(c, L) // 2 for ** / __, 1 for * / _
+		openEnd := p + ln
+		isOpen := canOpen(s, p, c, L)
+		var q, qln int
+		if isOpen {
+			q, qln = findCloser(s, openEnd, c, ln)
+		}
+		if !isOpen || q < 0 {
+			// literal marker run
+			out.WriteString(inlineNoEmphLinks(s[i : p+L], links))
+			i = p + L
+			continue
+		}
+		tag := "em"
+		if ln == 2 {
+			tag = "strong"
+		}
+		out.WriteString(inlineNoEmphLinks(s[i:p], links))
+		out.WriteString("<" + tag + ">")
+		out.WriteString(emphPassLinks(s[openEnd:q], links))
+		out.WriteString("</" + tag + ">")
+		i = q + qln
+	}
+	return out.String()
+}
+
+// runLen returns the marker length used by a run of c with total length L.
+func runLen(c byte, L int) int {
+	if c == '_' && L < 2 {
+		return 1
+	}
+	if L >= 2 {
+		return 2
+	}
+	return 1
+}
+
+// nextRun finds the next run of '*' or '_' starting at or after i.
+func nextRun(s string, i int) (pos, length int) {
+	for j := i; j < len(s); j++ {
+		if s[j] == '*' || s[j] == '_' {
+			k := j
+			for k < len(s) && s[k] == s[j] {
+				k++
+			}
+			return j, k - j
+		}
+	}
+	return -1, 0
+}
+
+// canOpen reports whether the run [p, p+L) may open emphasis.
+func canOpen(s string, p int, c byte, L int) bool {
+	if p+L >= len(s) || s[p+L] == ' ' {
+		return false
+	}
+	if c == '_' && p > 0 && isWordChar(s[p-1]) {
+		return false
+	}
+	return true
+}
+
+// findCloser searches for the first run of c that may close emphasis of
+// length ln; returns its position and consumed length.
+func findCloser(s string, from int, c byte, ln int) (int, int) {
+	p, L := nextRun(s, from)
+	for p >= 0 {
+		if s[p] == c && canClose(s, p, c, L) {
+			consume := ln
+			if L < consume {
+				consume = L
+			}
+			return p, consume
+		}
+		p, L = nextRun(s, p+L)
+	}
+	return -1, 0
+}
+
+// canClose reports whether the run [p, p+L) may close emphasis.
+func canClose(s string, p int, c byte, L int) bool {
+	if p == 0 || s[p-1] == ' ' {
+		return false
+	}
+	if c == '_' && p+L < len(s) && isWordChar(s[p+L]) {
+		return false
+	}
+	return true
+}
+
+// inlineLine processes one line left to right.
+func inlineLine(s string) string {
+	return emphPass(s)
+}
+
+func isWordChar(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+}
+
+// inlineNoEmph processes all inline constructs except strong/emphasis,
+// leaving * and _ as literal text.
+func inlineNoEmph(s string) string {
+	var out strings.Builder
+	var lit strings.Builder
+	flush := func() {
+		if lit.Len() > 0 {
+			out.WriteString(escapeText(lit.String()))
+			lit.Reset()
+		}
+	}
+	for i := 0; i < len(s); {
+		c := s[i]
+		// backslash escape
+		if c == '\\' && i+1 < len(s) && strings.IndexByte(escSet, s[i+1]) >= 0 {
+			flush()
+			out.WriteString(escapeText(string(s[i+1])))
+			i += 2
+			continue
+		}
+		// code span
+		if c == '`' {
+			n := 0
+			for i+n < len(s) && s[i+n] == '`' {
+				n++
+			}
+			if j := findCloseBacktick(s, i+n, n); j >= 0 {
+				content := s[i+n : j]
+				if len(content) >= 2 && content[0] == ' ' && content[len(content)-1] == ' ' &&
+					strings.TrimSpace(content) != "" {
+					content = content[1 : len(content)-1]
+				}
+				flush()
+				out.WriteString("<code>" + escapeText(content) + "</code>")
+				i = j + n
+				continue
+			}
+			lit.WriteByte('`')
+			i++
+			continue
+		}
+		// autolink
+		if c == '<' {
+			rest := s[i+1:]
+			var url string
+			if strings.HasPrefix(rest, "http://") {
+				url = "http://"
+			} else if strings.HasPrefix(rest, "https://") {
+				url = "https://"
+			}
+			if url != "" {
+				tail := s[i+len(url):]
+				end := strings.IndexAny(tail, " <>")
+				if end > 0 {
+					u := url + tail[:end]
+					flush()
+					out.WriteString(`<a href="` + escapeAttr(u) + `">` + escapeAttr(u) + "</a>")
+					i += len(url) + end + 1
+					continue
+				}
+			}
+			lit.WriteByte('<')
+			i++
+			continue
+		}
+		// link
+		if c == '[' {
+			if end := matchBracket(s, i); end > 0 {
+				after := s[end+1:]
+				if strings.HasPrefix(after, "(") {
+					if p := findCloseParen(s, end+1); p >= 0 {
+						target := s[end+2 : p]
+						url, title := parseTarget(target)
+						if url != "" {
+							flush()
+							out.WriteString(`<a href="` + escapeAttr(url) + `"`)
+							if title != "" {
+								out.WriteString(` title="` + escapeText(title) + `"`)
+							}
+							out.WriteString(">" + inlineLinkText(s[i+1:end]) + "</a>")
+							i = p + 1
+							continue
+						}
+					}
+				}
+			}
+			lit.WriteByte('[')
+			i++
+			continue
+		}
+		lit.WriteByte(c)
+		i++
+	}
+	flush()
+	return out.String()
+}
+
+// inlineLinkText processes link text with all syntax except links.
+func inlineLinkText(s string) string {
+	// Emphasis and code spans still apply inside link text.
+	return inlineLine(s)
+}
+
+// parseTarget splits "url" or "url \"title\"". ok is false when the target
+// does not match the pattern (url must have no spaces).
+func parseTarget(t string) (url, title string, ok bool) {
+	t = strings.TrimSpace(t)
+	if i := strings.IndexByte(t, '"'); i >= 0 {
+		if j := strings.IndexByte(t[i+1:], '"'); j >= 0 {
+			rest := strings.TrimSpace(t[i+1+j+1:])
+			if rest != "" {
+				return "", "", false
+			}
+			url = strings.TrimSpace(t[:i])
+			if url == "" || strings.Contains(url, " ") {
+				return "", "", false
+			}
+			return url, t[i+1 : i+1+j], true
+		}
+		return "", "", false
+	}
+	url = t
+	if url == "" || strings.Contains(url, " ") {
+		return "", "", false
+	}
+	return url, "", true
+}
+
+// findCloseBacktick finds the next run of exactly n backticks; returns its
+// start index or -1.
+func findCloseBacktick(s string, from, n int) int {
+	i := from
+	for i < len(s) {
+		if s[i] != '`' {
+			i++
+			continue
+		}
+		j := i
+		for j < len(s) && s[j] == '`' {
+			j++
+		}
+		if j-i == n {
+			return i
+		}
+		i = j
+	}
+	return -1
+}
+
+// matchBracket returns the index of the matching ']' for the '[' at i, or -1.
+func matchBracket(s string, i int) int {
+	depth := 0
+	for j := i; j < len(s); j++ {
+		switch s[j] {
+		case '[':
+			depth++
+		case ']':
+			depth--
+			if depth == 0 {
+				return j
+			}
+		}
+	}
+	return -1
+}
+
+// findCloseParen returns the index of the ')' closing the '(' at i, honouring
+// nested parentheses, or -1.
+func findCloseParen(s string, i int) int {
+	depth := 0
+	for j := i; j < len(s); j++ {
+		switch s[j] {
+		case '(':
+			depth++
+		case ')':
+			depth--
+			if depth == 0 {
+				return j
+			}
+		}
+	}
+	return -1
+}
