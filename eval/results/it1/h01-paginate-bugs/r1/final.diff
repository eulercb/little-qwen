+
+func TestLastPageKeepsAllItems(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []int{5}
+	if len(p.Items) != len(want) || p.Items[0] != want[0] || p.HasNext || !p.HasPrev {
+		t.Fatalf("%+v", p)
+	}
+}
+
+func TestLastPageExactMultiple(t *testing.T) {
+	// 6 items, size 3: last page must contain both of its items.
+	p, err := Get([]int{1, 2, 3, 4, 5, 6}, 3, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []int{4, 5, 6}
+	if len(p.Items) != len(want) {
+		t.Fatalf("got %v, want %v", p.Items, want)
+	}
+	for i := range want {
+		if p.Items[i] != want[i] {
+			t.Fatalf("got %v, want %v", p.Items, want)
+		}
+	}
+	if p.HasNext {
+		t.Fatalf("HasNext = true on last page (%+v)", p)
+	}
+}
+
+func TestTotalPagesExactMultiple(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5, 6}, 3, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.TotalPages != 2 {
+		t.Fatalf("TotalPages = %d, want 2 (%+v)", p.TotalPages, p)
+	}
+}
+
+func TestTotalPagesRemainder(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.TotalPages != 3 {
+		t.Fatalf("TotalPages = %d, want 3 (%+v)", p.TotalPages, p)
+	}
+}
+
+func TestPagePastEndIsEmpty(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 99)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Items) != 0 || p.HasNext || !p.HasPrev {
+		t.Fatalf("%+v", p)
+	}
+	if p.Number != 99 {
+		t.Fatalf("Number = %d, want 99", p.Number)
+	}
+}
+
+func TestEmptyInput(t *testing.T) {
+	p, err := Get([]int{}, 2, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.TotalPages != 0 || len(p.Items) != 0 || p.HasNext || p.HasPrev {
+		t.Fatalf("%+v", p)
+	}
+}
+
+func TestItemsDoNotAliasInput(t *testing.T) {
+	in := []int{1, 2, 3, 4}
+	p, err := Get(in, 2, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.Items[0] = 42
+	if in[2] == 42 {
+		t.Fatal("returned Items slice aliases the input")
+	}
