diff --git a/page/page.go b/page/page.go
index 4876b58..b2a295f 100644
--- a/page/page.go
+++ b/page/page.go
@@ -28,22 +28,22 @@ func Get[T any](items []T, size, n int) (Page[T], error) {
 	if n < 1 {
 		return Page[T]{}, ErrBadPage
 	}
-	total := len(items)/size + 1
-	if len(items) == 0 {
-		total = 0
-	}
-	start := (n - 1) * size
-	end := start + size
-	if end > len(items) {
-		end = len(items) - 1
-	}
+	total := (len(items) + size - 1) / size
 	p := Page[T]{
-		Items:      items[start:end],
 		Number:     n,
 		TotalPages: total,
-		HasNext:    n < total,
 		HasPrev:    n > 1,
 	}
+	if n <= total {
+		start := (n - 1) * size
+		end := start + size
+		if end > len(items) {
+			end = len(items)
+		}
+		p.Items = make([]T, end-start)
+		copy(p.Items, items[start:end])
+		p.HasNext = n < total
+	}
 	return p, nil
 }
 
