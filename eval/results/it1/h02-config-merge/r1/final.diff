+
+func TestLoadDefaultsNewFields(t *testing.T) {
+	c, err := Load(env(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != 30*time.Second {
+		t.Fatalf("Timeout = %v, want 30s", c.Timeout)
+	}
+	if c.Tags != nil {
+		t.Fatalf("Tags = %v, want nil", c.Tags)
+	}
+}
+
+func TestLoadTimeoutAndTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TIMEOUT": "2.5s", "APP_TAGS": " a, b ,,c "}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Timeout != 2500*time.Millisecond {
+		t.Fatalf("Timeout = %v, want 2.5s", c.Timeout)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("Tags = %v, want %v", c.Tags, want)
+	}
+	for i := range want {
+		if c.Tags[i] != want[i] {
+			t.Fatalf("Tags = %v, want %v", c.Tags, want)
+		}
+	}
+}
+
+func TestLoadCollectsAllInvalid(t *testing.T) {
+	c, err := Load(env(map[string]string{
+		"APP_PORT": "abc", "APP_DEBUG": "maybe", "APP_WORKERS": "0", "APP_TIMEOUT": "nope",
+	}))
+	if err == nil {
+		t.Fatal("expected error, got nil")
+	}
+	if !reflect.DeepEqual(c, Config{}) {
+		t.Fatalf("Config = %+v, want zero", c)
+	}
+	for _, name := range []string{"APP_PORT", "APP_DEBUG", "APP_WORKERS", "APP_TIMEOUT"} {
+		if !strings.Contains(err.Error(), name) {
+			t.Errorf("error %q does not mention %s", err, name)
+		}
+	}
+}
+
+func TestLoadValidAlongsideOneInvalid(t *testing.T) {
+	_, err := Load(env(map[string]string{"APP_HOST": "x", "APP_PORT": "99999"}))
+	if err == nil || !strings.Contains(err.Error(), "APP_PORT") {
+		t.Fatalf("err = %v, want single APP_PORT error", err)
+	}
+}
+
+func TestMergeZeroValuesKeepBase(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a", "b"}
+	merged := Merge(base, Config{})
+	if !reflect.DeepEqual(merged, base) || merged.Tags[0] != "a" {
+		t.Fatalf("merged = %+v, want base %+v", merged, base)
+	}
+}
+
+func TestMergeNonZeroReplacesBase(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a", "b"}
+	override := Config{Host: "example.com", Port: 9000, Timeout: 5 * time.Second, Tags: []string{"x"}}
+	merged := Merge(base, override)
+	if merged.Host != "example.com" || merged.Port != 9000 || merged.Workers != 4 || merged.Debug || merged.Timeout != 5*time.Second {
+		t.Fatalf("merged = %+v", merged)
+	}
+	if len(merged.Tags) != 1 || merged.Tags[0] != "x" {
+		t.Fatalf("Tags = %v, want [x]", merged.Tags)
+	}
+}
+
+func TestMergeEmptyNonNilTagsReplace(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a", "b"}
+	override := Config{Tags: []string{}}
+	merged := Merge(base, override)
+	if merged.Tags == nil || len(merged.Tags) != 0 {
+		t.Fatalf("Tags = %v, want empty non-nil", merged.Tags)
+	}
+	if len(base.Tags) != 2 {
