+	}
+}
+
+func TestMergeNilTagsKeepBase(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a", "b"}
+	merged := Merge(base, Config{Host: "h"})
+	if merged.Tags == nil || len(merged.Tags) != 2 || merged.Tags[0] != "a" {
+		t.Fatalf("Tags = %v, want base tags [a b]", merged.Tags)
+	}
+}
+
+func TestMergeDoesNotModifyArguments(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a"}
+	override := Config{Tags: []string{"x"}}
+	Merge(base, override)
+	if len(base.Tags) != 1 || base.Tags[0] != "a" || len(override.Tags) != 1 || override.Tags[0] != "x" {
+		t.Fatalf("arguments modified: base=%v override=%v", base.Tags, override.Tags)
+	}
+}
