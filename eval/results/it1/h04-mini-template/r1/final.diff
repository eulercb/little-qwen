+// Package tmpl is a tiny text template engine.
+//
+// Text outside {{ ... }} tags is copied verbatim. {{ name | filter | ... }}
+// tags look up nested values from data and apply string filters.
+package tmpl
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Render renders src using data. The returned string is empty when an error
+// occurs.
+func Render(src string, data map[string]any) (string, error) {
+	var b strings.Builder
+	i := 0
+	for i < len(src) {
+		if !strings.HasPrefix(src[i:], "{{") {
+			b.WriteByte(src[i])
+			i++
+			continue
+		}
+		// {{{{ outputs a literal {{ and is not the start of a tag.
+		if strings.HasPrefix(src[i:], "{{{{") {
+			b.WriteString("{{")
+			i += 4
+			continue
+		}
+		rest := src[i+2:]
+		j := strings.Index(rest, "}}")
+		if j < 0 {
+			return "", fmt.Errorf("unterminated tag %q", rest)
+		}
+		val, err := renderTag(rest[:j], data)
+		if err != nil {
+			return "", err
+		}
+		b.WriteString(val)
+		i += 2 + j + 2
+	}
+	return b.String(), nil
+}
+
+// renderTag renders the text between the braces of one tag.
+func renderTag(inner string, data map[string]any) (string, error) {
+	if strings.TrimSpace(inner) == "" {
+		return "", fmt.Errorf("empty tag %q", inner)
+	}
+	pos := 0
+	full, segs, pos, err := parseName(inner, pos)
+	if err != nil {
+		return "", err
+	}
+	value, err := lookup(data, full, segs)
+	if err != nil {
+		return "", err
+	}
+	val := format(value)
+	for {
+		skipWS(inner, &pos)
+		if pos >= len(inner) {
+			break
+		}
+		if inner[pos] != '|' {
+			return "", fmt.Errorf("bad tag %q: unexpected content after name %q", inner, full)
+		}
+		pos++
+		val, pos, err = applyFilter(inner, pos, val)
+		if err != nil {
+			return "", err
+		}
+	}
+	return val, nil
+}
+
+// parseName reads an identifier followed by any .field segments.
+func parseName(s string, pos int) (full string, segs []string, next int, err error) {
+	skipWS(s, &pos)
+	if pos >= len(s) || !isIdentStart(s[pos]) {
+		return "", nil, pos, fmt.Errorf("bad name in tag %q", s)
+	}
+	start := pos
+	for pos < len(s) && isIdentRune(s[pos]) {
+		pos++
+	}
+	full = s[start:pos]
+	segs = []string{full}
+	for pos < len(s) && s[pos] == '.' {
+		pos++
+		if pos >= len(s) || !isIdentStart(s[pos]) {
+			return full, segs, pos, fmt.Errorf("bad name in tag %q", s)
+		}
+		start = pos
+		for pos < len(s) && isIdentRune(s[pos]) {
+			pos++
+		}
+		segs = append(segs, s[start:pos])
+	}
+	return full, segs, pos, nil
+}
+
+// lookup resolves a possibly dotted name against nested map[string]any values.
+// A missing name yields nil (formatted as the empty string); indexing a
+// non-map value yields an error naming the full path.
+func lookup(data map[string]any, full string, segs []string) (any, error) {
+	cur := any(data)
+	for i, seg := range segs {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			if i == 0 {
+				return nil, nil // missing name
+			}
+			return nil, fmt.Errorf("cannot index %q: not a map", strings.Join(segs[:i+1], "."))
+		}
+		v, present := m[seg]
+		if !present || v == nil {
+			return nil, nil
+		}
+		cur = v
+	}
+	return cur, nil
+}
+
+// format renders a looked-up value as a string.
+func format(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return v
+	case bool:
+		return strconv.FormatBool(v)
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// applyFilter parses and applies one "filter[:arg]" starting just after the '|'.
+func applyFilter(s string, pos int, val string) (string, int, error) {
+	skipWS(s, &pos)
+	if pos >= len(s) || !isIdentStart(s[pos]) {
+		return val, pos, fmt.Errorf("bad tag %q: missing filter name", s)
+	}
+	start := pos
+	for pos < len(s) && isIdentRune(s[pos]) {
+		pos++
+	}
+	name := s[start:pos]
+	skipWS(s, &pos)
+	hasArg := false
+	var arg string
+	if pos < len(s) && s[pos] == ':' {
+		pos++
+		skipWS(s, &pos)
+		if pos >= len(s) || s[pos] != '"' {
+			return val, pos, fmt.Errorf("filter %q requires an argument", name)
+		}
+		var err error
+		arg, pos, err = parseQuoted(s, pos)
+		if err != nil {
+			return val, pos, fmt.Errorf("filter %q: %v", name, err)
+		}
+		hasArg = true
+	}
+	skipWS(s, &pos)
+	switch name {
+	case "upper":
+		if hasArg {
+			return val, pos, fmt.Errorf("filter %q takes no arguments", name)
+		}
+		val = strings.ToUpper(val)
+	case "lower":
+		if hasArg {
+			return val, pos, fmt.Errorf("filter %q takes no arguments", name)
+		}
+		val = strings.ToLower(val)
+	case "trim":
+		if hasArg {
+			return val, pos, fmt.Errorf("filter %q takes no arguments", name)
+		}
+		val = strings.TrimSpace(val)
+	case "html":
+		if hasArg {
+			return val, pos, fmt.Errorf("filter %q takes no arguments", name)
+		}
+		val = htmlEscape(val)
+	case "default":
+		if !hasArg {
+			return val, pos, fmt.Errorf("filter %q requires an argument", name)
+		}
+		if val == "" {
+			val = arg
+		}
+	case "truncate":
+		if !hasArg {
+			return val, pos, fmt.Errorf("filter %q requires an argument", name)
+		}
+		n, err := strconv.Atoi(arg)
+		if err != nil || n < 0 {
+			return val, pos, fmt.Errorf("filter %q: invalid argument %q", name, arg)
+		}
+		val = truncate(val, n)
+	default:
+		return val, pos, fmt.Errorf("unknown filter %q", name)
+	}
+	return val, pos, nil
+}
+
+// parseQuoted reads a double-quoted argument starting at s[pos] == '"'.
+func parseQuoted(s string, pos int) (string, int, error) {
+	pos++ // opening quote
+	var b strings.Builder
+	for {
+		if pos >= len(s) {
+			return "", pos, errors.New("unterminated argument")
+		}
+		c := s[pos]
+		if c == '\\' {
+			if pos+1 >= len(s) {
+				return "", pos, errors.New("unterminated argument")
+			}
+			pos++
+			switch s[pos] {
+			case '"', '\\':
+				b.WriteByte(s[pos])
+				pos++
+			default:
+				return "", pos, fmt.Errorf("invalid escape %q", s[pos])
+			}
+			continue
+		}
+		if c == '"' {
+			return b.String(), pos + 1, nil
+		}
+		b.WriteByte(c)
+		pos++
+	}
+}
+
+var escaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&#34;",
+	"'", "&#39;",
+)
+
+// htmlEscape escapes the five HTML special characters.
+func htmlEscape(s string) string {
+	return escaper.Replace(s)
+}
+
+// truncate keeps at most n runes, appending … if anything was cut.
+func truncate(s string, n int) string {
+	r := []rune(s)
+	if len(r) <= n {
+		return s
+	}
+	return string(r[:n]) + "…"
+}
+
+func isIdentStart(c byte) bool {
+	return c == '_' || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
+}
+
+func isIdentRune(c byte) bool {
+	return isIdentStart(c) || (c >= '0' && c <= '9')
+}
+
+func skipWS(s string, pos *int) {
+	for *pos < len(s) {
+		switch s[*pos] {
+		case ' ', '\t', '\n', '\r':
+			*pos++
+		default:
+			return
+		}
+	}
+}
diff --git a/tmpl/tmpl_test.go b/tmpl/tmpl_test.go
