@@ -0,0 +1,206 @@
+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func mustRender(t *testing.T, src string, data map[string]any) string {
+	t.Helper()
+	got, err := Render(src, data)
+	if err != nil {
+		t.Fatalf("Render(%q) error: %v", src, err)
+	}
+	return got
+}
+
+func wantErr(t *testing.T, src string, data map[string]any, contains ...string) {
+	t.Helper()
+	got, err := Render(src, data)
+	if err == nil {
+		t.Fatalf("Render(%q) = %q, want error", src, got)
+	}
+	for _, c := range contains {
+		if !strings.Contains(err.Error(), c) {
+			t.Fatalf("Render(%q) error = %q, want it to contain %q", src, err.Error(), c)
+		}
+	}
+	if got != "" {
+		t.Fatalf("Render(%q) output = %q, want empty on error", src, got)
+	}
+}
+
+func TestPlainText(t *testing.T) {
+	if got := mustRender(t, "hello world\n1+1=2", nil); got != "hello world\n1+1=2" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "a } } b { { c", nil); got != "a } } b { { c" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestLiteralBraces(t *testing.T) {
+	if got := mustRender(t, "{{{{", nil); got != "{{" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{{{ name }}", map[string]any{"name": "x"}); got != "{{ name }}" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestValues(t *testing.T) {
+	data := map[string]any{
+		"empty": "",
+		"str":   "  hi ",
+		"i":     42,
+		"i64":   int64(7),
+		"f":     3.14,
+		"b":     true,
+		"bf":    false,
+		"none":  nil,
+	}
+	cases := []struct{ tag, want string }{
+		{"{{ empty }}", ""},
+		{"{{ str }}", "  hi "},
+		{"{{ i }}", "42"},
+		{"{{ i64 }}", "7"},
+		{"{{ f }}", "3.14"},
+		{"{{ b }}", "true"},
+		{"{{ bf }}", "false"},
+		{"{{ missing }}", ""},
+		{"{{ none }}", ""},
+	}
+	for _, c := range cases {
+		if got := mustRender(t, c.tag, data); got != c.want {
+			t.Errorf("Render(%q) = %q, want %q", c.tag, got, c.want)
+		}
+	}
+}
+
+func TestNestedLookup(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name": "Alice",
+			"age":  30,
+			"nick": nil,
+		},
+	}
+	if got := mustRender(t, "{{ user.name }}", data); got != "Alice" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{ user.age }}", data); got != "30" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{ user.missing }}", data); got != "" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{ user.nick }}", data); got != "" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{ ghost.name }}", data); got != "" {
+		t.Fatalf("got %q, want empty for missing root", got)
+	}
+}
+
+func TestNonMapIndexError(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{"name": "Alice"},
+	}
+	wantErr(t, "{{ user.name.first }}", data, "user.name.first")
+	if got := mustRender(t, "{{ user }}", map[string]any{"user": 3}); got != "3" {
+		t.Fatalf("got %q, want %q", got, "3")
+	}
+}
+
+func TestFilters(t *testing.T) {
+	data := map[string]any{
+		"raw":  "  Hello  ",
+		"long": "abcdefgh",
+		"uni":  "héllo",
+		"html": "<a href=\"x\">&'>'",
+	}
+	cases := []struct{ tag, want string }{
+		{"{{ raw | upper }}", "  HELLO  "},
+		{"{{ raw | lower }}", "  hello  "},
+		{"{{ raw | trim }}", "Hello"},
+		{"{{ raw | trim | upper }}", "HELLO"},
+		{"{{ missing | default:\"none\" }}", "none"},
+		{"{{ raw | default:\"none\" }}", "  Hello  "},
+		{"{{ raw | trim | default:\"none\" }}", "Hello"},
+		{"{{ long | truncate:\"2\" }}", "ab…"},
+		{"{{ long | truncate:\"8\" }}", "abcdefgh"},
+		{"{{ long | truncate:\"0\" }}", "…"},
+		{"{{ uni | truncate:\"2\" }}", "hé…"},
+		{`{{ html | html }}`, "&lt;a href=&#34;x&#34;&gt;&amp;&#39;&gt;&#39;"},
+	}
+	for _, c := range cases {
+		if got := mustRender(t, c.tag, data); got != c.want {
+			t.Errorf("Render(%q) = %q, want %q", c.tag, got, c.want)
+		}
+	}
+}
+
+func TestFilterArgEscapes(t *testing.T) {
+	data := map[string]any{"s": ""}
+	if got := mustRender(t, `{{ s | default:"a\"b\\c" }}`, data); got != `a"b\c` {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestWhitespaceIgnored(t *testing.T) {
+	data := map[string]any{"user": map[string]any{"name": "bob"}}
+	if got := mustRender(t, "{{  user.name  |  upper  }}", data); got != "BOB" {
+		t.Fatalf("got %q", got)
+	}
+	if got := mustRender(t, "{{\n user.name\n}}", data); got != "bob" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	data := map[string]any{"name": "x"}
+	wantErr(t, "{{ name | nope }}", data, "nope")
+	wantErr(t, "{{ missing | nope:5 }}", data, "nope")
+	wantErr(t, "{{ name | default }}", data, "default")
+	wantErr(t, `{{ name | default }}`, data, "default")
+	wantErr(t, `{{ name | upper:"y" }}`, data, "upper")
+	wantErr(t, `{{ name | lower:1 }}`, data, "lower")
+	wantErr(t, `{{ name | trim:"x" }}`, data, "trim")
+	wantErr(t, `{{ name | html:"x" }}`, data, "html")
+	wantErr(t, `{{ name | truncate:"x" }}`, data, "truncate")
+	wantErr(t, `{{ name | truncate:"-1" }}`, data, "truncate")
+	wantErr(t, `{{ name | truncate }}`, data, "truncate")
+	wantErr(t, "{{ name", data, "unterminated")
+	wantErr(t, "{{ }}", data)
+	wantErr(t, "{{   }}", data)
+	wantErr(t, "{{ 1abc }}", data)
+	wantErr(t, "{{ .name }}", data)
+	wantErr(t, `{{ name | upper:"unterminated }}`, data)
+	wantErr(t, `{{ name | upper:5 }}`, data)
+}
+
+func TestMixedDocument(t *testing.T) {
+	data := map[string]any{
+		"title":     "My <Page>",
+		"user":      map[string]any{"name": "  alice  "},
+		"biography": strings.Repeat("word ", 100),
+		"count":     5,
+	}
+	src := `{{ title | html }}
+By {{ user.name | trim | lower | default:"anonymous" }}
+{{ count }} {{ user.name | trim | default:"anonymous" }}
+{{ biography | truncate:"12" }}
+Braces: {{{{ stay`
+	want := `My &lt;Page&gt;
+By alice
+5 alice
+word word wo…
+Braces: {{ stay`
+	got, err := Render(src, data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
