+func TestNestedCallErrors(t *testing.T) {
+	// Argument errors occur before the function body runs.
+	mustErrEval(t, "abs(1/0)", nil, "5: division by zero")
+	mustErrEval(t, "abs(x)", nil, `4: unknown variable "x"`)
+}
diff --git a/expr/lexer.go b/expr/lexer.go
new file mode 100644
index 0000000..9bdd863
--- /dev/null
+++ b/expr/lexer.go
@@ -0,0 +1,139 @@
+package expr
+
+import (
+	"fmt"
+	"strconv"
+)
+
+type tokKind int
+
+const (
+	tEOF tokKind = iota
+	tNum
+	tIdent
+	tOp
+)
+
+type token struct {
+	kind tokKind
+	pos  int
+	text string
+	num  float64
+}
+
+func (t token) is(op string) bool { return t.kind == tOp && t.text == op }
+
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func isIdentStart(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
+}
+
+func isIdentPart(c byte) bool { return isIdentStart(c) || isDigit(c) }
+
+// lex scans src into tokens. A trailing tEOF token at len(src) is appended.
+func lex(src string) ([]token, error) {
+	b := []byte(src)
+	var toks []token
+	i, n := 0, len(b)
+	for i < n {
+		c := b[i]
+		switch {
+		case c == ' ' || c == '\t' || c == '\n':
+			i++
+		case isDigit(c) || c == '.':
+			val, j, err := scanNumber(b, i)
+			if err != nil {
+				return nil, &Error{Pos: i, Msg: err.Error()}
+			}
+			toks = append(toks, token{kind: tNum, pos: i, text: string(b[i:j]), num: val})
+			i = j
+		case isIdentStart(c):
+			j := i + 1
+			for j < n && isIdentPart(b[j]) {
+				j++
+			}
+			text := string(b[i:j])
+			if text == "true" {
+				toks = append(toks, token{kind: tNum, pos: i, text: text, num: 1})
+			} else if text == "false" {
+				toks = append(toks, token{kind: tNum, pos: i, text: text, num: 0})
+			} else {
+				toks = append(toks, token{kind: tIdent, pos: i, text: text})
+			}
+			i = j
+		case c == '<' || c == '>' || c == '=' || c == '!':
+			if i+1 < n {
+				two := string(b[i : i+2])
+				if two == "<=" || two == ">=" || two == "==" || two == "!=" {
+					toks = append(toks, token{kind: tOp, pos: i, text: two})
+					i += 2
+					continue
+				}
+			}
+			if c == '=' {
+				return nil, &Error{Pos: i, Msg: "unexpected character '='"}
+			}
+			toks = append(toks, token{kind: tOp, pos: i, text: string(c)})
+			i++
+		case c == '&' && i+1 < n && b[i+1] == '&':
+			toks = append(toks, token{kind: tOp, pos: i, text: "&&"})
+			i += 2
+		case c == '|' && i+1 < n && b[i+1] == '|':
+			toks = append(toks, token{kind: tOp, pos: i, text: "||"})
+			i += 2
+		case c == '+' || c == '-' || c == '*' || c == '/' || c == '%' ||
+			c == '^' || c == '!' || c == '(' || c == ')' || c == ',' ||
+			c == '?' || c == ':':
+			toks = append(toks, token{kind: tOp, pos: i, text: string(c)})
+			i++
+		default:
+			return nil, &Error{Pos: i, Msg: fmt.Sprintf("unexpected character '%c'", rune(c))}
+		}
+	}
+	toks = append(toks, token{kind: tEOF, pos: n, text: "end of input"})
+	return toks, nil
+}
+
+// scanNumber reads a number literal starting at b[i] (a digit or '.').
+func scanNumber(b []byte, i int) (float64, int, error) {
+	n := len(b)
+	j := i
+	if c := b[j]; c == '.' {
+		j++
+		for j < n && isDigit(b[j]) {
+			j++
+		}
+	} else {
+		for j < n && isDigit(b[j]) {
+			j++
+		}
+		if j < n && b[j] == '.' {
+			j++
+			for j < n && isDigit(b[j]) {
+				j++
+			}
+		}
+	}
+	// Exponent; only attached when the mantissa is complete (not a bare '.').
+	if j < n && (b[j] == 'e' || b[j] == 'E') && b[j-1] != '.' {
+		k := j + 1
+		if k < n && (b[k] == '+' || b[k] == '-') {
+			k++
+		}
+		if k < n && isDigit(b[k]) {
+			k++
+			for k < n && isDigit(b[k]) {
+				k++
+			}
+			j = k
+		}
+	}
+	text := string(b[i:j])
+	val, err := strconv.ParseFloat(text, 64)
+	if err != nil {
+		// e.g. a stray '.' — report at its position.
+		return 0, i + 1, fmt.Errorf("invalid number %q", text)
+	}
+	return val, j, nil
+}
diff --git a/expr/parser.go b/expr/parser.go
new file mode 100644
index 0000000..4bd4e2a
--- /dev/null
+++ b/expr/parser.go
@@ -0,0 +1,261 @@
+package expr
+
+import "fmt"
+
+// node is a parsed expression.
+type node interface {
+	eval(vars map[string]float64) (float64, error)
+}
+
+type numNode struct {
+	pos int
+	val float64
+}
+
+type varNode struct {
+	pos  int
+	name string
+}
+
+type binNode struct {
+	pos int
+	op  string
+	l   node
+	r   node
+}
+
+type unNode struct {
+	pos int
+	op  string
+	x   node
+}
+
+type ternaryNode struct {
+	pos  int
+	cond node
+	a    node
+	b    node
+}
+
+type callNode struct {
+	pos  int
+	name string
+	args []node
+}
+
+// builtin describes the arity of a built-in function.
+type builtin struct {
+	min int
+	max int // -1 means unbounded
+}
+
+var builtins = map[string]builtin{
+	"abs":   {min: 1, max: 1},
+	"sqrt":  {min: 1, max: 1},
+	"min":   {min: 1, max: -1},
+	"max":   {min: 1, max: -1},
+	"round": {min: 1, max: 1},
+	"clamp": {min: 3, max: 3},
+}
+
+type parser struct {
+	toks   []token
+	pos    int
+	srcLen int
+}
+
+func (p *parser) peek() token {
+	if p.pos >= len(p.toks) {
+		return p.toks[len(p.toks)-1]
+	}
+	return p.toks[p.pos]
+}
+func (p *parser) next() token       { t := p.toks[p.pos]; p.pos++; return t }
+func (p *parser) eofPos() int       { return p.srcLen }
+func (p *parser) atEOF() bool       { return p.peek().kind == tEOF }
+
+// parse parses a complete expression, requiring end of input afterwards.
+func (p *parser) parse() (node, error) {
+	n, err := p.parseTernary()
+	if err != nil {
+		return nil, err
+	}
+	if p.atEOF() {
+		return n, nil
+	}
+	t := p.peek()
+	return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unexpected token %q", t.text)}
+}
+
+func (p *parser) expect(op string) error {
+	t := p.peek()
+	if t.is(op) {
+		p.next()
+		return nil
+	}
+	if p.atEOF() {
+		return &Error{Pos: p.srcLen, Msg: fmt.Sprintf("expected %q", op)}
+	}
+	return &Error{Pos: t.pos, Msg: fmt.Sprintf("expected %q", op)}
+}
+
+// parseTernary: c ? a : b, right-associative.
+func (p *parser) parseTernary() (node, error) {
+	cond, err := p.parseOr()
+	if err != nil {
+		return nil, err
+	}
+	if !p.peek().is("?") {
+		return cond, nil
+	}
+	q := p.next()
+	a, err := p.parseOr()
+	if err != nil {
+		return nil, err
+	}
+	if err := p.expect(":"); err != nil {
+		return nil, err
+	}
+	b, err := p.parseTernary()
+	if err != nil {
+		return nil, err
+	}
+	return &ternaryNode{pos: q.pos, cond: cond, a: a, b: b}, nil
+}
+
+// parseBinary parses a left-associative chain of the given operators,
+// with next as the level below.
+func (p *parser) parseBinary(next func() (node, error), ops ...string) (node, error) {
+	l, err := next()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		t := p.peek()
+		match := false
+		if t.kind == tOp {
+			for _, op := range ops {
+				if t.text == op {
+					match = true
+					break
+				}
+			}
+		}
+		if !match {
+			return l, nil
+		}
+		p.next()
+		r, err := next()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: t.text, l: l, r: r}
+	}
+}
+
+func (p *parser) parseOr() (node, error)  { return p.parseBinary(p.parseAnd, "||") }
+func (p *parser) parseAnd() (node, error) { return p.parseBinary(p.parseEq, "&&") }
+func (p *parser) parseEq() (node, error)  { return p.parseBinary(p.parseCmp, "==", "!=") }
+func (p *parser) parseCmp() (node, error) { return p.parseBinary(p.parseAdd, "<", "<=", ">", ">=") }
+func (p *parser) parseAdd() (node, error) { return p.parseBinary(p.parseMul, "+", "-") }
+func (p *parser) parseMul() (node, error) { return p.parseBinary(p.parseUnary, "*", "/", "%") }
+
+// parseUnary handles prefix - + ! (level 8, above power).
+func (p *parser) parseUnary() (node, error) {
+	t := p.peek()
+	if t.kind == tOp && (t.text == "-" || t.text == "+" || t.text == "!") {
+		p.next()
+		x, err := p.parseUnary()
+		if err != nil {
+			return nil, err
+		}
+		return &unNode{pos: t.pos, op: t.text, x: x}, nil
+	}
+	return p.parsePower()
+}
+
+// parsePower: base ^ exponent, right-associative, exponent is a unary
+// expression (level 9, tighter than unary on the left).
+func (p *parser) parsePower() (node, error) {
+	base, err := p.parsePostfix()
+	if err != nil {
+		return nil, err
+	}
+	t := p.peek()
+	if !t.is("^") {
+		return base, nil
+	}
+	p.next()
+	exp, err := p.parseUnary()
+	if err != nil {
+		return nil, err
+	}
+	return &binNode{pos: t.pos, op: "^", l: base, r: exp}, nil
+}
+
+func (p *parser) parsePostfix() (node, error) { return p.parsePrimary() }
+
+func (p *parser) parsePrimary() (node, error) {
+	t := p.next()
+	switch t.kind {
+	case tNum:
+		return &numNode{pos: t.pos, val: t.num}, nil
+	case tIdent:
+		if p.peek().is("(") {
+			return p.parseCall(t)
+		}
+		return &varNode{pos: t.pos, name: t.text}, nil
+	case tOp:
+		if t.is("(") {
+			n, err := p.parseTernary()
+			if err != nil {
+				return nil, err
+			}
+			if err := p.expect(")"); err != nil {
+				return nil, err
+			}
+			return n, nil
+		}
+	}
+	if t.kind == tEOF {
+		return nil, &Error{Pos: t.pos, Msg: "unexpected end of input"}
+	}
+	return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unexpected token %q", t.text)}
+}
+
+func (p *parser) parseCall(nameTok token) (node, error) {
+	p.next() // consume '('
+	var args []node
+	if p.peek().is(")") {
+		p.next()
+	} else {
+		for {
+			arg, err := p.parseTernary()
+			if err != nil {
+				return nil, err
+			}
+			args = append(args, arg)
+			if p.peek().is(",") {
+				p.next()
+				continue
+			}
+			break
+		}
+		if err := p.expect(")"); err != nil {
+			return nil, err
+		}
+	}
+	spec, ok := builtins[nameTok.text]
+	if !ok {
+		return nil, &Error{Pos: nameTok.pos, Msg: fmt.Sprintf("unknown function %q", nameTok.text)}
+	}
+	if len(args) < spec.min || (spec.max >= 0 && len(args) > spec.max) {
+		if spec.max < 0 {
+			return nil, &Error{Pos: nameTok.pos,
+				Msg: fmt.Sprintf("function %q expects at least 1 argument, got %d", nameTok.text, len(args))}
+		}
+		return nil, &Error{Pos: nameTok.pos,
+			Msg: fmt.Sprintf("function %q expects %d arguments, got %d", nameTok.text, spec.max, len(args))}
+	}
+	return &callNode{pos: nameTok.pos, name: nameTok.text, args: args}, nil
+}
