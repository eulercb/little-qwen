+
+func TestRuntimeErrors(t *testing.T) {
+	mustErrEval(t, "1/x", map[string]float64{"x": 0}, "1: division by zero")
+	mustErrEval(t, "5%0", nil, "1: division by zero")
+	mustErrEval(t, "x%y", map[string]float64{"x": 5, "y": 0}, "1: division by zero")
+	mustErrEval(t, "1 / 0", nil, "2: division by zero")
+	mustErrEval(t, "1+x", nil, `2: unknown variable "x"`)
+	mustErrEval(t, "x+y", map[string]float64{"y": 1}, `0: unknown variable "x"`)
+	mustErrEval(t, "sqrt(-1)", nil, "0: sqrt of negative number")
+	mustErrEval(t, "sqrt(x)", map[string]float64{"x": -4}, "0: sqrt of negative number")
+	mustErrEval(t, "1e308*10", nil, "0: result is not finite")
+	mustErrEval(t, "-1e308*10", nil, "0: result is not finite")
+	mustErrEval(t, "2^1024", nil, "0: result is not finite")
+	mustErrEval(t, "1e308*1e308*0", nil, "0: result is not finite")
+	// Non-finite intermediates that become finite are fine.
+	checkEval(t, "1e308*0*1e308", nil, 0)
+}
+
+func TestProgramReuse(t *testing.T) {
+	p, err := Compile("x+1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := p.Eval(map[string]float64{"x": 1})
+	if err != nil || v != 2 {
+		t.Fatalf("Eval x=1: %v, %v", v, err)
+	}
+	v, err = p.Eval(map[string]float64{"x": 2})
+	if err != nil || v != 3 {
+		t.Fatalf("Eval x=2: %v, %v", v, err)
+	}
+	_, err = p.Eval(nil)
+	mustError(t, err, `0: unknown variable "x"`)
+	if got := p.Vars(); len(got) != 1 || got[0] != "x" {
+		t.Errorf("Vars() = %v", got)
+	}
+}
