+package expr
+
+import (
+	"math"
+	"testing"
+)
+
+func mustEval(t *testing.T, src string, vars map[string]float64) float64 {
+	t.Helper()
+	v, err := Eval(src, vars)
+	if err != nil {
+		t.Fatalf("Eval(%q, %v): unexpected error: %v", src, vars, err)
+	}
+	return v
+}
+
+func checkEval(t *testing.T, src string, vars map[string]float64, want float64) {
+	t.Helper()
+	got := mustEval(t, src, vars)
+	if got != want {
+		t.Errorf("Eval(%q) = %v, want %v", src, got, want)
+	}
+}
+
+func mustError(t *testing.T, err error, want string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected error %q, got nil", want)
+	}
+	e, ok := err.(*Error)
+	if !ok {
+		t.Fatalf("error %v is not *Error (type %T)", err, err)
+	}
+	if e.Error() != want {
+		t.Fatalf("error = %q, want %q", e.Error(), want)
+	}
+}
+
+func mustErrEval(t *testing.T, src string, vars map[string]float64, want string) {
+	t.Helper()
+	_, err := Eval(src, vars)
+	mustError(t, err, want)
+}
+
+func TestNumberLiterals(t *testing.T) {
+	cases := map[string]float64{
+		"123":     123,
+		"1.5":     1.5,
+		".5":      0.5,
+		"1.":      1,
+		"1e3":     1000,
+		"2.5E-2":  0.025,
+		"1E+2":    100,
+		"100.":    100,
+		"3.14":    3.14,
+		"0":       0,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestArithmetic(t *testing.T) {
+	cases := map[string]float64{
+		"2+3*4":  14,
+		"2*3+4":  10,
+		"10/4":   2.5,
+		"10/10/2": 0.5,
+		"1-2-3":  -4,
+		"10-4-3": 3,
+		"7%3":    1,
+		"-7%3":   -1,
+		"10%4":   2,
+		"2.5*2":  5,
+		"1/true": 1,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestPower(t *testing.T) {
+	cases := map[string]float64{
+		"2^3":     8,
+		"2^3^2":   512,
+		"2^2^2":   16,
+		"-2^2":    -4,
+		"-2^2+1":  -3,
+		"2^-1":    0.5,
+		"10^-2":   0.01,
+		"2^3*2":   16,
+		"2+2^2":   6,
+		"2^2+1":   5,
+		"(2+3)^2": 25,
+		"-(2+3)^2": -25,
+		"4^0.5":   2,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestUnary(t *testing.T) {
+	cases := map[string]float64{
+		"-5":   -5,
+		"--5":  5,
+		"++5":  5,
+		"+-3":  -3,
+		"!true": 0,
+		"!false": 1,
+		"!!5": 1,
+		"!3": 0,
+		"!0.5": 0,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestComparisons(t *testing.T) {
+	cases := map[string]float64{
+		"1<2":  1,
+		"2<2":  0,
+		"2<=2": 1,
+		"3>2":  1,
+		"3>=2": 1,
+		"3>=3": 1,
+		"3==3": 1,
+		"3!=3": 0,
+		"1.0==1": 1,
+		"1+1==2": 1,
+		"1==1+1": 0,
+		"2*3>4":  1,
+		"2>1&&1<3": 1,
+		"2<1&&1<3": 0,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestLogical(t *testing.T) {
+	cases := map[string]float64{
+		"1&&1":  1,
+		"0&&1":  0,
+		"1&&0":  0,
+		"2&&3":  1,
+		"2||3":  1,
+		"0||1":  1,
+		"0||0":  0,
+		"1||0":  1,
+		"0.5||0": 1,
+		"0.5&&2": 1,
+		"true && true":  1,
+		"true || false": 1,
+		"false || false": 0,
+	}
+	for src, want := range cases {
+		checkEval(t, src, nil, want)
+	}
+}
+
+func TestShortCircuit(t *testing.T) {
+	if v := mustEval(t, "x && x/0", map[string]float64{"x": 0}); v != 0 {
+		t.Errorf("x && x/0 with x=0 = %v, want 0", v)
+	}
+	if v := mustEval(t, "0 && 1/0", nil); v != 0 {
+		t.Errorf("0 && 1/0 = %v, want 0", v)
+	}
+	if v := mustEval(t, "true || 1/0", nil); v != 1 {
+		t.Errorf("true || 1/0 = %v, want 1", v)
+	}
+	if v := mustEval(t, "false || x", map[string]float64{"x": 2}); v != 1 {
+		t.Errorf("false || 2 = %v, want 1", v)
+	}
+	if v := mustEval(t, "0 ? 1/0 : 5", nil); v != 5 {
+		t.Errorf("0 ? 1/0 : 5 = %v, want 5", v)
+	}
+	if v := mustEval(t, "1 ? 5 : 1/0", nil); v != 5 {
+		t.Errorf("1 ? 5 : 1/0 = %v, want 5", v)
+	}
+	// The evaluated sides still produce runtime errors.
+	mustErrEval(t, "1 && 1/0", nil, "6: division by zero")
+	mustErrEval(t, "0 || 1/0", nil, "6: division by zero")
+	mustErrEval(t, "1 ? 1/0 : 5", nil, "5: division by zero")
+	mustErrEval(t, "0 ? 1/0 : 1/0", nil, "11: division by zero")
+	mustErrEval(t, "1 && 1/y", nil, `7: unknown variable "y"`)
+}
+
+func TestTernary(t *testing.T) {
+	checkEval(t, "1 ? 2 : 3", nil, 2)
+	checkEval(t, "0 ? 2 : 3", nil, 3)
+	checkEval(t, "1 ? 2 : 3 ? 4 : 5", nil, 2)
+	checkEval(t, "0 ? 2 : 3 ? 4 : 5", nil, 4)
+	checkEval(t, "0 ? 1 : 0 ? 2 : 3", nil, 3)
+	checkEval(t, "1 ? 1 : 0 ? 2 : 3", nil, 1)
+	checkEval(t, "x ? x*2 : 0", map[string]float64{"x": 3}, 6)
+	checkEval(t, "1==1 ? true : false", nil, 1)
+	checkEval(t, "1 ? a+1 : 0", map[string]float64{"a": 41}, 42)
+}
+
+func TestFunctions(t *testing.T) {
+	checkEval(t, "abs(-3)", nil, 3)
+	checkEval(t, "abs(3)", nil, 3)
+	checkEval(t, "abs(0)", nil, 0)
+	checkEval(t, "sqrt(9)", nil, 3)
+	checkEval(t, "sqrt(0)", nil, 0)
+	if got := mustEval(t, "sqrt(2)", nil); math.Abs(got-math.Sqrt(2)) > 1e-15 {
+		t.Errorf("sqrt(2) = %v", got)
+	}
+	checkEval(t, "min(1,2,3)", nil, 1)
+	checkEval(t, "min(5)", nil, 5)
+	checkEval(t, "min(3,2,1)", nil, 1)
+	checkEval(t, "max(1,2,3)", nil, 3)
+	checkEval(t, "max(9)", nil, 9)
+	checkEval(t, "max(1,9,2)", nil, 9)
+	checkEval(t, "round(2.4)", nil, 2)
+	checkEval(t, "round(2.5)", nil, 3)
+	checkEval(t, "round(-2.5)", nil, -3)
+	checkEval(t, "round(-2.4)", nil, -2)
+	checkEval(t, "clamp(5,0,3)", nil, 3)
+	checkEval(t, "clamp(-1,0,3)", nil, 0)
+	checkEval(t, "clamp(1.5,0,3)", nil, 1.5)
+	checkEval(t, "clamp(x,0,3)", map[string]float64{"x": 2}, 2)
+	checkEval(t, "min(abs(-5), max(1,2))", nil, 2)
+	// A bare function name is a variable reference.
+	checkEval(t, "abs", map[string]float64{"abs": 4}, 4)
+	checkEval(t, "sqrt", map[string]float64{"sqrt": 2.5}, 2.5)
+}
+
+func TestVars(t *testing.T) {
+	cases := []struct {
+		src  string
+		want []string
+	}{
+		{"b+a+b", []string{"a", "b"}},
+		{"1+2", []string{}},
+		{"abs(x)+x", []string{"x"}},
+		{"a ? b : c", []string{"a", "b", "c"}},
+		{"x && y || x", []string{"x", "y"}},
+		{"sqrt(x)+y", []string{"x", "y"}}, // function names are not variables
+		{"min(x, y, x)", []string{"x", "y"}},
+		{"abs", []string{"abs"}}, // bare function name is a variable
+	}
+	for _, tc := range cases {
+		p, err := Compile(tc.src)
+		if err != nil {
+			t.Fatalf("Compile(%q): %v", tc.src, err)
+		}
+		got := p.Vars()
+		if len(got) != len(tc.want) {
+			t.Errorf("Vars(%q) = %v, want %v", tc.src, got, tc.want)
+			continue
+		}
+		for i := range got {
+			if got[i] != tc.want[i] {
+				t.Errorf("Vars(%q) = %v, want %v", tc.src, got, tc.want)
+			}
+		}
+	}
+}
+
