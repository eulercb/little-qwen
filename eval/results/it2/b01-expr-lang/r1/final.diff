+package expr
+
+import "fmt"
+
+// Error describes a lexical, syntax or runtime error.
+type Error struct {
+	Pos int    // 0-based byte offset in the source where the problem is
+	Msg string
+}
+
+func (e *Error) Error() string { return fmt.Sprintf("%d: %s", e.Pos, e.Msg) }
diff --git a/expr/eval.go b/expr/eval.go
new file mode 100644
index 0000000..1c0ece6
--- /dev/null
+++ b/expr/eval.go
@@ -0,0 +1,259 @@
+package expr
+
+import (
+	"fmt"
+	"math"
+	"sort"
+)
+
+// Program is a compiled expression.
+type Program struct {
+	root node
+}
+
+// Compile parses src once. Syntax problems are returned as *Error.
+func Compile(src string) (*Program, error) {
+	toks, err := lex(src)
+	if err != nil {
+		return nil, err
+	}
+	p := &parser{toks: toks, srcLen: len(src)}
+	root, err := p.parse()
+	if err != nil {
+		return nil, err
+	}
+	return &Program{root: root}, nil
+}
+
+// Eval evaluates the program with the given variable values.
+func (p *Program) Eval(vars map[string]float64) (float64, error) {
+	v, err := p.root.eval(vars)
+	if err != nil {
+		return 0, err
+	}
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return 0, &Error{Pos: 0, Msg: "result is not finite"}
+	}
+	return v, nil
+}
+
+// Vars returns the sorted, de-duplicated variable names referenced by the program.
+func (p *Program) Vars() []string {
+	set := make(map[string]bool)
+	var walk func(n node)
+	walk = func(n node) {
+		switch v := n.(type) {
+		case *varNode:
+			set[v.name] = true
+		case *binNode:
+			walk(v.l)
+			walk(v.r)
+		case *unNode:
+			walk(v.x)
+		case *ternaryNode:
+			walk(v.cond)
+			walk(v.a)
+			walk(v.b)
+		case *callNode:
+			for _, a := range v.args {
+				walk(a)
+			}
+		}
+	}
+	walk(p.root)
+	names := make([]string, 0, len(set))
+	for name := range set {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// Eval compiles and evaluates src in one step.
+func Eval(src string, vars map[string]float64) (float64, error) {
+	p, err := Compile(src)
+	if err != nil {
+		return 0, err
+	}
+	return p.Eval(vars)
+}
+
+func truthy(v float64) bool { return v != 0 }
+
+func (n *numNode) eval(vars map[string]float64) (float64, error) {
+	return n.val, nil
+}
+
+func (n *varNode) eval(vars map[string]float64) (float64, error) {
+	v, ok := vars[n.name]
+	if !ok {
+		return 0, &Error{Pos: n.pos, Msg: fmt.Sprintf("unknown variable %q", n.name)}
+	}
+	return v, nil
+}
+
+func (n *unNode) eval(vars map[string]float64) (float64, error) {
+	x, err := n.x.eval(vars)
+	if err != nil {
+		return 0, err
+	}
+	switch n.op {
+	case "-":
+		return -x, nil
+	case "+":
+		return x, nil
+	case "!":
+		if x == 0 {
+			return 1, nil
+		}
+		return 0, nil
+	}
+	return 0, fmt.Errorf("internal error: unknown unary operator %q", n.op)
+}
+
+func (n *ternaryNode) eval(vars map[string]float64) (float64, error) {
+	c, err := n.cond.eval(vars)
+	if err != nil {
+		return 0, err
+	}
+	if c == 0 {
+		return n.b.eval(vars)
+	}
+	return n.a.eval(vars)
+}
+
+func (n *callNode) eval(vars map[string]float64) (float64, error) {
+	vals := make([]float64, len(n.args))
+	for i, a := range n.args {
+		v, err := a.eval(vars)
+		if err != nil {
+			return 0, err
+		}
+		vals[i] = v
+	}
+	switch n.name {
+	case "abs":
+		return math.Abs(vals[0]), nil
+	case "sqrt":
+		if vals[0] < 0 {
+			return 0, &Error{Pos: n.pos, Msg: "sqrt of negative number"}
+		}
+		return math.Sqrt(vals[0]), nil
+	case "min":
+		m := vals[0]
+		for _, v := range vals[1:] {
+			if v < m {
+				m = v
+			}
+		}
+		return m, nil
+	case "max":
+		m := vals[0]
+		for _, v := range vals[1:] {
+			if v > m {
+				m = v
+			}
+		}
+		return m, nil
+	case "round":
+		return math.Round(vals[0]), nil
+	case "clamp":
+		x, lo, hi := vals[0], vals[1], vals[2]
+		if x < lo {
+			x = lo
+		}
+		if x > hi {
+			x = hi
+		}
+		return x, nil
+	}
+	return 0, fmt.Errorf("internal error: unknown function %q", n.name)
+}
+
+func (n *binNode) eval(vars map[string]float64) (float64, error) {
+	l, err := n.l.eval(vars)
+	if err != nil {
+		return 0, err
+	}
+	switch n.op {
+	case "&&":
+		if l == 0 {
+			return 0, nil
+		}
+		r, err := n.r.eval(vars)
+		if err != nil {
+			return 0, err
+		}
+		if r == 0 {
+			return 0, nil
+		}
+		return 1, nil
+	case "||":
+		if truthy(l) {
+			return 1, nil
+		}
+		r, err := n.r.eval(vars)
+		if err != nil {
+			return 0, err
+		}
+		if r == 0 {
+			return 0, nil
+		}
+		return 1, nil
+	}
+	r, err := n.r.eval(vars)
+	if err != nil {
+		return 0, err
+	}
+	switch n.op {
+	case "+":
+		return l + r, nil
+	case "-":
+		return l - r, nil
+	case "*":
+		return l * r, nil
+	case "/":
+		if r == 0 {
+			return 0, &Error{Pos: n.pos, Msg: "division by zero"}
+		}
+		return l / r, nil
+	case "%":
+		if r == 0 {
+			return 0, &Error{Pos: n.pos, Msg: "division by zero"}
+		}
+		return math.Mod(l, r), nil
+	case "^":
+		return math.Pow(l, r), nil
+	case "==":
+		if l == r {
+			return 1, nil
+		}
+		return 0, nil
+	case "!=":
+		if l != r {
+			return 1, nil
+		}
+		return 0, nil
+	case "<":
+		if l < r {
+			return 1, nil
+		}
+		return 0, nil
+	case "<=":
+		if l <= r {
+			return 1, nil
+		}
+		return 0, nil
+	case ">":
+		if l > r {
+			return 1, nil
+		}
+		return 0, nil
+	case ">=":
+		if l >= r {
+			return 1, nil
+		}
+		return 0, nil
+	}
+	return 0, fmt.Errorf("internal error: unknown operator %q", n.op)
+}
