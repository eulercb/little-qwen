+	}
+	counts := map[string]int{}
+	for _, t := range s.All() {
+		if t.Done {
+			continue
+		}
+		for _, g := range t.Tags {
+			counts[g]++
+		}
+	}
+	tags := make([]string, 0, len(counts))
+	for tag := range counts {
+		tags = append(tags, tag)
+	}
