+package cli
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAddTagsDue(t *testing.T) {
+	h := newHarness(t)
+	out, errb, code := h.run("add", "--tag", "B", "--tag=a", "--due", "2026-04-15", "file", "taxes")
+	if code != 0 || out != "added #1\n" {
+		t.Fatalf("%q %q %d", out, errb, code)
+	}
+	out, _, _ = h.run("list")
+	if out != "#1 [ ] P3 file taxes (due 2026-04-15) [a,b]\n" {
+		t.Fatalf("list: %q", out)
+	}
+	// Invalid tag and date are usage errors.
+	if _, _, code := h.run("add", "--tag", "bad tag", "x"); code != 2 {
+		t.Fatalf("bad tag: %d", code)
+	}
+	if _, _, code := h.run("add", "--due", "15/04/2026", "x"); code != 2 {
+		t.Fatalf("bad date: %d", code)
+	}
+}
+
+func TestFormatTask(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--due", "2026-04-15", "plain") // due, no tags
+	out, _, _ := h.run("list")
+	if out != "#1 [ ] P3 plain (due 2026-04-15)\n" {
+		t.Fatalf("list: %q", out)
+	}
+}
+
+func TestListOverdueAndSortDue(t *testing.T) {
+	h := newHarness(t)                                             // now = 2026-03-10 12:00 UTC
+	h.run("add", "--tag", "home", "--due", "2026-03-09", "old")    // #1 open, overdue
+	h.run("add", "--tag", "home", "--due", "2026-03-08", "gone")   // #2 done, overdue
+	h.run("add", "--due", "2026-03-10", "today")                   // #3 open, due today
+	h.run("add", "--tag", "money", "--due", "2026-03-12", "later") // #4 open
+	h.run("add", "nodate")                                         // #5 open, no due
+	h.run("done", "2")
+
+	out, _, _ := h.run("list", "--overdue")
+	if out != "#1 [ ] P3 old (due 2026-03-09) [home]\n" {
+		t.Fatalf("overdue: %q", out)
+	}
+	out, _, _ = h.run("list", "--all", "--sort", "due")
+	want := "#2 [x] P3 gone (due 2026-03-08) [home]\n" +
+		"#1 [ ] P3 old (due 2026-03-09) [home]\n" +
+		"#3 [ ] P3 today (due 2026-03-10)\n" +
+		"#4 [ ] P3 later (due 2026-03-12) [money]\n" +
+		"#5 [ ] P3 nodate\n"
+	if out != want {
+		t.Fatalf("sort due:\n%q", out)
+	}
+	// --tag and --overdue combine.
+	out, _, _ = h.run("list", "--tag", "home", "--overdue")
+	if out != "#1 [ ] P3 old (due 2026-03-09) [home]\n" {
+		t.Fatalf("tag+overdue: %q", out)
+	}
+	if _, _, code := h.run("list", "--sort", "nope"); code != 2 {
+		t.Fatalf("bad sort: %d", code)
+	}
+}
+
+func TestEditTagsDue(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "home", "--tag", "money", "--due", "2026-04-15", "file", "taxes")
+	out, _, code := h.run("edit", "1", "--untag", "home", "--due", "none")
+	if code != 0 || out != "updated #1\n" {
+		t.Fatalf("%q %d", out, code)
+	}
+	out, _, _ = h.run("list")
+	if out != "#1 [ ] P3 file taxes [money]\n" {
+		t.Fatalf("list: %q", out)
+	}
+	// Untagging a tag that is not present is fine.
+	if _, _, code := h.run("edit", "1", "--untag", "home"); code != 0 {
+		t.Fatalf("untag missing: %d", code)
+	}
+	out, _, _ = h.run("edit", "1", "--tag", "Work", "--due", "2026-05-01")
+	if out != "updated #1\n" {
+		t.Fatalf("%q", out)
+	}
+	out, _, _ = h.run("list")
+	if out != "#1 [ ] P3 file taxes (due 2026-05-01) [money,work]\n" {
+		t.Fatalf("list: %q", out)
+	}
+	if _, _, code := h.run("edit", "1", "--due", "soon"); code != 2 {
+		t.Fatalf("bad due: %d", code)
+	}
+}
+
+func TestTagsCommand(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "Home", "--tag", "home", "--tag", "money", "a") // #1: home, money
+	h.run("add", "--tag", "home", "b")                                    // #2: home
+	h.run("add", "--tag", "zeta", "--tag", "alpha", "c")                  // #3: alpha, zeta
+	h.run("done", "2")
+	out, _, code := h.run("tags")
+	if code != 0 {
+		t.Fatalf("code %d", code)
+	}
+	want := "alpha 1\nhome 1\nmoney 1\nzeta 1\n"
+	if out != want {
+		t.Fatalf("tags: %q", out)
+	}
+}
+
+func TestUsage(t *testing.T) {
+	h := newHarness(t)
+	_, errb, code := h.run()
+	if code != 2 || !strings.Contains(errb, "tags") {
+		t.Fatalf("missing command: %q %d", errb, code)
+	}
+}
