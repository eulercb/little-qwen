+	s.Add(model.Task{Title: "plain", Priority: 3})
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	s2, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := s2.All()
