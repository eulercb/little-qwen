+func TestConcurrent(t *testing.T) {
+	s, _ := newTestStore()
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			k := string(rune('a' + i))
+			for j := 0; j < 100; j++ {
+				s.Set(k, "v", 0)
+				s.Get(k)
+				s.Incr(k, 1)
+				s.Keys("*")
+				s.Len()
+			}
+		}(i)
+	}
+	wg.Wait()
+}
