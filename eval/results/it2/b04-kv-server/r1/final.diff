index 0000000..c641358
--- /dev/null
+++ b/proto/proto.go
@@ -0,0 +1,260 @@
+// Package proto implements the line protocol on top of a store.Store.
+package proto
+
+import (
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// Exec parses one request line and returns the full response,
+// including the trailing '\n'.
+func Exec(s *store.Store, line string) string {
+	toks, err := tokenize(line)
+	if err != nil {
+		return "-ERR syntax error\n"
+	}
+	if len(toks) == 0 {
+		return "-ERR empty command\n"
+	}
+	cmd := strings.ToLower(toks[0])
+	args := toks[1:]
+	switch cmd {
+	case "ping":
+		if len(args) != 0 {
+			return wrongArgs(cmd)
+		}
+		return "+PONG\n"
+	case "quit":
+		if len(args) != 0 {
+			return wrongArgs(cmd)
+		}
+		return "+BYE\n"
+	case "set":
+		return doSet(s, args)
+	case "get":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		if v, ok := s.Get(args[0]); ok {
+			return "$" + encodeValue(v) + "\n"
+		}
+		return "$nil\n"
+	case "del":
+		if len(args) < 1 {
+			return wrongArgs(cmd)
+		}
+		return ":" + strconv.Itoa(s.Del(args...)) + "\n"
+	case "exists":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		return intResp(s.Exists(args[0]))
+	case "expire":
+		if len(args) != 2 {
+			return wrongArgs(cmd)
+		}
+		secs, err := strconv.ParseInt(args[1], 10, 64)
+		if err != nil {
+			return notInt()
+		}
+		return intResp(s.Expire(args[0], time.Duration(secs)*time.Second))
+	case "persist":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		return intResp(s.Persist(args[0]))
+	case "ttl":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		return ":" + strconv.FormatInt(ttlSeconds(s.TTL(args[0])), 10) + "\n"
+	case "incr":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		return doIncr(s, args[0], 1)
+	case "incrby":
+		if len(args) != 2 {
+			return wrongArgs(cmd)
+		}
+		n, err := strconv.ParseInt(args[1], 10, 64)
+		if err != nil {
+			return notInt()
+		}
+		return doIncr(s, args[0], n)
+	case "keys":
+		if len(args) != 1 {
+			return wrongArgs(cmd)
+		}
+		keys := s.Keys(args[0])
+		var b strings.Builder
+		b.WriteByte('*')
+		b.WriteString(strconv.Itoa(len(keys)))
+		b.WriteByte('\n')
+		for _, k := range keys {
+			b.WriteByte('$')
+			b.WriteString(encodeValue(k))
+			b.WriteByte('\n')
+		}
+		return b.String()
+	case "dbsize":
+		if len(args) != 0 {
+			return wrongArgs(cmd)
+		}
+		return ":" + strconv.Itoa(s.Len()) + "\n"
+	}
+	return "-ERR unknown command '" + toks[0] + "'\n"
+}
+
+func doSet(s *store.Store, args []string) string {
+	switch len(args) {
+	case 2:
+		s.Set(args[0], args[1], 0)
+		return "+OK\n"
+	case 4:
+		if !strings.EqualFold(args[2], "ex") {
+			return "-ERR syntax error\n"
+		}
+		n, err := strconv.ParseInt(args[3], 10, 64)
+		if err != nil || n <= 0 {
+			if err != nil {
+				return notInt()
+			}
+			return "-ERR syntax error\n"
+		}
+		s.Set(args[0], args[1], time.Duration(n)*time.Second)
+		return "+OK\n"
+	}
+	return wrongArgs("set")
+}
+
+func doIncr(s *store.Store, key string, by int64) string {
+	v, err := s.Incr(key, by)
+	if err != nil {
+		return notInt()
+	}
+	return ":" + strconv.FormatInt(v, 10) + "\n"
+}
+
+func wrongArgs(cmd string) string {
+	return "-ERR wrong number of arguments for '" + cmd + "'\n"
+}
+
+func notInt() string {
+	return "-ERR value is not an integer\n"
+}
+
+func intResp(b bool) string {
+	if b {
+		return ":1\n"
+	}
+	return ":0\n"
+}
+
+// ttlSeconds converts a store.TTL result to seconds: -2 missing, -1 no
+// expiry, otherwise the remaining time rounded UP to whole seconds.
+func ttlSeconds(d time.Duration) int64 {
+	switch {
+	case d == -2:
+		return -2
+	case d == -1:
+		return -1
+	}
+	return int64((d + time.Second - 1) / time.Second)
+}
+
+// tokenize splits a request line into tokens separated by spaces/tabs.
+// A token may be double-quoted; inside quotes \" \\ and \n are escapes.
+// An unterminated quote is a syntax error.
+func tokenize(line string) ([]string, error) {
+	var toks []string
+	i, n := 0, len(line)
+	for i < n {
+		c := line[i]
+		if c == ' ' || c == '\t' {
+			i++
+			continue
+		}
+		if c == '"' {
+			var b strings.Builder
+			i++
+			terminated := false
+			for i < n {
+				c := line[i]
+				if c == '\\' && i+1 < n {
+					switch esc := line[i+1]; esc {
+					case 'n':
+						b.WriteByte('\n')
+					case '"', '\\':
+						b.WriteByte(esc)
+					default:
+						b.WriteByte('\\')
+						b.WriteByte(esc)
+					}
+					i += 2
+					continue
+				}
+				if c == '"' {
+					i++
+					terminated = true
+					break
+				}
+				b.WriteByte(c)
+				i++
+			}
+			if !terminated {
+				return nil, errSyntax
+			}
+			toks = append(toks, b.String())
+			continue
+		}
+		start := i
+		for i < n && line[i] != ' ' && line[i] != '\t' {
+			i++
+		}
+		toks = append(toks, line[start:i])
+	}
+	return toks, nil
+}
+
+var errSyntax = newSyntaxErr()
+
+type syntaxErr struct{}
+
+func (syntaxErr) Error() string { return "syntax error" }
+
+func newSyntaxErr() error { return syntaxErr{} }
+
+// encodeValue quotes a value when it is empty or contains a space, tab,
+// '"', '\\' or newline, escaping those characters.
+func encodeValue(v string) string {
+	needsQuote := v == ""
+	for _, c := range v {
+		if c == ' ' || c == '\t' || c == '"' || c == '\\' || c == '\n' {
+			needsQuote = true
+			break
+		}
+	}
+	if !needsQuote {
+		return v
+	}
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, c := range v {
+		switch c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		default:
+			b.WriteRune(c)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
