+func TestSaveLoad(t *testing.T) {
+	s, _ := newTestStore()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", time.Hour)
+	s.Set("c", "3", time.Second)
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatal(err)
+	}
+	want := `{"version":1,"entries":[{"k":"a","v":"1","exp":0},{"k":"b","v":"2","exp":` +
+		strconv.FormatInt(t0.Add(time.Hour).UnixMilli(), 10) + `},{"k":"c","v":"3","exp":` +
+		strconv.FormatInt(t0.Add(time.Second).UnixMilli(), 10) + `}]}`
+	if strings.TrimSuffix(buf.String(), "\n") != want {
+		t.Fatalf("snapshot:\n got %s\nwant %s", buf.String(), want)
+	}
+
+	// load into a store whose clock is 2s later: c is expired at load time
+	ns2 := int64(t0.Add(2 * time.Second).UnixNano())
+	s2 := New(func() time.Time { return time.Unix(0, 0).Add(time.Duration(ns2)) })
+	if err := s2.Load(strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	if got := s2.Len(); got != 2 {
+		t.Fatalf("Len after load: %d", got)
+	}
+	if v, ok := s2.Get("c"); ok || v != "" {
+		t.Fatalf("expired entry must be dropped: %q %v", v, ok)
+	}
+	if v, ok := s2.Get("b"); !ok || v != "2" {
+		t.Fatalf("b after load: %q %v", v, ok)
+	}
+	// b still has its (future) expiry
+	if got := s2.TTL("b"); got != time.Hour-2*time.Second {
+		t.Fatalf("b ttl after load: %v", got)
+	}
+	// Load replaces all contents
+	s2.Set("zz", "z", 0)
+	if err := s2.Load(strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	if s2.Exists("zz") {
+		t.Fatal("Load must replace all contents")
+	}
+}
