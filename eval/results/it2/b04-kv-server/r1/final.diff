+func TestLoadRejectsVersion(t *testing.T) {
+	s, _ := newTestStore()
+	err := s.Load(strings.NewReader(`{"version":2,"entries":[]}`))
+	if err == nil {
+		t.Fatal("want error for version 2")
+	}
