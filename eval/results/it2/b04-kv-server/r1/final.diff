+func TestGlob(t *testing.T) {
+	cases := []struct {
+		pattern, s string
+		want       bool
+	}{
+		{"*", "", true},
+		{"*", "anything/at/all", true},
+		{"a*", "a", true},
+		{"a*", "abc", true},
+		{"a*", "b", false},
+		{"*a", "ba", true},
+		{"a*a", "a", false},
+		{"a*a", "aa", true},
+		{"a*a", "abca", true},
+		{"a*a", "ab", false},
+		{"?", "a", true},
+		{"?", "ab", false},
+		{"?", "", false},
+		{"??", "ab", true},
+		{"??", "a", false},
+		{"[abc]", "b", true},
+		{"[abc]", "d", false},
+		{"[a-z]", "m", true},
+		{"[a-z]", "M", false},
+		{"[a-z]", "1", false},
+		{"[^abc]", "d", true},
+		{"[^abc]", "b", false},
+		{"[!abc]", "d", true},
+		{"[!abc]", "a", false},
+		{`a\b`, `a\b`, false},
+		{`a\b`, `ab`, true},
+		{`\*`, "*", true},
+		{`\*`, "x", false},
+		{`a\*b`, "a*b", true},
+		{"[a-cx-z]", "y", true},
+		{"[a-cx-z]", "g", false},
+	}
+	for _, c := range cases {
+		if got := globMatch(c.pattern, c.s); got != c.want {
+			t.Errorf("globMatch(%q, %q) = %v, want %v", c.pattern, c.s, got, c.want)
+		}
+	}
+}
