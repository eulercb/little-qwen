+// Package cron implements a cron-expression library.
+//
+// Syntax: five space-separated fields: minute hour day-of-month month day-of-week
+//   minute 0-59, hour 0-23, day-of-month 1-31, month 1-12 (or JAN-DEC), day-of-week 0-6 (or SUN-SAT; 7 is also Sunday)
+// Each field is a comma-separated list of items. An item is:
+//   *            every value
+//   N            a single value
+//   N-M          an inclusive range (N <= M required)
+//   */S  N-M/S   a step over the full range or over a range (S >= 1)
+//   N/S          from N to the field maximum with step S
+// Names (JAN..DEC, SUN..SAT) are case-insensitive and may be used wherever a number may.
+// Macros: @yearly (= "0 0 1 1 *"), @monthly ("0 0 1 * *"), @weekly ("0 0 * * 0"), @daily ("0 0 * * *"), @hourly ("0 * * * *").
+// Day matching follows Vixie cron: if both day-of-month and day-of-week are restricted (neither field is "*"),
+// a day matches when EITHER matches; otherwise both must match.
+package cron
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// CronError is returned for invalid expressions and unsatisfiable schedules.
+type CronError struct{ msg string }
+
+func (e *CronError) Error() string { return e.msg }
+
+func errf(format string, args ...any) error { return &CronError{msg: fmt.Sprintf(format, args...)} }
+
+var fieldSpecs = [5][3]string{
+	{"minute", "0", "59"},
+	{"hour", "0", "23"},
+	{"day-of-month", "1", "31"},
+	{"month", "1", "12"},
+	{"day-of-week", "0", "6"},
+}
+
+var months = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var days = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":    "0 0 1 1 *",
+	"@annually":  "0 0 1 1 *",
+	"@monthly":   "0 0 1 * *",
+	"@weekly":    "0 0 * * 0",
+	"@daily":     "0 0 * * *",
+	"@midnight":  "0 0 * * *",
+	"@hourly":    "0 * * * *",
+}
+
+// Schedule is a parsed cron expression. Each field bitmap is indexed by
+// (value - field minimum), matching parseField's output.
+type Schedule struct {
+	expr     string
+	minute   [60]bool
+	hour     [24]bool
+	dayOfMonth [31]bool
+	month    [12]bool
+	dayOfWeek  [7]bool
+	domStar  bool
+	dowStar  bool
+}
+
+// repr renders s with Python's repr() quoting rules (single quotes, backslash
+// escaping). It matches CPython output for all printable ASCII strings, which
+// covers every token reachable through whitespace splitting.
+func repr(s string) string {
+	var b strings.Builder
+	b.WriteByte('\'')
+	for _, r := range s {
+		switch {
+		case r == '\'':
+			b.WriteString(`\'`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case !unicode.IsPrint(r):
+			b.WriteString(strconv.QuoteRune(r))
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('\'')
+	return b.String()
+}
+
+// isDigits reports whether s is non-empty and consists only of decimal
+// digits, mirroring Python's str.isdigit() for digit strings.
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// parseDigits converts a string of ASCII digits to its integer value.
+func parseDigits(s string) int {
+	v := 0
+	for _, r := range s {
+		v = v*10 + int(r-'0')
+	}
+	return v
+}
+
+func value(tok string, idx int) (int, error) {
+	name := fieldSpecs[idx][0]
+	t := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range months {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range days {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, errf("%s: invalid value %s", name, repr(tok))
+	}
+	v := parseDigits(tok)
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	lo, _ := strconv.Atoi(fieldSpecs[idx][1])
+	hi, _ := strconv.Atoi(fieldSpecs[idx][2])
+	if v < lo || v > hi {
+		return 0, errf("%s: value %d out of range %s-%s", name, v, fieldSpecs[idx][1], fieldSpecs[idx][2])
+	}
+	return v, nil
+}
+
+func parseField(text string, idx int) ([]bool, error) {
+	name := fieldSpecs[idx][0]
+	if text == "" {
+		return nil, errf("%s: empty field", name)
+	}
+	lo, _ := strconv.Atoi(fieldSpecs[idx][1])
+	hi, _ := strconv.Atoi(fieldSpecs[idx][2])
+	values := make([]bool, hi-lo+1)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, errf("%s: empty item", name)
+		}
+		step := 1
+		base := item
+		if i := strings.Index(item, "/"); i >= 0 {
+			stepStr := item[i+1:]
+			if !isDigits(stepStr) || parseDigits(stepStr) < 1 {
+				return nil, errf("%s: invalid step %s", name, repr(stepStr))
+			}
+			step = parseDigits(stepStr)
+			base = item[:i]
+		}
+		start, end := 0, 0
+		switch {
+		case base == "*":
+			start, end = lo, hi
+		case strings.Contains(base, "-"):
+			parts := strings.SplitN(base, "-", 2)
+			a, err := value(parts[0], idx)
+			if err != nil {
+				return nil, err
+			}
+			b, err := value(parts[1], idx)
+			if err != nil {
+				return nil, err
+			}
+			start, end = a, b
+			if start > end {
+				return nil, errf("%s: range %d-%d is reversed", name, start, end)
+			}
+		default:
+			v, err := value(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			start, end = v, v
+			if strings.Contains(item, "/") {
+				end = hi
+			}
+		}
+		for v := start; v <= end; v += step {
+			values[v-lo] = true
+		}
+	}
+	return values, nil
+}
+
+// Parse parses a cron expression.
+func Parse(expr string) (*Schedule, error) {
+	original := expr
+	e := strings.TrimSpace(expr)
+	if strings.HasPrefix(e, "@") {
+		m, ok := macros[strings.ToLower(e)]
+		if !ok {
+			return nil, errf("unknown macro %s", repr(e))
+		}
+		e = m
+	}
+	parts := strings.Fields(e)
+	if len(parts) != 5 {
+		return nil, errf("expected 5 fields, got %d", len(parts))
+	}
+	s := &Schedule{expr: strings.TrimSpace(original)}
+	fields := [][]bool{
+		make([]bool, 60), make([]bool, 24), make([]bool, 31), make([]bool, 12), make([]bool, 7),
+	}
+	for i, p := range parts {
+		v, err := parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+		fields[i] = v
+	}
+	copy(s.minute[:], fields[0])
+	copy(s.hour[:], fields[1])
+	copy(s.dayOfMonth[:], fields[2])
+	copy(s.month[:], fields[3])
+	copy(s.dayOfWeek[:], fields[4])
+	s.domStar = parts[2] == "*"
+	s.dowStar = parts[4] == "*"
+	return s, nil
+}
+
+// wallClock returns after's local wall-clock fields as a time in UTC, so that
+// duration arithmetic on it mirrors Python's naive timedelta addition.
+func wallClock(t time.Time) time.Time {
+	return time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.UTC)
+}
+
+// real instantiates a wall clock in the given location, like Python attaching
+// a tzinfo object.
+func real(w time.Time, loc *time.Location) time.Time {
+	return time.Date(w.Year(), w.Month(), w.Day(), w.Hour(), w.Minute(), w.Second(), w.Nanosecond(), loc)
+}
+
+func dayOK(s *Schedule, t time.Time) bool {
+	dow := int(t.Weekday()) // Sunday=0 .. Saturday=6, matching Python's (weekday()+1)%7
+	inDom := s.dayOfMonth[t.Day()-1]
+	inDow := s.dayOfWeek[dow]
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first run strictly after `after`, in after's location.
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	wall := wallClock(after)
+	loc := after.Location()
+	t := wall.Truncate(time.Minute).Add(time.Minute)
+	limit := wall.Add(366 * 5 * 24 * time.Hour)
+	for !real(t, loc).After(real(limit, loc)) {
+		if !s.month[int(t.Month())-1] {
+			y, m := t.Year(), int(t.Month())
+			if m == 12 {
+				y, m = y+1, 1
+			} else {
+				m++
+			}
+			t = time.Date(y, time.Month(m), 1, 0, 0, 0, 0, time.UTC)
+			continue
+		}
+		if !dayOK(s, t) {
+			t = time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, time.UTC).Add(24 * time.Hour)
+			continue
+		}
+		if !s.hour[t.Hour()] {
+			t = time.Date(t.Year(), t.Month(), t.Day(), t.Hour()+1, 0, 0, 0, time.UTC)
+			continue
+		}
+		if !s.minute[t.Minute()] {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return real(t, loc), nil
+	}
+	return time.Time{}, errf("no match within 5 years for %s", repr(s.expr))
+}
+
+func formatField(values []bool, idx int) string {
+	lo, _ := strconv.Atoi(fieldSpecs[idx][1])
+	hi, _ := strconv.Atoi(fieldSpecs[idx][2])
+	full := true
+	for v := lo; v <= hi; v++ {
+		if !values[v-lo] {
+			full = false
+			break
+		}
+	}
+	if full {
+		return "*"
+	}
+	var vs []int
+	for v := lo; v <= hi; v++ {
+		if values[v-lo] {
+			vs = append(vs, v)
+		}
+	}
+	var out []string
+	for i := 0; i < len(vs); {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, strconv.Itoa(vs[i]))
+		} else {
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		if 0 < j-i && j-i < 2 {
+			for k := i + 1; k <= j; k++ {
+				out = append(out, strconv.Itoa(vs[k]))
+			}
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+// String describes the schedule, like describe().
+func (s *Schedule) String() string {
+	return strings.Join([]string{
+		formatField(s.minute[:], 0),
+		formatField(s.hour[:], 1),
+		formatField(s.dayOfMonth[:], 2),
+		formatField(s.month[:], 3),
+		formatField(s.dayOfWeek[:], 4),
+	}, " ")
+}
+
+// IsCronError reports whether err was produced by this package.
+func IsCronError(err error) bool {
+	var ce *CronError
+	return errors.As(err, &ce)
+}
