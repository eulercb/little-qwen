+// Package md implements a small Markdown-subset to HTML converter.
+// The exact rules are specified in SPEC.md at the repository root.
+package md
+
+import (
+	"strconv"
+	"strings"
+)
+
+// ToHTML converts src to HTML following the block and inline rules of the spec.
+func ToHTML(src string) string {
+	lines := strings.Split(src, "\n")
+	for i, l := range lines {
+		lines[i] = strings.TrimSuffix(l, "\r")
+	}
+	if len(lines) > 0 && lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	return renderBlocks(lines)
+}
+
+func isBlank(s string) bool { return strings.TrimSpace(s) == "" }
+
+// ---------- blocks ----------
+
+// renderBlocks renders a list of lines as a sequence of block elements.
+// Each block element is followed by "\n".
+func renderBlocks(lines []string) string {
+	var b strings.Builder
+	i := 0
+	n := len(lines)
+	for i < n {
+		line := lines[i]
+
+		if isBlank(line) {
+			i++
+			continue
+		}
+
+		// Fenced code block.
+		if strings.HasPrefix(line, "```") {
+			info := strings.TrimSpace(line[3:])
+			var content []string
+			j := i + 1
+			closed := false
+			for j < n && strings.TrimRight(lines[j], " ") != "```" {
+				content = append(content, escapeHTML(lines[j]))
+				j++
+			}
+			if j < n {
+				closed = true
+			}
+			body := strings.Join(content, "\n")
+			if len(content) > 0 {
+				body += "\n"
+			}
+			class := ""
+			if info != "" {
+				class = ` class="language-` + info + `"`
+			}
+			b.WriteString("<pre><code" + class + ">" + body + "</code></pre>\n")
+			if closed {
+				j++ // consume the closing fence
+			}
+			i = j
+			continue
+		}
+
+		// Heading.
+		if hl, text, ok := parseHeading(line); ok {
+			b.WriteString("<h" + strconv.Itoa(hl) + ">" + renderInline(text) + "</h" + strconv.Itoa(hl) + ">\n")
+			i++
+			continue
+		}
+
+		// Horizontal rule.
+		if isHR(line) {
+			b.WriteString("<hr />\n")
+			i++
+			continue
+		}
+
+		// Blockquote.
+		if strings.HasPrefix(line, ">") {
+			var inner []string
+			j := i
+			for j < n && strings.HasPrefix(lines[j], ">") {
+				rest := lines[j][1:]
+				if strings.HasPrefix(rest, " ") {
+					rest = rest[1:]
+				}
+				inner = append(inner, rest)
+				j++
+			}
+			b.WriteString("<blockquote>\n" + renderBlocks(inner) + "</blockquote>\n")
+			i = j
+			continue
+		}
+
+		// List item at indentation 0.
+		if _, ok := listItemMarker(line); ok {
+			items, kind, next := collectList(lines, i)
+			b.WriteString(renderList(kind, items))
+			i = next
+			continue
+		}
+
+		// Paragraph.
+		var para []string
+		j := i
+		for j < n {
+			l := lines[j]
+			if isBlank(l) ||
+				strings.HasPrefix(l, "```") ||
+				isHeadingLine(l) ||
+				isHR(l) ||
+				strings.HasPrefix(l, ">") ||
+				listItemMarkerAt0(l) {
+				break
+			}
+			para = append(para, strings.TrimLeft(l, " "))
+			j++
+		}
+		b.WriteString("<p>" + renderInline(strings.Join(para, "\n")) + "</p>\n")
+		i = j
+	}
+	return b.String()
+}
+
+// parseHeading reports whether the line is a heading and returns its level
+// and cleaned text.
+func parseHeading(line string) (int, string, bool) {
+	hl := 0
+	for hl < len(line) && line[hl] == '#' {
+		hl++
+	}
+	if hl < 1 || hl > 6 {
+		return 0, "", false
+	}
+	if hl < len(line) && line[hl] == '#' {
+		return 0, "", false // more than six hashes
+	}
+	if hl == len(line) {
+		return hl, "", true // "#", "##", ... alone
+	}
+	if line[hl] != ' ' {
+		return 0, "", false // "#foo" is not a heading
+	}
+	return hl, cleanHeadingText(line[hl+1:]), true
+}
+
+func isHeadingLine(line string) bool {
+	_, _, ok := parseHeading(line)
+	return ok
+}
+
+func isHR(line string) bool {
+	if len(line) < 3 {
+		return false
+	}
+	c := line[0]
+	if c != '-' && c != '*' && c != '_' {
+		return false
+	}
+	for i := 1; i < len(line); i++ {
+		if line[i] != c {
+			return false
+		}
+	}
+	return true
+}
+
+// listItemMarker returns the marker text ("- ", "* ", "+ ", or "N. ") and
+// whether the line starts with a list-item marker at the start of the line.
+func listItemMarker(line string) (string, bool) {
+	switch {
+	case strings.HasPrefix(line, "- "),
+		strings.HasPrefix(line, "* "),
+		strings.HasPrefix(line, "+ "):
+		return line[:2], true
+	}
+	i := 0
+	for i < len(line) && line[i] >= '0' && line[i] <= '9' {
+		i++
+	}
+	if i > 0 && i+1 < len(line) && line[i] == '.' && line[i+1] == ' ' {
+		return line[:i+2], true
+	}
+	return "", false
+}
+
+func isOrderedMarker(m string) bool {
+	return len(m) > 0 && m[0] >= '0' && m[0] <= '9'
+}
+
+func listItemMarkerAt0(line string) bool {
+	_, ok := listItemMarker(line)
+	return ok
+}
+
+type listItem struct {
+	num     int
+	text    string // item text plus continuation lines joined with "\n"
+	nested  []*listItem
+	nKind   string // kind of nested list ("u"/"o"); empty when no nested list
+	hasNest bool
+}
+
+// collectList gathers consecutive list items of one kind starting at index i.
+func collectList(lines []string, i int) ([]*listItem, string, int) {
+	m0, _ := listItemMarker(lines[i])
+	kind := "u"
+	if isOrderedMarker(m0) {
+		kind = "o"
+	}
+	var items []*listItem
+	j := i
+	for j < len(lines) {
+		line := lines[j]
+		if isBlank(line) {
+			break
+		}
+		if leadingSpaces(line) != 0 {
+			break
+		}
+		m, ok := listItemMarker(line)
+		if !ok || isOrderedMarker(m) != (kind == "o") {
+			break
+		}
+		item := &listItem{num: parseNum(m), text: line[len(m):]}
+		items = append(items, item)
+		j++
+		// Continuation lines: indented by 2 or more spaces.
+		for j < len(lines) {
+			l := lines[j]
+			if isBlank(l) {
+				break
+			}
+			sp := leadingSpaces(l)
+			if sp < 2 {
+				break
+			}
+			trimmed := strings.TrimLeft(l, " ")
+			if nm, ok := listItemMarker(trimmed); ok && sp <= 4 {
+				sub := &listItem{num: parseNum(nm), text: trimmed[len(nm):]}
+				nk := "u"
+				if isOrderedMarker(nm) {
+					nk = "o"
+				}
+				item.nested = append(item.nested, sub)
+				item.hasNest = true
+				if item.nKind == "" {
+					item.nKind = nk
+				}
+				j++
+				// Continuations of the nested item: indented, not a new item.
+				for j < len(lines) {
+					l2 := lines[j]
+					if isBlank(l2) {
+						break
+					}
+					if leadingSpaces(l2) < 2 {
+						break
+					}
+					t2 := strings.TrimLeft(l2, " ")
+					if _, ok := listItemMarker(t2); ok {
+						break
+					}
+					sub.text += "\n" + t2
+					j++
+				}
+			} else {
+				item.text += "\n" + trimmed
+				j++
+			}
+		}
+	}
+	return items, kind, j
+}
+
+func leadingSpaces(s string) int {
+	n := 0
+	for n < len(s) && s[n] == ' ' {
+		n++
+	}
+	return n
+}
+
+func parseNum(marker string) int {
+	s := strings.TrimSuffix(strings.TrimRight(marker, " "), ".")
+	n := 0
+	for i := 0; i < len(s); i++ {
+		n = n*10 + int(s[i]-'0')
+	}
+	return n
+}
+
+func renderList(kind string, items []*listItem) string {
+	var b strings.Builder
+	closeTag := ""
+	if kind == "o" {
+		if items[0].num != 1 {
+			b.WriteString(`<ol start="` + strconv.Itoa(items[0].num) + `">`)
+		} else {
+			b.WriteString("<ol>")
+		}
+	} else {
+		b.WriteString("<ul>")
+	}
+	if kind == "o" {
+		closeTag = "</ol>"
+	} else {
+		closeTag = "</ul>"
+	}
+	for _, it := range items {
+		b.WriteString("\n<li>" + renderInline(it.text))
+		if it.hasNest {
+			b.WriteString("\n")
+			b.WriteString(renderList(it.nKind, it.nested))
+		}
+		b.WriteString("</li>")
+	}
+	b.WriteString("\n" + closeTag + "\n")
+	return b.String()
+}
+
+// cleanHeadingText removes trailing spaces and a trailing run of '#' preceded
+// by a space (repeatedly).
+func cleanHeadingText(s string) string {
+	for {
+		s = strings.TrimRight(s, " ")
+		if strings.HasSuffix(s, "#") {
+			idx := len(s) - 1
+			for idx > 0 && s[idx-1] == '#' {
+				idx--
+			}
+			if idx == 0 || s[idx-1] == ' ' {
+				s = s[:idx]
+				continue
+			}
+		}
+		return s
+	}
+}
