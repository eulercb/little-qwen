@@ -0,0 +1,186 @@
+package md
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func check(t *testing.T, in, want string) {
+	t.Helper()
+	got := ToHTML(in)
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ToHTML(%q) =\n%q\nwant\n%q", in, got, want)
+	}
+}
+
+func TestSpecExample(t *testing.T) {
+	in := "# Title #\n\nSome *emphasis* and **strong** text\nwith `code` and a [link](http://x.io \"T\").\n\n- one\n- two\n  - nested\n3. three\n"
+	want := "<h1>Title</h1>\n" +
+		"<p>Some <em>emphasis</em> and <strong>strong</strong> text\nwith <code>code</code> and a <a href=\"http://x.io\" title=\"T\">link</a>.</p>\n" +
+		"<ul>\n<li>one</li>\n<li>two\n<ul>\n<li>nested</li>\n</ul>\n</li>\n</ul>\n" +
+		`<ol start="3">` + "\n<li>three</li>\n</ol>\n"
+	check(t, in, want)
+}
+
+func TestHeadings(t *testing.T) {
+	check(t, "# T", "<h1>T</h1>\n")
+	check(t, "## T", "<h2>T</h2>\n")
+	check(t, "### T", "<h3>T</h3>\n")
+	check(t, "#### T", "<h4>T</h4>\n")
+	check(t, "##### T", "<h5>T</h5>\n")
+	check(t, "###### T", "<h6>T</h6>\n")
+	check(t, "####### T", "<p>####### T</p>\n") // 7 hashes: paragraph
+	check(t, "#foo", "<p>#foo</p>\n")           // no space
+	check(t, "#", "<h1></h1>\n")
+	check(t, "# ", "<h1></h1>\n")
+	check(t, "# Title #", "<h1>Title</h1>\n")
+	check(t, "# Title  ##  ", "<h1>Title</h1>\n")
+	check(t, "# Title##", "<h1>Title##</h1>\n") // not preceded by a space
+}
+
+func TestHorizontalRule(t *testing.T) {
+	check(t, "---", "<hr />\n")
+	check(t, "***", "<hr />\n")
+	check(t, "___", "<hr />\n")
+	check(t, "----", "<hr />\n")
+	check(t, "--", "<p>--</p>\n")
+	check(t, "- - -", "<ul>\n<li>- -</li>\n</ul>\n") // has spaces: not an HR, so a list item
+}
+
+func TestCodeFence(t *testing.T) {
+	check(t, "```go\nx := 1\n```", `<pre><code class="language-go">x := 1
+</code></pre>
+`)
+	check(t, "```\na\nb\n```", "<pre><code>a\nb\n</code></pre>\n")
+	check(t, "```\na\n", "<pre><code>a\n</code></pre>\n") // unterminated: end of input
+	check(t, "```\n", "<pre><code></code></pre>\n")
+	check(t, "```\n<>&\"q\" &&\n```", "<pre><code>&lt;&gt;&amp;&quot;q&quot; &amp;&amp;\n</code></pre>\n")
+	check(t, "```\n<em>raw</em>\n```", "<pre><code>&lt;em&gt;raw&lt;/em&gt;\n</code></pre>\n") // no inline processing
+}
+
+func TestBlockquote(t *testing.T) {
+	check(t, "> hello", "<blockquote>\n<p>hello</p>\n</blockquote>\n")
+	check(t, ">hello", "<blockquote>\n<p>hello</p>\n</blockquote>\n") // no space after >
+	check(t, "> one\n> two", "<blockquote>\n<p>one\ntwo</p>\n</blockquote>\n")
+	check(t, "> # T\n> body", "<blockquote>\n<h1>T</h1>\n<p>body</p>\n</blockquote>\n")
+	check(t, "> > inner", "<blockquote>\n<blockquote>\n<p>inner</p>\n</blockquote>\n</blockquote>\n")
+	check(t, "> a\nplain", "<blockquote>\n<p>a</p>\n</blockquote>\n<p>plain</p>\n")
+}
+
+func TestLists(t *testing.T) {
+	check(t, "- a\n- b", "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n")
+	check(t, "* a\n+ b", "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n")
+	check(t, "1. a\n2. b", "<ol>\n<li>a</li>\n<li>b</li>\n</ol>\n")
+	check(t, "5. a\n6. b", `<ol start="5">` + "\n<li>a</li>\n<li>b</li>\n</ol>\n")
+	check(t, "- a\n1. b", "<ul>\n<li>a</li>\n</ul>\n<ol>\n<li>b</li>\n</ol>\n")
+	check(t, "1. a\n- b", "<ol>\n<li>a</li>\n</ol>\n<ul>\n<li>b</li>\n</ul>\n")
+	check(t, "- a\n- b\n  cont", "<ul>\n<li>a</li>\n<li>b\ncont</li>\n</ul>\n")
+	check(t, "- a\n  - n1\n  - n2", "<ul>\n<li>a\n<ul>\n<li>n1</li>\n<li>n2</li>\n</ul>\n</li>\n</ul>\n")
+	check(t, "- a\n  - n\n    deep", "<ul>\n<li>a\n<ul>\n<li>n\ndeep</li>\n</ul>\n</li>\n</ul>\n")
+	check(t, "- a\n1. b", "<ul>\n<li>a</li>\n</ul>\n<ol>\n<li>b</li>\n</ol>\n") // kind change
+}
+
+func TestParagraph(t *testing.T) {
+	check(t, "a\nb", "<p>a\nb</p>\n")
+	check(t, "a\n\nb", "<p>a</p>\n<p>b</p>\n")
+	check(t, "  a\n   b", "<p>a\nb</p>\n") // leading spaces removed
+	check(t, "para\n- item", "<p>para</p>\n<ul>\n<li>item</li>\n</ul>\n")
+	check(t, "para\n# h", "<p>para</p>\n<h1>h</h1>\n")
+	check(t, "para\n---", "<p>para</p>\n<hr />\n")
+	check(t, "para\n> q", "<p>para</p>\n<blockquote>\n<p>q</p>\n</blockquote>\n")
+	check(t, "para\n```go\ncode\n```", "<p>para</p>\n<pre><code class=\"language-go\">code\n</code></pre>\n")
+}
+
+func TestBlankAndCR(t *testing.T) {
+	check(t, "a\n\n\nb", "<p>a</p>\n<p>b</p>\n")
+	check(t, "a\n   \nb", "<p>a</p>\n<p>b</p>\n") // spaces-only blank
+	check(t, "a\r\nb\r\n", "<p>a\nb</p>\n")     // trailing \r removed
+	check(t, "", "")
+}
+
+func TestInlineCode(t *testing.T) {
+	check(t, "x `a<b` y", "<p>x <code>a&lt;b</code> y</p>\n")
+	check(t, "x ``a`` b", "<p>x <code>a</code> b</p>\n")
+	check(t, "x ```a`` b", "<p>x ```a`` b</p>\n") // run of 3, closer run of 2: no match
+	check(t, "x ``a` b`` c", "<p>x <code>a` b</code> c</p>\n")
+	check(t, "x ` a ` y", "<p>x <code>a</code> y</p>\n") // one space trimmed each end
+	check(t, "x ` a  ` y", "<p>x <code>a </code> y</p>\n")
+	check(t, "x ` ` y", "<p>x <code> </code> y</p>\n") // only spaces: kept
+	check(t, "x `unterminated", "<p>x `unterminated</p>\n") // literal backticks
+}
+
+func TestInlineLinks(t *testing.T) {
+	check(t, `[a](http://x.io)`, `<p><a href="http://x.io">a</a></p>
+`)
+	check(t, `[a](http://x.io "My T")`, `<p><a href="http://x.io" title="My T">a</a></p>
+`)
+	check(t, `[*b*](http://x.io)`, `<p><a href="http://x.io"><em>b</em></a></p>
+`)
+	check(t, `**[x](http://u)**`, `<p><strong><a href="http://u">x</a></strong></p>
+`)
+	check(t, `[a](http://x.io`, "<p>[a](http://x.io</p>\n")  // unclosed
+	check(t, `[a](http://x .io)`, "<p>[a](http://x .io)</p>\n") // url cannot contain a space
+	check(t, "x [a](http://x.io) y", `<p>x <a href="http://x.io">a</a> y</p>
+`)
+}
+
+func TestAutolink(t *testing.T) {
+	check(t, `<http://x.io>`, `<p><a href="http://x.io">http://x.io</a></p>
+`)
+	check(t, `<https://x.io/p?q=1&r=2>`, `<p><a href="https://x.io/p?q=1&amp;r=2">https://x.io/p?q=1&amp;r=2</a></p>
+`)
+	check(t, "<ftp://x>", "<p>&lt;ftp://x&gt;</p>\n")
+	check(t, `<http://x a>`, "<p>&lt;http://x a&gt;</p>\n") // space in url: not an autolink
+	check(t, "<x>", "<p>&lt;x&gt;</p>\n")
+}
+
+func TestEmphasis(t *testing.T) {
+	check(t, "*a*", "<p><em>a</em></p>\n")
+	check(t, "_a_", "<p><em>a</em></p>\n")
+	check(t, "**a**", "<p><strong>a</strong></p>\n")
+	check(t, "__a__", "<p><strong>a</strong></p>\n")
+	check(t, "a*b*c", "<p>a<em>b</em>c</p>\n")
+	check(t, "snake_case_name", "<p>snake_case_name</p>\n")
+	check(t, "a_b_c", "<p>a_b_c</p>\n")
+	check(t, "foo _bar_ baz", "<p>foo <em>bar</em> baz</p>\n")
+	check(t, "**a *b* c**", "<p><strong>a <em>b</em> c</strong></p>\n")
+	check(t, "*a **b** c*", "<p><em>a <strong>b</strong> c</em></p>\n")
+	check(t, "*a* *b*", "<p><em>a</em> <em>b</em></p>\n")
+	check(t, "a * b* c", "<p>a * b* c</p>\n") // opener followed by space: literal
+	check(t, "a _ b_ c", "<p>a _ b_ c</p>\n")
+	check(t, "_ a_ b_", "<p>_ a_ b_</p>\n") // _ opener followed by space
+	check(t, "*unmatched", "<p>*unmatched</p>\n")
+}
+
+func TestEscape(t *testing.T) {
+	check(t, `a \* b`, "<p>a * b</p>\n")
+	check(t, `a \_ b`, "<p>a _ b</p>\n")
+	check(t, `a \< b`, "<p>a &lt; b</p>\n")
+	check(t, `a \& b`, "<p>a \\&amp; b</p>\n") // & is not a special escape char: literal backslash
+	check(t, `a \q b`, "<p>a \\q b</p>\n") // q not special: literal backslash
+}
+
+func TestHardBreaks(t *testing.T) {
+	check(t, "a  \nb", "<p>a<br />\nb</p>\n")
+	check(t, "a   \nb", "<p>a<br />\nb</p>\n")
+	check(t, "a \nb", "<p>a\nb</p>\n") // one space: just removed
+	check(t, "a\nb  ", "<p>a\nb</p>\n") // last line: no break, spaces removed
+	check(t, "a\\\nb", "<p>a<br />\nb</p>\n")
+	check(t, "a\\", "<p>a\\</p>\n") // backslash at end of last line: literal
+}
+
+func TestHTMLEscaping(t *testing.T) {
+	check(t, `a & b < c > d " e"`, `<p>a &amp; b &lt; c &gt; d &quot; e&quot;</p>
+`)
+	check(t, `a<b`, "<p>a&lt;b</p>\n")
+}
+
+// guard against accidental leading blank output lines
+func TestNoLeadingNewline(t *testing.T) {
+	for _, s := range []string{"x", "x\ny", "- a"} {
+		if strings.HasPrefix(ToHTML(s), "\n") {
+			t.Errorf("ToHTML(%q) starts with newline: %q", s, ToHTML(s))
+		}
+	}
+}
