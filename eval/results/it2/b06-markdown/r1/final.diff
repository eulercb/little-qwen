+package md
+
+import "strings"
+
+// ---------- inline tokens ----------
+
+const (
+	nkText = iota // raw text, escaped at render time
+	nkHTML        // pre-rendered HTML fragment
+	nkDelim       // a run of * or _ emphasis delimiters
+)
+
+type inlNode struct {
+	kind  int
+	s     string // text / html / delimiter run
+	ch    byte   // nkDelim: the character ('*' or '_')
+	ln    int    // nkDelim: run length
+	open  bool   // nkDelim: valid opener
+	close bool   // nkDelim: valid closer
+}
+
+func textNode(s string) inlNode { return inlNode{kind: nkText, s: s} }
+func htmlNode(s string) inlNode { return inlNode{kind: nkHTML, s: s} }
+
+func isAlnum(r byte) bool {
+	return r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9'
+}
+
+var specials = []byte("\\`*_{}[]()#+-.!<>")
+
+func isSpecial(b byte) bool {
+	for _, c := range specials {
+		if b == c {
+			return true
+		}
+	}
+	return false
+}
+
+func escapeHTML(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&quot;")
+		default:
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+// renderInline applies the full inline pipeline to s.
+func renderInline(s string) string {
+	nodes := phaseA(s, true)
+	applyEmphasis(nodes)
+	var b strings.Builder
+	for _, n := range nodes {
+		switch n.kind {
+		case nkText, nkDelim:
+			b.WriteString(escapeHTML(n.s))
+		default:
+			b.WriteString(n.s)
+		}
+	}
+	return b.String()
+}
+
+// phaseA tokenizes s into text, html and delimiter nodes.
+func phaseA(s string, allowLinks bool) []inlNode {
+	var nodes []inlNode
+	var buf strings.Builder
+	last := byte(' ') // last emitted character, for word-boundary checks
+
+	flush := func() {
+		if buf.Len() > 0 {
+			nodes = append(nodes, textNode(buf.String()))
+			buf.Reset()
+		}
+	}
+	emitHTML := func(h string) {
+		flush()
+		nodes = append(nodes, htmlNode(h))
+		if len(h) > 0 {
+			last = h[len(h)-1]
+		}
+	}
+
+	i := 0
+	n := len(s)
+	for i < n {
+		c := s[i]
+		switch {
+		case c == '\\':
+			if i+1 < n && s[i+1] == '\n' {
+				// hard break: backslash at end of a line that is not last
+				emitHTML("<br />")
+				buf.WriteByte('\n')
+				last = '\n'
+				i += 2
+			} else if i+1 < n && isSpecial(s[i+1]) {
+				flush()
+				nodes = append(nodes, textNode(string(s[i+1])))
+				last = s[i+1]
+				i += 2
+			} else {
+				buf.WriteByte('\\')
+				last = '\\'
+				i++
+			}
+		case c == '`':
+			j := i + 1
+			for j < n && s[j] == '`' {
+				j++
+			}
+			run := j - i
+			closeIdx := findCodeClose(s, j, run)
+			if closeIdx >= 0 {
+				content := s[j:closeIdx]
+				if len(content) > 1 && content[0] == ' ' && content[len(content)-1] == ' ' {
+					content = content[1 : len(content)-1]
+				}
+				emitHTML("<code>" + escapeHTML(content) + "</code>")
+				i = closeIdx + run
+			} else {
+				buf.WriteString(s[i:j])
+				last = '`'
+				i = j
+			}
+		case c == '<':
+			if url, ok := tryAutolink(s, i); ok {
+				href := escapeHTML(url)
+				emitHTML(`<a href="` + href + `">` + href + `</a>`)
+				i += len(url) + 2
+			} else {
+				buf.WriteByte('<')
+				last = '<'
+				i++
+			}
+		case c == '[' && allowLinks:
+			if inner, url, title, end, ok := tryLink(s, i); ok {
+				t := ""
+				if title != "" {
+					t = ` title="` + escapeHTML(title) + `"`
+				}
+				emitHTML(`<a href="` + escapeHTML(url) + `"` + t + `>` + renderInline(inner) + `</a>`)
+				i = end
+			} else {
+				buf.WriteByte('[')
+				last = '['
+				i++
+			}
+		case c == '*' || c == '_':
+			j := i + 1
+			for j < n && s[j] == c {
+				j++
+			}
+			run := j - i
+			next := byte(' ')
+			if j < n {
+				next = s[j]
+			}
+			prev := last
+			flush()
+			d := inlNode{kind: nkDelim, s: s[i:j], ch: c, ln: run}
+			d.open = next != ' ' && next != '\n' && (c == '*' || !isAlnum(prev))
+			d.close = prev != ' ' && prev != '\n' && (c == '*' || !isAlnum(next))
+			nodes = append(nodes, d)
+			last = c
+			i = j
+		case c == ' ':
+			j := i + 1
+			for j < n && s[j] == ' ' {
+				j++
+			}
+			run := j - i
+			if j == n {
+				// trailing spaces on the final line: removed
+				i = j
+			} else if s[j] == '\n' {
+				if run >= 2 {
+					emitHTML("<br />")
+					buf.WriteByte('\n')
+					last = '\n'
+				} else {
+					buf.WriteByte('\n')
+					last = '\n'
+				}
+				i = j + 1
+			} else {
+				buf.WriteString(s[i:j])
+				last = ' '
+				i = j
+			}
+		default:
+			buf.WriteByte(c)
+			last = c
+			i++
+		}
+	}
+	flush()
+	return nodes
+}
+
+// findCodeClose finds the next run of exactly run backticks starting after pos.
+// Returns the index of that run, or -1.
+func findCodeClose(s string, pos, run int) int {
+	n := len(s)
+	i := pos
+	for i < n {
+		if s[i] != '`' {
+			i++
+			continue
+		}
+		j := i
+		for j < n && s[j] == '`' {
+			j++
+		}
+		if j-i == run {
+			return i
+		}
+		i = j
+	}
+	return -1
+}
+
+// tryAutolink checks for <http://...> or <https://...> at position i.
+func tryAutolink(s string, i int) (string, bool) {
+	rest := s[i+1:]
+	var scheme string
+	switch {
+	case strings.HasPrefix(rest, "http://"):
+		scheme = "http://"
+	case strings.HasPrefix(rest, "https://"):
+		scheme = "https://"
+	default:
+		return "", false
+	}
+	j := i + 1 + len(scheme)
+	n := len(s)
+	for j < n && s[j] != ' ' && s[j] != '<' && s[j] != '>' {
+		j++
+	}
+	url := s[i+1 : j]
+	if len(url) == len(scheme) || j >= n || s[j] != '>' {
+		return "", false
+	}
+	return url, true
+}
+
+// tryLink checks for [text](url) or [text](url "title") at position i.
+// On success it returns the inner text, the url, the optional title and the
+// index just past the closing ')'.
+func tryLink(s string, i int) (inner, url, title string, end int, ok bool) {
+	n := len(s)
+	j := i + 1
+	for j < n && s[j] != ']' {
+		j++
+	}
+	if j >= n || s[j] != ']' || j+1 >= n || s[j+1] != '(' {
+		return "", "", "", 0, false
+	}
+	k := j + 2
+	uStart := k
+	for k < n && s[k] != ' ' && s[k] != ')' {
+		k++
+	}
+	if k <= uStart {
+		return "", "", "", 0, false
+	}
+	url = s[uStart:k]
+	if k < n && s[k] == ' ' {
+		m := k + 1
+		if m < n && s[m] == '"' {
+			m++
+			tStart := m
+			for m < n && s[m] != '"' {
+				m++
+			}
+			if m < n && s[m] == '"' && m+1 < n && s[m+1] == ')' {
+				title = s[tStart:m]
+				k = m + 1
+			}
+		}
+	}
+	if k >= n || s[k] != ')' {
+		return "", "", "", 0, false
+	}
+	return s[i+1 : j], url, title, k + 1, true
+}
+
+// applyEmphasis pairs emphasis/strong delimiter runs in place.
+func applyEmphasis(nodes []inlNode) {
+	stack := []int{}
+	for i := range nodes {
+		d := &nodes[i]
+		if d.kind != nkDelim {
+			continue
+		}
+		paired := false
+		if d.close {
+			for k := len(stack) - 1; k >= 0; k-- {
+				o := &nodes[stack[k]]
+				if o.kind != nkDelim || o.ch != d.ch || !o.open || o.ln != d.ln || d.ln > 2 {
+					continue
+				}
+				// Intermediate openers become literal.
+				for m := len(stack) - 1; m > k; m-- {
+					nodes[stack[m]].kind = nkText
+				}
+				tagOpen, tagClose := "<em>", "</em>"
+				if d.ln == 2 {
+					tagOpen, tagClose = "<strong>", "</strong>"
+				}
+				o.kind = nkHTML
+				o.s = tagOpen
+				d.kind = nkHTML
+				d.s = tagClose
+				stack = stack[:k]
+				paired = true
+				break
+			}
+		}
+		if !paired && d.open {
+			stack = append(stack, i)
+		}
+	}
+	for i := range nodes {
+		if nodes[i].kind == nkDelim {
+			nodes[i].kind = nkText
+		}
+	}
+}
