+package main
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, in io.Reader, out io.Writer) error {
+	by, top, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+	records, err := r.ReadAll()
+	if err != nil {
+		return fmt.Errorf("reading CSV: %w", err)
+	}
+	if len(records) == 0 {
+		return errors.New("missing header row")
+	}
+
+	header := records[0]
+	idx := make(map[string]int, len(header))
+	for i, name := range header {
+		idx[strings.TrimSpace(name)] = i
+	}
+	required := []string{"region", "product", "qty", "price"}
+	for _, col := range required {
+		if _, ok := idx[col]; !ok {
+			return fmt.Errorf("missing required column %q", col)
+		}
+	}
+
+	type group struct {
+		qty    int64
+		revenue int64 // cents
+	}
+	groups := make(map[string]*group)
+	totalQty := int64(0)
+	totalRevenue := int64(0)
+
+	for i, rec := range records[1:] {
+		line := i + 2 // header is line 1
+		if len(rec) <= idx["qty"] || len(rec) <= idx["price"] || len(rec) <= idx[by] {
+			return fmt.Errorf("line %d: not enough fields", line)
+		}
+		qty, err := strconv.Atoi(strings.TrimSpace(rec[idx["qty"]]))
+		if err != nil || qty < 0 {
+			return fmt.Errorf("line %d: bad qty value %q", line, rec[idx["qty"]])
+		}
+		cents, err := parsePriceCents(strings.TrimSpace(rec[idx["price"]]))
+		if err != nil {
+			return fmt.Errorf("line %d: bad price value %q", line, rec[idx["price"]])
+		}
+		name := strings.TrimSpace(rec[idx[by]])
+		g := groups[name]
+		if g == nil {
+			g = &group{}
+			groups[name] = g
+		}
+		g.qty += int64(qty)
+		g.revenue += int64(qty) * cents
+		totalQty += int64(qty)
+		totalRevenue += int64(qty) * cents
+	}
+
+	type row struct {
+		name    string
+		qty     int64
+		revenue int64
+	}
+	rows := make([]row, 0, len(groups))
+	for name, g := range groups {
+		rows = append(rows, row{name, g.qty, g.revenue})
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].revenue != rows[j].revenue {
+			return rows[i].revenue > rows[j].revenue
+		}
+		return rows[i].name < rows[j].name
+	})
+	if top > 0 && top < len(rows) {
+		rows = rows[:top]
+	}
+	for _, r := range rows {
+		fmt.Fprintf(out, "%s\t%d\t%.2f\n", r.name, r.qty, float64(r.revenue)/100)
+	}
+	fmt.Fprintf(out, "TOTAL\t%d\t%.2f\n", totalQty, float64(totalRevenue)/100)
+	return nil
+}
+
+func parsePriceCents(s string) (int64, error) {
+	if s == "" {
+		return 0, errors.New("empty price")
+	}
+	neg := false
+	if s[0] == '+' {
+		s = s[1:]
+	} else if s[0] == '-' {
+		neg = true
+		s = s[1:]
+	}
+	intPart := s
+	fracPart := ""
+	if dot := strings.IndexByte(s, '.'); dot >= 0 {
+		intPart = s[:dot]
+		fracPart = s[dot+1:]
+	}
+	if intPart == "" {
+		intPart = "0"
+	}
+	if len(fracPart) > 2 {
+		return 0, fmt.Errorf("price has more than 2 decimal places")
+	}
+	for _, c := range intPart + fracPart {
+		if c < '0' || c > '9' {
+			return 0, fmt.Errorf("invalid number")
+		}
+	}
+	fracPart = fracPart + strings.Repeat("0", 2-len(fracPart))
+	c, err := strconv.ParseInt(intPart, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	d, err := strconv.ParseInt(fracPart, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	c = c*100 + d
+	if neg {
+		c = -c
+	}
+	return c, nil
+}
+
+func parseFlags(args []string) (by string, top int, err error) {
+	by = "region"
+	top = 0
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case a == "--by":
+			if i+1 >= len(args) {
+				return "", 0, errors.New("--by requires a value")
+			}
+			i++
+			by = args[i]
+		case strings.HasPrefix(a, "--by="):
+			by = strings.TrimPrefix(a, "--by=")
+		case a == "--top":
+			if i+1 >= len(args) {
+				return "", 0, errors.New("--top requires a value")
+			}
+			i++
+			top, err = parseTop(args[i])
+		case strings.HasPrefix(a, "--top="):
+			top, err = parseTop(strings.TrimPrefix(a, "--top="))
+		default:
+			return "", 0, fmt.Errorf("unknown flag %q", a)
+		}
+		if err != nil {
+			return "", 0, err
+		}
+	}
+	switch by {
+	case "region", "product":
+	default:
+		return "", 0, fmt.Errorf("invalid --by value %q (must be region or product)", by)
+	}
+	return by, top, nil
+}
+
+func parseTop(s string) (int, error) {
+	n, err := strconv.Atoi(s)
+	if err != nil || n < 1 {
+		return 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", s)
+	}
+	return n, nil
+}
