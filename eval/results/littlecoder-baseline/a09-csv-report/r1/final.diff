+package main
+
+import (
+	"bytes"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+const sampleCSV = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func runOut(t *testing.T, args []string, csv string) (string, error) {
+	t.Helper()
+	var buf bytes.Buffer
+	err := run(args, strings.NewReader(csv), &buf)
+	return buf.String(), err
+}
+
+func TestExampleByRegion(t *testing.T) {
+	got, err := runOut(t, nil, sampleCSV)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestByProduct(t *testing.T) {
+	got, err := runOut(t, []string{"--by", "product"}, sampleCSV)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestEqualFlags(t *testing.T) {
+	got, err := runOut(t, []string{"--by=product", "--top=1"}, sampleCSV)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "apple\t3\t3.30\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestGroupingAndSorting(t *testing.T) {
+	csv := "region,product,qty,price\n" +
+		"a,x,1,1.00\n" +
+		"b,y,2,1.50\n" + // 3.00, ties with c on revenue
+		"c,z,3,1.00\n" + // 3.00
+		"a,w,0,9.99\n"
+	got, err := runOut(t, []string{"--by", "region"}, csv)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	// a: qty 1, rev 1.00; b: qty 2, rev 3.00; c: qty 3, rev 3.00
+	// b and c tie on revenue -> b before c
+	want := "b\t2\t3.00\nc\t3\t3.00\na\t1\t1.00\nTOTAL\t6\t7.00\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestTop(t *testing.T) {
+	csv := "region,product,qty,price\na,x,1,5.00\nb,y,1,4.00\nc,z,1,3.00\n"
+	got, err := runOut(t, []string{"--top", "2"}, csv)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	// TOTAL still covers all rows
+	want := "a\t1\t5.00\nb\t1\t4.00\nTOTAL\t3\t12.00\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestShuffledAndExtraColumns(t *testing.T) {
+	csv := "price,note,qty,product,region,extra\n1.10,hi,3,apple,north,?\n"
+	got, err := runOut(t, nil, csv)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "north\t3\t3.30\nTOTAL\t3\t3.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestMissingColumn(t *testing.T) {
+	for _, col := range []string{"region", "product", "qty", "price"} {
+		cols := []string{"region", "product", "qty", "price"}
+		var kept []string
+		for _, c := range cols {
+			if c != col {
+				kept = append(kept, c)
+			}
+		}
+		_, err := runOut(t, nil, strings.Join(kept, ",")+"\n1,2,3,4\n")
+		if err == nil || !strings.Contains(err.Error(), col) {
+			t.Errorf("missing %q: err = %v, want error mentioning %q", col, err, col)
+		}
+	}
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	_, err := runOut(t, nil, "region,product,qty,price\nnorth,apple,2,1.00\nsouth,pear,abc,1.00\n")
+	if err == nil || !strings.Contains(err.Error(), "line 3") {
+		t.Errorf("err = %v, want mention of line 3", err)
+	}
+}
+
+func TestNegativeQty(t *testing.T) {
+	_, err := runOut(t, nil, "region,product,qty,price\nnorth,apple,-1,1.00\n")
+	if err == nil || !strings.Contains(err.Error(), "line 2") {
+		t.Errorf("err = %v, want mention of line 2", err)
+	}
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	_, err := runOut(t, nil, "region,product,qty,price\nnorth,apple,1,1.234\n")
+	if err == nil || !strings.Contains(err.Error(), "line 2") {
+		t.Errorf("err = %v, want mention of line 2", err)
+	}
+	_, err = runOut(t, nil, "region,product,qty,price\nnorth,apple,1,foo\n")
+	if err == nil || !strings.Contains(err.Error(), "line 2") {
+		t.Errorf("err = %v, want mention of line 2", err)
+	}
+}
+
+func TestFlags(t *testing.T) {
+	cases := [][]string{
+		{"--by", "bogus"},
+		{"--by=1"},
+		{"--top", "0"},
+		{"--top", "-1"},
+		{"--top", "x"},
+		{"--top"},
+		{"--by"},
+		{"--unknown"},
+	}
+	for _, args := range cases {
+		if _, err := runOut(t, args, sampleCSV); err == nil {
+			t.Errorf("args %v: expected error, got nil", args)
+		}
+	}
+}
+
+func TestIntegerArithmeticNoDrift(t *testing.T) {
+	// 0.10 * 3 is inexact in binary floats; integer cents must yield 0.30.
+	csv := "region,product,qty,price\na,x,3,0.10\n"
+	got, err := runOut(t, nil, csv)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "a\t3\t0.30\nTOTAL\t3\t0.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestTopLargerThanGroups(t *testing.T) {
+	got, err := runOut(t, []string{"--top", "10"}, sampleCSV)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Errorf("output = %q, want %q", got, want)
+	}
+}
+
+func TestMainDelegates(t *testing.T) {
+	// run with no args on the sample equals --by region
+	got, err := runOut(t, nil, sampleCSV)
+	want, err2 := runOut(t, []string{"--by", "region"}, sampleCSV)
+	if err != nil || err2 != nil {
+		t.Fatalf("run: %v / %v", err, err2)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("default differs: %q vs %q", got, want)
+	}
+}
