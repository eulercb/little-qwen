+// Package jpath implements a tiny path query language over decoded JSON.
+package jpath
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var errMalformed = errors.New("jpath: malformed path")
+
+type stepKind int
+
+const (
+	stMember stepKind = iota
+	stIndex
+	stWildcard
+	stRecurse
+)
+
+type step struct {
+	kind stepKind
+	name string
+	idx  int
+	oob  bool
+}
+
+func isIdentFirst(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdentChar(c byte) bool {
+	return isIdentFirst(c) || (c >= '0' && c <= '9')
+}
+
+func isStepStart(c byte) bool {
+	return c == '.' || c == '['
+}
+
+func parsePath(p string) ([]step, error) {
+	if p == "" || p[0] != '$' {
+		return nil, fmt.Errorf("%w: must start with $", errMalformed)
+	}
+	rest := p[1:]
+	var steps []step
+	for rest != "" {
+		switch {
+		case rest[0] == '.' && len(rest) > 1 && rest[1] == '.':
+			i := 2
+			if i >= len(rest) || !isIdentFirst(rest[i]) {
+				return nil, fmt.Errorf("%w: bad recursive descent", errMalformed)
+			}
+			i++
+			for i < len(rest) && isIdentChar(rest[i]) {
+				i++
+			}
+			steps = append(steps, step{kind: stRecurse, name: rest[2:i]})
+			rest = rest[i:]
+		case rest[0] == '.':
+			i := 1
+			if i < len(rest) && rest[i] == '*' {
+				i++
+			} else {
+				if i >= len(rest) || !isIdentFirst(rest[i]) {
+					return nil, fmt.Errorf("%w: bad member name", errMalformed)
+				}
+				i++
+				for i < len(rest) && isIdentChar(rest[i]) {
+					i++
+				}
+			}
+			kind, name := stMember, ""
+			if i > 1 && rest[1] == '*' {
+				kind = stWildcard
+			} else {
+				name = rest[1:i]
+			}
+			steps = append(steps, step{kind: kind, name: name})
+			rest = rest[i:]
+		case rest[0] == '[':
+			st, n, err := parseBracket(rest)
+			if err != nil {
+				return nil, err
+			}
+			steps = append(steps, st)
+			rest = rest[n:]
+		default:
+			return nil, fmt.Errorf("%w: unexpected %q", errMalformed, string(rest[0]))
+		}
+		if rest != "" && !isStepStart(rest[0]) {
+			return nil, fmt.Errorf("%w: unexpected %q", errMalformed, string(rest[0]))
+		}
+	}
+	return steps, nil
+}
+
+func parseBracket(s string) (step, int, error) {
+	// s[0] == '['
+	if len(s) < 2 {
+		return step{}, 0, fmt.Errorf("%w: bad bracket expression", errMalformed)
+	}
+	if len(s) >= 3 && s[1] == '*' && s[2] == ']' {
+		return step{kind: stWildcard}, 3, nil
+	}
+	if s[1] == '"' {
+		key, i, err := parseQuoted(s, 1)
+		if err != nil || i >= len(s) || s[i] != ']' {
+			return step{}, 0, fmt.Errorf("%w: bad quoted key", errMalformed)
+		}
+		return step{kind: stMember, name: key}, i + 1, nil
+	}
+	// Numeric index.
+	i := 1
+	neg := false
+	if i < len(s) && s[i] == '-' {
+		neg = true
+		i++
+	}
+	if i >= len(s) || s[i] < '0' || s[i] > '9' {
+		return step{}, 0, fmt.Errorf("%w: bad index", errMalformed)
+	}
+	start := i
+	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+		i++
+	}
+	if i >= len(s) || s[i] != ']' {
+		return step{}, 0, fmt.Errorf("%w: bad index", errMalformed)
+	}
+	st := step{kind: stIndex}
+	num := s[start:i]
+	if neg {
+		num = "-" + num
+	}
+	n, err := strconv.Atoi(num)
+	if err != nil {
+		st.oob = true
+	} else {
+		st.idx = n
+	}
+	return st, i + 1, nil
+}
+
+// parseQuoted parses a double-quoted string starting at s[start].
+// It returns the unescaped key and the index just past the closing quote.
+func parseQuoted(s string, start int) (string, int, error) {
+	var b strings.Builder
+	i := start + 1
+	for i < len(s) {
+		c := s[i]
+		switch {
+		case c == '\\':
+			if i+1 >= len(s) {
+				return "", 0, fmt.Errorf("%w: bad escape", errMalformed)
+			}
+			e := s[i+1]
+			if e != '"' && e != '\\' {
+				return "", 0, fmt.Errorf("%w: bad escape", errMalformed)
+			}
+			b.WriteByte(e)
+			i += 2
+		case c == '"':
+			return b.String(), i + 1, nil
+		default:
+			b.WriteByte(c)
+			i++
+		}
+	}
+	return "", 0, fmt.Errorf("%w: unterminated string", errMalformed)
+}
+
+// Query evaluates path against the decoded JSON document doc and returns
+// all matching nodes.
+func Query(doc any, path string) ([]any, error) {
+	steps, err := parsePath(path)
+	if err != nil {
+		return nil, err
+	}
+	nodes := []any{doc}
+	for _, st := range steps {
+		out := []any{}
+		for _, n := range nodes {
+			out = append(out, apply(st, n)...)
+		}
+		nodes = out
+	}
+	return nodes, nil
+}
+
+func apply(s step, v any) []any {
+	switch s.kind {
+	case stMember:
+		if m, ok := v.(map[string]any); ok {
+			if x, ok := m[s.name]; ok {
+				return []any{x}
+			}
+		}
+	case stIndex:
+		arr, ok := v.([]any)
+		if !ok || s.oob {
+			break
+		}
+		i := s.idx
+		if i < 0 {
+			i += len(arr)
+		}
+		if i >= 0 && i < len(arr) {
+			return []any{arr[i]}
+		}
+	case stWildcard:
+		switch n := v.(type) {
+		case []any:
+			return append([]any{}, n...)
+		case map[string]any:
+			keys := make([]string, 0, len(n))
+			for k := range n {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			out := make([]any, 0, len(keys))
+			for _, k := range keys {
+				out = append(out, n[k])
+			}
+			return out
+		}
+	case stRecurse:
+		return descend(s.name, v)
+	}
+	return nil
+}
+
+func descend(name string, v any) []any {
+	var out []any
+	if m, ok := v.(map[string]any); ok {
+		if x, ok := m[name]; ok {
+			out = append(out, x)
+		}
+	}
+	var children []any
+	switch n := v.(type) {
+	case map[string]any:
+		keys := make([]string, 0, len(n))
+		for k := range n {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			children = append(children, n[k])
+		}
+	case []any:
+		children = n
+	}
+	for _, c := range children {
+		out = append(out, descend(name, c)...)
+	}
+	return out
+}
