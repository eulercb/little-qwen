+func TestVersion1Loads(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "t.json")
+	v1 := `{"version":1,"next_id":2,"tasks":[{"id":1,"title":"old","priority":2,"done":false,"created":"2026-01-01T00:00:00Z"}]}`
+	if err := os.WriteFile(p, []byte(v1), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.All(); len(got) != 1 || got[0].Title != "old" || got[0].Tags != nil || got[0].Due != nil {
+		t.Fatalf("%+v", got)
+	}
+	d := time.Date(2026, 4, 15, 0, 0, 0, 0, time.UTC)
+	if _, err := s.Add(model.Task{Title: "new", Priority: 3, Tags: []string{"home"}, Due: &d}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	txt := string(data)
+	if !strings.Contains(txt, `"version": 2`) {
+		t.Fatalf("saved file must be version 2: %s", txt)
+	}
+	if !strings.Contains(txt, `"tags"`) || !strings.Contains(txt, `"home"`) || !strings.Contains(txt, `"due": "2026-04-15T00:00:00Z"`) {
+		t.Fatalf("saved file missing tags/due: %s", txt)
+	}
+	if !strings.Contains(txt, `"title": "old"`) || strings.Contains(txt, `"due": null`) {
+		t.Fatalf("v1 task lost fields or gained nulls: %s", txt)
+	}
+	s2, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := s2.All()
+	if all[0].Title != "old" || all[1].Tags[0] != "home" || all[1].Due == nil || all[1].Due.Format("2006-01-02") != "2026-04-15" {
+		t.Fatalf("%+v", all)
+	}
+}
