+func TestApplyTagsOverdueSort(t *testing.T) {
+	now := time.Date(2026, 3, 10, 12, 0, 0, 0, time.UTC)
+	ts := []model.Task{
+		{ID: 1, Tags: []string{"home"}, Due: due("2026-03-09")},
+		{ID: 2, Tags: []string{"home", "money"}, Due: due("2026-03-10")},
+		{ID: 3, Tags: []string{"home"}},
+		{ID: 4, Tags: []string{"home"}, Due: due("2026-03-08"), Done: true},
+	}
+	ids := func(got []model.Task) []int {
+		var r []int
+		for _, t := range got {
+			r = append(r, t.ID)
+		}
+		return r
+	}
+	if got, _ := Apply(ts, Options{Tags: []string{"home"}}); len(ids(got)) != 3 || ids(got)[0] != 1 {
+		t.Fatalf("--tag home: %v", ids(got))
+	}
+	if got, _ := Apply(ts, Options{Tags: []string{"home", "money"}}); len(ids(got)) != 1 || ids(got)[0] != 2 {
+		t.Fatalf("--tag home --tag money: %v", ids(got))
+	}
+	if got, _ := Apply(ts, Options{Tags: []string{"nope"}}); len(got) != 0 {
+		t.Fatalf("missing tag: %v", ids(got))
+	}
+	if got, _ := Apply(ts, Options{Overdue: true, Now: now}); len(ids(got)) != 1 || ids(got)[0] != 1 {
+		t.Fatalf("--overdue: %v", ids(got))
+	}
+	if got, _ := Apply(ts, Options{IncludeDone: true, Overdue: true, Now: now}); len(ids(got)) != 1 || ids(got)[0] != 1 {
+		t.Fatalf("--all --overdue must exclude done: %v", ids(got))
+	}
+	if got, _ := Apply(ts, Options{IncludeDone: true, SortBy: "due"}); len(ids(got)) != 4 || ids(got)[0] != 4 || ids(got)[1] != 1 || ids(got)[2] != 2 || ids(got)[3] != 3 {
+		t.Fatalf("--sort due: %v", ids(got))
+	}
+	ties := []model.Task{{ID: 2, Due: due("2026-03-01")}, {ID: 1, Due: due("2026-03-01")}}
+	if got, _ := Apply(ties, Options{SortBy: "due"}); ids(got)[0] != 1 || ids(got)[1] != 2 {
+		t.Fatalf("due ties must break by id: %v", ids(got))
+	}
+}
