+// roundToEven rounds x to the nearest integer, with ties to even.
+func roundToEven(x float64) int64 {
+	if x < 0 {
+		return -roundToEven(-x)
+	}
+	f := math.Floor(x)
+	d := x - f
+	if d > 0.5 || (d == 0.5 && int64(f)%2 == 1) {
+		f++
+	}
+	return int64(f)
 }
 
