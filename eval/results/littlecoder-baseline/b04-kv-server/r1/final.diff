+package store
+
+import (
+	"bytes"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+type fakeClock struct {
+	t time.Time
+}
+
+func (f *fakeClock) Now() time.Time { return f.t }
+
+func (f *fakeClock) Add(d time.Duration) { f.t = f.t.Add(d) }
+
+var t0 = time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+
+func newTestStore() (*Store, *fakeClock) {
+	fc := &fakeClock{t: t0}
+	return New(fc.Now), fc
+}
+
+func TestSetGet(t *testing.T) {
+	s, _ := newTestStore()
+	s.Set("k", "v", 0)
+	if v, ok := s.Get("k"); !ok || v != "v" {
+		t.Fatalf("Get = %q %v", v, ok)
+	}
+	if _, ok := s.Get("nope"); ok {
+		t.Fatal("missing key should be absent")
+	}
+	s.Set("k", "v2", 5*time.Second)
+	if v, _ := s.Get("k"); v != "v2" {
+		t.Fatalf("after re-set v = %q", v)
+	}
+}
+
+func TestExpiry(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("k", "v", 10*time.Second)
+	fc.Add(9 * time.Second)
+	if _, ok := s.Get("k"); !ok {
+		t.Fatal("key should still be alive just before deadline")
+	}
+	if d := s.TTL("k"); d != time.Second {
+		t.Fatalf("TTL = %v, want 1s", d)
+	}
+	fc.Add(time.Second) // now == deadline
+	if _, ok := s.Get("k"); ok {
+		t.Fatal("expired key (now == deadline) should be missing")
+	}
+	if s.Len() != 0 {
+		t.Fatalf("Len = %d, want 0", s.Len())
+	}
+	if got := s.Keys("*"); len(got) != 0 {
+		t.Fatalf("Keys = %v, want empty", got)
+	}
+}
+
+func TestSetReplacesTTL(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("k", "v1", 10*time.Second)
+	fc.Add(9 * time.Second)
+	s.Set("k", "v2", 0)
+	if v, ok := s.Get("k"); !ok || v != "v2" {
+		t.Fatalf("Get after re-set = %q %v", v, ok)
+	}
+	fc.Add(10 * time.Hour)
+	if v, ok := s.Get("k"); !ok || v != "v2" {
+		t.Fatalf("key with ttl=0 should not expire: %q %v", v, ok)
+	}
+}
+
+func TestDel(t *testing.T) {
+	s, _ := newTestStore()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 0)
+	if n := s.Del("a", "b", "c"); n != 2 {
+		t.Fatalf("Del = %d, want 2", n)
+	}
+	if n := s.Del("a"); n != 0 {
+		t.Fatalf("Del again = %d, want 0", n)
+	}
+}
+
+func TestExists(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 1*time.Second)
+	if !s.Exists("a") {
+		t.Fatal("Exists = false, want true")
+	}
+	fc.Add(2 * time.Second)
+	if s.Exists("a") {
+		t.Fatal("expired key Exists = true")
+	}
+}
+
+func TestExpire(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 0)
+	if !s.Expire("a", 3*time.Second) {
+		t.Fatal("Expire = false, want true")
+	}
+	if d := s.TTL("a"); d != 3*time.Second {
+		t.Fatalf("TTL = %v, want 3s", d)
+	}
+	fc.Add(4 * time.Second)
+	if _, ok := s.Get("a"); ok {
+		t.Fatal("expired key should be gone")
+	}
+	if s.Expire("missing", 1*time.Second) {
+		t.Fatal("Expire on missing key should be false")
+	}
+	s.Set("b", "2", 0)
+	if !s.Expire("b", 0) {
+		t.Fatal("Expire ttl<=0 should delete key and return true")
+	}
+	if _, ok := s.Get("b"); ok {
+		t.Fatal("key deleted via Expire(0) should be gone")
+	}
+}
+
+func TestPersist(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 5*time.Second)
+	s.Set("b", "2", 0)
+	if !s.Persist("a") {
+		t.Fatal("Persist on expiring key = false")
+	}
+	if s.Persist("a") {
+		t.Fatal("Persist twice should be false")
+	}
+	fc.Add(10 * time.Hour)
+	if v, ok := s.Get("a"); !ok || v != "1" {
+		t.Fatal("persisted key should not expire")
+	}
+	if s.Persist("missing") {
+		t.Fatal("Persist on missing key should be false")
+	}
+}
+
+func TestTTL(t *testing.T) {
+	s, fc := newTestStore()
+	if d := s.TTL("nope"); d != -2*time.Second {
+		t.Fatalf("TTL missing = %v, want -2s", d)
+	}
+	s.Set("a", "1", 0)
+	if d := s.TTL("a"); d != -1*time.Second {
+		t.Fatalf("TTL no-expiry = %v, want -1s", d)
+	}
+	s.Set("b", "2", 7*time.Second)
+	fc.Add(2 * time.Second)
+	if d := s.TTL("b"); d != 5*time.Second {
+		t.Fatalf("TTL remaining = %v, want 5s", d)
+	}
+}
+
+func TestIncr(t *testing.T) {
+	s, _ := newTestStore()
+	if n, err := s.Incr("c", 1); err != nil || n != 1 {
+		t.Fatalf("Incr missing = %d %v", n, err)
+	}
+	if n, err := s.Incr("c", 5); err != nil || n != 6 {
+		t.Fatalf("Incr = %d %v", n, err)
+	}
+	if n, err := s.Incr("c", -10); err != nil || n != -4 {
+		t.Fatalf("Incr neg = %d %v", n, err)
+	}
+	s.Set("s", "abc", 0)
+	if _, err := s.Incr("s", 1); err != ErrNotInteger {
+		t.Fatalf("Incr non-int err = %v, want ErrNotInteger", err)
+	}
+	s.Set("f", "1.5", 0)
+	if _, err := s.Incr("f", 1); err != ErrNotInteger {
+		t.Fatalf("Incr float err = %v, want ErrNotInteger", err)
+	}
+	// keeps existing ttl
+	sfc := &fakeClock{t: t0}
+	s2 := New(sfc.Now)
+	s2.Set("c", "1", 3*time.Second)
+	sfc.Add(2 * time.Second)
+	if d := s2.TTL("c"); d != time.Second {
+		t.Fatalf("ttl before = %v", d)
+	}
+	if _, err := s2.Incr("c", 1); err != nil {
+		t.Fatal(err)
+	}
+	if d := s2.TTL("c"); d != time.Second {
+		t.Fatalf("ttl after incr = %v, want 1s", d)
+	}
+}
+
+func TestKeysGlob(t *testing.T) {
+	s, _ := newTestStore()
+	for _, k := range []string{"user:1", "user:2", "users/4", "u2", "v1", "u9"} {
+		s.Set(k, "x", 0)
+	}
+	if n := s.Len(); n != 6 {
+		t.Fatalf("Len = %d, want 6", n)
+	}
+	cases := []struct {
+		pat  string
+		want []string
+	}{
+		{"*", []string{"u2", "u9", "user:1", "user:2", "users/4", "v1"}},
+		{"user:*", []string{"user:1", "user:2"}},
+		{"*4", []string{"users/4"}},
+		{"u?", []string{"u2", "u9"}},
+		{"u[1-9]", []string{"u2", "u9"}},
+		{"u[29]", []string{"u2", "u9"}},
+		{"u[^2]", []string{"u9"}},
+		{"u[!2]", []string{"u9"}},
+		{`u\2`, []string{"u2"}},
+		{`*/*`, []string{"users/4"}},
+		{"u2?", []string{}},
+	}
+	for _, c := range cases {
+		got := s.Keys(c.pat)
+		if strings.Join(got, ",") != strings.Join(c.want, ",") {
+			t.Errorf("Keys(%q) = %v, want %v", c.pat, got, c.want)
+		}
+	}
+}
+
+func TestSaveLoad(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("b", "2", 60*time.Second)
+	s.Set("a", "1", 0)
+	s.Set("gone", "x", time.Millisecond)
+	fc.Add(2 * time.Second)
+
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatal(err)
+	}
+	const want = `{"version":1,"entries":[{"k":"a","v":"1","exp":0},{"k":"b","v":"2","exp":`
+	if !strings.HasPrefix(buf.String(), want) {
+		t.Fatalf("Save output = %s, want prefix %s", buf.String(), want)
+	}
+	wantExp := t0.Add(60 * time.Second).UnixMilli()
+	if !strings.Contains(buf.String(), `"exp":`+itoa(wantExp)) {
+		t.Fatalf("Save output = %s, want exp %d", buf.String(), wantExp)
+	}
+	if strings.Contains(buf.String(), "gone") {
+		t.Fatal("expired entry saved")
+	}
+
+	s2, _ := newTestStore()
+	snapBytes := buf.String()
+	if err := s2.Load(strings.NewReader(snapBytes)); err != nil {
+		t.Fatal(err)
+	}
+	if v, ok := s2.Get("a"); !ok || v != "1" {
+		t.Fatalf("after load a = %q %v", v, ok)
+	}
+	if v, ok := s2.Get("b"); !ok || v != "2" {
+		t.Fatalf("after load b = %q %v", v, ok)
+	}
+	// pre-existing contents replaced
+	s2.Set("zz", "z", 0)
+	if err := s2.Load(strings.NewReader(snapBytes)); err != nil {
+		t.Fatal(err)
+	}
+	if s2.Exists("zz") {
+		t.Fatal("Load should replace all contents")
+	}
+
+	// wrong version rejected
+	s3, _ := newTestStore()
+	s3.Set("a", "1", 0)
+	if err := s3.Load(strings.NewReader(`{"version":2,"entries":[]}`)); err == nil {
+		t.Fatal("Load should reject version 2")
+	}
+	if s3.Len() != 1 {
+		t.Fatal("failed Load should not clear store")
+	}
+}
+
+func TestLoadDropsExpired(t *testing.T) {
+	s, _ := newTestStore()
+	expired := t0.Add(-1 * time.Second).UnixMilli()
+	future := t0.Add(50 * time.Second).UnixMilli()
+	data := `{"version":1,"entries":[
+		{"k":"dead","v":"1","exp":` + itoa(expired) + `},
+		{"k":"live","v":"2","exp":` + itoa(future) + `},
+		{"k":"noexp","v":"3","exp":0}]}`
+	if err := s.Load(strings.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.Get("dead"); ok {
+		t.Fatal("entry expired at load time should be dropped")
+	}
+	if v, ok := s.Get("live"); !ok || v != "2" {
+		t.Fatalf("live = %q %v", v, ok)
+	}
+	if v, ok := s.Get("noexp"); !ok || v != "3" {
+		t.Fatalf("noexp = %q %v", v, ok)
+	}
+	// boundary: exp == now is expired at load
+	edge := t0.UnixMilli()
+	sfc := &fakeClock{t: t0}
+	s2 := New(sfc.Now)
+	if err := s2.Load(strings.NewReader(`{"version":1,"entries":[{"k":"edge","v":"1","exp":` + itoa(edge) + `}]}`)); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s2.Get("edge"); ok {
+		t.Fatal("entry expiring exactly at load time should be dropped")
+	}
+}
+
+func itoa(n int64) string { return strconv.FormatInt(n, 10) }
+
+func TestConcurrency(t *testing.T) {
+	s, _ := newTestStore()
+	done := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			defer func() { done <- struct{}{} }()
+			key := "k"
+			for j := 0; j < 1000; j++ {
+				s.Set(key, "v", time.Second)
+				s.Get(key)
+				s.Incr(key, 1)
+				s.Keys("*")
+				s.Len()
+				if i == 0 {
+					s.Del(key)
+				}
+			}
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+}
