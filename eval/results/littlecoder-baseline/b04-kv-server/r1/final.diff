@@ -0,0 +1,271 @@
+package proto
+
+import (
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// Exec parses one request line and returns the full response, including the
+// trailing newline.
+func Exec(s *store.Store, line string) string {
+	if strings.TrimSpace(line) == "" {
+		return errResp("empty command")
+	}
+	toks, err := tokenize(line)
+	if err != nil {
+		return errResp("syntax error")
+	}
+	if len(toks) == 0 {
+		return errResp("empty command")
+	}
+	name := strings.ToLower(toks[0])
+	args := toks[1:]
+	switch name {
+	case "ping":
+		if len(args) != 0 {
+			return errArgs("ping")
+		}
+		return "+PONG\n"
+	case "quit":
+		return "+BYE\n"
+	case "set":
+		return cmdSet(s, args)
+	case "get":
+		if len(args) != 1 {
+			return errArgs("get")
+		}
+		if v, ok := s.Get(args[0]); ok {
+			return stringResp(v)
+		}
+		return "$nil\n"
+	case "del":
+		if len(args) < 1 {
+			return errArgs("del")
+		}
+		return intResp(int64(s.Del(args...)))
+	case "exists":
+		if len(args) != 1 {
+			return errArgs("exists")
+		}
+		if s.Exists(args[0]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "expire":
+		if len(args) != 2 {
+			return errArgs("expire")
+		}
+		n, err := parseIntArg(args[1])
+		if err != nil {
+			return errResp("value is not an integer")
+		}
+		if s.Expire(args[0], time.Duration(n)*time.Second) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "persist":
+		if len(args) != 1 {
+			return errArgs("persist")
+		}
+		if s.Persist(args[0]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "ttl":
+		if len(args) != 1 {
+			return errArgs("ttl")
+		}
+		d := s.TTL(args[0])
+		switch {
+		case d == -2*time.Second:
+			return ":-2\n"
+		case d == -1*time.Second:
+			return ":-1\n"
+		default:
+			// round up to whole seconds
+			sec := int64((d + time.Second - time.Nanosecond) / time.Second)
+			return intResp(sec)
+		}
+	case "incr":
+		if len(args) != 1 {
+			return errArgs("incr")
+		}
+		return cmdIncr(s, args[0], 1)
+	case "incrby":
+		if len(args) != 2 {
+			return errArgs("incrby")
+		}
+		n, err := parseIntArg(args[1])
+		if err != nil {
+			return errResp("value is not an integer")
+		}
+		return cmdIncr(s, args[0], n)
+	case "keys":
+		if len(args) != 1 {
+			return errArgs("keys")
+		}
+		ks := s.Keys(args[0])
+		var b strings.Builder
+		b.WriteString("*" + strconv.Itoa(len(ks)) + "\n")
+		for _, k := range ks {
+			b.WriteString(stringResp(k))
+		}
+		return b.String()
+	case "dbsize":
+		if len(args) != 0 {
+			return errArgs("dbsize")
+		}
+		return intResp(int64(s.Len()))
+	default:
+		return "-ERR unknown command '" + toks[0] + "'\n"
+	}
+}
+
+func cmdSet(s *store.Store, args []string) string {
+	switch len(args) {
+	case 2:
+		s.Set(args[0], args[1], 0)
+		return "+OK\n"
+	case 4:
+		if !strings.EqualFold(args[2], "EX") {
+			return errResp("syntax error")
+		}
+		n, err := strconv.ParseInt(args[3], 10, 64)
+		if err != nil {
+			return errResp("value is not an integer")
+		}
+		if n <= 0 {
+			return errResp("syntax error")
+		}
+		s.Set(args[0], args[1], time.Duration(n)*time.Second)
+		return "+OK\n"
+	case 3:
+		return errResp("syntax error")
+	default:
+		return errArgs("set")
+	}
+}
+
+func cmdIncr(s *store.Store, key string, by int64) string {
+	n, err := s.Incr(key, by)
+	if err != nil {
+		return errResp("value is not an integer")
+	}
+	return intResp(n)
+}
+
+func parseIntArg(t string) (int64, error) {
+	return strconv.ParseInt(t, 10, 64)
+}
+
+func errResp(msg string) string { return "-ERR " + msg + "\n" }
+
+func errArgs(name string) string { return "-ERR wrong number of arguments for '" + name + "'\n" }
+
+func intResp(n int64) string { return ":" + strconv.FormatInt(n, 10) + "\n" }
+
+// stringResp renders a bulk string, quoting with escapes when the value
+// contains a space, tab, quote, backslash or newline, or is empty.
+func stringResp(v string) string {
+	needsQuote := v == ""
+	for i := 0; i < len(v); i++ {
+		switch v[i] {
+		case ' ', '\t', '"', '\\', '\n':
+			needsQuote = true
+		}
+	}
+	if !needsQuote {
+		return "$" + v + "\n"
+	}
+	var b strings.Builder
+	b.WriteByte('$')
+	b.WriteByte('"')
+	for i := 0; i < len(v); i++ {
+		c := v[i]
+		switch c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte('"')
+	b.WriteByte('\n')
+	return b.String()
+}
+
+// tokenize splits a request line into tokens. Tokens are separated by one or
+// more spaces/tabs. A token may be double-quoted; inside quotes \" \\ and \n
+// are escapes. An unterminated quote or a bad escape is a syntax error.
+func tokenize(line string) ([]string, error) {
+	var toks []string
+	i := 0
+	n := len(line)
+	for i < n {
+		// skip separators
+		for i < n && (line[i] == ' ' || line[i] == '\t') {
+			i++
+		}
+		if i >= n {
+			break
+		}
+		var tok string
+		if line[i] == '"' {
+			i++ // consume opening quote
+			var b strings.Builder
+			closed := false
+		quoteLoop:
+			for i < n {
+				c := line[i]
+				switch {
+				case c == '"':
+					closed = true
+					i++
+					break quoteLoop
+				case c == '\\':
+					if i+1 >= n {
+						return nil, errSyntax
+					}
+					esc := line[i+1]
+					switch esc {
+					case '"', '\\':
+						b.WriteByte(esc)
+					case 'n':
+						b.WriteByte('\n')
+					default:
+						return nil, errSyntax
+					}
+					i += 2
+				default:
+					b.WriteByte(c)
+					i++
+				}
+			}
+			if !closed {
+				return nil, errSyntax
+			}
+			tok = b.String()
+		} else {
+			start := i
+			for i < n && line[i] != ' ' && line[i] != '\t' {
+				i++
+			}
+			tok = line[start:i]
+		}
+		toks = append(toks, tok)
+	}
+	return toks, nil
+}
+
+var errSyntax = err("syntax error")
+
+type err string
+
+func (e err) Error() string { return string(e) }
diff --git a/proto/proto_test.go b/proto/proto_test.go
