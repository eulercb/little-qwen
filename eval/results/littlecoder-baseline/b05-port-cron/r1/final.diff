+// Package cron is a Go port of the reference cron-expression library.
+//
+// Syntax: five space-separated fields: minute hour day-of-month month day-of-week
+//
+//	minute 0-59, hour 0-23, day-of-month 1-31, month 1-12 (or JAN-DEC),
+//	day-of-week 0-6 (or SUN-SAT; 7 is also Sunday)
+//
+// Day matching follows Vixie cron: if both day-of-month and day-of-week are
+// restricted (neither field is "*"), a day matches when EITHER matches;
+// otherwise both must match.
+package cron
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type fieldSpec struct {
+	name string
+	lo   int
+	hi   int
+}
+
+var fieldSpecs = [5]fieldSpec{
+	{"minute", 0, 59},
+	{"hour", 0, 23},
+	{"day-of-month", 1, 31},
+	{"month", 1, 12},
+	{"day-of-week", 0, 6},
+}
+
+var months = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var days = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+var macros = map[string]string{
+	"@yearly":   "0 0 1 1 *",
+	"@annually": "0 0 1 1 *",
+	"@monthly":  "0 0 1 * *",
+	"@weekly":   "0 0 * * 0",
+	"@daily":    "0 0 * * *",
+	"@midnight": "0 0 * * *",
+	"@hourly":   "0 * * * *",
+}
+
+// Schedule is a parsed cron expression.
+type Schedule struct {
+	expr       string
+	minute     map[int]bool
+	hour       map[int]bool
+	dayOfMonth map[int]bool
+	month      map[int]bool
+	dayOfWeek  map[int]bool
+	domStar    bool
+	dowStar    bool
+}
+
+func repr(s string) string { return "'" + s + "'" }
+
+// Parse parses expr with the same accepted syntax and errors as the
+// reference parse().
+func Parse(expr string) (*Schedule, error) {
+	original := expr
+	expr = strings.TrimSpace(expr)
+	if strings.HasPrefix(expr, "@") {
+		m, ok := macros[strings.ToLower(expr)]
+		if !ok {
+			return nil, fmt.Errorf("unknown macro %s", repr(expr))
+		}
+		expr = m
+	}
+	parts := strings.Fields(expr)
+	if len(parts) != 5 {
+		return nil, fmt.Errorf("expected 5 fields, got %d", len(parts))
+	}
+	s := &Schedule{expr: strings.TrimSpace(original)}
+	for i, p := range parts {
+		values, err := parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+		switch i {
+		case 0:
+			s.minute = values
+		case 1:
+			s.hour = values
+		case 2:
+			s.dayOfMonth = values
+			s.domStar = p == "*"
+		case 3:
+			s.month = values
+		case 4:
+			s.dayOfWeek = values
+			s.dowStar = p == "*"
+		}
+	}
+	return s, nil
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func value(tok string, idx int) (int, error) {
+	spec := fieldSpecs[idx]
+	t := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range months {
+			if t == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range days {
+			if t == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, fmt.Errorf("%s: invalid value %s", spec.name, repr(tok))
+	}
+	v, _ := strconv.Atoi(tok)
+	if idx == 4 && v == 7 {
+		v = 0
+	}
+	if v < spec.lo || v > spec.hi {
+		return 0, fmt.Errorf("%s: value %d out of range %d-%d", spec.name, v, spec.lo, spec.hi)
+	}
+	return v, nil
+}
+
+func parseField(text string, idx int) (map[int]bool, error) {
+	spec := fieldSpecs[idx]
+	if text == "" {
+		return nil, fmt.Errorf("%s: empty field", spec.name)
+	}
+	values := make(map[int]bool)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, fmt.Errorf("%s: empty item", spec.name)
+		}
+		step := 1
+		base := item
+		if i := strings.Index(item, "/"); i >= 0 {
+			s := item[i+1:]
+			if !isDigits(s) || atoi(s) < 1 {
+				return nil, fmt.Errorf("%s: invalid step %s", spec.name, repr(s))
+			}
+			step = atoi(s)
+			base = item[:i]
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = spec.lo, spec.hi
+		case strings.Contains(base, "-"):
+			a, b := base[:strings.Index(base, "-")], base[strings.Index(base, "-")+1:]
+			va, err := value(a, idx)
+			if err != nil {
+				return nil, err
+			}
+			vb, err := value(b, idx)
+			if err != nil {
+				return nil, err
+			}
+			start, end = va, vb
+			if start > end {
+				return nil, fmt.Errorf("%s: range %d-%d is reversed", spec.name, start, end)
+			}
+		default:
+			v, err := value(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			start = v
+			if strings.Contains(item, "/") {
+				end = spec.hi
+			} else {
+				end = v
+			}
+		}
+		for v := start; v <= end; v += step {
+			values[v] = true
+		}
+	}
+	return values, nil
+}
+
+func atoi(s string) int {
+	n := 0
+	for i := 0; i < len(s); i++ {
+		n = n*10 + int(s[i]-'0')
+	}
+	return n
+}
+
+func dayOK(s *Schedule, d time.Time) bool {
+	dow := int(d.Weekday())
+	inDom := s.dayOfMonth[d.Day()]
+	inDow := s.dayOfWeek[dow]
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first matching time strictly after after, in after's
+// location, with the same semantics (and errors) as the reference next_run().
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	y, mo, d := after.Date()
+	h, mi, _ := after.Clock()
+	t := time.Date(y, mo, d, h, mi, 0, 0, loc)
+	t = t.Add(time.Minute)
+	limit := after.AddDate(0, 0, 366*5)
+	for !t.After(limit) {
+		if !s.month[int(t.Month())] {
+			m := int(t.Month())
+			if m == 12 {
+				t = time.Date(t.Year()+1, 1, 1, 0, 0, 0, 0, loc)
+			} else {
+				t = time.Date(t.Year(), time.Month(m+1), 1, 0, 0, 0, 0, loc)
+			}
+			continue
+		}
+		if !dayOK(s, t) {
+			y, m, d := t.Date()
+			t = time.Date(y, m, d, 0, 0, 0, 0, loc).Add(24 * time.Hour)
+			continue
+		}
+		if !s.hour[t.Hour()] {
+			y, m, d := t.Date()
+			t = time.Date(y, m, d, t.Hour()+1, 0, 0, 0, loc)
+			continue
+		}
+		if !s.minute[t.Minute()] {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, fmt.Errorf("no match within 5 years for %s", repr(s.expr))
+}
+
+func fmtField(values map[int]bool, idx int) string {
+	spec := fieldSpecs[idx]
+	full := true
+	for v := spec.lo; v <= spec.hi; v++ {
+		if !values[v] {
+			full = false
+			break
+		}
+	}
+	if full {
+		return "*"
+	}
+	var vs []int
+	for v := range values {
+		vs = append(vs, v)
+	}
+	sortInts(vs)
+	var out []string
+	for i := 0; i < len(vs); {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, strconv.Itoa(vs[i]))
+		} else {
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		if 0 < j-i && j-i < 2 {
+			for k := i + 1; k <= j; k++ {
+				out = append(out, strconv.Itoa(vs[k]))
+			}
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+func sortInts(v []int) {
+	for i := 1; i < len(v); i++ {
+		for j := i; j > 0 && v[j] < v[j-1]; j-- {
+			v[j], v[j-1] = v[j-1], v[j]
+		}
+	}
+}
+
+// String renders the schedule with the same syntax as the reference
+// describe().
+func (s *Schedule) String() string {
+	return fmtField(s.minute, 0) + " " +
+		fmtField(s.hour, 1) + " " +
+		fmtField(s.dayOfMonth, 2) + " " +
+		fmtField(s.month, 3) + " " +
+		fmtField(s.dayOfWeek, 4)
+}
