 func env(m map[string]string) func(string) string { return func(k string) string { return m[k] } }
 
+func (c Config) isEmpty() bool {
+	return c.Host == "" && c.Port == 0 && !c.Debug && c.Workers == 0 && c.Timeout == 0 && c.Tags == nil
+}
+
+func (c Config) equals(o Config) bool {
+	if c.Host != o.Host || c.Port != o.Port || c.Debug != o.Debug || c.Workers != o.Workers || c.Timeout != o.Timeout {
+		return false
+	}
+	if len(c.Tags) != len(o.Tags) {
+		return false
+	}
+	for i := range c.Tags {
+		if c.Tags[i] != o.Tags[i] {
+			return false
+		}
+	}
+	return true
+}
+
