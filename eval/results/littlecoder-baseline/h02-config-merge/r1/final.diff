+func TestMerge(t *testing.T) {
+	base := Config{Host: "localhost", Port: 8080, Debug: false, Workers: 4, Timeout: 30 * time.Second, Tags: []string{"base"}}
+	override := Config{Host: "prod", Port: 0, Debug: true, Workers: 8, Timeout: 5 * time.Minute, Tags: []string{"a", "b"}}
+	overrideTags := override.Tags
+
+	m := Merge(base, override)
+	if m.Host != "prod" || m.Port != 8080 || !m.Debug || m.Workers != 8 || m.Timeout != 5*time.Minute {
+		t.Fatalf("m = %+v", m)
+	}
+	if len(m.Tags) != 2 || m.Tags[0] != "a" || m.Tags[1] != "b" {
+		t.Fatalf("Tags = %v", m.Tags)
+	}
+	// Result slice must be independent of the arguments.
+	m.Tags[0] = "mutated"
+	if overrideTags[0] != "a" {
+		t.Fatalf("override slice was mutated: %v", overrideTags)
+	}
+	// Arguments must be unchanged.
+	if base.Host != "localhost" || len(base.Tags) != 1 || base.Tags[0] != "base" {
+		t.Fatalf("base was mutated: %+v", base)
+	}
+	if override.Host != "prod" || len(overrideTags) != 2 || overrideTags[1] != "b" {
+		t.Fatalf("override was mutated: %+v %v", override, overrideTags)
+	}
+}
