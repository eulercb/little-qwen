+
+// firstFailure records the failed result with the lowest index.
+type firstFailure struct {
+	mu sync.Mutex
+	e  error
+}
+
+// record remembers a failure, keeping the one with the lowest index.
+func (f *firstFailure) record(i int, err error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.e == nil {
+		f.e = &IndexError{Index: i, Err: err}
+		return
+	}
+	if prev, ok := f.e.(*IndexError); ok && i < prev.Index {
+		f.e = &IndexError{Index: i, Err: err}
+	}
+}
+
+// take returns the recorded error (nil if none) and forgets it.
+func (f *firstFailure) take() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	e := f.e
+	f.e = nil
+	return e
+}
