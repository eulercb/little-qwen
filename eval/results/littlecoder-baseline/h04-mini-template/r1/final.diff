+package tmpl
+
+import "testing"
+
+func mustRender(t *testing.T, src string, data map[string]any) string {
+	t.Helper()
+	got, err := Render(src, data)
+	if err != nil {
+		t.Fatalf("Render(%q) error: %v", src, err)
+	}
+	return got
+}
+
+func mustErr(t *testing.T, src string, data map[string]any, substr string) {
+	t.Helper()
+	got, err := Render(src, data)
+	if err == nil {
+		t.Fatalf("Render(%q) = %q, want error containing %q", src, got, substr)
+	}
+	if got != "" {
+		t.Fatalf("Render(%q) output = %q, want empty", src, got)
+	}
+	if substr != "" && !contains(err.Error(), substr) {
+		t.Fatalf("Render(%q) error = %q, want containing %q", src, err, substr)
+	}
+}
+
+func contains(s, sub string) bool {
+	return len(sub) == 0 || len(s) >= len(sub) && (func() bool {
+		for i := 0; i+len(sub) <= len(s); i++ {
+			if s[i:i+len(sub)] == sub {
+				return true
+			}
+		}
+		return false
+	})()
+}
+
+func TestVerbatimText(t *testing.T) {
+	got := mustRender(t, "hello world", nil)
+	if got != "hello world" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestLiteralBraces(t *testing.T) {
+	got := mustRender(t, "a{{{{b {{{{c {{x}} d", map[string]any{"x": "X"})
+	if got != "a{{b {{c X d" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestValues(t *testing.T) {
+	data := map[string]any{
+		"s": "str", "i": 42, "i64": int64(7), "f": 1.5,
+		"b": true, "bf": false, "n": nil,
+	}
+	cases := map[string]string{
+		"{{s}}": "str", "{{i}}": "42", "{{i64}}": "7", "{{f}}": "1.5",
+		"{{b}}": "true", "{{bf}}": "false", "{{n}}": "", "{{missing}}": "",
+	}
+	for src, want := range cases {
+		if got := mustRender(t, src, data); got != want {
+			t.Errorf("%q: got %q, want %q", src, got, want)
+		}
+	}
+}
+
+func TestNestedName(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"name": "alice",
+			"info": map[string]any{"age": 30},
+		},
+		"empty": map[string]any{},
+	}
+	cases := map[string]string{
+		"{{user.name}}":     "alice",
+		"{{user.info.age}}": "30",
+		"{{user.missing}}":  "",
+		"{{empty.x}}":       "",
+	}
+	for src, want := range cases {
+		if got := mustRender(t, src, data); got != want {
+			t.Errorf("%q: got %q, want %q", src, got, want)
+		}
+	}
+}
+
+func TestWhitespaceInTag(t *testing.T) {
+	data := map[string]any{"name": "  Bob  "}
+	got := mustRender(t, "{{ name | trim | upper }}", data)
+	if got != "BOB" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestFilters(t *testing.T) {
+	data := map[string]any{
+		"s":     "  hello  ",
+		"empty": "",
+		"long":  "abcdefghij",
+		"uni":   "héllo wörld",
+		"tag":   `<a href="x">&</a> 'ok'`,
+	}
+	cases := map[string]string{
+		"{{s | upper}}":                      "  HELLO  ",
+		"{{s | lower}}":                      "  hello  ",
+		"{{s | trim}}":                       "hello",
+		`{{empty | default:"n/a"}}`:          "n/a",
+		`{{s | default:"n/a"}}`:              "  hello  ",
+		`{{s | trim | upper | default:"z"}}`: "HELLO",
+		`{{long | truncate:"4"}}`:            "abcd…",
+		`{{long | truncate:"10"}}`:           "abcdefghij",
+		`{{long | truncate:"0"}}`:            "…",
+		`{{s | trim | truncate:"3"}}`:        "hel…",
+		`{{uni | truncate:"5"}}`:             "héllo…",
+		`{{tag | html}}`:                     "&lt;a href=&#34;x&#34;&gt;&amp;&lt;/a&gt; &#39;ok&#39;",
+		`{{empty | default:"a\"b"}}`:         "a\"b",
+		`{{empty | default:"a\\b"}}`:         `a\b`,
+	}
+	for src, want := range cases {
+		if got := mustRender(t, src, data); got != want {
+			t.Errorf("%q: got %q, want %q", src, got, want)
+		}
+	}
+}
+
+func TestPipeInArgument(t *testing.T) {
+	data := map[string]any{"x": ""}
+	got := mustRender(t, `{{x | default:"a|b"}}`, data)
+	if got != "a|b" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestMultipleTags(t *testing.T) {
+	data := map[string]any{"a": 1, "b": "two", "c": 3.0}
+	got := mustRender(t, "[{{a}}|{{b}}|{{c}}]", data)
+	if got != "[1|two|3]" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	data := map[string]any{
+		"name": "bob",
+		"user": map[string]any{"name": "alice"},
+		"str":  "hi",
+	}
+	cases := []struct {
+		src    string
+		substr string
+	}{
+		{`{{name | bogus}}`, "bogus"},
+		{`{{user.name | bogus:"x"}}`, "bogus"},
+		{`{{name | default}}`, "default"},
+		{`{{name | truncate}}`, "truncate"},
+		{`{{name | upper:"x"}}`, "upper"},
+		{`{{name | lower:"x"}}`, "lower"},
+		{`{{name | trim:"x"}}`, "trim"},
+		{`{{str | html:"x"}}`, "html"},
+		{`{{name | truncate:"abc"}}`, "truncate"},
+		{`{{name | truncate:"-1"}}`, "truncate"},
+	}
+	for _, tc := range cases {
+		mustErr(t, tc.src, data, tc.substr)
+	}
+}
+
+func TestUnterminatedTag(t *testing.T) {
+	mustErr(t, "a {{ name", map[string]any{"name": "x"}, "unterminated")
+	mustErr(t, "{{ name", nil, "unterminated")
+}
+
+func TestEmptyTag(t *testing.T) {
+	mustErr(t, "{{ }}", nil, "empty")
+	mustErr(t, "{{   }}", nil, "empty")
+}
+
+func TestBadName(t *testing.T) {
+	mustErr(t, `{{1abc}}`, nil, "")
+	mustErr(t, `{{-x}}`, nil, "")
+	mustErr(t, `{{a..b}}`, nil, "")
+	mustErr(t, `{{a b}}`, nil, "")
+	mustErr(t, `{{a.b!}}`, nil, "")
+}
+
+func TestIndexIntoNonMap(t *testing.T) {
+	mustErr(t, `{{user.name.first}}`, map[string]any{
+		"user": map[string]any{"name": "alice"},
+	}, "user.name.first")
+	mustErr(t, `{{name.x}}`, map[string]any{"name": "bob"}, "name.x")
+}
