+// Package tmpl is a tiny text template engine.
+package tmpl
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Render expands the template src with values from data.
+func Render(src string, data map[string]any) (string, error) {
+	var out strings.Builder
+	i := 0
+	for i < len(src) {
+		if strings.HasPrefix(src[i:], "{{{{") {
+			out.WriteString("{{")
+			i += 4
+			continue
+		}
+		if strings.HasPrefix(src[i:], "{{") {
+			rest := src[i+2:]
+			end := strings.Index(rest, "}}")
+			if end < 0 {
+				return "", fmt.Errorf("tmpl: unterminated tag starting at %q", src[i:])
+			}
+			i += 2 + end + 2
+			s, err := renderTag(rest[:end], data)
+			if err != nil {
+				return "", err
+			}
+			out.WriteString(s)
+			continue
+		}
+		out.WriteByte(src[i])
+		i++
+	}
+	return out.String(), nil
+}
+
+// splitPipes splits s on '|' characters that are outside double-quoted strings.
+func splitPipes(s string) []string {
+	var parts []string
+	var cur strings.Builder
+	inQuote := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case inQuote && c == '\\':
+			cur.WriteByte(c)
+			if i+1 < len(s) {
+				i++
+				cur.WriteByte(s[i])
+			}
+		case c == '"':
+			inQuote = !inQuote
+			cur.WriteByte(c)
+		case c == '|' && !inQuote:
+			parts = append(parts, cur.String())
+			cur.Reset()
+		default:
+			cur.WriteByte(c)
+		}
+	}
+	parts = append(parts, cur.String())
+	return parts
+}
+
+func renderTag(body string, data map[string]any) (string, error) {
+	parts := splitPipes(body)
+	nameStr := strings.TrimSpace(parts[0])
+	if nameStr == "" {
+		return "", fmt.Errorf("tmpl: empty tag")
+	}
+	name, err := parseName(nameStr)
+	if err != nil {
+		return "", err
+	}
+	val, err := resolveName(name, data)
+	if err != nil {
+		return "", err
+	}
+	s := format(val)
+	for _, p := range parts[1:] {
+		fn, arg, hasArg, err := parseFilter(p)
+		if err != nil {
+			return "", err
+		}
+		s, err = applyFilter(fn, arg, hasArg, s)
+		if err != nil {
+			return "", err
+		}
+	}
+	return s, nil
+}
+
+func isLetter(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdentChar(c byte) bool {
+	return isLetter(c) || (c >= '0' && c <= '9') || c == '_'
+}
+
+// parseName validates an identifier optionally followed by .field segments.
+func parseName(s string) (string, error) {
+	if s == "" {
+		return "", fmt.Errorf("tmpl: bad name")
+	}
+	var b strings.Builder
+	i := 0
+	readIdent := func() bool {
+		if i < len(s) && s[i] == '_' {
+			start := i
+			i++
+			for i < len(s) && isIdentChar(s[i]) {
+				i++
+			}
+			b.WriteString(s[start:i])
+			return true
+		}
+		if i < len(s) && isLetter(s[i]) {
+			start := i
+			for i < len(s) && isIdentChar(s[i]) {
+				i++
+			}
+			b.WriteString(s[start:i])
+			return true
+		}
+		return false
+	}
+	if !readIdent() {
+		return "", fmt.Errorf("tmpl: bad name %q", s)
+	}
+	for strings.HasPrefix(s[i:], ".") {
+		i++
+		b.WriteByte('.')
+		if !readIdent() {
+			return "", fmt.Errorf("tmpl: bad name %q", s)
+		}
+	}
+	if i != len(s) {
+		return "", fmt.Errorf("tmpl: bad name %q", s)
+	}
+	return b.String(), nil
+}
+
+// resolveName looks up a possibly dotted name in data.
+func resolveName(name string, data map[string]any) (any, error) {
+	segments := strings.Split(name, ".")
+	v, ok := data[segments[0]]
+	if !ok {
+		return nil, nil
+	}
+	for _, seg := range segments[1:] {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("tmpl: cannot index %q: %s is not a map", name, seg)
+		}
+		v, ok = m[seg]
+		if !ok {
+			return nil, nil
+		}
+	}
+	return v, nil
+}
+
+func format(v any) string {
+	switch t := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return t
+	case bool:
+		return strconv.FormatBool(t)
+	case int:
+		return fmt.Sprint(t)
+	case int64:
+		return fmt.Sprint(t)
+	case float64:
+		return fmt.Sprint(t)
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// parseFilter parses a filter token of the form `name` or `name:"arg"`.
+func parseFilter(s string) (name, arg string, hasArg bool, err error) {
+	s = strings.TrimSpace(s)
+	idx := strings.IndexByte(s, ':')
+	if idx < 0 {
+		name = strings.TrimSpace(s)
+		if !isValidFilterName(name) {
+			return "", "", false, fmt.Errorf("tmpl: unknown filter %q", name)
+		}
+		return name, "", false, nil
+	}
+	name = strings.TrimSpace(s[:idx])
+	if !isValidFilterName(name) {
+		return "", "", false, fmt.Errorf("tmpl: unknown filter %q", name)
+	}
+	arg, hasArg, err = parseQuoted(strings.TrimSpace(s[idx+1:]))
+	if err != nil {
+		return "", "", false, fmt.Errorf("tmpl: filter %q: %v", name, err)
+	}
+	return name, arg, hasArg, nil
+}
+
+func isValidFilterName(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !isIdentChar(s[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// parseQuoted parses a double-quoted string, supporting \" and \\ escapes.
+func parseQuoted(s string) (string, bool, error) {
+	if s == "" {
+		return "", false, nil
+	}
+	if !strings.HasPrefix(s, `"`) {
+		return "", false, fmt.Errorf("unterminated argument")
+	}
+	var b strings.Builder
+	for i := 1; i < len(s); i++ {
+		c := s[i]
+		if c == '\\' {
+			if i+1 >= len(s) {
+				return "", false, fmt.Errorf("unterminated argument")
+			}
+			b.WriteByte(s[i+1])
+			i++
+			continue
+		}
+		if c == '"' {
+			if i+1 != len(s) {
+				return "", false, fmt.Errorf("unexpected content after argument")
+			}
+			return b.String(), true, nil
+		}
+		b.WriteByte(c)
+	}
+	return "", false, fmt.Errorf("unterminated argument")
+}
+
+func applyFilter(name, arg string, hasArg bool, in string) (string, error) {
+	switch name {
+	case "upper":
+		if hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: extra argument", name)
+		}
+		return strings.ToUpper(in), nil
+	case "lower":
+		if hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: extra argument", name)
+		}
+		return strings.ToLower(in), nil
+	case "trim":
+		if hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: extra argument", name)
+		}
+		return strings.TrimSpace(in), nil
+	case "default":
+		if !hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: missing argument", name)
+		}
+		if in == "" {
+			return arg, nil
+		}
+		return in, nil
+	case "truncate":
+		if !hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: missing argument", name)
+		}
+		n, err := strconv.Atoi(arg)
+		if err != nil || n < 0 {
+			return "", fmt.Errorf("tmpl: filter %q: argument %q is not a non-negative integer", name, arg)
+		}
+		r := []rune(in)
+		if len(r) <= n {
+			return in, nil
+		}
+		return string(r[:n]) + "\u2026", nil
+	case "html":
+		if hasArg {
+			return "", fmt.Errorf("tmpl: filter %q: extra argument", name)
+		}
+		return htmlEscape(in), nil
+	default:
+		return "", fmt.Errorf("tmpl: unknown filter %q", name)
+	}
+}
+
+func htmlEscape(s string) string {
+	var b strings.Builder
+	for _, c := range s {
+		switch c {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&#34;")
+		case '\'':
+			b.WriteString("&#39;")
+		default:
+			b.WriteRune(c)
+		}
+	}
+	return b.String()
+}
