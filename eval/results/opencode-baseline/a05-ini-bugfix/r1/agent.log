+// inlineComment returns the index where an inline comment begins in an
+// unquoted value: the first ';' or '#' that is preceded by whitespace.
+func inlineComment(val string) int {
+	for i := 1; i < len(val); i++ {
+		if (val[i] == ';' || val[i] == '#') && unicode.IsSpace(rune(val[i-1])) {
+			return i
+		}
+	}
+	return -1
+}

