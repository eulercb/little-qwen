 		if len(val) >= 2 && val[0] == '"' && val[len(val)-1] == '"' {
-			val = strings.TrimSpace(val[1 : len(val)-1])
+			val = val[1 : len(val)-1]
+		} else if j := inlineComment(val); j >= 0 {
