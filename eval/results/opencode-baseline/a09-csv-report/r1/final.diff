+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+const exampleInput = "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+
+func mustRun(t *testing.T, args []string, input string) (string, error) {
+	t.Helper()
+	var buf bytes.Buffer
+	err := run(args, strings.NewReader(input), &buf)
+	return buf.String(), err
+}
+
+func expectOutput(t *testing.T, got string, err error, want string) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got != want {
+		t.Fatalf("output mismatch:\ngot:  %q\nwant: %q", got, want)
+	}
+}
+
+func expectErrorContaining(t *testing.T, err error, substr string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected error containing %q, got nil", substr)
+	}
+	if !strings.Contains(err.Error(), substr) {
+		t.Fatalf("expected error containing %q, got %q", substr, err)
+	}
+}
+
+func TestRunExampleByRegion(t *testing.T) {
+	out, err := mustRun(t, []string{"--by", "region"}, exampleInput)
+	expectOutput(t, out, err, "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n")
+}
+
+func TestRunDefaultIsByRegion(t *testing.T) {
+	out, err := mustRun(t, nil, exampleInput)
+	expectOutput(t, out, err, "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n")
+}
+
+func TestRunByProduct(t *testing.T) {
+	out, err := mustRun(t, []string{"--by", "product"}, exampleInput)
+	expectOutput(t, out, err, "apple\t3\t3.30\npear\t1\t2.00\nTOTAL\t4\t5.30\n")
+}
+
+func TestShuffledAndExtraColumns(t *testing.T) {
+	input := "price,qty,notes,region,product\n1.10,3,hi,north,apple\n2.00,1,lo,south,pear\n"
+	out, err := mustRun(t, []string{"--by", "region"}, input)
+	expectOutput(t, out, err, "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n")
+}
+
+func TestMissingPriceColumn(t *testing.T) {
+	_, err := mustRun(t, nil, "region,product,qty\nnorth,apple,3\n")
+	expectErrorContaining(t, err, "price")
+}
+
+func TestMissingRegionColumn(t *testing.T) {
+	_, err := mustRun(t, []string{"--by", "region"}, "product,qty,price\napple,3,1.10\n")
+	expectErrorContaining(t, err, "region")
+}
+
+func TestMissingQtyColumn(t *testing.T) {
+	_, err := mustRun(t, nil, "region,product,price\nnorth,apple,1.10\n")
+	expectErrorContaining(t, err, "qty")
+}
+
+func TestBadQtyMentionsLine(t *testing.T) {
+	input := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,abc,2.00\n"
+	_, err := mustRun(t, nil, input)
+	expectErrorContaining(t, err, "line 3")
+}
+
+func TestNegativeQtyMentionsLine(t *testing.T) {
+	_, err := mustRun(t, nil, "region,product,qty,price\nnorth,apple,-1,1.10\n")
+	expectErrorContaining(t, err, "line 2")
+}
+
+func TestBadPriceMentionsLine(t *testing.T) {
+	input := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.0\nwest,kiwi,2,1.234\n"
+	_, err := mustRun(t, nil, input)
+	expectErrorContaining(t, err, "line 4")
+}
+
+func TestShortRowIsBadPrice(t *testing.T) {
+	_, err := mustRun(t, nil, "region,product,qty,price\nnorth,apple,3\n")
+	expectErrorContaining(t, err, "line 2")
+}
+
+func TestOneDecimalPriceIsValid(t *testing.T) {
+	out, err := mustRun(t, nil, "region,product,qty,price\nnorth,apple,2,12.5\n")
+	expectOutput(t, out, err, "north\t2\t25.00\nTOTAL\t2\t25.00\n")
+}
+
+func TestAggregatesAcrossProducts(t *testing.T) {
+	input := "region,product,qty,price\nnorth,apple,1,1.00\nnorth,pear,2,1.00\nsouth,apple,5,0.10\n"
+	out, err := mustRun(t, []string{"--by", "region"}, input)
+	expectOutput(t, out, err, "north\t3\t3.00\nsouth\t5\t0.50\nTOTAL\t8\t3.50\n")
+}
+
+func TestSortedRevenueDescTiesByNameAsc(t *testing.T) {
+	input := "region,product,qty,price\nzeta,apple,1,1.00\nalpha,pear,2,0.50\nmid,kiwi,1,2.00\n"
+	out, err := mustRun(t, nil, input)
+	expectOutput(t, out, err, "mid\t1\t2.00\nalpha\t2\t1.00\nzeta\t1\t1.00\nTOTAL\t4\t4.00\n")
+}
+
+func TestTopLimitsGroupsButNotTotal(t *testing.T) {
+	input := "region,product,qty,price\na,x,1,3.00\nb,y,1,2.00\nc,z,1,1.00\n"
+	out, err := mustRun(t, []string{"--top", "2"}, input)
+	expectOutput(t, out, err, "a\t1\t3.00\nb\t1\t2.00\nTOTAL\t3\t6.00\n")
+}
+
+func TestTopLargerThanGroupCount(t *testing.T) {
+	input := "region,product,qty,price\na,x,1,3.00\nb,y,1,2.00\n"
+	out, err := mustRun(t, []string{"--top", "10"}, input)
+	expectOutput(t, out, err, "a\t1\t3.00\nb\t1\t2.00\nTOTAL\t2\t5.00\n")
+}
+
+func TestHeaderOnly(t *testing.T) {
+	out, err := mustRun(t, nil, "region,product,qty,price\n")
+	expectOutput(t, out, err, "TOTAL\t0\t0.00\n")
+}
+
+func TestZeroQtyIsValid(t *testing.T) {
+	out, err := mustRun(t, nil, "region,product,qty,price\nnorth,apple,0,1.10\nsouth,pear,1,2.00\n")
+	expectOutput(t, out, err, "south\t1\t2.00\nnorth\t0\t0.00\nTOTAL\t1\t2.00\n")
+}
+
+func TestNoFloatDrift(t *testing.T) {
+	var b strings.Builder
+	b.WriteString("region,product,qty,price\n")
+	for i := 0; i < 40; i++ {
+		b.WriteString("north,apple,1,0.01\n")
+	}
+	out, err := mustRun(t, nil, b.String())
+	expectOutput(t, out, err, "north\t40\t0.40\nTOTAL\t40\t0.40\n")
+}
+
+func TestBadTopValues(t *testing.T) {
+	for _, args := range [][]string{
+		{"--top", "0"},
+		{"--top", "-1"},
+		{"--top", "abc"},
+		{"--top"},
+	} {
+		_, err := mustRun(t, args, exampleInput)
+		if err == nil {
+			t.Fatalf("args %v: expected error, got nil", args)
+		}
+	}
+}
+
+func TestBadByValues(t *testing.T) {
+	for _, args := range [][]string{
+		{"--by", "area"},
+		{"--by", "REGION"},
+		{"--by"},
+		{"--bogus"},
+	} {
+		_, err := mustRun(t, args, exampleInput)
+		if err == nil {
+			t.Fatalf("args %v: expected error, got nil", args)
+		}
+	}
+}
