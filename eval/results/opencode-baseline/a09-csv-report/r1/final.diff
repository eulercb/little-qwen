+package main
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+var requiredColumns = []string{"region", "product", "qty", "price"}
+
+func run(args []string, in io.Reader, out io.Writer) error {
+	by, top, err := parseFlags(args)
+	if err != nil {
+		return err
+	}
+
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+
+	header, err := r.Read()
+	if err != nil {
+		return fmt.Errorf("reading header: %v", err)
+	}
+
+	colIdx := make(map[string]int, len(header))
+	for i, name := range header {
+		name = strings.TrimSpace(name)
+		if _, exists := colIdx[name]; !exists {
+			colIdx[name] = i
+		}
+	}
+	for _, col := range requiredColumns {
+		if _, ok := colIdx[col]; !ok {
+			return fmt.Errorf("missing required column %q", col)
+		}
+	}
+	byIdx, qtyIdx, priceIdx := colIdx[by], colIdx["qty"], colIdx["price"]
+
+	type agg struct {
+		qty   int64
+		cents int64
+	}
+
+	groups := make(map[string]*agg)
+	var totalQty, totalCents int64
+
+	for {
+		rec, err := r.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			if pe, ok := err.(*csv.ParseError); ok {
+				return fmt.Errorf("line %d: %v", pe.Line, pe.Err)
+			}
+			return fmt.Errorf("reading input: %v", err)
+		}
+
+		line, _ := r.FieldPos(0)
+
+		qtyRaw := ""
+		if qtyIdx < len(rec) {
+			qtyRaw = rec[qtyIdx]
+		}
+		qty, err := strconv.ParseInt(strings.TrimSpace(qtyRaw), 10, 64)
+		if err != nil || qty < 0 {
+			return fmt.Errorf("line %d: bad qty %q", line, qtyRaw)
+		}
+
+		priceRaw := ""
+		if priceIdx < len(rec) {
+			priceRaw = rec[priceIdx]
+		}
+		cents, err := parsePriceCents(priceRaw)
+		if err != nil {
+			return fmt.Errorf("line %d: bad price %q", line, priceRaw)
+		}
+
+		key := ""
+		if byIdx < len(rec) {
+			key = rec[byIdx]
+		}
+		g := groups[key]
+		if g == nil {
+			g = &agg{}
+			groups[key] = g
+		}
+		rev := cents * qty
+		g.qty += qty
+		g.cents += rev
+		totalQty += qty
+		totalCents += rev
+	}
+
+	names := make([]string, 0, len(groups))
+	for name := range groups {
+		names = append(names, name)
+	}
+	sort.Slice(names, func(i, j int) bool {
+		a, b := groups[names[i]], groups[names[j]]
+		if a.cents != b.cents {
+			return a.cents > b.cents
+		}
+		return names[i] < names[j]
+	})
+
+	if top > 0 && top < len(names) {
+		names = names[:top]
+	}
+
+	for _, name := range names {
+		g := groups[name]
+		fmt.Fprintf(out, "%s\t%d\t%s\n", name, g.qty, formatCents(g.cents))
+	}
+	fmt.Fprintf(out, "TOTAL\t%d\t%s\n", totalQty, formatCents(totalCents))
+	return nil
+}
+
+func parseFlags(args []string) (by string, top int, err error) {
+	by = "region"
+	for i := 0; i < len(args); i++ {
+		switch args[i] {
+		case "--by":
+			if i+1 >= len(args) {
+				return "", 0, errors.New(`--by requires a value ("region" or "product")`)
+			}
+			i++
+			v := strings.TrimSpace(args[i])
+			if v != "region" && v != "product" {
+				return "", 0, fmt.Errorf("invalid --by value %q (must be region or product)", args[i])
+			}
+			by = v
+		case "--top":
+			if i+1 >= len(args) {
+				return "", 0, errors.New("--top requires a value")
+			}
+			i++
+			n, perr := strconv.Atoi(args[i])
+			if perr != nil || n < 1 {
+				return "", 0, fmt.Errorf("invalid --top value %q (must be an integer >= 1)", args[i])
+			}
+			top = n
+		default:
+			return "", 0, fmt.Errorf("unknown argument %q", args[i])
+		}
+	}
+	return by, top, nil
+}
+
+func parsePriceCents(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, errors.New("empty price")
+	}
+	neg := false
+	if s[0] == '+' || s[0] == '-' {
+		neg = s[0] == '-'
+		s = s[1:]
+	}
+	intPart, fracPart := s, ""
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		if strings.IndexByte(s[i+1:], '.') >= 0 {
+			return 0, errors.New("more than one decimal point")
+		}
+		intPart, fracPart = s[:i], s[i+1:]
+	}
+	if intPart == "" && fracPart == "" {
+		return 0, errors.New("not a number")
+	}
+	if len(fracPart) > 2 {
+		return 0, errors.New("more than 2 decimal places")
+	}
+	var cents int64
+	if intPart != "" {
+		n, err := strconv.ParseInt(intPart, 10, 64)
+		if err != nil {
+			return 0, errors.New("not a number")
+		}
+		cents = n * 100
+	}
+	if fracPart != "" {
+		f := fracPart
+		if len(f) == 1 {
+			f += "0"
+		}
+		n, err := strconv.ParseInt(f, 10, 64)
+		if err != nil {
+			return 0, errors.New("not a number")
+		}
+		cents += n
+	}
+	if neg {
+		cents = -cents
+	}
+	return cents, nil
+}
+
+func formatCents(c int64) string {
+	sign := ""
+	if c < 0 {
+		sign = "-"
+		c = -c
+	}
+	return fmt.Sprintf("%s%d.%02d", sign, c/100, c%100)
+}
