+
+func TestLastPageComplete(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 3)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !reflect.DeepEqual(p.Items, []int{5}) {
+		t.Fatalf("page 3 = %v, want [5]", p.Items)
+	}
+	if p.HasNext || !p.HasPrev {
+		t.Fatalf("page 3 HasNext=%v HasPrev=%v, want false true", p.HasNext, p.HasPrev)
+	}
+}
+
+func TestLastItemOnNonMultipleLastPage(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4}, 3, 2)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !reflect.DeepEqual(p.Items, []int{4}) {
+		t.Fatalf("page 2 = %v, want [4]", p.Items)
+	}
+}
+
+func TestTotalPagesExactMultiple(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4}, 2, 1)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if p.TotalPages != 2 {
+		t.Fatalf("TotalPages = %d, want 2", p.TotalPages)
+	}
+}
+
+func TestExactMultipleLastPage(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4}, 2, 2)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if p.TotalPages != 2 || p.HasNext {
+		t.Fatalf("%+v: TotalPages = %d, HasNext = %v, want 2, false", p, p.TotalPages, p.HasNext)
+	}
+	if !reflect.DeepEqual(p.Items, []int{3, 4}) {
+		t.Fatalf("page 2 = %v, want [3 4]", p.Items)
+	}
+}
+
+func TestPastEndIsEmpty(t *testing.T) {
+	p, err := Get([]int{1, 2, 3, 4, 5}, 2, 4)
+	if err != nil {
+		t.Fatalf("past-end page must not error: %v", err)
+	}
+	if len(p.Items) != 0 {
+		t.Fatalf("past-end page = %v, want empty", p.Items)
+	}
+	if p.Number != 4 || p.TotalPages != 3 || !p.HasPrev || p.HasNext {
+		t.Fatalf("page = %+v, want Number=4 TotalPages=3 HasPrev=true HasNext=false", p)
+	}
+}
+
+func TestPastEndEmptyInput(t *testing.T) {
+	p, err := Get([]int{}, 2, 1)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(p.Items) != 0 || p.TotalPages != 0 || p.HasNext || p.HasPrev {
+		t.Fatalf("page = %+v, want empty page with TotalPages=0", p)
+	}
+}
+
+func TestFarPastEnd(t *testing.T) {
+	p, err := Get([]int{1, 2, 3}, 1, 1<<30)
+	if err != nil {
+		t.Fatalf("far past-end page must not error: %v", err)
+	}
+	if len(p.Items) != 0 || p.TotalPages != 3 || !p.HasPrev || p.HasNext {
+		t.Fatalf("page = %+v, want empty page with TotalPages=3", p)
+	}
+}
+
+func TestNoAlias(t *testing.T) {
+	items := []int{1, 2, 3, 4}
+	p, err := Get(items, 2, 1)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	p.Items[0] = 99
+	if items[0] != 1 {
+		t.Fatalf("returned Items aliases the input")
+	}
+}
+
+func TestErrors(t *testing.T) {
+	if _, err := Get([]int{1}, 0, 1); !errors.Is(err, ErrBadSize) {
+		t.Fatalf("err = %v, want ErrBadSize", err)
+	}
+	if _, err := Get([]int{1}, 1, 0); !errors.Is(err, ErrBadPage) {
+		t.Fatalf("err = %v, want ErrBadPage", err)
+	}
+}
+
+func TestAll(t *testing.T) {
+	got, err := All([]int{1, 2, 3, 4, 5}, 2)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := [][]int{{1, 2}, {3, 4}, {5}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("All = %v, want %v", got, want)
+	}
+}
