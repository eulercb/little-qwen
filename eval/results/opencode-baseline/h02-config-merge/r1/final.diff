 func env(m map[string]string) func(string) string { return func(k string) string { return m[k] } }
 
+// sameConfig compares two configs field by field, including the Tags slice.
+func sameConfig(a, b Config) bool {
+	if a.Host != b.Host || a.Port != b.Port || a.Debug != b.Debug || a.Workers != b.Workers || a.Timeout != b.Timeout {
+		return false
+	}
+	if len(a.Tags) != len(b.Tags) {
+		return false
+	}
+	for i := range a.Tags {
+		if a.Tags[i] != b.Tags[i] {
+			return false
+		}
+	}
+	return true
+}
+
 func TestLoadDefaults(t *testing.T) {
 	c, err := Load(env(nil))
-	if err != nil || c.Host != "localhost" || c.Port != 8080 || c.Workers != 4 {
-		t.Fatalf("%+v %v", c, err)
+	if err != nil {
+		t.Fatalf("err = %v", err)
+	}
+	if c.Host != "localhost" || c.Port != 8080 || c.Workers != 4 {
+		t.Fatalf("got %+v", c)
+	}
+	if c.Timeout != 30*time.Second {
+		t.Fatalf("Timeout = %v, want 30s", c.Timeout)
+	}
+	if c.Tags != nil {
+		t.Fatalf("Tags = %v, want nil", c.Tags)
 	}
 }
 
