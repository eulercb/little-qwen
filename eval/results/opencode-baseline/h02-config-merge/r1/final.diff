+	if m.Tags != nil {
+		t.Fatalf("Tags = %v, want nil", m.Tags)
+	}
+}
+
+func TestMergeDoesNotModifyInputs(t *testing.T) {
+	baseTags := []string{"x", "y"}
+	overrideTags := []string{"z"}
+	base := Config{Tags: baseTags}
+	override := Config{Host: "h", Tags: overrideTags}
+
+	m := Merge(base, override)
+
+	// Inputs must be untouched.
+	if len(baseTags) != 2 || baseTags[0] != "x" || baseTags[1] != "y" {
+		t.Fatalf("base tags mutated: %v", baseTags)
+	}
+	if len(overrideTags) != 1 || overrideTags[0] != "z" {
+		t.Fatalf("override tags mutated: %v", overrideTags)
+	}
+
+	// Result must alias neither input slice.
+	m.Tags[0] = "mutated"
+	if overrideTags[0] != "z" {
+		t.Fatalf("override tags aliased: %v", overrideTags)
+	}
+	if len(m.Tags) != 1 || m.Tags[0] != "mutated" {
+		t.Fatalf("result tags = %v", m.Tags)
 	}
 }
