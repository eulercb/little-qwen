+func TestMergeNilOverrideTagsKeepsBase(t *testing.T) {
+	base := Config{Tags: []string{"a", "b"}}
+	m := Merge(base, Config{})
+	if len(m.Tags) != 2 || m.Tags[0] != "a" || m.Tags[1] != "b" {
