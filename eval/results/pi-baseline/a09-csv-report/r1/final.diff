+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func runCSV(t *testing.T, args []string, in string) (string, error) {
+	t.Helper()
+	var out bytes.Buffer
+	err := run(args, strings.NewReader(in), &out)
+	return out.String(), err
+}
+
+func wantErrContains(t *testing.T, err error, subs ...string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected error containing %q, got nil", subs)
+	}
+	for _, s := range subs {
+		if !strings.Contains(err.Error(), s) {
+			t.Fatalf("error %q does not contain %q", err, s)
+		}
+	}
+}
+
+func TestExampleByRegion(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+	got, err := runCSV(t, []string{"--by", "region"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDefaultByIsRegion(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\n"
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestByProduct(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.00\nsouth,apple,2,1.10\n"
+	got, err := runCSV(t, []string{"--by", "product"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// apple: 5 @ 110c = 550c, pear: 1 @ 200c = 200c
+	want := "apple\t5\t5.50\npear\t1\t2.00\nTOTAL\t6\t7.50\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestByEqualsForm(t *testing.T) {
+	in := "region,product,qty,price\nnorth,apple,1,1.00\n"
+	got, err := runCSV(t, []string{"--by=product", "--top=1"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "apple\t1\t1.00\nTOTAL\t1\t1.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestSortingRevenueDescNameAsc(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"c,x,1,5.00\n" + // 500
+		"a,x,1,5.00\n" + // 500 (tie with c, a first)
+		"b,x,1,9.99\n" + // 999
+		"d,x,2,1.00\n"   // 200
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "b\t1\t9.99\na\t1\t5.00\nc\t1\t5.00\nd\t2\t2.00\nTOTAL\t5\t21.99\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTopLimitsGroupsButNotTotal(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"c,x,1,3.00\n" +
+		"a,x,1,5.00\n" +
+		"b,x,1,9.99\n"
+	got, err := runCSV(t, []string{"--top", "2"}, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "b\t1\t9.99\na\t1\t5.00\nTOTAL\t3\t17.99\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsAnyOrderWithExtras(t *testing.T) {
+	in := "price,date,qty,region,notes,product\n2.00,2024-01-01,1,south,hi,pear\n1.10,2024-01-02,3,north,lo,apple\n"
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "north\t3\t3.30\nsouth\t1\t2.00\nTOTAL\t4\t5.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestMissingColumns(t *testing.T) {
+	_, err := runCSV(t, nil, "region,product,qty\nnorth,apple,3\n")
+	wantErrContains(t, err, "price")
+
+	_, err = runCSV(t, nil, "region,qty,price\nnorth,3,1.10\n")
+	wantErrContains(t, err, "product")
+
+	_, err = runCSV(t, nil, "zone,product,qty,price\nnorth,apple,3,1.10\n")
+	wantErrContains(t, err, "region")
+}
+
+func TestBadQty(t *testing.T) {
+	_, err := runCSV(t, nil, "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,-1,2.00\n")
+	wantErrContains(t, err, "line 3", "qty")
+
+	_, err = runCSV(t, nil, "region,product,qty,price\nnorth,apple,1.5,1.10\n")
+	wantErrContains(t, err, "line 2", "qty")
+
+	_, err = runCSV(t, nil, "region,product,qty,price\nnorth,apple,,1.10\n")
+	wantErrContains(t, err, "line 2", "qty")
+
+	// Short row is also a bad qty, and the line number is still correct.
+	_, err = runCSV(t, nil, "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear\n")
+	wantErrContains(t, err, "line 3", "qty")
+}
+
+func TestBadPrice(t *testing.T) {
+	_, err := runCSV(t, nil, "region,product,qty,price\nnorth,apple,3,1.10\nsouth,pear,1,2.0\nwest,pear,1,2.345\n")
+	wantErrContains(t, err, "line 4", "price")
+
+	_, err = runCSV(t, nil, "region,product,qty,price\nnorth,apple,3,abc\n")
+	wantErrContains(t, err, "line 2", "price")
+}
+
+func TestPriceFormats(t *testing.T) {
+	in := "region,product,qty,price\n" +
+		"a,x,1,7\n" + // integer price
+		"b,x,1,.5\n" + // no leading digit
+		"c,x,2,0.05\n" // sub-cent-safe
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t1\t7.00\nb\t1\t0.50\nc\t2\t0.10\nTOTAL\t4\t7.60\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestRevenuePrecision(t *testing.T) {
+	// 0.10 * 3 must be exactly 0.30, not 0.30000000000000004
+	in := "region,product,qty,price\na,x,3,0.10\n"
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "a\t3\t0.30\nTOTAL\t3\t0.30\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestZeroQtyRows(t *testing.T) {
+	in := "region,product,qty,price\na,x,0,5.00\nb,x,1,2.00\n"
+	got, err := runCSV(t, nil, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// a still appears as a group with 0 revenue; 0.00 sorts after 2.00.
+	want := "b\t1\t2.00\na\t0\t0.00\nTOTAL\t1\t2.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestInvalidBy(t *testing.T) {
+	_, err := runCSV(t, []string{"--by", "zone"}, "region,product,qty,price\n")
+	wantErrContains(t, err, "zone")
+
+	_, err = runCSV(t, []string{"--by="}, "region,product,qty,price\n")
+	wantErrContains(t, err, "")
+	if err == nil {
+		t.Fatal("expected error for empty --by value")
+	}
+}
+
+func TestInvalidTop(t *testing.T) {
+	in := "region,product,qty,price\na,x,1,1.00\n"
+	_, err := runCSV(t, []string{"--top", "0"}, in)
+	wantErrContains(t, err, "--top")
+
+	_, err = runCSV(t, []string{"--top", "abc"}, in)
+	wantErrContains(t, err, "--top")
+
+	_, err = runCSV(t, []string{"--top", "-2"}, in)
+	wantErrContains(t, err, "--top")
+
+	_, err = runCSV(t, []string{"--top"}, in)
+	wantErrContains(t, err, "--top")
+}
+
+func TestUnknownFlag(t *testing.T) {
+	_, err := runCSV(t, []string{"--bogus"}, "region,product,qty,price\n")
+	wantErrContains(t, err, "--bogus")
+}
+
+func TestEmptyInput(t *testing.T) {
+	_, err := runCSV(t, nil, "")
+	if err == nil {
+		t.Fatal("expected error for empty input (missing columns)")
+	}
+}
+
+func TestNoDataRows(t *testing.T) {
+	got, err := runCSV(t, nil, "region,product,qty,price\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "TOTAL\t0\t0.00\n"
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
