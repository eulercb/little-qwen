+package main
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// groupAgg accumulates totals for one group.
+type groupAgg struct {
+	name  string
+	qty   int64
+	cents int64 // revenue in integer cents
+}
+
+// run parses flags from args, reads a sales CSV from in, and writes the
+// summary to out.
+func run(args []string, in io.Reader, out io.Writer) error {
+	by := "region"
+	top := 0
+
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case a == "--by":
+			if i+1 >= len(args) {
+				return errors.New("--by requires a value")
+			}
+			i++
+			by = args[i]
+		case strings.HasPrefix(a, "--by="):
+			by = a[len("--by="):]
+		case a == "--top":
+			if i+1 >= len(args) {
+				return errors.New("--top requires a value")
+			}
+			i++
+			n, err := strconv.Atoi(args[i])
+			if err != nil || n < 1 {
+				return fmt.Errorf("invalid --top value %q (must be an integer >= 1)", args[i])
+			}
+			top = n
+		case strings.HasPrefix(a, "--top="):
+			n, err := strconv.Atoi(a[len("--top="):])
+			if err != nil || n < 1 {
+				return fmt.Errorf("invalid --top value %q (must be an integer >= 1)", a[len("--top="):])
+			}
+			top = n
+		default:
+			return fmt.Errorf("unknown argument: %q", a)
+		}
+	}
+
+	if by != "region" && by != "product" {
+		return fmt.Errorf("invalid --by value %q (must be \"region\" or \"product\")", by)
+	}
+
+	required := []string{"region", "product", "qty", "price"}
+
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+
+	header, err := r.Read()
+	if err != nil && err != io.EOF {
+		return fmt.Errorf("reading header: %w", err)
+	}
+
+	col := make(map[string]int)
+	for i, h := range header {
+		if _, ok := col[strings.TrimSpace(h)]; !ok {
+			col[strings.TrimSpace(h)] = i
+		}
+	}
+	var missing []string
+	for _, name := range required {
+		if _, ok := col[name]; !ok {
+			missing = append(missing, name)
+		}
+	}
+	if len(missing) > 0 {
+		return fmt.Errorf("missing required column(s): %s", strings.Join(missing, ", "))
+	}
+
+	field := make([]int, len(required))
+	for i, name := range required {
+		field[i] = col[name]
+	}
+
+	groups := make(map[string]*groupAgg)
+	var totalQty int64
+	var totalCents int64
+
+	for {
+		rec, err := r.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return fmt.Errorf("reading CSV: %w", err)
+		}
+		line, _ := r.FieldPos(0) // 1-based line in the file (header is line 1)
+
+		get := func(idx int) string {
+			if idx >= len(rec) {
+				return ""
+			}
+			return strings.TrimSpace(rec[idx])
+		}
+
+		region := get(field[0])
+		product := get(field[1])
+
+		qtyStr := get(field[2])
+		qty, err := parseQty(qtyStr)
+		if err != nil {
+			return fmt.Errorf("line %d: bad qty %q: %v", line, qtyStr, err)
+		}
+
+		priceStr := get(field[3])
+		cents, err := parsePriceCents(priceStr)
+		if err != nil {
+			return fmt.Errorf("line %d: bad price %q: %v", line, priceStr, err)
+		}
+
+		key := region
+		if by == "product" {
+			key = product
+		}
+		g, ok := groups[key]
+		if !ok {
+			g = &groupAgg{name: key}
+			groups[key] = g
+		}
+		g.qty += qty
+		g.cents += cents * qty
+		totalQty += qty
+		totalCents += cents * qty
+	}
+
+	list := make([]*groupAgg, 0, len(groups))
+	for _, g := range groups {
+		list = append(list, g)
+	}
+	sort.Slice(list, func(i, j int) bool {
+		if list[i].cents != list[j].cents {
+			return list[i].cents > list[j].cents
+		}
+		return list[i].name < list[j].name
+	})
+
+	for i, g := range list {
+		if top != 0 && i >= top {
+			break
+		}
+		fmt.Fprintf(out, "%s\t%d\t%s\n", g.name, g.qty, formatCents(g.cents))
+	}
+	fmt.Fprintf(out, "TOTAL\t%d\t%s\n", totalQty, formatCents(totalCents))
+	return nil
+}
+
+// parseQty parses a non-negative integer quantity.
+func parseQty(s string) (int64, error) {
+	n, err := strconv.ParseInt(s, 10, 64)
+	if err != nil {
+		return 0, errors.New("must be an integer")
+	}
+	if n < 0 {
+		return 0, errors.New("must be >= 0")
+	}
+	return n, nil
+}
+
+// parsePriceCents parses a decimal price with at most 2 decimal places and
+// returns its value in integer cents.
+func parsePriceCents(s string) (int64, error) {
+	if s == "" {
+		return 0, errors.New("must not be empty")
+	}
+	neg := false
+	switch s[0] {
+	case '-':
+		neg = true
+		s = s[1:]
+	case '+':
+		s = s[1:]
+	}
+
+	intPart := s
+	fracPart := ""
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		intPart = s[:i]
+		fracPart = s[i+1:]
+		if len(fracPart) > 2 {
+			return 0, errors.New("must have at most 2 decimal places")
+		}
+	}
+	if intPart == "" && fracPart == "" {
+		return 0, errors.New("must be a decimal number")
+	}
+	if intPart == "" {
+		intPart = "0"
+	}
+	if !isDigits(intPart) || !isDigits(fracPart) {
+		return 0, errors.New("must be a decimal number")
+	}
+
+	intVal, err := strconv.ParseInt(intPart, 10, 64)
+	if err != nil {
+		return 0, errors.New("out of range")
+	}
+	var fracVal int64
+	switch len(fracPart) {
+	case 0:
+	case 1:
+		fracVal = int64(fracPart[0]-'0') * 10
+	case 2:
+		fracVal = int64(fracPart[0]-'0')*10 + int64(fracPart[1]-'0')
+	}
+
+	cents := intVal*100 + fracVal
+	if neg {
+		cents = -cents
+	}
+	return cents, nil
+}
+
+func isDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// formatCents formats integer cents with exactly 2 decimals.
+func formatCents(c int64) string {
+	neg := c < 0
+	if neg {
+		c = -c
+	}
+	s := fmt.Sprintf("%d.%02d", c/100, c%100)
+	if neg {
+		s = "-" + s
+	}
+	return s
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout); err != nil {
+		fmt.Fprintln(os.Stderr, "report:", err)
+		os.Exit(1)
+	}
+}
