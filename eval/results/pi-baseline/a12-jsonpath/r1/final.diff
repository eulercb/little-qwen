+package jpath
+
+import (
+	"reflect"
+	"testing"
+)
+
+var testDoc = map[string]any{
+	"a": map[string]any{"b": []any{1.0, 2.0, 3.0}},
+	"c": []any{map[string]any{"d": 10.0}, map[string]any{"d": 20.0, "e": "x"}},
+	"z": "top",
+}
+
+func check(t *testing.T, path string, want []any) {
+	t.Helper()
+	got, err := Query(testDoc, path)
+	if err != nil {
+		t.Fatalf("Query(%q) error: %v", path, err)
+	}
+	if got == nil {
+		t.Fatalf("Query(%q) = nil, want %v", path, want)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Query(%q) = %v, want %v", path, got, want)
+	}
+}
+
+func checkEmpty(t *testing.T, path string) {
+	t.Helper()
+	got, err := Query(testDoc, path)
+	if err != nil {
+		t.Fatalf("Query(%q) error: %v", path, err)
+	}
+	if got == nil {
+		t.Fatalf("Query(%q) = nil, want empty non-nil", path)
+	}
+	if len(got) != 0 {
+		t.Fatalf("Query(%q) = %v, want empty", path, got)
+	}
+}
+
+func checkErr(t *testing.T, path string) {
+	t.Helper()
+	got, err := Query(testDoc, path)
+	if err == nil {
+		t.Fatalf("Query(%q) = %v, want error", path, got)
+	}
+	if got != nil {
+		t.Fatalf("Query(%q) = %v, want nil on error", path, got)
+	}
+}
+
+func TestRoot(t *testing.T) {
+	got, err := Query(testDoc, "$")
+	if err != nil || !reflect.DeepEqual(got, []any{testDoc}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestMemberAndIndex(t *testing.T) {
+	check(t, "$.a.b", []any{[]any{1.0, 2.0, 3.0}})
+	check(t, "$.a.b[0]", []any{1.0})
+	check(t, "$.a.b[-1]", []any{3.0})
+	check(t, "$.a.b[-3]", []any{1.0})
+	checkEmpty(t, "$.a.b[3]")
+	checkEmpty(t, "$.a.b[-4]")
+	checkEmpty(t, "$.missing")
+	checkEmpty(t, "$.z[0]") // index on non-array
+}
+
+func TestStar(t *testing.T) {
+	check(t, "$.*", []any{testDoc["a"], testDoc["c"], testDoc["z"]})
+	check(t, "$.a.*", []any{testDoc["a"].(map[string]any)["b"]})
+	checkEmpty(t, "$[0]") // index on non-array
+	check(t, "$.c[*]", []any{testDoc["c"].([]any)[0], testDoc["c"].([]any)[1]})
+	check(t, "$.c[*].d", []any{10.0, 20.0})
+	check(t, "$.c[*].e", []any{"x"}) // missing on first element contributes nothing
+	check(t, "$.a[*]", []any{[]any{1.0, 2.0, 3.0}})
+	checkEmpty(t, "$.z[*]") // star on scalar
+	check(t, "$.a.b[*]", []any{1.0, 2.0, 3.0})
+}
+
+func TestBracketKeys(t *testing.T) {
+	check(t, `$["a"].b`, []any{[]any{1.0, 2.0, 3.0}})
+	check(t, `$["z"]`, []any{"top"})
+}
+
+func TestEscapes(t *testing.T) {
+	d := map[string]any{`a"b`: 1.0, `a\b`: 2.0}
+	got, err := Query(d, `$["a\"b"]`)
+	if err != nil || !reflect.DeepEqual(got, []any{1.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+	got, err = Query(d, `$["a\\b"]`)
+	if err != nil || !reflect.DeepEqual(got, []any{2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestRecursive(t *testing.T) {
+	check(t, "$..d", []any{10.0, 20.0})
+	check(t, "$..z", []any{"top"})
+	check(t, "$..b", []any{[]any{1.0, 2.0, 3.0}})
+	checkEmpty(t, "$..nope")
+	// pre-order: node's own match before children's matches
+	d := map[string]any{"x": 1.0, "m": map[string]any{"x": 2.0}}
+	got, err := Query(d, "$..x")
+	if err != nil || !reflect.DeepEqual(got, []any{1.0, 2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestMultiStep(t *testing.T) {
+	got, err := Query(testDoc, `$.a.b[1]`)
+	if err != nil || !reflect.DeepEqual(got, []any{2.0}) {
+		t.Fatalf("%v %v", got, err)
+	}
+}
+
+func TestMalformed(t *testing.T) {
+	for _, p := range []string{
+		"", "a.b", "$.", "$[", "$[1", `$["x]`, "$.1abc", "$[abc]",
+		"$..", "$..1abc", "$[", "$[x]", "$[+1]", "$[1.5]", "$..$",
+	} {
+		checkErr(t, p)
+	}
+}
