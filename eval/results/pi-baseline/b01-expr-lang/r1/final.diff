diff --git a/expr/api.go b/expr/api.go
new file mode 100644
index 0000000..6005ad7
--- /dev/null
+++ b/expr/api.go
@@ -0,0 +1,58 @@
+package expr
+
+import "math"
+
+// Program is a compiled expression, ready to be evaluated many times.
+type Program struct {
+	root node
+	vars []string
+}
+
+// Compile parses src and validates its function calls. It returns *Error
+// for lexical and syntax errors.
+func Compile(src string) (*Program, error) {
+	toks, err := lex(src)
+	if err != nil {
+		return nil, err
+	}
+	p := &parser{toks: toks, src: src}
+	root, err := p.parse()
+	if err != nil {
+		return nil, err
+	}
+	vars, err := validate(root)
+	if err != nil {
+		return nil, err
+	}
+	return &Program{root: root, vars: vars}, nil
+}
+
+// Eval evaluates the program against vars. It returns *Error for runtime
+// errors (unknown variable, division by zero, non-finite result).
+func (p *Program) Eval(vars map[string]float64) (float64, error) {
+	v, err := eval(p.root, vars)
+	if err != nil {
+		return 0, err
+	}
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return 0, &Error{Pos: 0, Msg: "result is not finite"}
+	}
+	return v, nil
+}
+
+// Vars returns the sorted, de-duplicated names of variables referenced by
+// the program. Function names are not variables.
+func (p *Program) Vars() []string {
+	out := make([]string, len(p.vars))
+	copy(out, p.vars)
+	return out
+}
+
+// Eval compiles src and evaluates it against vars in one step.
+func Eval(src string, vars map[string]float64) (float64, error) {
+	p, err := Compile(src)
+	if err != nil {
+		return 0, err
+	}
+	return p.Eval(vars)
+}
