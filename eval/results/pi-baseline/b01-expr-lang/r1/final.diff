@@ -0,0 +1,97 @@
+package expr
+
+import (
+	"testing"
+)
+
+func TestProgramReuse(t *testing.T) {
+	p, err := Compile("x * 2 + 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		x    float64
+		want float64
+	}{
+		{0, 1},
+		{1, 3},
+		{-2, -3},
+	} {
+		got, err := p.Eval(map[string]float64{"x": tc.x})
+		if err != nil {
+			t.Fatalf("x=%v: %v", tc.x, err)
+		}
+		if got != tc.want {
+			t.Errorf("x=%v: got %v, want %v", tc.x, got, tc.want)
+		}
+	}
+}
+
+func TestVars(t *testing.T) {
+	cases := []struct {
+		src  string
+		want []string
+	}{
+		{"1 + 2", []string{}},
+		{"x", []string{"x"}},
+		{"x + x * x", []string{"x"}},
+		{"b + a * b", []string{"a", "b"}},
+		{"z1 + a_b + zz", []string{"a_b", "z1", "zz"}},
+		// function names are not variables; a bare builtin name is
+		// a variable reference
+		{"abs(1)", []string{}},
+		{"abs(1) + abs", []string{"abs"}},
+		{"min(x, y) * 2", []string{"x", "y"}},
+		// variables inside short-circuited / unchosen branches still count
+		{"c ? a : b", []string{"a", "b", "c"}},
+		{"!f", []string{"f"}},
+		{"x ^ -y", []string{"x", "y"}},
+		{"(x)", []string{"x"}},
+		{"x || y && z", []string{"x", "y", "z"}},
+	}
+	for _, c := range cases {
+		p, err := Compile(c.src)
+		if err != nil {
+			t.Fatalf("%q: %v", c.src, err)
+		}
+		got := p.Vars()
+		if len(got) != len(c.want) {
+			t.Errorf("%q: Vars() = %v, want %v", c.src, got, c.want)
+			continue
+		}
+		for i := range got {
+			if got[i] != c.want[i] {
+				t.Errorf("%q: Vars() = %v, want %v", c.src, got, c.want)
+				break
+			}
+		}
+	}
+}
+
+func TestVarsCopy(t *testing.T) {
+	p, err := Compile("x + y")
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := p.Vars()
+	v[0] = "mutated"
+	if got := p.Vars(); got[0] != "x" {
+		t.Errorf("Vars() returned internal slice: %v", got)
+	}
+}
+
+func TestEvalAPI(t *testing.T) {
+	got, err := Eval("2 + 2", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != 4 {
+		t.Fatalf("Eval(2+2) = %v, want 4", got)
+	}
+	// Compile errors propagate from Eval.
+	_, err = Eval("1 +", nil)
+	checkError(t, err, 3, "unexpected end of input")
+	// Runtime errors propagate from Eval.
+	_, err = Eval("1 / 0", nil)
+	checkError(t, err, 2, "division by zero")
+}
diff --git a/expr/ast.go b/expr/ast.go
new file mode 100644
index 0000000..547d85c
--- /dev/null
+++ b/expr/ast.go
@@ -0,0 +1,52 @@
+package expr
+
+// node is an abstract syntax tree node. Every node records the 0-based byte
+// offset in the source at which it begins, for error reporting.
+type node interface {
+	at() int
+}
+
+type numNode struct {
+	pos int
+	val float64
+}
+
+func (n *numNode) at() int { return n.pos }
+
+type varNode struct {
+	pos  int
+	name string
+}
+
+func (n *varNode) at() int { return n.pos }
+
+type unaryNode struct {
+	pos int
+	op  string // "-", "+", "!"
+	x   node
+}
+
+func (n *unaryNode) at() int { return n.pos }
+
+type binaryNode struct {
+	pos  int
+	op   string
+	l, r node
+}
+
+func (n *binaryNode) at() int { return n.pos }
+
+type ternaryNode struct {
+	pos     int
+	c, a, b node
+}
+
+func (n *ternaryNode) at() int { return n.pos }
+
+type callNode struct {
+	pos  int
+	name string
+	args []node
+}
+
+func (n *callNode) at() int { return n.pos }
