@@ -0,0 +1,128 @@
+package cli
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAddTagDueList(t *testing.T) {
+	h := newHarness(t) // now = 2026-03-10 12:00 UTC
+	if _, errb, code := h.run("add", "--tag", "HOME", "--tag", "home", "--due", "2026-04-15", "file", "taxes"); code != 0 || errb != "" {
+		t.Fatalf("code %d err %q", code, errb)
+	}
+	out, _, code := h.run("list")
+	if code != 0 || out != "#1 [ ] P3 file taxes (due 2026-04-15) [home]\n" {
+		t.Fatalf("code %d out %q", code, out)
+	}
+}
+
+func TestAddUsageErrors(t *testing.T) {
+	h := newHarness(t)
+	if _, _, code := h.run("add", "--due", "15-04-2026", "x"); code != 2 {
+		t.Fatal("bad date should be a usage error")
+	}
+	if _, _, code := h.run("add", "--tag", "Bad Tag", "x"); code != 2 {
+		t.Fatal("bad tag should be a usage error")
+	}
+	if _, _, code := h.run("add", "--tag", "-x", "y"); code != 2 {
+		t.Fatal("tag starting with dash should be a usage error")
+	}
+}
+
+func TestEditTagsDue(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "work", "--due", "2026-01-01", "thing")
+	h.run("edit", "1", "--tag", "home", "--untag", "WORK")
+	out, _, code := h.run("list")
+	if code != 0 || out != "#1 [ ] P3 thing (due 2026-01-01) [home]\n" {
+		t.Fatalf("code %d out %q", code, out)
+	}
+	// Untagging a tag that is not present is fine.
+	if _, errb, code := h.run("edit", "1", "--untag", "nope"); code != 0 || errb != "" {
+		t.Fatalf("code %d err %q", code, errb)
+	}
+	// Clearing the due date.
+	h.run("edit", "1", "--due", "none")
+	out, _, _ = h.run("list")
+	if out != "#1 [ ] P3 thing [home]\n" {
+		t.Fatalf("out %q", out)
+	}
+	// Invalid due on edit is a usage error.
+	if _, _, code := h.run("edit", "1", "--due", "soon"); code != 2 {
+		t.Fatal("bad due on edit should be a usage error")
+	}
+	// Invalid new tag on edit is a usage error.
+	if _, _, code := h.run("edit", "1", "--tag", "bad tag"); code != 2 {
+		t.Fatal("bad tag on edit should be a usage error")
+	}
+}
+
+func TestListFilters(t *testing.T) {
+	h := newHarness(t)                                                           // now = 2026-03-10 12:00 UTC
+	h.run("add", "--tag", "home", "--due", "2026-04-15", "file taxes")           // 1
+	h.run("add", "--tag", "home", "--tag", "work", "--due", "2026-03-05", "old") // 2, done below
+	h.run("add", "--tag", "work", "--due", "2026-03-09", "soon")                 // 3, overdue
+	h.run("add", "no due")                                                       // 4
+	h.run("done", "2")
+	h.run("add", "--tag", "work", "--due", "2026-03-01", "done old") // 5, done below
+	h.run("done", "5")
+
+	// --tag, repeatable, ALL tags required (with --all to include the done task).
+	out, _, code := h.run("list", "--all", "--tag", "home", "--tag", "work")
+	if code != 0 || out != "#2 [x] P3 old (due 2026-03-05) [home,work]\n" {
+		t.Fatalf("code %d out %q", code, out)
+	}
+	// --overdue: due strictly before today, never includes done tasks.
+	out, _, code = h.run("list", "--overdue")
+	if code != 0 || out != "#3 [ ] P3 soon (due 2026-03-09) [work]\n" {
+		t.Fatalf("code %d out %q", code, out)
+	}
+	out, _, _ = h.run("list", "--overdue", "--all")
+	if out != "#3 [ ] P3 soon (due 2026-03-09) [work]\n" {
+		t.Fatalf("out %q", out)
+	}
+	// --sort due with --all: ascending, no due date last, ties by ID.
+	out, _, code = h.run("list", "--all", "--sort", "due")
+	if code != 0 {
+		t.Fatalf("code %d out %q", code, out)
+	}
+	lines := strings.Split(strings.TrimSpace(out), "\n")
+	want := []string{
+		"#5 [x] P3 done old (due 2026-03-01) [work]",
+		"#2 [x] P3 old (due 2026-03-05) [home,work]",
+		"#3 [ ] P3 soon (due 2026-03-09) [work]",
+		"#1 [ ] P3 file taxes (due 2026-04-15) [home]",
+		"#4 [ ] P3 no due",
+	}
+	if len(lines) != len(want) {
+		t.Fatalf("got %d lines: %q", len(lines), out)
+	}
+	for i := range want {
+		if lines[i] != want[i] {
+			t.Fatalf("line %d: got %q want %q", i, lines[i], want[i])
+		}
+	}
+}
+
+func TestTagsCommand(t *testing.T) {
+	h := newHarness(t)
+	h.run("add", "--tag", "home", "--tag", "money", "a")
+	h.run("add", "--tag", "home", "b")
+	h.run("add", "--tag", "work", "c")
+	h.run("done", "1")
+	out, errb, code := h.run("tags")
+	if code != 0 || errb != "" {
+		t.Fatalf("code %d err %q", code, errb)
+	}
+	if out != "home 1\nwork 1\n" {
+		t.Fatalf("out %q", out)
+	}
+}
+
+func TestTagsInUsage(t *testing.T) {
+	h := newHarness(t)
+	_, errb, code := h.run()
+	if code != 2 || !strings.Contains(errb, "tags") {
+		t.Fatalf("code %d err %q", code, errb)
+	}
+}
