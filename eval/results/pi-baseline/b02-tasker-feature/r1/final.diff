+package store
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"example.com/tasker/internal/model"
+)
+
+func TestLoadVersion1File(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "v1.json")
+	v1 := `{"version":1,"next_id":2,"tasks":[{"id":1,"title":"old","priority":3,"done":false,"created":"2026-01-01T00:00:00Z"}]}`
+	if err := os.WriteFile(p, []byte(v1), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := s.All()
+	if len(all) != 1 || all[0].Title != "old" {
+		t.Fatalf("%+v", all)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	if Version != 2 {
+		t.Fatalf("Version = %d, want 2", Version)
+	}
+	data, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s2, err := Open(p); err != nil || len(s2.All()) != 1 {
+		t.Fatalf("re-open: %v %s", err, data)
+	}
+}
+
+func TestTagsDueRoundTrip(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "v2.json")
+	s, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	due := time.Date(2026, 4, 15, 0, 0, 0, 0, time.UTC)
+	if _, err := s.Add(model.Task{Title: "a", Priority: 2, Tags: []string{" Home ", "home", "money"}, Due: &due}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s2, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := s2.All()
+	if len(all) != 1 {
+		t.Fatalf("data = %s", data)
+	}
+	if len(all[0].Tags) != 2 || all[0].Tags[0] != "home" || all[0].Tags[1] != "money" {
+		t.Fatalf("tags = %v", all[0].Tags)
+	}
+	if all[0].Due == nil || !all[0].Due.Equal(due) {
+		t.Fatalf("due = %v, want %v (data %s)", all[0].Due, due, data)
+	}
+}
+
+func TestNewerVersionRejected(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "v99.json")
+	if err := os.WriteFile(p, []byte(`{"version":99,"next_id":1,"tasks":[]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(p); err == nil {
+		t.Fatal("expected error for newer file version")
+	}
+}
