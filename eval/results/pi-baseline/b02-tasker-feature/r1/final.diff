+package query
+
+import (
+	"testing"
+	"time"
+
+	"example.com/tasker/internal/model"
+)
+
+func dt(s string) *time.Time {
+	d, err := time.Parse("2006-01-02", s)
+	if err != nil {
+		panic(err)
+	}
+	u := time.Date(d.Year(), d.Month(), d.Day(), 0, 0, 0, 0, time.UTC)
+	return &u
+}
+
+func TestApplyTags(t *testing.T) {
+	ts := []model.Task{
+		{ID: 1, Tags: []string{"home", "money"}},
+		{ID: 2, Tags: []string{"work"}},
+		{ID: 3, Tags: []string{"home"}},
+	}
+	got, err := Apply(ts, Options{Tags: []string{"home"}})
+	if err != nil || len(got) != 2 || got[0].ID != 1 || got[1].ID != 3 {
+		t.Fatalf("%+v %v", got, err)
+	}
+	// ALL given tags required.
+	got, err = Apply(ts, Options{Tags: []string{"home", "money"}})
+	if err != nil || len(got) != 1 || got[0].ID != 1 {
+		t.Fatalf("%+v %v", got, err)
+	}
+	// Filter tags are normalised before comparison.
+	got, err = Apply(ts, Options{Tags: []string{" HOME "}})
+	if err != nil || len(got) != 2 {
+		t.Fatalf("%+v %v", got, err)
+	}
+}
+
+func TestApplyOverdue(t *testing.T) {
+	today := time.Date(2026, 3, 10, 12, 0, 0, 0, time.UTC)
+	ts := []model.Task{
+		{ID: 1, Due: dt("2026-03-09")},             // overdue
+		{ID: 2, Due: dt("2026-03-10")},             // due today: not strictly before
+		{ID: 3, Due: dt("2026-03-11")},             // in the future
+		{ID: 4, Done: true, Due: dt("2026-03-01")}, // done
+		{ID: 5}, // no due date
+	}
+	got, err := Apply(ts, Options{Overdue: true, Today: today})
+	if err != nil || len(got) != 1 || got[0].ID != 1 {
+		t.Fatalf("%+v %v", got, err)
+	}
+	// --overdue never includes done tasks, even with IncludeDone.
+	got, err = Apply(ts, Options{Overdue: true, IncludeDone: true, Today: today})
+	if err != nil || len(got) != 1 || got[0].ID != 1 {
+		t.Fatalf("%+v %v", got, err)
+	}
+}
+
+func TestApplySortDue(t *testing.T) {
+	ts := []model.Task{
+		{ID: 1}, // no due date -> last, ties by ID
+		{ID: 2, Due: dt("2026-03-10")},
+		{ID: 3}, // no due date
+		{ID: 4, Due: dt("2026-03-09")},
+		{ID: 5, Due: dt("2026-03-10")}, // ties with ID 2 by ID
+	}
+	got, err := Apply(ts, Options{SortBy: "due"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []int{4, 2, 5, 1, 3}
+	if len(got) != len(want) {
+		t.Fatalf("%+v", got)
+	}
+	for i, w := range want {
+		if got[i].ID != w {
+			t.Fatalf("position %d: got %d want %d (%+v)", i, got[i].ID, w, got)
+		}
+	}
+}
