+// toUSD converts an amount in minor units to USD cents, rounded to the
+// nearest cent with ties to even (banker's rounding).
+// The rates have at most 4 decimal places, so exact decimal arithmetic is
+// used: usd = amount * rateNumerator / 10000.
 func toUSD(amount int64, currency string) (int64, error) {
 	rate, ok := Rates[currency]
 	if !ok {
 		return 0, fmt.Errorf("unknown currency %q", currency)
 	}
-	return int64(float64(amount) * rate), nil
+	num := amount * int64(math.Round(rate*10000))
+	q, r := num/10000, num%10000
+	if r < 0 {
+		q, r = q-1, r+10000
+	}
+	switch {
+	case r < 5000:
+		return q, nil
+	case r > 5000:
+		return q + 1, nil
+	default: // exact tie: round to the even integer
+		if q%2 == 0 {
+			return q, nil
+		}
+		return q + 1, nil
+	}
 }
 
