@@ -0,0 +1,195 @@
+package proto
+
+import (
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+func mustExec(t *testing.T, s *store.Store, line, want string) {
+	t.Helper()
+	got := Exec(s, line)
+	if got != want {
+		t.Fatalf("Exec(%q) = %q, want %q", line, got, want)
+	}
+}
+
+func TestCommands(t *testing.T) {
+	s := store.New(nil)
+	mustExec(t, s, "PING", "+PONG\n")
+	mustExec(t, s, "ping", "+PONG\n")
+	mustExec(t, s, "  PING  ", "+PONG\n")
+	mustExec(t, s, "PING extra", "-ERR wrong number of arguments for 'ping'\n")
+
+	mustExec(t, s, "SET a 1", "+OK\n")
+	mustExec(t, s, "get a", "$1\n")
+	mustExec(t, s, "GET missing", "$nil\n")
+	mustExec(t, s, "GET", "-ERR wrong number of arguments for 'get'\n")
+
+	mustExec(t, s, "SET b 2", "+OK\n")
+	mustExec(t, s, "SET c 3", "+OK\n")
+	mustExec(t, s, "DEL a c a nope", ":2\n")
+	mustExec(t, s, "DEL", "-ERR wrong number of arguments for 'del'\n")
+
+	mustExec(t, s, "EXISTS b", ":1\n")
+	mustExec(t, s, "EXISTS a", ":0\n")
+
+	mustExec(t, s, "EXPIRE b 10", ":1\n")
+	mustExec(t, s, "EXPIRE nope 10", ":0\n")
+	mustExec(t, s, "EXPIRE b x", "-ERR value is not an integer\n")
+	mustExec(t, s, "PERSIST b", ":1\n")
+	mustExec(t, s, "PERSIST b", ":0\n")
+
+	mustExec(t, s, "TTL b", ":-1\n")
+	mustExec(t, s, "TTL nope", ":-2\n")
+
+	mustExec(t, s, "INCR n", ":1\n")
+	mustExec(t, s, "INCR n", ":2\n")
+	mustExec(t, s, "INCRBY n 10", ":12\n")
+	mustExec(t, s, "SET s abc", "+OK\n")
+	mustExec(t, s, "INCR s", "-ERR value is not an integer\n")
+	mustExec(t, s, "INCRBY s x", "-ERR value is not an integer\n")
+
+	mustExec(t, s, "SET x:1 v", "+OK\n")
+	mustExec(t, s, "SET x:2 v", "+OK\n")
+	mustExec(t, s, "SET y v", "+OK\n")
+	mustExec(t, s, "KEYS x:*", "*2\n$x:1\n$x:2\n")
+	mustExec(t, s, "KEYS z*", "*0\n")
+
+	mustExec(t, s, "DBSIZE", ":6\n") // b n s x:1 x:2 y
+
+	mustExec(t, s, "FROB a", "-ERR unknown command 'FROB'\n")
+	mustExec(t, s, "", "-ERR empty command\n")
+	mustExec(t, s, "   ", "-ERR empty command\n")
+}
+
+func TestSetOptions(t *testing.T) {
+	s := store.New(nil)
+	mustExec(t, s, "SET a 1 EX 30", "+OK\n")
+	mustExec(t, s, "SET a 1 NOPE 30", "-ERR syntax error\n")
+	mustExec(t, s, "SET a 1 EX 0", "-ERR syntax error\n")
+	mustExec(t, s, "SET a 1 EX -5", "-ERR syntax error\n")
+	mustExec(t, s, "SET a 1 EX x", "-ERR syntax error\n")
+	mustExec(t, s, "SET a 1 EX", "-ERR wrong number of arguments for 'set'\n")
+	mustExec(t, s, "SET a", "-ERR wrong number of arguments for 'set'\n")
+}
+
+func TestTTLRoundUp(t *testing.T) {
+	now := time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := store.New(func() time.Time { return now })
+	s.Set("a", "1", 1200*time.Millisecond) // 1.2s -> 2
+	mustExec(t, s, "TTL a", ":2\n")
+	now = now.Add(200 * time.Millisecond) // 1.0s left -> 1
+	mustExec(t, s, "TTL a", ":1\n")
+	now = now.Add(1100 * time.Millisecond) // expired
+	mustExec(t, s, "TTL a", ":-2\n")
+}
+
+func TestQuotingRoundTrip(t *testing.T) {
+	s := store.New(nil)
+	cases := map[string]string{
+		"plain":     "hello",
+		"space":     "hello world",
+		"tab":       "a\tb",
+		"quote":     `say "hi"`,
+		"backslash": `a\b`,
+		"newline":   "line1\nline2",
+		"empty":     "",
+		"all":       " \"\\\n\t",
+	}
+	for name, v := range cases {
+		v := v
+		mustExec(t, s, "SET q "+encodeRequestValue(v), "+OK\n")
+		got := Exec(s, "GET q")
+		// the response must be a quoted/plain string that decodes back to v
+		dec, ok := decodeResponseString(t, got)
+		if !ok || dec != v {
+			t.Fatalf("%s: round trip = %q, %v; want %q", name, dec, ok, v)
+		}
+	}
+}
+
+func TestQuotedRequests(t *testing.T) {
+	s := store.New(nil)
+	mustExec(t, s, `SET "hello world" v`, "+OK\n")
+	mustExec(t, s, `GET "hello world"`, "$v\n")
+	mustExec(t, s, `SET "a\"b" v`, "+OK\n")
+	mustExec(t, s, `GET "a\"b"`, "$v\n")
+	mustExec(t, s, `SET "a\\b" v`, "+OK\n")
+	mustExec(t, s, `GET "a\\b"`, "$v\n")
+	mustExec(t, s, `SET "a\nb" v`, "+OK\n")
+	mustExec(t, s, `GET "a\nb"`, "$v\n")
+	mustExec(t, s, `SET "" v`, "+OK\n")
+	mustExec(t, s, `GET ""`, "$v\n")
+
+	mustExec(t, s, `GET "unterminated`, "-ERR syntax error\n")
+	mustExec(t, s, `SET a "b\z"`, "-ERR syntax error\n") // unknown escape
+	mustExec(t, s, `SET a "b"x`, "-ERR syntax error\n")  // junk after close quote
+	mustExec(t, s, `SET "a b" "c\td"`, "+OK\n")
+	mustExec(t, s, `GET "a b"`, "$\"c\\td\"\n")
+}
+
+func TestResponseFormatting(t *testing.T) {
+	s := store.New(nil)
+	mustExec(t, s, `SET a "a b"`, "+OK\n")
+	mustExec(t, s, `GET a`, "$\"a b\"\n")
+	mustExec(t, s, `SET e ""`, "+OK\n")
+	mustExec(t, s, `GET e`, "$\"\"\n")
+	mustExec(t, s, `SET p plain`, "+OK\n")
+	mustExec(t, s, `GET p`, "$plain\n")
+	mustExec(t, s, `SET t "a\tb"`, "+OK\n")
+	mustExec(t, s, `GET t`, "$\"a\\tb\"\n")
+}
+
+// encodeRequestValue quotes a value the way the request side requires.
+func encodeRequestValue(v string) string {
+	if v == "" || containsSpecial(v) {
+		var b []byte
+		b = append(b, '"')
+		for i := 0; i < len(v); i++ {
+			switch c := v[i]; c {
+			case '"':
+				b = append(b, '\\', '"')
+			case '\\':
+				b = append(b, '\\', '\\')
+			case '\n':
+				b = append(b, '\\', 'n')
+			case '\t':
+				b = append(b, '\\', 't')
+			default:
+				b = append(b, c)
+			}
+		}
+		b = append(b, '"')
+		return string(b)
+	}
+	return v
+}
+
+func containsSpecial(v string) bool {
+	for i := 0; i < len(v); i++ {
+		switch v[i] {
+		case ' ', '\t', '"', '\\', '\n':
+			return true
+		}
+	}
+	return false
+}
+
+// decodeResponseString decodes a $-string response line back to its value.
+func decodeResponseString(t *testing.T, resp string) (string, bool) {
+	t.Helper()
+	if len(resp) < 3 || resp[0] != '$' || resp[len(resp)-1] != '\n' {
+		t.Fatalf("bad response %q", resp)
+	}
+	body := resp[1 : len(resp)-1]
+	if body == "nil" {
+		return "", false
+	}
+	toks, err := tokenize(body)
+	if err != nil || len(toks) != 1 {
+		t.Fatalf("bad response body %q (%v)", body, err)
+	}
+	return toks[0], true
+}
diff --git a/server/server.go b/server/server.go
new file mode 100644
index 0000000..3276ca9
--- /dev/null
+++ b/server/server.go
@@ -0,0 +1,112 @@
+// Package server serves the kv line protocol over TCP.
+package server
+
+import (
+	"bufio"
+	"context"
+	"io"
+	"net"
+	"strings"
+	"sync"
+
+	"example.com/kv/proto"
+	"example.com/kv/store"
+)
+
+// maxLine is the maximum accepted request line length (64 KiB).
+const maxLine = 64 * 1024
+
+// Serve accepts TCP connections on l and serves each client concurrently
+// until ctx is cancelled. On cancellation it closes the listener, closes
+// open connections, waits for all connection goroutines to finish and
+// returns nil. Any other listener error is returned.
+func Serve(ctx context.Context, l net.Listener, s *store.Store) error {
+	var mu sync.Mutex
+	clients := make(map[net.Conn]*sync.Once)
+	var wg sync.WaitGroup
+
+	done := make(chan struct{})
+	go func() {
+		<-ctx.Done()
+		close(done)
+		l.Close() // unblock Accept
+	}()
+
+	closeClients := func() {
+		mu.Lock()
+		for c, closeOnce := range clients {
+			closeOnce.Do(func() { c.Close() })
+		}
+		mu.Unlock()
+		wg.Wait()
+	}
+
+	for {
+		c, err := l.Accept()
+		if err != nil {
+			if ctx.Err() != nil {
+				closeClients()
+				return nil
+			}
+			closeClients()
+			return err
+		}
+		closeOnce := &sync.Once{}
+		mu.Lock()
+		clients[c] = closeOnce
+		mu.Unlock()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			serveConn(c, s, done)
+			mu.Lock()
+			delete(clients, c)
+			mu.Unlock()
+			closeOnce.Do(func() { c.Close() })
+		}()
+	}
+}
+
+func serveConn(c net.Conn, s *store.Store, done <-chan struct{}) {
+	r := bufio.NewReaderSize(c, 1<<20)
+	w := bufio.NewWriter(c)
+	for {
+		select {
+		case <-done:
+			return
+		default:
+		}
+		line, err := r.ReadString('\n')
+		if err == bufio.ErrBufferFull {
+			io.WriteString(w, "-ERR line too long\n")
+			w.Flush()
+			return
+		}
+		if err != nil {
+			return
+		}
+		line = strings.TrimSuffix(line, "\n")
+		line = strings.TrimSuffix(line, "\r")
+		if len(line) > maxLine {
+			io.WriteString(w, "-ERR line too long\n")
+			w.Flush()
+			return
+		}
+		if isQuit(line) {
+			io.WriteString(w, "+BYE\n")
+			w.Flush()
+			return
+		}
+		io.WriteString(w, proto.Exec(s, line))
+		w.Flush()
+	}
+}
+
+// isQuit reports whether the line is a QUIT command (case-insensitive).
+func isQuit(line string) bool {
+	t := strings.TrimSpace(line)
+	if i := strings.IndexAny(t, " \t"); i >= 0 {
+		t = t[:i]
+	}
+	return strings.EqualFold(t, "quit")
+}
diff --git a/server/server_test.go b/server/server_test.go
new file mode 100644
index 0000000..98ce84e
--- /dev/null
+++ b/server/server_test.go
@@ -0,0 +1,202 @@
+package server
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// client is a raw TCP line client.
+type client struct {
+	t    *testing.T
+	c    net.Conn
+	r    *bufio.Reader
+	w    *bufio.Writer
+	done chan struct{}
+}
+
+func dialClient(t *testing.T, addr string) *client {
+	t.Helper()
+	c, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl := &client{t: t, c: c, r: bufio.NewReader(c), w: bufio.NewWriter(c), done: make(chan struct{})}
+	t.Cleanup(func() { c.Close() })
+	return cl
+}
+
+func (cl *client) send(line string) {
+	cl.t.Helper()
+	cl.w.WriteString(line)
+	cl.w.WriteRune('\n')
+	cl.w.Flush()
+}
+
+func (cl *client) expect(want string) {
+	cl.t.Helper()
+	got, err := cl.r.ReadString('\n')
+	if err != nil {
+		cl.t.Fatalf("read response: %v", err)
+	}
+	if got != want {
+		cl.t.Fatalf("response = %q, want %q", got, want)
+	}
+}
+
+func newTestServer(t *testing.T) (net.Addr, context.CancelFunc) {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	go Serve(ctx, l, store.New(nil))
+	return l.Addr(), cancel
+}
+
+func TestServeBasics(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	cl := dialClient(t, addr.String())
+	cl.send("PING")
+	cl.expect("+PONG\n")
+	cl.send("SET a hello")
+	cl.expect("+OK\n")
+	cl.send("GET a")
+	cl.expect("$hello\n")
+	cl.send("GET a") // repeated, in order
+	cl.expect("$hello\n")
+	cl.send("SET b \"a b\"")
+	cl.expect("+OK\n")
+	cl.send("GET b")
+	cl.expect("$\"a b\"\n")
+	cl.send("QUIT")
+	cl.expect("+BYE\n")
+}
+
+func TestQuitClosesConnection(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	cl := dialClient(t, addr.String())
+	cl.send("QUIT")
+	cl.expect("+BYE\n")
+	// connection closed by server: next read is EOF
+	cl.send("PING")
+	buf := make([]byte, 64)
+	n, err := cl.c.Read(buf)
+	if err == nil && n > 0 {
+		cl.t.Fatalf("expected EOF after QUIT, got %q", buf[:n])
+	}
+}
+
+func TestCRLineEndings(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	cl := dialClient(t, addr.String())
+	cl.w.WriteString("SET a b\r\n")
+	cl.w.Flush()
+	cl.expect("+OK\n")
+	cl.send("QUIT")
+	cl.expect("+BYE\n")
+}
+
+func TestLineTooLong(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	cl := dialClient(t, addr.String())
+	// 64 KiB of x + GET prefix: longer than 64 KiB
+	cl.w.WriteString("GET " + strings.Repeat("x", 65*1024) + "\n")
+	cl.w.Flush()
+	cl.expect("-ERR line too long\n")
+	// connection is closed after
+	buf := make([]byte, 16)
+	n, _ := cl.c.Read(buf)
+	if n > 0 {
+		cl.t.Fatalf("expected closed conn, got %q", buf[:n])
+	}
+
+	// a line of exactly 64 KiB is accepted
+	cl2 := dialClient(t, addr.String())
+	cl2.w.WriteString("SET " + strings.Repeat("x", 64*1024-11) + " v\n")
+	cl2.w.Flush()
+	cl2.expect("+OK\n")
+	cl2.send("QUIT")
+	cl2.expect("+BYE\n")
+}
+
+// Very long line that exceeds the read buffer (1 MiB).
+func TestLineExceedsBuffer(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	cl := dialClient(t, addr.String())
+	cl.w.Write([]byte("GET "))
+	cl.w.WriteString(strings.Repeat("x", 2*1024*1024))
+	cl.w.WriteRune('\n')
+	cl.w.Flush()
+	cl.expect("-ERR line too long\n")
+}
+
+func TestConcurrentClients(t *testing.T) {
+	addr, cancel := newTestServer(t)
+	defer cancel()
+
+	var wg sync.WaitGroup
+	const n = 10
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			cl := dialClient(t, addr.String())
+			for j := 0; j < 20; j++ {
+				cl.send(fmt.Sprintf("SET k%d %d", i, j))
+				cl.expect("+OK\n")
+			}
+			cl.send("QUIT")
+			cl.expect("+BYE\n")
+		}(i)
+	}
+	wg.Wait()
+}
+
+func TestShutdown(t *testing.T) {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	errCh := make(chan error, 1)
+	go func() { errCh <- Serve(ctx, l, store.New(nil)) }()
+
+	cl := dialClient(t, l.Addr().String())
+	cl.send("PING")
+	cl.expect("+PONG\n")
+
+	cancel()
+	select {
+	case err := <-errCh:
+		if err != nil {
+			t.Fatalf("Serve returned %v after cancel, want nil", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Serve did not return after cancel")
+	}
+	// the open connection must have been closed
+	buf := make([]byte, 16)
+	n, _ := cl.c.Read(buf)
+	if n > 0 {
+		t.Fatalf("expected server-closed conn, got %q", buf[:n])
+	}
+}
