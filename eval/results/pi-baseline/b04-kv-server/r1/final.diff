diff --git a/proto/proto.go b/proto/proto.go
new file mode 100644
index 0000000..8f5fa99
--- /dev/null
+++ b/proto/proto.go
@@ -0,0 +1,245 @@
+// Package proto implements a line-based request/response protocol on top of
+// a store.Store.
+package proto
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// Exec parses one request line and returns the full response,
+// including the trailing newline.
+func Exec(s *store.Store, line string) string {
+	toks, err := tokenize(line)
+	if err != nil {
+		return "-ERR syntax error\n"
+	}
+	if len(toks) == 0 {
+		return "-ERR empty command\n"
+	}
+	name := toks[0]
+	switch ln := strings.ToLower(name); ln {
+	case "ping":
+		if len(toks) != 1 {
+			return argErr(ln)
+		}
+		return "+PONG\n"
+	case "set":
+		if len(toks) != 3 && len(toks) != 5 {
+			return argErr(ln)
+		}
+		var ttl time.Duration
+		if len(toks) == 5 {
+			if !strings.EqualFold(toks[3], "EX") {
+				return "-ERR syntax error\n"
+			}
+			sec, err := strconv.ParseInt(toks[4], 10, 64)
+			if err != nil || sec <= 0 {
+				return "-ERR syntax error\n"
+			}
+			ttl = time.Duration(sec) * time.Second
+		}
+		s.Set(toks[1], toks[2], ttl)
+		return "+OK\n"
+	case "get":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		v, ok := s.Get(toks[1])
+		if !ok {
+			return "$nil\n"
+		}
+		return encodeString(v)
+	case "del":
+		if len(toks) < 2 {
+			return argErr(ln)
+		}
+		return ":" + strconv.Itoa(s.Del(toks[1:]...)) + "\n"
+	case "exists":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		if s.Exists(toks[1]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "expire":
+		if len(toks) != 3 {
+			return argErr(ln)
+		}
+		sec, err := strconv.ParseInt(toks[2], 10, 64)
+		if err != nil {
+			return "-ERR value is not an integer\n"
+		}
+		if s.Expire(toks[1], time.Duration(sec)*time.Second) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "persist":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		if s.Persist(toks[1]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "ttl":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		d := s.TTL(toks[1])
+		if d < 0 {
+			return ":" + strconv.FormatInt(int64(d), 10) + "\n"
+		}
+		// seconds remaining rounded up
+		sec := int64((d + time.Second - 1) / time.Second)
+		return ":" + strconv.FormatInt(sec, 10) + "\n"
+	case "incr":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		return incrResp(s, toks[1], 1)
+	case "incrby":
+		if len(toks) != 3 {
+			return argErr(ln)
+		}
+		n, err := strconv.ParseInt(toks[2], 10, 64)
+		if err != nil {
+			return "-ERR value is not an integer\n"
+		}
+		return incrResp(s, toks[1], n)
+	case "keys":
+		if len(toks) != 2 {
+			return argErr(ln)
+		}
+		return encodeArray(s.Keys(toks[1]))
+	case "dbsize":
+		if len(toks) != 1 {
+			return argErr(ln)
+		}
+		return ":" + strconv.Itoa(s.Len()) + "\n"
+	default:
+		return "-ERR unknown command '" + name + "'\n"
+	}
+}
+
+func incrResp(s *store.Store, key string, by int64) string {
+	v, err := s.Incr(key, by)
+	if err != nil {
+		return "-ERR value is not an integer\n"
+	}
+	return ":" + strconv.FormatInt(v, 10) + "\n"
+}
+
+func argErr(name string) string {
+	return "-ERR wrong number of arguments for '" + strings.ToLower(name) + "'\n"
+}
+
+// tokenize splits line into tokens separated by one or more spaces/tabs.
+// A token may be double-quoted; inside quotes \" \\ \n \t are escapes.
+// An unterminated quote is a syntax error.
+func tokenize(line string) ([]string, error) {
+	var toks []string
+	i := 0
+	for i < len(line) {
+		for i < len(line) && (line[i] == ' ' || line[i] == '\t') {
+			i++
+		}
+		if i >= len(line) {
+			break
+		}
+		if line[i] == '"' {
+			i++
+			var b strings.Builder
+			terminated := false
+			for i < len(line) {
+				c := line[i]
+				if c == '\\' && i+1 < len(line) {
+					switch e := line[i+1]; e {
+					case '"':
+						b.WriteByte('"')
+					case '\\':
+						b.WriteByte('\\')
+					case 'n':
+						b.WriteByte('\n')
+					case 't':
+						b.WriteByte('\t')
+					default:
+						return nil, errSyntax
+					}
+					i += 2
+					continue
+				}
+				if c == '"' {
+					i++
+					terminated = true
+					break
+				}
+				b.WriteByte(c)
+				i++
+			}
+			if !terminated {
+				return nil, errSyntax
+			}
+			if i < len(line) && line[i] != ' ' && line[i] != '\t' {
+				return nil, errSyntax
+			}
+			toks = append(toks, b.String())
+		} else {
+			j := i
+			for j < len(line) && line[j] != ' ' && line[j] != '\t' {
+				j++
+			}
+			toks = append(toks, line[i:j])
+			i = j
+		}
+	}
+	return toks, nil
+}
+
+var errSyntax = errors.New("syntax error")
+
+// encodeString encodes v as a $-bulk string line with the protocol's
+// quoting rules: values containing a space, tab, '"', '\' or newline,
+// or empty values, are written quoted with escapes.
+func encodeString(v string) string {
+	if v != "" && !strings.ContainsAny(v, " \t\"\\\n") {
+		return "$" + v + "\n"
+	}
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(v); i++ {
+		switch c := v[i]; c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte('"')
+	b.WriteByte('\n')
+	return "$" + b.String()
+}
+
+// encodeArray encodes an array of strings: *<count> line plus one
+// $-bulk string line per element.
+func encodeArray(items []string) string {
+	var b strings.Builder
+	b.WriteByte('*')
+	b.WriteString(strconv.Itoa(len(items)))
+	b.WriteByte('\n')
+	for _, it := range items {
+		b.WriteString(encodeString(it))
+	}
+	return b.String()
+}
