new file mode 100644
index 0000000..208087a
--- /dev/null
+++ b/store/store.go
@@ -0,0 +1,382 @@
+// Package store implements an in-memory key-value store with expiry,
+// glob key matching, and JSON snapshots.
+package store
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// ErrNotInteger is returned by Incr when the current value is not a base-10 int64.
+var ErrNotInteger = errors.New("value is not an integer")
+
+// Clock is a function returning the current time.
+type Clock func() time.Time
+
+type entry struct {
+	value    string
+	deadline time.Time // zero value means no expiry
+}
+
+func (e *entry) expired(now time.Time) bool {
+	return !e.deadline.IsZero() && !now.Before(e.deadline)
+}
+
+// Store is a concurrency-safe in-memory key-value store.
+type Store struct {
+	mu    sync.Mutex
+	clock Clock
+	m     map[string]*entry
+}
+
+// New creates a Store. A nil clock uses time.Now.
+func New(clock Clock) *Store {
+	if clock == nil {
+		clock = time.Now
+	}
+	return &Store{clock: clock, m: make(map[string]*entry)}
+}
+
+func (s *Store) now() time.Time { return s.clock() }
+
+// liveLocked returns the entry for key, or nil if the key is missing or
+// expired (expired entries are deleted). Caller must hold s.mu.
+func (s *Store) liveLocked(key string) *entry {
+	e := s.m[key]
+	if e == nil {
+		return nil
+	}
+	if e.expired(s.now()) {
+		delete(s.m, key)
+		return nil
+	}
+	return e
+}
+
+// Set stores value under key, replacing any existing value and TTL.
+// A ttl <= 0 means no expiry.
+func (s *Store) Set(key, value string, ttl time.Duration) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var d time.Time
+	if ttl > 0 {
+		d = s.now().Add(ttl)
+	}
+	s.m[key] = &entry{value: value, deadline: d}
+}
+
+// Get returns the value for key and true if the key exists and is not expired.
+func (s *Store) Get(key string) (string, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.liveLocked(key)
+	if e == nil {
+		return "", false
+	}
+	return e.value, true
+}
+
+// Del removes the given keys and returns the number that existed and were removed.
+func (s *Store) Del(keys ...string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for _, k := range keys {
+		if s.liveLocked(k) != nil {
+			delete(s.m, k)
+			n++
+		}
+	}
+	return n
+}
+
+// Exists reports whether key exists and is not expired.
+func (s *Store) Exists(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.liveLocked(key) != nil
+}
+
+// Expire sets a new expiry on key, returning false if the key is missing.
+// A ttl <= 0 deletes the key and returns true (if the key existed).
+func (s *Store) Expire(key string, ttl time.Duration) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.liveLocked(key)
+	if e == nil {
+		return false
+	}
+	if ttl <= 0 {
+		delete(s.m, key)
+		return true
+	}
+	e.deadline = s.now().Add(ttl)
+	return true
+}
+
+// Persist removes the expiry of key. It returns true only if the key
+// existed and had an expiry.
+func (s *Store) Persist(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.liveLocked(key)
+	if e == nil || e.deadline.IsZero() {
+		return false
+	}
+	e.deadline = time.Time{}
+	return true
+}
+
+// TTL returns -2 (as time.Duration) if the key is missing, -1 if it has no
+// expiry, otherwise the remaining time (> 0).
+func (s *Store) TTL(key string) time.Duration {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.liveLocked(key)
+	if e == nil {
+		return time.Duration(-2)
+	}
+	if e.deadline.IsZero() {
+		return time.Duration(-1)
+	}
+	return e.deadline.Sub(s.now())
+}
+
+// Incr adds by to the integer value of key (a missing key counts as 0) and
+// stores the result. Any existing TTL is preserved. It returns
+// ErrNotInteger if the current value is not a base-10 int64.
+func (s *Store) Incr(key string, by int64) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.liveLocked(key)
+	var v int64
+	if e != nil {
+		var err error
+		v, err = strconv.ParseInt(e.value, 10, 64)
+		if err != nil {
+			return 0, ErrNotInteger
+		}
+	}
+	v += by
+	ne := &entry{value: strconv.FormatInt(v, 10)}
+	if e != nil {
+		ne.deadline = e.deadline
+	}
+	s.m[key] = ne
+	return v, nil
+}
+
+// Keys returns the live keys matching the glob pattern, sorted ascending.
+func (s *Store) Keys(pattern string) []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	out := make([]string, 0)
+	for k, e := range s.m {
+		if e.expired(now) {
+			delete(s.m, k)
+			continue
+		}
+		if globMatch(pattern, k) {
+			out = append(out, k)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// Len returns the number of live (non-expired) keys.
+func (s *Store) Len() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	for k, e := range s.m {
+		if e.expired(now) {
+			delete(s.m, k)
+		}
+	}
+	return len(s.m)
+}
+
+type snapshot struct {
+	Version int         `json:"version"`
+	Entries []snapEntry `json:"entries"`
+}
+
+type snapEntry struct {
+	K   string `json:"k"`
+	V   string `json:"v"`
+	Exp int64  `json:"exp"` // unix milliseconds, 0 = no expiry
+}
+
+// Save writes a JSON snapshot of all live entries, sorted by key.
+func (s *Store) Save(w io.Writer) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	snap := snapshot{Version: 1, Entries: make([]snapEntry, 0, len(s.m))}
+	for k, e := range s.m {
+		if e.expired(now) {
+			delete(s.m, k)
+			continue
+		}
+		se := snapEntry{K: k, V: e.value}
+		if !e.deadline.IsZero() {
+			se.Exp = e.deadline.UnixMilli()
+		}
+		snap.Entries = append(snap.Entries, se)
+	}
+	sort.Slice(snap.Entries, func(i, j int) bool {
+		return snap.Entries[i].K < snap.Entries[j].K
+	})
+	return json.NewEncoder(w).Encode(snap)
+}
+
+// Load replaces all contents with the entries from the JSON snapshot.
+// Snapshots with a version other than 1 are rejected. Entries that are
+// already expired at load time are dropped.
+func (s *Store) Load(r io.Reader) error {
+	var snap snapshot
+	if err := json.NewDecoder(r).Decode(&snap); err != nil {
+		return err
+	}
+	if snap.Version != 1 {
+		return errors.New("unsupported snapshot version")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	m := make(map[string]*entry, len(snap.Entries))
+	for _, se := range snap.Entries {
+		if se.Exp != 0 {
+			d := time.UnixMilli(se.Exp)
+			if !d.After(now) {
+				continue // already expired
+			}
+			m[se.K] = &entry{value: se.V, deadline: d}
+		} else {
+			m[se.K] = &entry{value: se.V}
+		}
+	}
+	s.m = m
+	return nil
+}
+
+// glob matcher -----------------------------------------------------------
+
+type globClass struct {
+	lo, hi byte
+}
+
+type globFrag struct {
+	kind  byte // 0 literal, 1 any (?), 2 star (*), 3 class
+	ch    byte
+	neg   bool
+	class []globClass
+}
+
+func (f globFrag) match(b byte) bool {
+	switch f.kind {
+	case 1, 2:
+		return true
+	case 0:
+		return b == f.ch
+	case 3:
+		in := false
+		for _, c := range f.class {
+			if c.lo <= b && b <= c.hi {
+				in = true
+				break
+			}
+		}
+		return in != f.neg
+	}
+	return false
+}
+
+func parseGlob(p string) []globFrag {
+	var frags []globFrag
+	for i := 0; i < len(p); {
+		switch c := p[i]; c {
+		case '*':
+			frags = append(frags, globFrag{kind: 2})
+			i++
+		case '?':
+			frags = append(frags, globFrag{kind: 1})
+			i++
+		case '\\':
+			if i+1 < len(p) {
+				frags = append(frags, globFrag{kind: 0, ch: p[i+1]})
+				i += 2
+			} else {
+				frags = append(frags, globFrag{kind: 0, ch: '\\'})
+				i++
+			}
+		case '[':
+			j := i + 1
+			neg := false
+			if j < len(p) && (p[j] == '^' || p[j] == '!') {
+				neg = true
+				j++
+			}
+			var cls []globClass
+			for j < len(p) && p[j] != ']' {
+				if j+2 < len(p) && p[j+1] == '-' && p[j+2] != ']' {
+					cls = append(cls, globClass{lo: p[j], hi: p[j+2]})
+					j += 3
+				} else {
+					cls = append(cls, globClass{lo: p[j], hi: p[j]})
+					j++
+				}
+			}
+			if j >= len(p) {
+				// unterminated class: treat '[' as a literal
+				frags = append(frags, globFrag{kind: 0, ch: '['})
+				i++
+			} else {
+				frags = append(frags, globFrag{kind: 3, neg: neg, class: cls})
+				i = j + 1
+			}
+		default:
+			frags = append(frags, globFrag{kind: 0, ch: c})
+			i++
+		}
+	}
+	return frags
+}
+
+// globMatch reports whether s matches the whole glob pattern p.
+// '*' matches any sequence (including empty), '?' one byte,
+// '[abc]', '[a-z]' classes, '[^a]'/'[!a]' negation, '\x' escapes.
+func globMatch(pattern, s string) bool {
+	frags := parseGlob(pattern)
+	p, sPos, starP, starS := 0, 0, -1, 0
+	for sPos < len(s) {
+		if p < len(frags) && frags[p].match(s[sPos]) {
+			if frags[p].kind == 2 {
+				starP, starS = p, sPos
+			}
+			p++
+			sPos++
+		} else if starP >= 0 && frags[starP].kind == 2 {
+			starS++
+			sPos = starS
+			p = starP + 1
+		} else if p < len(frags) && frags[p].kind == 2 {
+			starP = p
+			starS = sPos
+			p++
+		} else {
+			return false
+		}
+	}
+	for p < len(frags) && frags[p].kind == 2 {
+		p++
+	}
+	return p == len(frags)
+}
diff --git a/store/store_test.go b/store/store_test.go
new file mode 100644
index 0000000..89e96f7
--- /dev/null
+++ b/store/store_test.go
@@ -0,0 +1,276 @@
+package store
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+)
+
+func newFakeClock() (*Store, *time.Time) {
+	now := time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := New(func() time.Time { return now })
+	return s, &now
+}
+
+func TestSetGet(t *testing.T) {
+	s := New(nil)
+	s.Set("a", "1", 0)
+	if v, ok := s.Get("a"); !ok || v != "1" {
+		t.Fatalf("Get(a) = %q, %v; want 1, true", v, ok)
+	}
+	if _, ok := s.Get("nope"); ok {
+		t.Fatal("Get(nope) should be false")
+	}
+	// Set always replaces value AND ttl
+	s, now := newFakeClock()
+	s.Set("k", "v1", time.Minute)
+	s.Set("k", "v2", 0)
+	if v, _ := s.Get("k"); v != "v2" {
+		t.Fatalf("value not replaced: %q", v)
+	}
+	if got := s.TTL("k"); got != time.Duration(-1) {
+		t.Fatalf("ttl after reset = %v, want -1", got)
+	}
+	// expired at exactly now == deadline
+	s, now = newFakeClock()
+	s.Set("k", "v", time.Minute)
+	*now = now.Add(time.Minute)
+	if _, ok := s.Get("k"); ok {
+		t.Fatal("key at deadline should be expired")
+	}
+}
+
+func TestDelExists(t *testing.T) {
+	s, _ := newFakeClock()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 0)
+	if n := s.Del("a", "nope", "a"); n != 1 {
+		t.Fatalf("Del = %d, want 1", n)
+	}
+	if s.Exists("a") {
+		t.Fatal("a should be gone")
+	}
+	if !s.Exists("b") {
+		t.Fatal("b should remain")
+	}
+	// expired keys are not counted
+	s, now := newFakeClock()
+	s.Set("x", "1", time.Second)
+	*now = now.Add(2 * time.Second)
+	if n := s.Del("x"); n != 0 {
+		t.Fatalf("Del(expired) = %d, want 0", n)
+	}
+}
+
+func TestExpirePersistTTL(t *testing.T) {
+	s, _ := newFakeClock()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", time.Minute)
+	s.Set("c", "3", time.Minute)
+
+	if s.Expire("missing", time.Minute) {
+		t.Fatal("Expire(missing) should be false")
+	}
+	if got := s.Expire("a", time.Hour); !got {
+		t.Fatal("Expire(a) should be true")
+	}
+	if got := s.TTL("a"); got != time.Hour {
+		t.Fatalf("TTL(a) = %v, want 1h", got)
+	}
+	if got := s.Expire("b", 0); !got {
+		t.Fatal("Expire(b, 0) should be true")
+	}
+	if s.Exists("b") {
+		t.Fatal("b should be deleted by ttl<=0")
+	}
+	if got := s.Persist("c"); !got {
+		t.Fatal("Persist(c) should be true")
+	}
+	if got := s.Persist("c"); got {
+		t.Fatal("second Persist(c) should be false (no expiry left)")
+	}
+	if got := s.Persist("missing"); got {
+		t.Fatal("Persist(missing) should be false")
+	}
+	if got := s.Persist("a"); !got {
+		t.Fatal("Persist(a) with expiry should be true")
+	}
+	if got := s.TTL("missing"); got != time.Duration(-2) {
+		t.Fatalf("TTL(missing) = %v, want -2", got)
+	}
+	if got := s.TTL("a"); got != time.Duration(-1) {
+		t.Fatalf("TTL(a) = %v, want -1", got)
+	}
+}
+
+func TestIncr(t *testing.T) {
+	s, _ := newFakeClock()
+	if v, err := s.Incr("n", 5); err != nil || v != 5 {
+		t.Fatalf("Incr new = %d, %v; want 5, nil", v, err)
+	}
+	if v, err := s.Incr("n", 3); err != nil || v != 8 {
+		t.Fatalf("Incr = %d, %v; want 8", v, err)
+	}
+	s.Set("s", "abc", 0)
+	if _, err := s.Incr("s", 1); !errors.Is(err, ErrNotInteger) {
+		t.Fatalf("Incr non-integer err = %v, want ErrNotInteger", err)
+	}
+	// keeps existing ttl
+	s, now := newFakeClock()
+	s.Set("m", "10", time.Minute)
+	s.Incr("m", 1)
+	*now = now.Add(30 * time.Second)
+	if v, ok := s.Get("m"); !ok || v != "11" {
+		t.Fatalf("Incr with ttl = %q, %v", v, ok)
+	}
+	// expired key counts as 0 and loses expiry
+	*now = now.Add(time.Minute)
+	if v, err := s.Incr("m", 1); err != nil || v != 1 {
+		t.Fatalf("Incr expired = %d, %v; want 1", v, err)
+	}
+	if got := s.TTL("m"); got != time.Duration(-1) {
+		t.Fatalf("ttl after incr of expired = %v, want -1", got)
+	}
+}
+
+func TestKeysGlob(t *testing.T) {
+	s, now := newFakeClock()
+	for _, k := range []string{"user:1", "user:2", "user:x", "page", "pages", "a/b/c", "file.txt"} {
+		s.Set(k, "v", 0)
+	}
+	s.Set("user:3", "v", time.Second) // expired: must not appear
+	*now = now.Add(2 * time.Second)
+
+	check := func(pattern string, want ...string) {
+		t.Helper()
+		got := s.Keys(pattern)
+		if len(got) != len(want) {
+			t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+			}
+		}
+	}
+	check("*", "a/b/c", "file.txt", "page", "pages", "user:1", "user:2", "user:x") // * matches '/'
+	check("user:*", "user:1", "user:2", "user:x")
+	check("user:?", "user:1", "user:2", "user:x")
+	check("user:[12]", "user:1", "user:2")
+	check("user:[1-2]", "user:1", "user:2")
+	check("user:[!1-9]", "user:x")
+	check("user:[^1-9]", "user:x")
+	check(`user\:*`, "user:1", "user:2", "user:x") // escaped char
+	check("pag?", "page")
+	check("a*", "a/b/c") // star crosses slashes
+	check("file.???", "file.txt")
+	check("a*/c", "a/b/c")
+	check("nomatch*")
+	check("")
+}
+
+func TestLen(t *testing.T) {
+	s, now := newFakeClock()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", time.Second)
+	if got := s.Len(); got != 2 {
+		t.Fatalf("Len = %d, want 2", got)
+	}
+	*now = now.Add(2 * time.Second)
+	if got := s.Len(); got != 1 {
+		t.Fatalf("Len after expiry = %d, want 1", got)
+	}
+}
+
+func TestSaveLoad(t *testing.T) {
+	s, now := newFakeClock()
+	s.Set("b", "2", 0)
+	s.Set("a", "1", time.Minute)
+	s.Set("gone", "x", time.Second)
+
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.String()
+	// entries sorted, expired dropped, version field present
+	want := `{"version":1,"entries":[{"k":"a","v":"1","exp":`
+	if !bytes.HasPrefix([]byte(data), []byte(want)) {
+		t.Fatalf("Save output = %s", data)
+	}
+	if !bytes.Contains([]byte(data), []byte(`"k":"b","v":"2","exp":0}`)) {
+		t.Fatalf("Save output missing b/0: %s", data)
+	}
+
+	*now = now.Add(30 * time.Second)
+	s2 := New(func() time.Time { return *now })
+	if err := s2.Load(&buf); err != nil {
+		t.Fatal(err)
+	}
+	if got := s2.Len(); got != 2 {
+		t.Fatalf("Len after load = %d, want 2", got)
+	}
+	if v, ok := s2.Get("a"); !ok || v != "1" {
+		t.Fatalf("Get(a) after load = %q, %v", v, ok)
+	}
+	if v, ok := s2.Get("b"); !ok || v != "2" {
+		t.Fatalf("Get(b) after load = %q, %v", v, ok)
+	}
+	if got := s2.TTL("a"); got <= 0 || got >= time.Minute {
+		t.Fatalf("TTL(a) after load = %v", got)
+	}
+
+	// load replaces all contents
+	s2.Set("extra", "y", 0)
+	buf.Reset()
+	s.Save(&buf)
+	s2.Load(&buf)
+	if s2.Exists("extra") {
+		t.Fatal("Load should replace all contents")
+	}
+
+	// expired at load time are dropped
+	s3, _ := newFakeClock()
+	s3.Set("old", "1", time.Second)
+	s3.Set("keep", "2", 0)
+	buf.Reset()
+	s3.Save(&buf)
+	*now = now.Add(time.Hour)
+	s4 := New(func() time.Time { return *now })
+	s4.Load(&buf)
+	if s4.Exists("old") {
+		t.Fatal("expired entry should be dropped on load")
+	}
+	if !s4.Exists("keep") {
+		t.Fatal("non-expired entry should survive load")
+	}
+
+	// wrong version rejected
+	if err := s.Load(bytes.NewReader([]byte(`{"version":2,"entries":[]}`))); err == nil {
+		t.Fatal("Load should reject other versions")
+	}
+}
+
+func TestConcurrent(t *testing.T) {
+	s := New(nil)
+	done := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			defer func() { done <- struct{}{} }()
+			for j := 0; j < 200; j++ {
+				k := "k" + string(rune('a'+i%4))
+				s.Set(k, "v", time.Millisecond)
+				s.Get(k)
+				s.Incr("counter", 1)
+				s.Keys("k*")
+				s.Len()
+				s.Del("x")
+				s.Expire(k, time.Millisecond)
+			}
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+}
