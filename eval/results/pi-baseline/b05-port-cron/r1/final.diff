+// Package cron is a Go port of the reference Python cron-expression
+// library (reference/cron.py) with identical behaviour, including error
+// messages.
+//
+// Syntax: five space-separated fields: minute hour day-of-month month day-of-week
+//
+//	minute 0-59, hour 0-23, day-of-month 1-31, month 1-12 (or JAN-DEC),
+//	day-of-week 0-6 (or SUN-SAT; 7 is also Sunday)
+//
+// Each field is a comma-separated list of items: "*", "N", "N-M",
+// "*/S", "N-M/S", "N/S". Names (JAN..DEC, SUN..SAT) are case-insensitive
+// and may be used wherever a number may.
+//
+// Macros: @yearly, @annually, @monthly, @weekly, @daily, @midnight, @hourly.
+//
+// Day matching follows Vixie cron: if both day-of-month and day-of-week
+// are restricted (neither field is "*"), a day matches when EITHER
+// matches; otherwise both must match.
+package cron
+
+import (
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type fieldSpec struct {
+	name string
+	lo   int
+	hi   int
+}
+
+var fieldSpecs = [5]fieldSpec{
+	{"minute", 0, 59},
+	{"hour", 0, 23},
+	{"day-of-month", 1, 31},
+	{"month", 1, 12},
+	{"day-of-week", 0, 6},
+}
+
+var monthNames = [12]string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+
+var dayNames = [7]string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var macros = map[string]string{
+	"@yearly":   "0 0 1 1 *",
+	"@annually": "0 0 1 1 *",
+	"@monthly":  "0 0 1 * *",
+	"@weekly":   "0 0 * * 0",
+	"@daily":    "0 0 * * *",
+	"@midnight": "0 0 * * *",
+	"@hourly":   "0 * * * *",
+}
+
+// Schedule represents a parsed cron expression.
+type Schedule struct {
+	expr    string
+	minute  map[int]bool
+	hour    map[int]bool
+	dom     map[int]bool
+	month   map[int]bool
+	dow     map[int]bool
+	domStar bool
+	dowStar bool
+}
+
+// Parse parses a cron expression, accepting the same syntax as the
+// reference parse(). Error messages match the Python CronError messages.
+func Parse(expr string) (*Schedule, error) {
+	e := strings.TrimSpace(expr)
+	if strings.HasPrefix(e, "@") {
+		m, ok := macros[strings.ToLower(e)]
+		if !ok {
+			return nil, fmt.Errorf("unknown macro %s", pyRepr(e))
+		}
+		e = m
+	}
+	parts := strings.Fields(e)
+	if len(parts) != 5 {
+		return nil, fmt.Errorf("expected 5 fields, got %d", len(parts))
+	}
+	s := &Schedule{
+		expr:    e,
+		domStar: parts[2] == "*",
+		dowStar: parts[4] == "*",
+	}
+	targets := [5]*map[int]bool{&s.minute, &s.hour, &s.dom, &s.month, &s.dow}
+	for i, p := range parts {
+		values, err := parseField(p, i)
+		if err != nil {
+			return nil, err
+		}
+		*targets[i] = values
+	}
+	return s, nil
+}
+
+// pyRepr renders a string the way Python's repr() does (for the kinds of
+// strings that appear in error messages: single quotes by default, double
+// quotes when the string contains a single quote but no double quote,
+// backslashes and control characters escaped).
+func pyRepr(s string) string {
+	quote := byte('\'')
+	if strings.ContainsRune(s, '\'') && !strings.ContainsRune(s, '"') {
+		quote = '"'
+	}
+	var b strings.Builder
+	b.WriteByte(quote)
+	for _, r := range s {
+		switch {
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == rune(quote):
+			b.WriteByte('\\')
+			b.WriteRune(r)
+		case r < 0x20:
+			switch r {
+			case '\n':
+				b.WriteString(`\n`)
+			case '\t':
+				b.WriteString(`\t`)
+			case '\r':
+				b.WriteString(`\r`)
+			case '\v':
+				b.WriteString(`\v`)
+			case '\f':
+				b.WriteString(`\f`)
+			default:
+				b.WriteString(fmt.Sprintf("\\x%02x", r))
+			}
+		case r == 0x7f || (r >= 0x80 && r <= 0x9f):
+			b.WriteString(fmt.Sprintf("\\x%02x", r))
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte(quote)
+	return b.String()
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func value(tok string, idx int) (int, error) {
+	spec := fieldSpecs[idx]
+	u := strings.ToUpper(tok)
+	if idx == 3 {
+		for i, m := range monthNames {
+			if u == m {
+				return i + 1, nil
+			}
+		}
+	}
+	if idx == 4 {
+		for i, d := range dayNames {
+			if u == d {
+				return i, nil
+			}
+		}
+	}
+	if !isDigits(tok) {
+		return 0, fmt.Errorf("%s: invalid value %s", spec.name, pyRepr(tok))
+	}
+	v, _ := new(big.Int).SetString(tok, 10) // tok is all digits; never fails
+	if idx == 4 && v.Cmp(big.NewInt(7)) == 0 {
+		v.SetInt64(0)
+	}
+	if v.Cmp(big.NewInt(int64(spec.lo))) < 0 || v.Cmp(big.NewInt(int64(spec.hi))) > 0 {
+		return 0, fmt.Errorf("%s: value %s out of range %d-%d", spec.name, v.String(), spec.lo, spec.hi)
+	}
+	return int(v.Int64()), nil
+}
+
+func parseField(text string, idx int) (map[int]bool, error) {
+	spec := fieldSpecs[idx]
+	if text == "" {
+		return nil, fmt.Errorf("%s: empty field", spec.name)
+	}
+	values := make(map[int]bool)
+	for _, item := range strings.Split(text, ",") {
+		if item == "" {
+			return nil, fmt.Errorf("%s: empty item", spec.name)
+		}
+		step := 1
+		base := item
+		if i := strings.Index(item, "/"); i >= 0 {
+			base = item[:i]
+			stepStr := item[i+1:]
+			if !isDigits(stepStr) {
+				return nil, fmt.Errorf("%s: invalid step %s", spec.name, pyRepr(stepStr))
+			}
+			bv, _ := new(big.Int).SetString(stepStr, 10)
+			if bv.Sign() < 1 {
+				return nil, fmt.Errorf("%s: invalid step %s", spec.name, pyRepr(stepStr))
+			}
+			if bv.BitLen() > 32 {
+				// Python ints are unbounded; any step larger than the field
+				// span (max 60) selects only the start value.
+				step = 1 << 30
+			} else {
+				step = int(bv.Int64())
+			}
+		}
+		var start, end int
+		switch {
+		case base == "*":
+			start, end = spec.lo, spec.hi
+		case strings.Contains(base, "-"):
+			a, b, _ := strings.Cut(base, "-")
+			v1, err := value(a, idx)
+			if err != nil {
+				return nil, err
+			}
+			v2, err := value(b, idx)
+			if err != nil {
+				return nil, err
+			}
+			if v1 > v2 {
+				return nil, fmt.Errorf("%s: range %d-%d is reversed", spec.name, v1, v2)
+			}
+			start, end = v1, v2
+		default:
+			v, err := value(base, idx)
+			if err != nil {
+				return nil, err
+			}
+			start = v
+			end = v
+			if strings.Contains(item, "/") {
+				end = spec.hi
+			}
+		}
+		for v := start; v <= end; v += step {
+			values[v] = true
+		}
+	}
+	return values, nil
+}
+
+func (s *Schedule) dayOK(t time.Time) bool {
+	inDom := s.dom[t.Day()]
+	inDow := s.dow[int(t.Weekday())]
+	if !s.domStar && !s.dowStar {
+		return inDom || inDow
+	}
+	return inDom && inDow
+}
+
+// Next returns the first time matching the schedule strictly after after,
+// in after's location, matching the reference next_run().
+func (s *Schedule) Next(after time.Time) (time.Time, error) {
+	loc := after.Location()
+	t := time.Date(after.Year(), after.Month(), after.Day(), after.Hour(), after.Minute(), 0, 0, loc).Add(time.Minute)
+	limit := after.AddDate(0, 0, 366*5)
+	for !t.After(limit) {
+		if !s.month[int(t.Month())] {
+			y, m := t.Year(), int(t.Month())
+			if m == 12 {
+				y, m = y+1, 1
+			} else {
+				m++
+			}
+			t = time.Date(y, time.Month(m), 1, 0, 0, 0, 0, loc)
+			continue
+		}
+		if !s.dayOK(t) {
+			t = time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, loc).AddDate(0, 0, 1)
+			continue
+		}
+		if !s.hour[t.Hour()] {
+			t = time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), 0, 0, 0, loc).Add(time.Hour)
+			continue
+		}
+		if !s.minute[t.Minute()] {
+			t = t.Add(time.Minute)
+			continue
+		}
+		return t, nil
+	}
+	return time.Time{}, fmt.Errorf("no match within 5 years for %s", pyRepr(s.expr))
+}
+
+// String returns the canonical description of the schedule, matching the
+// reference describe().
+func (s *Schedule) String() string {
+	vals := [5]map[int]bool{s.minute, s.hour, s.dom, s.month, s.dow}
+	out := make([]string, 5)
+	for i := 0; i < 5; i++ {
+		out[i] = formatField(vals[i], i)
+	}
+	return strings.Join(out, " ")
+}
+
+func formatField(values map[int]bool, idx int) string {
+	spec := fieldSpecs[idx]
+	if len(values) == spec.hi-spec.lo+1 {
+		full := true
+		for v := spec.lo; v <= spec.hi; v++ {
+			if !values[v] {
+				full = false
+				break
+			}
+		}
+		if full {
+			return "*"
+		}
+	}
+	vs := make([]int, 0, len(values))
+	for v := range values {
+		vs = append(vs, v)
+	}
+	sortInts(vs)
+	var out []string
+	for i := 0; i < len(vs); {
+		j := i
+		for j+1 < len(vs) && vs[j+1] == vs[j]+1 {
+			j++
+		}
+		if j-i < 2 {
+			out = append(out, strconv.Itoa(vs[i]))
+		} else {
+			out = append(out, fmt.Sprintf("%d-%d", vs[i], vs[j]))
+		}
+		if j-i == 1 {
+			out = append(out, strconv.Itoa(vs[i+1]))
+		}
+		i = j + 1
+	}
+	return strings.Join(out, ",")
+}
+
+func sortInts(vs []int) {
+	// insertion sort is fine for field sizes <= 60
+	for i := 1; i < len(vs); i++ {
+		for j := i; j > 0 && vs[j-1] > vs[j]; j-- {
+			vs[j-1], vs[j] = vs[j], vs[j-1]
+		}
+	}
+}
