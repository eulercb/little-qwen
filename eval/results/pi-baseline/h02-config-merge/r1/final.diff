+
+func TestMergeDoesNotModifyArguments(t *testing.T) {
+	base := Defaults()
+	baseTags := []string{"base"}
+	base.Tags = baseTags
+	ov := Config{Tags: []string{"override", "tag2"}}
+	ovTags := ov.Tags
+
+	Merge(base, ov)
+
+	if len(baseTags) != 1 || baseTags[0] != "base" {
+		t.Fatalf("base.Tags modified: %v", baseTags)
+	}
+	if len(ovTags) != 2 || ovTags[0] != "override" || ovTags[1] != "tag2" {
+		t.Fatalf("override.Tags modified: %v", ovTags)
+	}
