+
+func TestMergeZeroOverrideKeepsBase(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"keep"}
+	merged := Merge(base, Config{})
+	if merged.Host != base.Host || merged.Port != base.Port || merged.Debug != base.Debug ||
+		merged.Workers != base.Workers || merged.Timeout != base.Timeout ||
+		len(merged.Tags) != 1 || merged.Tags[0] != "keep" {
+		t.Fatalf("zero override changed config: %+v vs %+v", merged, base)
