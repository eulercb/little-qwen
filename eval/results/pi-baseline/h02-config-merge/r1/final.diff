+func TestLoadTags(t *testing.T) {
+	c, err := Load(env(map[string]string{"APP_TAGS": "a, b ,,c,"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"a", "b", "c"}
+	if len(c.Tags) != len(want) {
+		t.Fatalf("tags = %v, want %v", c.Tags, want)
