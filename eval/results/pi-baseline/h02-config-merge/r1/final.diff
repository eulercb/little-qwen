 }
 
 // Defaults returns the built-in configuration.
 func Defaults() Config {
-	return Config{Host: "localhost", Port: 8080, Workers: 4}
+	return Config{Host: "localhost", Port: 8080, Workers: 4, Timeout: 30 * time.Second}
 }
 
 // Load starts from Defaults and applies environment overrides from getenv:
-// APP_HOST, APP_PORT (1-65535), APP_DEBUG (strconv.ParseBool), APP_WORKERS (>= 1).
+// APP_HOST, APP_PORT (1-65535), APP_DEBUG (strconv.ParseBool), APP_WORKERS (>= 1),
+// APP_TIMEOUT (time.ParseDuration), APP_TAGS (comma-separated, items trimmed,
+// empty items dropped).
+//
+// All invalid environment values are collected and returned together as a
+// single error listing each offending variable name; in that case the zero
+// Config is returned.
 func Load(getenv func(string) string) (Config, error) {
 	c := Defaults()
+	var errs []error
+
 	if v := getenv("APP_HOST"); v != "" {
 		c.Host = v
 	}
 	if v := getenv("APP_PORT"); v != "" {
 		p, err := strconv.Atoi(v)
 		if err != nil || p < 1 || p > 65535 {
-			return Config{}, fmt.Errorf("APP_PORT: invalid port %q", v)
+			errs = append(errs, fmt.Errorf("APP_PORT: invalid port %q", v))
+		} else {
+			c.Port = p
 		}
-		c.Port = p
 	}
 	if v := getenv("APP_DEBUG"); v != "" {
 		b, err := strconv.ParseBool(v)
 		if err != nil {
-			return Config{}, fmt.Errorf("APP_DEBUG: invalid bool %q", v)
+			errs = append(errs, fmt.Errorf("APP_DEBUG: invalid bool %q", v))
+		} else {
+			c.Debug = b
 		}
-		c.Debug = b
 	}
 	if v := getenv("APP_WORKERS"); v != "" {
 		n, err := strconv.Atoi(v)
 		if err != nil || n < 1 {
-			return Config{}, fmt.Errorf("APP_WORKERS: invalid count %q", v)
+			errs = append(errs, fmt.Errorf("APP_WORKERS: invalid count %q", v))
+		} else {
+			c.Workers = n
 		}
-		c.Workers = n
+	}
+	if v := getenv("APP_TIMEOUT"); v != "" {
+		d, err := time.ParseDuration(v)
+		if err != nil {
+			errs = append(errs, fmt.Errorf("APP_TIMEOUT: invalid duration %q", v))
+		} else {
+			c.Timeout = d
+		}
+	}
+	if v := getenv("APP_TAGS"); v != "" {
+		tags := []string{}
+		for _, part := range strings.Split(v, ",") {
+			p := strings.TrimSpace(part)
+			if p != "" {
+				tags = append(tags, p)
+			}
+		}
+		if len(tags) == 0 {
+			tags = nil
+		}
+		c.Tags = tags
+	}
+
+	if len(errs) > 0 {
+		return Config{}, errors.Join(errs...)
 	}
 	return c, nil
 }
+
+// Merge returns the result of overlaying override on top of base: every
+// field of override that is non-zero replaces the corresponding field in
+// base. For Tags, a non-nil override slice replaces the base slice, even
+// if it is empty. Neither base.Tags nor override.Tags is modified.
+func Merge(base, override Config) Config {
+	c := base
+	if override.Host != "" {
+		c.Host = override.Host
+	}
+	if override.Port != 0 {
+		c.Port = override.Port
+	}
+	if override.Debug {
+		c.Debug = override.Debug
+	}
+	if override.Workers != 0 {
+		c.Workers = override.Workers
+	}
+	if override.Timeout != 0 {
+		c.Timeout = override.Timeout
+	}
+	if override.Tags != nil {
+		c.Tags = override.Tags
+	}
+	return c
+}
