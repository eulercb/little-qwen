+func TestMergeEmptyTagsOverrideReplaces(t *testing.T) {
+	base := Defaults()
+	base.Tags = []string{"a", "b"}
+	merged := Merge(base, Config{Tags: []string{}})
+	if merged.Tags == nil || len(merged.Tags) != 0 {
