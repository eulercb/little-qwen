+// Results must be in input order even when later inputs finish before earlier
+// ones and concurrency is high.
+func TestResultOrder(t *testing.T) {
+	const n = 200
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	for workers := 1; workers <= 16; workers++ {
+		out, err := Map(context.Background(), in, workers, func(_ context.Context, x int) (int, error) {
+			// Deliberately invert finish order: low indices finish last.
+			time.Sleep(time.Duration(n-x) * time.Microsecond)
+			return x * 2, nil
+		})
+		if err != nil {
+			t.Fatalf("workers=%d: %v", workers, err)
+		}
+		if len(out) != n {
+			t.Fatalf("workers=%d: got %d results, want %d", workers, len(out), n)
+		}
+		for i, r := range out {
+			if r != in[i]*2 {
+				t.Fatalf("workers=%d: out[%d] = %d, want %d (results not in input order)", workers, i, r, in[i]*2)
+			}
+		}
+	}
+}
+
+// Stress: randomised latencies under the race detector.
+func TestResultOrderStress(t *testing.T) {
+	const n = 100
+	in := make([]int, n)
+	for i := range in {
+		in[i] = i
+	}
+	var lat [100]time.Duration
+	for i := range lat {
+		lat[i] = time.Duration((i*2654435761)%100) * time.Microsecond
+	}
+	for iter := 0; iter < 25; iter++ {
+		out, err := Map(context.Background(), in, 8, func(_ context.Context, x int) (int, error) {
+			time.Sleep(lat[x])
+			return x + 1000, nil
+		})
+		if err != nil {
+			t.Fatalf("iter %d: %v", iter, err)
+		}
+		for i, r := range out {
+			if r != in[i]+1000 {
+				t.Fatalf("iter %d: out[%d] = %d, want %d", iter, i, r, in[i]+1000)
+			}
+		}
+	}
+}
