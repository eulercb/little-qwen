+func TestEmpty(t *testing.T) {
+	out, err := Map(context.Background(), []int{}, 4, func(_ context.Context, x int) (int, error) { t.Fatal("fn called on empty input"); return 0, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out == nil || len(out) != 0 {
+		t.Fatalf("out = %#v, want empty slice", out)
+	}
+}
