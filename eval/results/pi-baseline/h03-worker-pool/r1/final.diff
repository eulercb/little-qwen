+// Format check for IndexError.
+func TestIndexErrorFormat(t *testing.T) {
+	ie := &IndexError{Index: 3, Err: fmt.Errorf("kaput")}
+	want := "pool: input 3: kaput"
+	if got := ie.Error(); got != want {
+		t.Fatalf("Error() = %q, want %q", got, want)
+	}
+	if errors.Unwrap(ie) != ie.Err {
+		t.Fatal("Unwrap should return wrapped error")
+	}
