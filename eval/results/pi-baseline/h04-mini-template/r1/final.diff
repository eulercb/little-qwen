+// Package tmpl is a tiny text template engine.
+package tmpl
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// htmlEscaper escapes the five HTML special characters.
+var htmlEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&#34;",
+	"'", "&#39;",
+)
+
+// filterArity maps filter names to their required argument count.
+var filterArity = map[string]int{
+	"upper":    0,
+	"lower":    0,
+	"trim":     0,
+	"default":  1,
+	"truncate": 1,
+	"html":     0,
+}
+
+// Render renders src as a template using data.
+// Text outside {{ ... }} is copied verbatim; {{{{{ ... }}}}}-style
+// {{{{ sequences produce a literal {{.
+func Render(src string, data map[string]any) (string, error) {
+	var b strings.Builder
+	i := 0
+	for i < len(src) {
+		if strings.HasPrefix(src[i:], "{{{{") {
+			b.WriteString("{{")
+			i += 4
+			continue
+		}
+		start := strings.Index(src[i:], "{{")
+		if start == -1 {
+			b.WriteString(src[i:])
+			break
+		}
+		b.WriteString(src[i : i+start])
+		i += start // now at the opening "{{"
+		if strings.HasPrefix(src[i:], "{{{{") {
+			// The found "{{" is actually a "{{{{" literal-escape.
+			continue
+		}
+		rest := src[i+2:]
+		end := strings.Index(rest, "}}")
+		if end == -1 {
+			return "", fmt.Errorf("tmpl: unterminated tag %q", strings.TrimSpace(rest))
+		}
+		out, err := renderTag(rest[:end], data)
+		if err != nil {
+			return "", err
+		}
+		b.WriteString(out)
+		i += 2 + end + 2 // consume "{{", tag body, "}}"
+	}
+	return b.String(), nil
+}
+
+// renderTag renders the body of a single tag (the text between {{ and }}).
+func renderTag(raw string, data map[string]any) (string, error) {
+	if strings.TrimSpace(raw) == "" {
+		return "", fmt.Errorf("tmpl: empty tag")
+	}
+	parts := strings.Split(raw, "|")
+	nameExpr := strings.TrimSpace(parts[0])
+	fullName, ok := parseName(nameExpr)
+	if !ok {
+		return "", fmt.Errorf("tmpl: bad name %q", nameExpr)
+	}
+	val, err := lookup(fullName, data)
+	if err != nil {
+		return "", err
+	}
+	s := formatValue(val)
+	for _, p := range parts[1:] {
+		var fname string
+		var arg string
+		var hasArg bool
+		p = strings.TrimSpace(p)
+		if idx := strings.IndexByte(p, ':'); idx != -1 {
+			fname = strings.TrimSpace(p[:idx])
+			a, err := parseArg(p[idx+1:])
+			if err != nil {
+				return "", fmt.Errorf("tmpl: filter %q: %v", p, err)
+			}
+			arg, hasArg = a, true
+		} else {
+			fname = p
+		}
+		want, known := filterArity[fname]
+		if !known {
+			return "", fmt.Errorf("tmpl: unknown filter %q", fname)
+		}
+		if (want == 0 && hasArg) || (want == 1 && !hasArg) {
+			if want == 0 {
+				return "", fmt.Errorf("tmpl: extra argument for filter %q", fname)
+			}
+			return "", fmt.Errorf("tmpl: missing argument for filter %q", fname)
+		}
+		s, err = applyFilter(fname, s, arg)
+		if err != nil {
+			return "", err
+		}
+	}
+	return s, nil
+}
+
+// parseName validates a name: identifier optionally followed by .field
+// segments. It returns the full name and whether it is valid.
+func parseName(s string) (string, bool) {
+	if s == "" {
+		return "", false
+	}
+	for _, seg := range strings.Split(s, ".") {
+		if !validIdent(seg) {
+			return "", false
+		}
+	}
+	return s, true
+}
+
+// validIdent reports whether s is a valid identifier.
+func validIdent(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i, r := range s {
+		switch {
+		case r == '_':
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z':
+		case i > 0 && r >= '0' && r <= '9':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// lookup resolves a (possibly dotted) name in data.
+// A missing name or field yields (nil, nil); indexing a non-map
+// yields an error mentioning the full name.
+func lookup(fullName string, data map[string]any) (any, error) {
+	segs := strings.Split(fullName, ".")
+	v, ok := data[segs[0]]
+	if !ok {
+		return nil, nil
+	}
+	for _, seg := range segs[1:] {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("tmpl: cannot index %q into a non-map value", fullName)
+		}
+		v, ok = m[seg]
+		if !ok {
+			return nil, nil
+		}
+	}
+	return v, nil
+}
+
+// formatValue renders a value as a string.
+func formatValue(v any) string {
+	switch t := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return t
+	case bool:
+		return strconv.FormatBool(t)
+	case int:
+		return fmt.Sprint(t)
+	case int64:
+		return fmt.Sprint(t)
+	case float64:
+		return fmt.Sprint(t)
+	default:
+		return fmt.Sprint(t)
+	}
+}
+
+// parseArg parses a double-quoted argument, supporting \" and \\ escapes.
+func parseArg(s string) (string, error) {
+	s = strings.TrimSpace(s)
+	if len(s) < 2 || s[0] != '"' {
+		return "", fmt.Errorf("bad argument %q: expected a double-quoted string", s)
+	}
+	var b strings.Builder
+	for i := 1; i < len(s); i++ {
+		c := s[i]
+		if c == '\\' {
+			if i+1 >= len(s) {
+				return "", fmt.Errorf("bad argument %q: trailing backslash", s)
+			}
+			b.WriteByte(s[i+1])
+			i++
+		} else if c == '"' {
+			if rest := strings.TrimSpace(s[i+1:]); rest != "" {
+				return "", fmt.Errorf("bad argument %q: trailing data %q", s, rest)
+			}
+			return b.String(), nil
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return "", fmt.Errorf("bad argument %q: unterminated string", s)
+}
+
+// applyFilter applies a named filter to s.
+func applyFilter(name, s, arg string) (string, error) {
+	switch name {
+	case "upper":
+		return strings.ToUpper(s), nil
+	case "lower":
+		return strings.ToLower(s), nil
+	case "trim":
+		return strings.TrimSpace(s), nil
+	case "html":
+		return htmlEscaper.Replace(s), nil
+	case "default":
+		if s == "" {
+			return arg, nil
+		}
+		return s, nil
+	case "truncate":
+		n, err := strconv.Atoi(arg)
+		if err != nil || n < 0 {
+			return "", fmt.Errorf("tmpl: bad argument %q for filter \"truncate\": must be a non-negative integer", arg)
+		}
+		r := []rune(s)
+		if len(r) > n {
+			return string(r[:n]) + "…", nil
+		}
+		return s, nil
+	}
+	panic("unreachable: unknown filter " + name)
+}
