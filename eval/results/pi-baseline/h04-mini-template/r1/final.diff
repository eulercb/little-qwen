+package tmpl
+
+import (
+	"strings"
+	"testing"
+)
+
+func render(t *testing.T, src string, data map[string]any) string {
+	t.Helper()
+	out, err := Render(src, data)
+	if err != nil {
+		t.Fatalf("Render(%q) error: %v", src, err)
+	}
+	return out
+}
+
+func mustError(t *testing.T, src string, data map[string]any, contains ...string) {
+	t.Helper()
+	out, err := Render(src, data)
+	if err == nil {
+		t.Fatalf("Render(%q) = %q, want error", src, out)
+	}
+	if out != "" {
+		t.Fatalf("Render(%q) output = %q on error, want empty", src, out)
+	}
+	for _, c := range contains {
+		if !strings.Contains(err.Error(), c) {
+			t.Fatalf("error %q does not contain %q", err, c)
+		}
+	}
+}
+
+func TestVerbatimText(t *testing.T) {
+	if got := render(t, "hello, plain text", nil); got != "hello, plain text" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestBasicSubstitution(t *testing.T) {
+	data := map[string]any{"name": "World"}
+	if got := render(t, "Hi {{name}}!", data); got != "Hi World!" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestWhitespaceInTag(t *testing.T) {
+	data := map[string]any{"name": "World"}
+	if got := render(t, "Hi {{  name  |  upper  }}!", data); got != "Hi WORLD!" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestNestedFields(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{"name": "Ada", "age": 36},
+	}
+	if got := render(t, "{{user.name}} is {{user.age}}", data); got != "Ada is 36" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestDeeplyNested(t *testing.T) {
+	data := map[string]any{
+		"user": map[string]any{
+			"address": map[string]any{"city": "Paris"},
+		},
+	}
+	if got := render(t, "{{user.address.city}}", data); got != "Paris" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestMissingNameIsEmpty(t *testing.T) {
+	if got := render(t, "[{{nope}}]", map[string]any{"x": 1}); got != "[]" {
+		t.Errorf("got %q", got)
+	}
+	if got := render(t, "[{{a.b}}]", map[string]any{"a": map[string]any{}}); got != "[]" {
+		t.Errorf("missing nested field: got %q", got)
+	}
+}
+
+func TestNilIsEmpty(t *testing.T) {
+	if got := render(t, "[{{x}}]", map[string]any{"x": nil}); got != "[]" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestValueFormatting(t *testing.T) {
+	data := map[string]any{
+		"s":  "text",
+		"i":  42,
+		"i64": int64(7),
+		"f":  1.5,
+		"b1": true,
+		"b0": false,
+	}
+	if got := render(t, "{{s}}|{{i}}|{{i64}}|{{f}}|{{b1}}|{{b0}}", data); got != "text|42|7|1.5|true|false" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestLiteralBraces(t *testing.T) {
+	data := map[string]any{"name": "x"}
+	if got := render(t, "{{{{name}}", data); got != "{{name}}" {
+		t.Errorf("got %q", got)
+	}
+	if got := render(t, "a{{{{}}}}b", data); got != "a{{}}}}b" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestUpperLowerTrim(t *testing.T) {
+	data := map[string]any{"v": "  Hello  "}
+	if got := render(t, "{{v | upper}}", data); got != "  HELLO  " {
+		t.Errorf("upper: got %q", got)
+	}
+	if got := render(t, "{{v | lower}}", data); got != "  hello  " {
+		t.Errorf("lower: got %q", got)
+	}
+	if got := render(t, "{{v | trim}}", data); got != "Hello" {
+		t.Errorf("trim: got %q", got)
+	}
+}
+
+func TestDefault(t *testing.T) {
+	data := map[string]any{"empty": "", "full": "yes"}
+	if got := render(t, "{{empty | default:\"-\"}}", data); got != "-" {
+		t.Errorf("got %q", got)
+	}
+	if got := render(t, "{{full | default:\"-\"}}", data); got != "yes" {
+		t.Errorf("got %q", got)
+	}
+	// default supplies a value for missing names.
+	if got := render(t, "[{{nope | default:\"x\"}}]", data); got != "[x]" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestDefaultWithEscapes(t *testing.T) {
+	if got := render(t, `{{v | default:"say \"hi\" \\ done" | upper}}`, nil); got != `SAY "HI" \ DONE` {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestTruncate(t *testing.T) {
+	data := map[string]any{"v": "héllo world"}
+	if got := render(t, `{{v | truncate:"11"}}`, data); got != "héllo world" {
+		t.Errorf("no cut: got %q", got)
+	}
+	if got := render(t, `{{v | truncate:"5"}}`, data); got != "héllo…" {
+		t.Errorf("cut: got %q", got)
+	}
+	if got := render(t, `{{v | truncate:"0"}}`, data); got != "…" {
+		t.Errorf("zero: got %q", got)
+	}
+	// runes, not bytes: "héllo" is 5 runes (6 bytes).
+	if got := render(t, `{{v | truncate:"6"}}`, data); got != "héllo …" {
+		t.Errorf("rune count: got %q", got)
+	}
+}
+
+func TestHTML(t *testing.T) {
+	data := map[string]any{"v": `& < > " '`}
+	if got := render(t, `{{v | html}}`, data); got != "&amp; &lt; &gt; &#34; &#39;" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestChainedFilters(t *testing.T) {
+	data := map[string]any{"v": "  Hello, <world>  "}
+	if got := render(t, `{{v | trim | upper | html}}`, data); got != "HELLO, &lt;WORLD&gt;" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestErrorUnknownFilter(t *testing.T) {
+	mustError(t, `{{v | bogus}}`, map[string]any{"v": "x"}, "bogus")
+}
+
+func TestErrorMissingArgument(t *testing.T) {
+	mustError(t, `{{v | default}}`, map[string]any{"v": "x"}, "default")
+}
+
+func TestErrorExtraArgument(t *testing.T) {
+	mustError(t, `{{v | upper:"x"}}`, map[string]any{"v": "x"}, "upper")
+}
+
+func TestErrorBadTruncateArgument(t *testing.T) {
+	mustError(t, `{{v | truncate:"abc"}}`, map[string]any{"v": "x"}, "truncate")
+	mustError(t, `{{v | truncate:"-1"}}`, map[string]any{"v": "x"}, "truncate")
+}
+
+func TestErrorUnterminatedTag(t *testing.T) {
+	mustError(t, `hello {{name`, map[string]any{"name": "x"})
+}
+
+func TestErrorEmptyTag(t *testing.T) {
+	mustError(t, `hello {{   }} world`, nil)
+}
+
+func TestErrorBadName(t *testing.T) {
+	mustError(t, `{{123}}`, nil, "123")
+	mustError(t, `{{.field}}`, nil)
+	mustError(t, `{{user.1name}}`, nil)
+	mustError(t, `{{user name}}`, nil)
+}
+
+func TestErrorIndexNonMap(t *testing.T) {
+	mustError(t, `{{user.name.first}}`, map[string]any{"user": map[string]any{"name": "Ada"}}, "user.name.first")
+	mustError(t, `{{user.name.first}}`, map[string]any{"user": map[string]any{"name": 5}}, "user.name.first")
+}
+
+func TestErrorBadArgumentSyntax(t *testing.T) {
+	mustError(t, `{{v | default:unquoted}}`, map[string]any{"v": ""})
+	mustError(t, `{{v | default:"unclosed}}`, map[string]any{"v": ""})
+	mustError(t, `{{v | default:"a" junk}}`, map[string]any{"v": ""})
+}
+
+func TestMultipleTagsAndVerbatim(t *testing.T) {
+	data := map[string]any{"a": "A", "b": "B"}
+	if got := render(t, "one {{a}} two {{b}} three {{a}}", data); got != "one A two B three A" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestEmptySource(t *testing.T) {
+	if got := render(t, "", nil); got != "" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestNilData(t *testing.T) {
+	if got := render(t, "[{{x}}]", nil); got != "[]" {
+		t.Errorf("got %q", got)
+	}
+}
