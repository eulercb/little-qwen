index 0000000..4f21e20
--- /dev/null
+++ b/expr/lexer.go
@@ -0,0 +1,139 @@
+package expr
+
+import (
+	"fmt"
+	"strconv"
+)
+
+type tokKind int
+
+const (
+	tokEOF tokKind = iota
+	tokNum
+	tokIdent
+	tokBool
+	tokOp
+)
+
+type token struct {
+	kind tokKind
+	pos  int
+	num  float64 // value for tokNum / tokBool
+	str  string  // identifier name, number literal text, operator text
+}
+
+func (t token) text() string {
+	if t.kind == tokEOF {
+		return "end of input"
+	}
+	return t.str
+}
+
+var twoCharOps = []string{"&&", "||", "<=", ">=", "==", "!="}
+
+var singleCharOps = "+-*/%^(),?:!<>"
+
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func isIdentStart(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdentPart(c byte) bool { return isIdentStart(c) || isDigit(c) }
+
+func isSpace(c byte) bool { return c == ' ' || c == '\t' || c == '\n' }
+
+// lex scans src into a token slice terminated by an EOF token.
+func lex(src string) ([]token, *Error) {
+	var toks []token
+	i, n := 0, len(src)
+	for i < n {
+		c := src[i]
+		switch {
+		case isSpace(c):
+			i++
+		case isDigit(c) || c == '.':
+			val, j, err := lexNumber(src, i)
+			if err != nil {
+				return nil, &Error{Pos: i, Msg: fmt.Sprintf("unexpected character '%c'", c)}
+			}
+			toks = append(toks, token{kind: tokNum, pos: i, num: val, str: src[i:j]})
+			i = j
+		case isIdentStart(c):
+			j := i + 1
+			for j < n && isIdentPart(src[j]) {
+				j++
+			}
+			name := src[i:j]
+			if name == "true" || name == "false" {
+				v := 0.0
+				if name == "true" {
+					v = 1
+				}
+				toks = append(toks, token{kind: tokBool, pos: i, num: v, str: name})
+			} else {
+				toks = append(toks, token{kind: tokIdent, pos: i, str: name})
+			}
+			i = j
+		default:
+			for _, op := range twoCharOps {
+				if i+1 < n && src[i:i+2] == op {
+					toks = append(toks, token{kind: tokOp, pos: i, str: op})
+					i += 2
+					goto done
+				}
+			}
+			for k := range singleCharOps {
+				if c == singleCharOps[k] {
+					toks = append(toks, token{kind: tokOp, pos: i, str: string(c)})
+					i++
+					goto done
+				}
+			}
+			return nil, &Error{Pos: i, Msg: fmt.Sprintf("unexpected character '%c'", c)}
+		}
+	done:
+	}
+	toks = append(toks, token{kind: tokEOF, pos: n})
+	return toks, nil
+}
+
+// lexNumber parses a numeric literal starting at i. It returns the value, the
+// end offset, and an error if the run is not a valid number.
+func lexNumber(src string, i int) (float64, int, error) {
+	n := len(src)
+	j := i
+	digits := false
+	for j < n && isDigit(src[j]) {
+		j++
+		digits = true
+	}
+	if j < n && src[j] == '.' {
+		j++
+		for j < n && isDigit(src[j]) {
+			j++
+			digits = true
+		}
+	}
+	if j < n && (src[j] == 'e' || src[j] == 'E') {
+		k := j + 1
+		if k < n && (src[k] == '+' || src[k] == '-') {
+			k++
+		}
+		if k < n && isDigit(src[k]) {
+			j = k
+			for j < n && isDigit(src[j]) {
+				j++
+			}
+			digits = true
+		}
+	}
+	if !digits {
+		return 0, 0, fmt.Errorf("not a number")
+	}
+	val, err := strconv.ParseFloat(src[i:j], 64)
+	if err != nil {
+		return 0, 0, err
+	}
+	return val, j, nil
+}
