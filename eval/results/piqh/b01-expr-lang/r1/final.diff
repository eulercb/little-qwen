index 0000000..a239e3f
--- /dev/null
+++ b/expr/parser.go
@@ -0,0 +1,432 @@
+package expr
+
+import (
+	"fmt"
+	"math"
+	"sort"
+)
+
+// AST nodes. pos is the 0-based byte offset of the syntactic element the node
+// errors should be attributed to (operator for binary/unary, name for calls
+// and variables).
+type anyNode interface{ nodePos() int }
+
+type numNode struct {
+	pos int
+	val float64
+}
+
+type varNode struct {
+	pos  int
+	name string
+}
+
+type unaryNode struct {
+	pos int
+	op  string
+	x   anyNode
+}
+
+type binNode struct {
+	pos int
+	op  string
+	l   anyNode
+	r   anyNode
+}
+
+type ternaryNode struct {
+	pos int
+	c   anyNode
+	t   anyNode
+	e   anyNode
+}
+
+type callNode struct {
+	pos  int
+	name string
+	args []anyNode
+}
+
+func (n *numNode) nodePos() int     { return n.pos }
+func (n *varNode) nodePos() int     { return n.pos }
+func (n *unaryNode) nodePos() int   { return n.pos }
+func (n *binNode) nodePos() int     { return n.pos }
+func (n *ternaryNode) nodePos() int { return n.pos }
+func (n *callNode) nodePos() int    { return n.pos }
+
+// builtin is a built-in function definition. max == -1 means unbounded arity.
+type builtin struct {
+	min, max int
+	fn       func([]float64) (float64, *Error)
+}
+
+var builtins = map[string]*builtin{
+	"abs": {1, 1, func(a []float64) (float64, *Error) {
+		return math.Abs(a[0]), nil
+	}},
+	"sqrt": {1, 1, func(a []float64) (float64, *Error) {
+		if a[0] < 0 {
+			return 0, &Error{Pos: 0, Msg: "sqrt of negative number"}
+		}
+		return math.Sqrt(a[0]), nil
+	}},
+	"min": {1, -1, func(a []float64) (float64, *Error) {
+		v := a[0]
+		for _, x := range a[1:] {
+			v = math.Min(v, x)
+		}
+		return v, nil
+	}},
+	"max": {1, -1, func(a []float64) (float64, *Error) {
+		v := a[0]
+		for _, x := range a[1:] {
+			v = math.Max(v, x)
+		}
+		return v, nil
+	}},
+	"round": {1, 1, func(a []float64) (float64, *Error) {
+		return math.Round(a[0]), nil
+	}},
+	"clamp": {3, 3, func(a []float64) (float64, *Error) {
+		return math.Min(math.Max(a[0], a[1]), a[2]), nil
+	}},
+}
+
+type parser struct {
+	toks []token
+	i    int
+}
+
+func (p *parser) peek() token { return p.toks[p.i] }
+
+func (p *parser) next() token {
+	t := p.toks[p.i]
+	if t.kind != tokEOF {
+		p.i++
+	}
+	return t
+}
+
+func (p *parser) acceptOp(op string) bool {
+	t := p.peek()
+	if t.kind == tokOp && t.str == op {
+		p.i++
+		return true
+	}
+	return false
+}
+
+// expectOp consumes op if present, otherwise reports it as missing at the
+// position of the token found instead (len(src) for end of input).
+func (p *parser) expectOp(op string) *Error {
+	t := p.peek()
+	if t.kind == tokOp && t.str == op {
+		p.i++
+		return nil
+	}
+	return &Error{Pos: t.pos, Msg: fmt.Sprintf("expected %q", op)}
+}
+
+// parseProgram parses a complete expression consuming the whole input.
+func parseProgram(toks []token) (anyNode, *Error) {
+	p := &parser{toks: toks}
+	root, err := p.parseTernary()
+	if err != nil {
+		return nil, err
+	}
+	t := p.peek()
+	if t.kind != tokEOF {
+		return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unexpected token %q", t.str)}
+	}
+	return root, nil
+}
+
+// Precedence levels, lowest to highest:
+// ternary (right-assoc) > || > && > equality > comparison > additive >
+// multiplicative > unary > power (right-assoc) > primary.
+
+func (p *parser) parseTernary() (anyNode, *Error) {
+	cond, err := p.parseOr()
+	if err != nil {
+		return nil, err
+	}
+	t := p.peek()
+	if t.kind != tokOp || t.str != "?" {
+		return cond, nil
+	}
+	q := p.next()
+	then, err := p.parseTernary()
+	if err != nil {
+		return nil, err
+	}
+	if err := p.expectOp(":"); err != nil {
+		return nil, err
+	}
+	els, err := p.parseTernary()
+	if err != nil {
+		return nil, err
+	}
+	return &ternaryNode{pos: q.pos, c: cond, t: then, e: els}, nil
+}
+
+func (p *parser) parseOr() (anyNode, *Error) {
+	l, err := p.parseAnd()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp && t.str == "||"; {
+		p.next()
+		r, err := p.parseAnd()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: "||", l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+func (p *parser) parseAnd() (anyNode, *Error) {
+	l, err := p.parseEq()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp && t.str == "&&"; {
+		p.next()
+		r, err := p.parseEq()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: "&&", l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+func (p *parser) parseEq() (anyNode, *Error) {
+	l, err := p.parseCmp()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp && (t.str == "==" || t.str == "!="); {
+		p.next()
+		r, err := p.parseCmp()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: t.str, l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+func (p *parser) parseCmp() (anyNode, *Error) {
+	l, err := p.parseAdd()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp &&
+		(t.str == "<" || t.str == "<=" || t.str == ">" || t.str == ">="); {
+		p.next()
+		r, err := p.parseAdd()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: t.str, l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+func (p *parser) parseAdd() (anyNode, *Error) {
+	l, err := p.parseMul()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp && (t.str == "+" || t.str == "-"); {
+		p.next()
+		r, err := p.parseMul()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: t.str, l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+func (p *parser) parseMul() (anyNode, *Error) {
+	l, err := p.parseUnary()
+	if err != nil {
+		return nil, err
+	}
+	for t := p.peek(); t.kind == tokOp && (t.str == "*" || t.str == "/" || t.str == "%"); {
+		p.next()
+		r, err := p.parseUnary()
+		if err != nil {
+			return nil, err
+		}
+		l = &binNode{pos: t.pos, op: t.str, l: l, r: r}
+		t = p.peek()
+	}
+	return l, nil
+}
+
+// parseUnary handles prefix -, + and !. A unary minus binds tighter than
+// everything left of it but looser than ^: -2^2 = -(2^2).
+func (p *parser) parseUnary() (anyNode, *Error) {
+	t := p.peek()
+	if t.kind == tokOp && (t.str == "-" || t.str == "+" || t.str == "!") {
+		p.next()
+		x, err := p.parseUnary()
+		if err != nil {
+			return nil, err
+		}
+		return &unaryNode{pos: t.pos, op: t.str, x: x}, nil
+	}
+	return p.parsePower()
+}
+
+// parsePower: base is a primary; the exponent may be a unary expression and ^
+// is right-associative, so 2^3^2 = 2^(3^2) and 2^-1 = 2^(-1).
+func (p *parser) parsePower() (anyNode, *Error) {
+	base, err := p.parsePrimary()
+	if err != nil {
+		return nil, err
+	}
+	t := p.peek()
+	if t.kind != tokOp || t.str != "^" {
+		return base, nil
+	}
+	p.next()
+	exp, err := p.parseUnary()
+	if err != nil {
+		return nil, err
+	}
+	return &binNode{pos: t.pos, op: "^", l: base, r: exp}, nil
+}
+
+func (p *parser) parsePrimary() (anyNode, *Error) {
+	t := p.peek()
+	switch t.kind {
+	case tokNum, tokBool:
+		p.next()
+		return &numNode{pos: t.pos, val: t.num}, nil
+	case tokIdent:
+		p.next()
+		if p.peek().kind == tokOp && p.peek().str == "(" {
+			p.next()
+			return p.parseCall(t)
+		}
+		return &varNode{pos: t.pos, name: t.str}, nil
+	case tokOp:
+		if t.str == "(" {
+			p.next()
+			n, err := p.parseTernary()
+			if err != nil {
+				return nil, err
+			}
+			if err := p.expectOp(")"); err != nil {
+				return nil, err
+			}
+			return n, nil
+		}
+	}
+	p.next()
+	if t.kind == tokEOF {
+		return nil, &Error{Pos: t.pos, Msg: "unexpected end of input"}
+	}
+	return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unexpected token %q", t.str)}
+}
+
+// parseCall parses the argument list of a call whose name token is t, and
+// checks the function name and arity.
+func (p *parser) parseCall(t token) (anyNode, *Error) {
+	fn, ok := builtins[t.str]
+	if !ok {
+		return nil, &Error{Pos: t.pos, Msg: fmt.Sprintf("unknown function %q", t.str)}
+	}
+	var args []anyNode
+	if pt := p.peek(); pt.kind == tokOp && pt.str == ")" {
+		p.next()
+	} else {
+		for {
+			a, err := p.parseTernary()
+			if err != nil {
+				return nil, err
+			}
+			args = append(args, a)
+			nt := p.peek()
+			switch nt.kind {
+			case tokOp:
+				if nt.str == ")" {
+					p.next()
+					goto done
+				}
+				if nt.str == "," {
+					p.next()
+					continue
+				}
+			}
+			return nil, &Error{Pos: nt.pos, Msg: `expected ")"`}
+		}
+	}
+done:
+	if fn.max >= 0 && len(args) > fn.max {
+		msg := fmt.Sprintf("function %q expects %d argument%s, got %d",
+			t.str, fn.max, plural(fn.max), len(args))
+		return nil, &Error{Pos: t.pos, Msg: msg}
+	}
+	if len(args) < fn.min {
+		var msg string
+		if fn.max >= 0 {
+			msg = fmt.Sprintf("function %q expects %d argument%s, got %d",
+				t.str, fn.max, plural(fn.max), len(args))
+		} else {
+			msg = fmt.Sprintf("function %q expects at least %d argument%s, got %d",
+				t.str, fn.min, plural(fn.min), len(args))
+		}
+		return nil, &Error{Pos: t.pos, Msg: msg}
+	}
+	return &callNode{pos: t.pos, name: t.str, args: args}, nil
+}
+
+func plural(n int) string {
+	if n == 1 {
+		return ""
+	}
+	return "s"
+}
+
+// collectVars returns the sorted, de-duplicated names of variables referenced
+// by the tree (function names in calls are not variables).
+func collectVars(n anyNode) []string {
+	set := make(map[string]bool)
+	var walk func(n anyNode)
+	walk = func(n anyNode) {
+		switch v := n.(type) {
+		case *varNode:
+			set[v.name] = true
+		case *unaryNode:
+			walk(v.x)
+		case *binNode:
+			walk(v.l)
+			walk(v.r)
+		case *ternaryNode:
+			walk(v.c)
+			walk(v.t)
+			walk(v.e)
+		case *callNode:
+			for _, a := range v.args {
+				walk(a)
+			}
+		}
+	}
+	walk(n)
+	names := make([]string, 0, len(set))
+	for name := range set {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
