+	Title    string     `json:"title"`
+	Priority int        `json:"priority"`
+	Done     bool       `json:"done"`
+	Created  time.Time  `json:"created"`
+	Tags     []string   `json:"tags,omitempty"`
+	Due      *time.Time `json:"due,omitempty"`
