+		{ID: 5},                        // no due, last
+	}
+	got, _ := Apply(s, Options{SortBy: "due"})
+	if !eqInts(ids(got), []int{3, 1, 4, 2, 5}) {
+		t.Fatalf("sort due: %v", ids(got))
+	}
+}
+
+func TestApplyCombinesFilters(t *testing.T) {
