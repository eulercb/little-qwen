 // DefaultPriority is used when none is given.
 const DefaultPriority = 3
 
+// tagPattern matches a normalised tag.
+var tagPattern = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)
+
+// NormalizeTags trims, lower-cases, de-duplicates and sorts the given tags.
+// It returns ErrBadTag if any tag does not match the allowed form.
+func NormalizeTags(tags []string) ([]string, error) {
+	seen := make(map[string]bool, len(tags))
+	var out []string
+	for _, tag := range tags {
+		tag = strings.ToLower(strings.TrimSpace(tag))
+		if !tagPattern.MatchString(tag) {
+			return nil, ErrBadTag
+		}
+		if !seen[tag] {
+			seen[tag] = true
+			out = append(out, tag)
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+// NormalizeTag normalises and validates a single tag.
+func NormalizeTag(tag string) (string, error) {
+	out, err := NormalizeTags([]string{tag})
+	if err != nil {
+		return "", err
+	}
+	return out[0], nil
+}
+
 // Validate checks the task fields.
 func (t *Task) Validate() error {
 	t.Title = strings.TrimSpace(t.Title)
@@ -34,5 +70,10 @@ func (t *Task) Validate() error {
 	if t.Priority < 1 || t.Priority > 5 {
 		return ErrBadPriority
 	}
