+// TestVersion2SaveRoundTrip checks the file is written as version 2 and that
+// tags and due dates survive a round trip.
+func TestVersion2SaveRoundTrip(t *testing.T) {
+	if Version != 2 {
+		t.Fatalf("Version = %d, want 2", Version)
+	}
+	p := filepath.Join(t.TempDir(), "t.json")
+	s, _ := Open(p)
+	due := time.Date(2026, 4, 15, 0, 0, 0, 0, time.UTC)
+	s.Add(model.Task{Title: "a", Priority: 2, Tags: []string{"home", "money"}, Due: &due})
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := os.ReadFile(p)
+	if !bytes.Contains(data, []byte(`"version": 2`)) {
+		t.Fatalf("file not saved as v2: %s", data)
+	}
+	s2, _ := Open(p)
+	all := s2.All()
+	if len(all) != 1 {
+		t.Fatalf("%+v", all)
+	}
+	if len(all[0].Tags) != 2 || all[0].Tags[0] != "home" || all[0].Tags[1] != "money" {
+		t.Fatalf("tags: %v", all[0].Tags)
+	}
+	if all[0].Due == nil || !all[0].Due.Equal(due) {
+		t.Fatalf("due: %v", all[0].Due)
+	}
+}
+
+// TestLoadVersion1 ensures a legacy version-1 file still loads.
+func TestLoadVersion1(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "legacy.json")
+	legacy := `{
+	  "version": 1,
+	  "next_id": 2,
+	  "tasks": [
+	    {"id": 1, "title": "old", "priority": 3, "done": false, "created": "2025-01-01T00:00:00Z"}
+	  ]
+	}`
+	if err := os.WriteFile(p, []byte(legacy), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Save(); err != nil {
+		t.Fatal(err)
+	}
+	s2, _ := Open(p)
+	all := s2.All()
+	if len(all) != 1 || all[0].Title != "old" {
+		t.Fatalf("%+v", all)
+	}
+	if all[0].Tags != nil {
+		t.Fatalf("tags should be empty: %v", all[0].Tags)
+	}
+	if all[0].Due != nil {
+		t.Fatalf("due should be nil: %v", all[0].Due)
+	}
+	data, _ := os.ReadFile(p)
+	if !bytes.Contains(data, []byte(`"version": 2`)) {
+		t.Fatalf("re-saved file should be v2: %s", data)
+	}
+}
