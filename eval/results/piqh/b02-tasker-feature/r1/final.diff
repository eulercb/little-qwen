+func due(y int, m time.Month, d int) *time.Time {
+	v := time.Date(y, m, d, 0, 0, 0, 0, time.UTC)
+	return &v
+}
+
+func ids(ts []model.Task) []int {
+	out := make([]int, len(ts))
+	for i, t := range ts {
+		out[i] = t.ID
+	}
+	return out
+}
+
+func eqInts(got, want []int) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestApplyTags(t *testing.T) {
+	s1 := model.Task{ID: 1, Tags: []string{"home", "money"}}
+	s2 := model.Task{ID: 2, Tags: []string{"home"}}
+	s3 := model.Task{ID: 3, Tags: []string{"work"}}
+	s := []model.Task{s1, s2, s3}
+
+	got, _ := Apply(s, Options{Tags: []string{"home"}})
+	if !eqInts(ids(got), []int{1, 2}) {
+		t.Fatalf("one tag: %v", ids(got))
+	}
+	got, _ = Apply(s, Options{Tags: []string{"home", "money"}})
+	if !eqInts(ids(got), []int{1}) {
+		t.Fatalf("all tags: %v", ids(got))
+	}
+	got, _ = Apply(s, Options{Tags: []string{"home", "work"}})
+	if len(got) != 0 {
+		t.Fatalf("intersection of no task: %v", ids(got))
+	}
+}
+
+func TestApplyOverdue(t *testing.T) {
+	now := time.Date(2026, 3, 10, 12, 0, 0, 0, time.UTC)
+	s := []model.Task{
+		{ID: 1, Due: due(2026, 3, 9)},             // overdue, open
+		{ID: 2, Due: due(2026, 3, 10)},            // due today, not overdue
+		{ID: 3, Due: due(2026, 3, 11)},            // future, not overdue
+		{ID: 4, Due: due(2026, 3, 8), Done: true}, // overdue but done
+		{ID: 5}, // no due date
+	}
+	got, _ := Apply(s, Options{Overdue: true, Now: now})
+	if !eqInts(ids(got), []int{1}) {
+		t.Fatalf("overdue: %v", ids(got))
+	}
+	// With --all done tasks are listed normally, but overdue must still exclude them.
+	got, _ = Apply(s, Options{Overdue: true, IncludeDone: true, Now: now})
+	if !eqInts(ids(got), []int{1}) {
+		t.Fatalf("overdue+all: %v", ids(got))
+	}
+}
+
+func TestApplySortDue(t *testing.T) {
+	s := []model.Task{
