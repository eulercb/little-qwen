 // Replay applies the events and returns balances in USD cents.
 func Replay(events []Event) (map[string]int64, error) {
+	// At-least-once delivery: keep only the first occurrence of each id.
+	seen := map[string]bool{}
+	evs := make([]Event, 0, len(events))
+	for _, e := range events {
+		if seen[e.ID] {
+			continue
+		}
+		seen[e.ID] = true
+		evs = append(evs, e)
+	}
+	// The log is not sorted: apply in timestamp order, ties by seq.
+	sort.SliceStable(evs, func(i, j int) bool {
+		if !evs[i].TS.Equal(evs[j].TS) {
+			return evs[i].TS.Before(evs[j].TS)
+		}
+		return evs[i].Seq < evs[j].Seq
+	})
 	bal := map[string]int64{}
 	applied := map[string]Event{}
 	reversed := map[string]bool{}
