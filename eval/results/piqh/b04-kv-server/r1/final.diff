+func TestKeys(t *testing.T) {
+	s, _ := newTestStore()
+	keys := []string{"abc", "a/b", "axc", "azc", "a-1", "file.txt", "x/y/z.txt", "abc2"}
+	for _, k := range keys {
+		s.Set(k, "v", 0)
+	}
+	check := func(pattern string, want ...string) {
+		got := s.Keys(pattern)
+		t.Helper()
+		if len(got) != len(want) {
+			t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("Keys(%q) = %v, want %v", pattern, got, want)
+			}
+		}
+	}
+	check("*", "a-1", "a/b", "abc", "abc2", "axc", "azc", "file.txt", "x/y/z.txt")
+	check("a?")
+	check("a??", "a-1", "a/b", "abc", "axc", "azc")
+	check("a?c", "abc", "axc", "azc")
+	check("a[bc]c", "abc")
+	check("a[b-z]c", "abc", "axc", "azc")
+	check("a[^b]c", "axc", "azc")
+	check("a[!b]c", "axc", "azc")
+	check(`a\?c`) // matches only the literal key "a?c", which is absent
+	check("*/")   // no key ends with '/'
+	check("*/*", "a/b", "x/y/z.txt")
+	check("*.txt", "file.txt", "x/y/z.txt")
+	check("a-1", "a-1")
+}
