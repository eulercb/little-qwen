+// Package proto implements the line protocol of the kv server: it
+// parses one request line and renders the full response, including
+// the trailing newline.
+package proto
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// Exec parses one request line and returns the full response
+// including the trailing newline.
+func Exec(s *store.Store, line string) string {
+	if strings.TrimSpace(line) == "" {
+		return "-ERR empty command\n"
+	}
+	toks, err := tokenize(line)
+	if err != nil {
+		return "-ERR syntax error\n"
+	}
+	if len(toks) == 0 {
+		return "-ERR empty command\n"
+	}
+	cmd := strings.ToLower(toks[0])
+	args := toks[1:]
+	switch cmd {
+	case "ping":
+		if len(args) != 0 {
+			return wrongArity("ping")
+		}
+		return "+PONG\n"
+	case "set":
+		return execSet(s, args)
+	case "get":
+		if len(args) != 1 {
+			return wrongArity("get")
+		}
+		if v, ok := s.Get(args[0]); ok {
+			return stringReply(v)
+		}
+		return "$nil\n"
+	case "del":
+		if len(args) < 1 {
+			return wrongArity("del")
+		}
+		return intReply(int64(s.Del(args...)))
+	case "exists":
+		if len(args) != 1 {
+			return wrongArity("exists")
+		}
+		if s.Exists(args[0]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "expire":
+		if len(args) != 2 {
+			return wrongArity("expire")
+		}
+		sec, err := parseSeconds(args[1])
+		if err != nil {
+			return errInt
+		}
+		if s.Expire(args[0], sec) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "persist":
+		if len(args) != 1 {
+			return wrongArity("persist")
+		}
+		if s.Persist(args[0]) {
+			return ":1\n"
+		}
+		return ":0\n"
+	case "ttl":
+		if len(args) != 1 {
+			return wrongArity("ttl")
+		}
+		return intReply(ttlSeconds(s, args[0]))
+	case "incr":
+		if len(args) != 1 {
+			return wrongArity("incr")
+		}
+		return execIncr(s, args, 1)
+	case "incrby":
+		if len(args) != 2 {
+			return wrongArity("incrby")
+		}
+		return execIncr(s, args, 0)
+	case "keys":
+		if len(args) != 1 {
+			return wrongArity("keys")
+		}
+		return arrayReply(s.Keys(args[0]))
+	case "dbsize":
+		if len(args) != 0 {
+			return wrongArity("dbsize")
+		}
+		return intReply(int64(s.Len()))
+	default:
+		return "-ERR unknown command '" + toks[0] + "'\n"
+	}
+}
+
+const errInt = "-ERR value is not an integer\n"
+
+func wrongArity(name string) string {
+	return "-ERR wrong number of arguments for '" + name + "'\n"
+}
+
+// execSet handles SET key value and SET key value EX seconds.
+func execSet(s *store.Store, args []string) string {
+	if len(args) != 2 && len(args) != 3 && len(args) != 4 {
+		return wrongArity("set")
+	}
+	var ttl time.Duration
+	if len(args) >= 3 {
+		if strings.ToLower(args[2]) != "ex" {
+			return "-ERR syntax error\n"
+		}
+		if len(args) != 4 {
+			return wrongArity("set")
+		}
+		n, err := strconv.ParseInt(args[3], 10, 64)
+		if err != nil || n <= 0 {
+			return "-ERR syntax error\n"
+		}
+		ttl = time.Duration(n) * time.Second
+	}
+	s.Set(args[0], args[1], ttl)
+	return "+OK\n"
+}
+
+// execIncr handles INCR key (by=1) and INCRBY key n.
+func execIncr(s *store.Store, args []string, fixedBy int64) string {
+	var by int64
+	if fixedBy == 0 {
+		n, err := strconv.ParseInt(args[1], 10, 64)
+		if err != nil {
+			return errInt
+		}
+		by = n
+	} else {
+		by = 1
+	}
+	n, err := s.Incr(args[0], by)
+	if err != nil {
+		return errInt
+	}
+	return intReply(n)
+}
+
+func parseSeconds(arg string) (time.Duration, error) {
+	n, err := strconv.ParseInt(arg, 10, 64)
+	if err != nil {
+		return 0, errIntError
+	}
+	return time.Duration(n) * time.Second, nil
+}
+
+var errIntError = store.ErrNotInteger
+
+// ttlSeconds converts a store TTL to protocol integer seconds,
+// rounded up. -1 means no expiry, -2 missing.
+func ttlSeconds(s *store.Store, key string) int64 {
+	d := s.TTL(key)
+	if d < 0 {
+		return int64(d / time.Second)
+	}
+	sec := int64(d / time.Second)
+	if d%time.Second != 0 {
+		sec++
+	}
+	return sec
+}
+
+func intReply(n int64) string {
+	return ":" + strconv.FormatInt(n, 10) + "\n"
+}
+
+// needsQuote reports whether a value must be written quoted.
+func needsQuote(v string) bool {
+	if v == "" {
+		return true
+	}
+	for i := 0; i < len(v); i++ {
+		switch v[i] {
+		case ' ', '\t', '"', '\\', '\n':
+			return true
+		}
+	}
+	return false
+}
+
+// quoteValue applies the value quoting/escaping rules.
+func quoteValue(v string) string {
+	if !needsQuote(v) {
+		return v
+	}
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(v); i++ {
+		switch c := v[i]; c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// stringReply renders a bulk string line.
+func stringReply(v string) string {
+	return "$" + quoteValue(v) + "\n"
+}
+
+// arrayReply renders an array of strings.
+func arrayReply(vs []string) string {
+	var b strings.Builder
+	b.WriteString("*" + strconv.Itoa(len(vs)) + "\n")
+	for _, v := range vs {
+		b.WriteString(stringReply(v))
+	}
+	return b.String()
+}
+
+// tokenize splits a request line into tokens separated by one or more
+// spaces or tabs. A token may be double-quoted; inside quotes \" \\
+// and \n are escapes. An unterminated quote (or a bad escape) is a
+// syntax error.
+func tokenize(line string) ([]string, error) {
+	var toks []string
+	i, n := 0, len(line)
+	for i < n {
+		for i < n && (line[i] == ' ' || line[i] == '\t') {
+			i++
+		}
+		if i >= n {
+			break
+		}
+		if line[i] == '"' {
+			i++
+			var b strings.Builder
+			closed := false
+			for i < n {
+				c := line[i]
+				if c == '\\' && i+1 < n {
+					switch line[i+1] {
+					case '"', '\\':
+						b.WriteByte(line[i+1])
+					case 'n':
+						b.WriteByte('\n')
+					default:
+						return nil, errSyntax
+					}
+					i += 2
+					continue
+				}
+				if c == '"' {
+					closed = true
+					i++
+					break
+				}
+				b.WriteByte(c)
+				i++
+			}
+			if !closed {
+				return nil, errSyntax
+			}
+			toks = append(toks, b.String())
+			continue
+		}
+		start := i
+		for i < n && line[i] != ' ' && line[i] != '\t' {
+			i++
+		}
+		toks = append(toks, line[start:i])
+	}
+	return toks, nil
+}
+
+var errSyntax = errors.New("syntax error")
