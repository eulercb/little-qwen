+++ b/server/server.go
@@ -0,0 +1,106 @@
+// Package server serves the kv store over TCP using the proto line
+// protocol.
+package server
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"strings"
+	"sync"
+
+	"example.com/kv/proto"
+	"example.com/kv/store"
+)
+
+// maxLine is the largest request line accepted (64 KiB); longer lines
+// get an error and the connection is closed.
+const maxLine = 64 * 1024
+
+// Serve accepts TCP connections on l until ctx is cancelled. On
+// cancellation it closes the listener, closes open connections, waits
+// for the connection goroutines to finish and returns nil. Each client
+// is served concurrently.
+func Serve(ctx context.Context, l net.Listener, s *store.Store) error {
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	conns := make(map[net.Conn]struct{})
+
+	go func() {
+		<-ctx.Done()
+		l.Close()
+		mu.Lock()
+		for c := range conns {
+			c.Close()
+		}
+		for c := range conns {
+			delete(conns, c)
+		}
+		mu.Unlock()
+	}()
+
+	for {
+		c, err := l.Accept()
+		if err != nil {
+			if ctx.Err() != nil {
+				wg.Wait()
+				return nil
+			}
+			return err
+		}
+		mu.Lock()
+		conns[c] = struct{}{}
+		mu.Unlock()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			serveConn(c, s)
+			mu.Lock()
+			delete(conns, c)
+			mu.Unlock()
+		}()
+	}
+}
+
+// serveConn handles a single connection until it is closed, an I/O
+// error occurs, the client sends QUIT, or a line exceeds maxLine.
+func serveConn(c net.Conn, s *store.Store) {
+	defer c.Close()
+	br := bufio.NewReader(c)
+	for {
+		line, err := readLine(br)
+		if err != nil {
+			return
+		}
+		if len(line) > maxLine {
+			c.Write([]byte("-ERR line too long\n"))
+			return
+		}
+		if strings.EqualFold(strings.TrimSpace(line), "QUIT") {
+			c.Write([]byte("+BYE\n"))
+			return
+		}
+		c.Write([]byte(proto.Exec(s, line)))
+	}
+}
+
+// readLine reads a \n-terminated line and strips one optional trailing
+// \r. The line is returned in full even if it exceeds maxLine; the
+// caller applies the limit. A non-nil error is returned only on I/O
+// failure.
+func readLine(br *bufio.Reader) (string, error) {
+	var sb strings.Builder
+	var b [1]byte
+	for {
+		n, err := br.Read(b[:])
+		if n > 0 {
+			if b[0] == '\n' {
+				return strings.TrimSuffix(sb.String(), "\r"), nil
+			}
+			sb.WriteByte(b[0])
+		}
+		if err != nil {
+			return sb.String(), err
+		}
+	}
+}
diff --git a/server/server_test.go b/server/server_test.go
