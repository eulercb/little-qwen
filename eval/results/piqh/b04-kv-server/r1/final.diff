+func TestSaveLoadRoundtrip(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 5*time.Second)
+	s.Set("gone", "3", time.Second) // expires before Save
+	s.Set("keep", "4", 10*time.Second)
+	fc.advance(2 * time.Second)
+
+	var buf bytes.Buffer
+	if err := s.Save(&buf); err != nil {
+		t.Fatal(err)
+	}
+	j := buf.String()
+	// Sorted by key, expired entries excluded.
+	if want := `{"version":1,"entries":[{"k":"a","v":"1","exp":0},{"k":"b","v":"2","exp":` +
+		itoa(fc.t.Add(3*time.Second).UnixMilli()) + `},{"k":"keep","v":"4","exp":` +
+		itoa(fc.t.Add(8*time.Second).UnixMilli()) + `}]}` + "\n"; j != want {
+		t.Fatalf("snapshot =\n%s\nwant\n%s", j, want)
+	}
+
+	s2, fc2 := newTestStore()
+	fc2.advance(2 * time.Second)
+	if err := s2.Load(&buf); err != nil {
+		t.Fatal(err)
+	}
+	// gone was already expired at Save time, so only a, b, keep survive.
+	if s2.Len() != 3 {
+		t.Fatalf("Len after load = %d, want 3", s2.Len())
+	}
+	if v, ok := s2.Get("b"); !ok || v != "2" {
+		t.Fatalf("b = %q, %v", v, ok)
+	}
+	if got := s2.TTL("b"); got <= 0 || got > 3*time.Second {
+		t.Fatalf("TTL(b) = %v, want (0, 3s]", got)
+	}
+	if s2.Exists("gone") {
+		t.Fatal("expired entry must be dropped at load")
+	}
+	// Load replaces all contents.
+	s3, _ := newTestStore()
+	s3.Set("old", "x", 0)
+	s3.Load(bytes.NewReader([]byte(`{"version":1,"entries":[{"k":"new","v":"y","exp":0}]}`)))
+	if s3.Exists("old") || !s3.Exists("new") {
+		t.Fatal("Load must replace all contents")
+	}
+}
