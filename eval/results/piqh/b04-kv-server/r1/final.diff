+func TestLoadDropsAlreadyExpired(t *testing.T) {
+	s, _ := newTestStore() // base time 1_000_000s
+	if err := s.Load(bytes.NewReader([]byte(`{"version":1,"entries":[{"k":"a","v":"1","exp":1500},{"k":"b","v":"2","exp":0}]}`))); err != nil {
+		t.Fatal(err)
