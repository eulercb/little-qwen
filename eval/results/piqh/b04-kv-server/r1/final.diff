index 0000000..f261934
--- /dev/null
+++ b/server/server_test.go
@@ -0,0 +1,181 @@
+package server
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+// serveAndDial starts a server on a loopback listener and dials it.
+func serveAndDial(t *testing.T, s *store.Store) (net.Conn, context.CancelFunc, func() error, string) {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	laddr := l.Addr().String()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- Serve(ctx, l, s) }()
+
+	var c net.Conn
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		c, err = net.Dial("tcp", laddr)
+		if err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			cancel()
+			t.Fatal(err)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	return c, cancel, func() error { return <-done }, laddr
+}
+
+func readReply(t *testing.T, c net.Conn) string {
+	t.Helper()
+	line, err := bufio.NewReader(c).ReadString('\n')
+	if err != nil {
+		t.Fatalf("reading reply: %v", err)
+	}
+	return line
+}
+
+// roundtrip sends a line and reads the reply.
+func roundtrip(t *testing.T, c net.Conn, line string) string {
+	t.Helper()
+	if _, err := c.Write([]byte(line + "\n")); err != nil {
+		t.Fatalf("writing %q: %v", line, err)
+	}
+	return readReply(t, c)
+}
+
+func TestBasicCommands(t *testing.T) {
+	s := store.New(nil)
+	c, cancel, _, _ := serveAndDial(t, s)
+	defer cancel()
+	defer c.Close()
+
+	if got := roundtrip(t, c, "PING"); got != "+PONG\n" {
+		t.Fatalf("PING = %q", got)
+	}
+	if got := roundtrip(t, c, "SET a hello"); got != "+OK\n" {
+		t.Fatalf("SET = %q", got)
+	}
+	if got := roundtrip(t, c, "GET a"); got != "$hello\n" {
+		t.Fatalf("GET = %q", got)
+	}
+	if got := roundtrip(t, c, "DBSIZE"); got != ":1\n" {
+		t.Fatalf("DBSIZE = %q", got)
+	}
+	// \r\n line endings.
+	if _, err := c.Write([]byte("GET a\r\n")); err != nil {
+		t.Fatal(err)
+	}
+	if got := readReply(t, c); got != "$hello\n" {
+		t.Fatalf("GET with CRLF = %q", got)
+	}
+}
+
+func TestQuit(t *testing.T) {
+	s := store.New(nil)
+	c, cancel, wait, _ := serveAndDial(t, s)
+
+	if got := roundtrip(t, c, "QUIT"); got != "+BYE\n" {
+		t.Fatalf("QUIT = %q", got)
+	}
+	// The server must have closed the connection.
+	c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	_, err := c.Read(make([]byte, 16))
+	if err == nil {
+		t.Fatal("expected connection to be closed after QUIT")
+	}
+	c.Close()
+	cancel()
+	if err := wait(); err != nil {
+		t.Fatalf("Serve = %v, want nil", err)
+	}
+}
+
+func TestLineTooLong(t *testing.T) {
+	s := store.New(nil)
+	c, cancel, wait, _ := serveAndDial(t, s)
+
+	long := strings.Repeat("a", maxLine+1)
+	c.Write([]byte(long + "\n"))
+	if got := readReply(t, c); got != "-ERR line too long\n" {
+		t.Fatalf("long line = %q", got)
+	}
+	c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	_, err := c.Read(make([]byte, 16))
+	if err == nil {
+		t.Fatal("expected connection to be closed after long line")
+	}
+	c.Close()
+	cancel()
+	if err := wait(); err != nil {
+		t.Fatalf("Serve = %v, want nil", err)
+	}
+}
+
+func TestExactMaxLine(t *testing.T) {
+	s := store.New(nil)
+	c, cancel, _, _ := serveAndDial(t, s)
+	defer cancel()
+	defer c.Close()
+	// A line of exactly maxLine bytes is not "longer than" maxLine.
+	val := strings.Repeat("x", maxLine-6) // "SET v " + val = maxLine bytes
+	if got := roundtrip(t, c, "SET v "+val); got != "+OK\n" {
+		t.Fatalf("SET 64KiB = %q", got)
+	}
+}
+
+func TestConcurrentClients(t *testing.T) {
+	s := store.New(nil)
+	c, cancel, wait, laddr := serveAndDial(t, s)
+	defer cancel()
+	defer c.Close()
+
+	errs := make(chan error, 2)
+	go func() {
+		defer func() { errs <- nil }()
+		for i := 0; i < 5; i++ {
+			if got := roundtrip(t, c, fmt.Sprintf("SET c1 %d", i)); got != "+OK\n" {
+				t.Errorf("client1 SET = %q", got)
+				return
+			}
+		}
+	}()
+
+	c2, err := net.Dial("tcp", laddr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c2.Close()
+	go func() {
+		defer func() { errs <- nil }()
+		for i := 0; i < 5; i++ {
+			if got := roundtrip(t, c2, "PING"); got != "+PONG\n" {
+				t.Errorf("client2 PING = %q", got)
+				return
+			}
+		}
+	}()
+	for i := 0; i < 2; i++ {
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	cancel()
+	if err := wait(); err != nil {
+		t.Fatalf("Serve = %v, want nil", err)
+	}
+}
diff --git a/store/glob.go b/store/glob.go
new file mode 100644
index 0000000..caec791
--- /dev/null
+++ b/store/glob.go
@@ -0,0 +1,101 @@
+package store
+
+// globMatch reports whether key matches pattern.
+//
+// Supported syntax: `*` matches any sequence of bytes (including
+// empty, including `/`), `?` matches exactly one byte, `[abc]` matches
+// one byte from the set, `[a-z]` matches one byte in the range,
+// `[^a]` / `[!a]` negates the class, and `\x` escapes `x` literally.
+// The whole key must match.
+func globMatch(pattern, key string) bool {
+	for len(pattern) > 0 {
+		switch pattern[0] {
+		case '*':
+			for len(pattern) > 0 && pattern[0] == '*' {
+				pattern = pattern[1:]
+			}
+			for i := 0; ; i++ {
+				if globMatch(pattern, key[i:]) {
+					return true
+				}
+				if i >= len(key) {
+					break
+				}
+			}
+			return false
+		case '?':
+			if key == "" {
+				return false
+			}
+			pattern, key = pattern[1:], key[1:]
+		case '\\':
+			if len(pattern) < 2 {
+				return false
+			}
+			if key == "" || key[0] != pattern[1] {
+				return false
+			}
+			pattern, key = pattern[2:], key[1:]
+		case '[':
+			end := indexClosingBracket(pattern)
+			if end < 0 {
+				// No closing ']': treat '[' as a literal byte.
+				if key == "" || key[0] != '[' {
+					return false
+				}
+				pattern, key = pattern[1:], key[1:]
+				break
+			}
+			class := pattern[1:end]
+			negated := false
+			if len(class) > 0 && (class[0] == '^' || class[0] == '!') {
+				negated = true
+				class = class[1:]
+			}
+			m := classMatches(class, key[0])
+			if negated {
+				m = !m
+			}
+			if key == "" || !m {
+				return false
+			}
+			pattern = pattern[end+1:]
+			key = key[1:]
+		default:
+			if key == "" || key[0] != pattern[0] {
+				return false
+			}
+			pattern, key = pattern[1:], key[1:]
+		}
+	}
+	return len(key) == 0
+}
+
+// indexClosingBracket returns the index of the ']' that closes the
+// class starting just after pattern[0] (which must be '['), or -1.
+func indexClosingBracket(pattern string) int {
+	for i := 1; i < len(pattern); i++ {
+		if pattern[i] == ']' {
+			return i
+		}
+	}
+	return -1
+}
+
+// classMatches reports whether b is matched by the (non-negated) class body.
+func classMatches(class string, b byte) bool {
+	matched := false
+	for i := 0; i < len(class); i++ {
+		if i+2 < len(class) && class[i+1] == '-' {
+			if class[i] <= b && b <= class[i+2] {
+				matched = true
+			}
+			i += 2
+			continue
+		}
+		if class[i] == b {
+			matched = true
+		}
+	}
+	return matched
+}
diff --git a/store/store.go b/store/store.go
new file mode 100644
index 0000000..cda49c8
--- /dev/null
+++ b/store/store.go
@@ -0,0 +1,274 @@
+// Package store implements a small Redis-like key-value store with
+// optional per-key expiry, glob matching and JSON snapshots.
+package store
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// ErrNotInteger is returned by Incr when the current value is not a
+// base-10 integer.
+var ErrNotInteger = errors.New("value is not an integer")
+
+// Clock returns the current time; it allows tests to control time.
+type Clock func() time.Time
+
+// entry is a single key-value pair with an optional deadline.
+type entry struct {
+	value    string
+	deadline time.Time // zero value means no expiry
+	hasExp   bool
+}
+
+// Store is a concurrent key-value store with optional key expiry.
+type Store struct {
+	mu   sync.RWMutex
+	c    Clock
+	data map[string]*entry
+}
+
+// New creates a Store. A nil clock uses time.Now.
+func New(clock Clock) *Store {
+	if clock == nil {
+		clock = time.Now
+	}
+	return &Store{c: clock, data: make(map[string]*entry)}
+}
+
+func (s *Store) live(key string, now time.Time) (*entry, bool) {
+	e, ok := s.data[key]
+	if !ok {
+		return nil, false
+	}
+	if e.hasExp && !now.Before(e.deadline) {
+		// now >= deadline: expired, behaves like missing.
+		delete(s.data, key)
+		return nil, false
+	}
+	return e, true
+}
+
+// Set stores value under key, replacing any existing value and ttl.
+// A ttl <= 0 means no expiry.
+func (s *Store) Set(key, value string, ttl time.Duration) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := &entry{value: value}
+	if ttl > 0 {
+		e.hasExp = true
+		e.deadline = s.c().Add(ttl)
+	}
+	s.data[key] = e
+}
+
+// Get returns the value of key and true if the key exists and is not expired.
+func (s *Store) Get(key string) (string, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.live(key, s.c())
+	if !ok {
+		return "", false
+	}
+	return e.value, true
+}
+
+// Del removes the given keys and returns how many existed and were removed.
+func (s *Store) Del(keys ...string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.c()
+	n := 0
+	for _, k := range keys {
+		if _, ok := s.live(k, now); ok {
+			delete(s.data, k)
+			n++
+		}
+	}
+	return n
+}
+
+// Exists reports whether the key exists and is not expired.
+func (s *Store) Exists(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	_, ok := s.live(key, s.c())
+	return ok
+}
+
+// Expire sets a new expiry on key. It returns false if the key is
+// missing (or expired). A ttl <= 0 deletes the key and returns true.
+func (s *Store) Expire(key string, ttl time.Duration) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.live(key, s.c())
+	if !ok {
+		return false
+	}
+	if ttl <= 0 {
+		delete(s.data, key)
+		return true
+	}
+	e.hasExp = true
+	e.deadline = s.c().Add(ttl)
+	return true
+}
+
+// Persist removes the expiry of key. It returns true only if the key
+// existed and had an expiry.
+func (s *Store) Persist(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.live(key, s.c())
+	if !ok {
+		return false
+	}
+	if !e.hasExp {
+		return false
+	}
+	e.hasExp = false
+	e.deadline = time.Time{}
+	return true
+}
+
+// TTL returns -2 if the key is missing, -1 if it has no expiry,
+// otherwise the remaining time (always > 0 for live keys).
+func (s *Store) TTL(key string) time.Duration {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.live(key, s.c())
+	if !ok {
+		return -2 * time.Second
+	}
+	if !e.hasExp {
+		return -1 * time.Second
+	}
+	return e.deadline.Sub(s.c())
+}
+
+// Incr adds by to the integer value of key (a missing key counts as 0),
+// stores the result keeping the existing ttl and returns it.
+func (s *Store) Incr(key string, by int64) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, _ := s.live(key, s.c())
+	var cur int64
+	if e != nil {
+		var err error
+		if cur, err = strconv.ParseInt(e.value, 10, 64); err != nil {
+			return 0, ErrNotInteger
+		}
+	}
+	nv := cur + by
+	if e == nil {
+		e = &entry{}
+		s.data[key] = e
+	}
+	e.value = strconv.FormatInt(nv, 10)
+	return nv, nil
+}
+
+// Keys returns all live keys matching the glob pattern, sorted ascending.
+func (s *Store) Keys(pattern string) []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.c()
+	out := make([]string, 0)
+	for k, e := range s.data {
+		if e.hasExp && !now.Before(e.deadline) {
+			delete(s.data, k)
+			continue
+		}
+		if globMatch(pattern, k) {
+			out = append(out, k)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// Len returns the number of live keys.
+func (s *Store) Len() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.c()
+	n := 0
+	for k, e := range s.data {
+		if e.hasExp && !now.Before(e.deadline) {
+			delete(s.data, k)
+			continue
+		}
+		n++
+	}
+	return n
+}
+
+// snapshot is the on-disk JSON representation.
+type snapshot struct {
+	Version int             `json:"version"`
+	Entries []snapshotEntry `json:"entries"`
+}
+
+type snapshotEntry struct {
+	K   string `json:"k"`
+	V   string `json:"v"`
+	Exp int64  `json:"exp"` // unix milliseconds, 0 for no expiry
+}
+
+// Save writes a JSON snapshot of all live keys to w.
+func (s *Store) Save(w io.Writer) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.c()
+	snap := snapshot{Version: 1, Entries: make([]snapshotEntry, 0)}
+	for k, e := range s.data {
+		if e.hasExp && !now.Before(e.deadline) {
+			delete(s.data, k)
+			continue
+		}
+		se := snapshotEntry{K: k, V: e.value}
+		if e.hasExp {
+			se.Exp = e.deadline.UnixMilli()
+		}
+		snap.Entries = append(snap.Entries, se)
+	}
+	sort.Slice(snap.Entries, func(i, j int) bool { return snap.Entries[i].K < snap.Entries[j].K })
+	enc := json.NewEncoder(w)
+	return enc.Encode(snap)
+}
+
+// Load replaces all contents with the snapshot read from r.
+// Snapshots with a version other than 1 are rejected, and entries
+// already expired at load time are dropped.
+func (s *Store) Load(r io.Reader) error {
+	var snap snapshot
+	if err := json.NewDecoder(r).Decode(&snap); err != nil {
+		return err
+	}
+	if snap.Version != 1 {
+		return fmt.Errorf("unsupported snapshot version %d", snap.Version)
+	}
+	now := s.c()
+	data := make(map[string]*entry, len(snap.Entries))
+	for _, se := range snap.Entries {
+		if se.Exp == 0 {
+			data[se.K] = &entry{value: se.V}
+			continue
+		}
+		deadline := time.UnixMilli(se.Exp)
+		if !now.Before(deadline) {
+			continue // already expired at load time
+		}
+		data[se.K] = &entry{value: se.V, deadline: deadline, hasExp: true}
+	}
+	s.mu.Lock()
+	s.data = data
+	s.mu.Unlock()
+	return nil
+}
diff --git a/store/store_test.go b/store/store_test.go
new file mode 100644
index 0000000..0381999
--- /dev/null
+++ b/store/store_test.go
@@ -0,0 +1,306 @@
+package store
+
+import (
+	"bytes"
+	"strconv"
+	"testing"
+	"time"
+)
+
+func itoa(v int64) string { return strconv.FormatInt(v, 10) }
+
+// fakeClock is a test clock whose time can be advanced.
+type fakeClock struct {
+	t time.Time
+}
+
+func (f *fakeClock) now() time.Time          { return f.t }
+func (f *fakeClock) advance(d time.Duration) { f.t = f.t.Add(d) }
+
+func newTestStore() (*Store, *fakeClock) {
+	fc := &fakeClock{t: time.Unix(1_000_000, 0)}
+	return New(fc.now), fc
+}
+
+func TestSetGet(t *testing.T) {
+	s, _ := newTestStore()
+	if v, ok := s.Get("a"); ok || v != "" {
+		t.Fatalf("missing key: got %q, %v", v, ok)
+	}
+	s.Set("a", "1", 0)
+	if v, ok := s.Get("a"); !ok || v != "1" {
+		t.Fatalf("Get = %q, %v; want 1, true", v, ok)
+	}
+	// Set replaces value and ttl.
+	s.Set("a", "2", 10*time.Second)
+	if v, ok := s.Get("a"); !ok || v != "2" {
+		t.Fatalf("Get after replace = %q, %v", v, ok)
+	}
+}
+
+func TestExpiry(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 10*time.Second)
+	if !s.Exists("a") {
+		t.Fatal("key should exist before deadline")
+	}
+	fc.advance(9 * time.Second)
+	if !s.Exists("a") {
+		t.Fatal("key should exist before deadline (9s < 10s)")
+	}
+	fc.advance(1 * time.Second) // now == deadline: expired
+	if s.Exists("a") {
+		t.Fatal("key must be expired at now == deadline")
+	}
+	if v, ok := s.Get("a"); ok || v != "" {
+		t.Fatalf("expired Get = %q, %v", v, ok)
+	}
+	if s.Len() != 0 {
+		t.Fatalf("Len = %d, want 0 after expiry", s.Len())
+	}
+}
+
+func TestDel(t *testing.T) {
+	s, _ := newTestStore()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 0)
+	if n := s.Del("a", "b", "c"); n != 2 {
+		t.Fatalf("Del = %d, want 2", n)
+	}
+	if n := s.Del("a", "zz"); n != 0 {
+		t.Fatalf("Del again = %d, want 0", n)
+	}
+}
+
+func TestDelExpired(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", time.Second)
+	fc.advance(2 * time.Second)
+	if n := s.Del("a"); n != 0 {
+		t.Fatalf("Del of expired = %d, want 0", n)
+	}
+}
+
+func TestExpire(t *testing.T) {
+	s, _ := newTestStore()
+	if s.Expire("nope", time.Second) {
+		t.Fatal("Expire missing key must return false")
+	}
+	s.Set("a", "1", 0)
+	if !s.Expire("a", 5*time.Second) {
+		t.Fatal("Expire existing key must return true")
+	}
+	if s.TTL("a") <= 0 || s.TTL("a") > 5*time.Second {
+		t.Fatalf("TTL = %v, want (0, 5s]", s.TTL("a"))
+	}
+	// ttl <= 0 deletes.
+	if !s.Expire("a", 0) {
+		t.Fatal("Expire ttl=0 must delete and return true")
+	}
+	if s.Exists("a") {
+		t.Fatal("key should be deleted")
+	}
+}
+
+func TestPersist(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", time.Second)
+	s.Set("b", "2", 0)
+	if !s.Persist("a") {
+		t.Fatal("Persist of key with expiry must return true")
+	}
+	if s.TTL("a") != -1*time.Second {
+		t.Fatalf("TTL = %v, want -1s", s.TTL("a"))
+	}
+	if s.Persist("a") {
+		t.Fatal("Persist of key without expiry must return false")
+	}
+	if s.Persist("missing") {
+		t.Fatal("Persist missing key must return false")
+	}
+	fc.advance(time.Hour)
+	if !s.Exists("a") || !s.Exists("b") {
+		t.Fatal("persisted and non-expiring keys must survive")
+	}
+}
+
+func TestTTL(t *testing.T) {
+	s, fc := newTestStore()
+	s.Set("a", "1", 0)
+	s.Set("b", "2", 5*time.Second)
+	if got := s.TTL("missing"); got != -2*time.Second {
+		t.Fatalf("TTL missing = %v, want -2s", got)
+	}
+	if got := s.TTL("a"); got != -1*time.Second {
+		t.Fatalf("TTL no-expiry = %v, want -1s", got)
+	}
+	if got := s.TTL("b"); got <= 0 || got > 5*time.Second {
+		t.Fatalf("TTL = %v, want (0, 5s]", got)
+	}
+	fc.advance(3 * time.Second)
+	if got := s.TTL("b"); got != 2*time.Second {
+		t.Fatalf("TTL after 3s = %v, want 2s", got)
+	}
+}
+
+func TestIncr(t *testing.T) {
+	s, _ := newTestStore()
+	if n, err := s.Incr("c", 1); err != nil || n != 1 {
+		t.Fatalf("Incr missing = %d, %v; want 1, nil", n, err)
+	}
+	if n, err := s.Incr("c", 41); err != nil || n != 42 {
+		t.Fatalf("Incr = %d, %v; want 42, nil", n, err)
+	}
+	if n, err := s.Incr("c", -50); err != nil || n != -8 {
+		t.Fatalf("Incr negative = %d, %v; want -8, nil", n, err)
+	}
+	if v, _ := s.Get("c"); v != "-8" {
+		t.Fatalf("value = %q, want -8", v)
+	}
+	// Keeps existing ttl.
+	s, _ = newTestStore()
+	s.Set("n", "1", 10*time.Second)
+	s.Incr("n", 1)
+	if got := s.TTL("n"); got <= 0 || got > 10*time.Second {
+		t.Fatalf("TTL after incr = %v, want (0, 10s]", got)
+	}
+	// Non-integer value.
+	s, _ = newTestStore()
+	s.Set("s", "abc", 0)
+	if _, err := s.Incr("s", 1); err != ErrNotInteger {
+		t.Fatalf("Incr non-integer err = %v, want ErrNotInteger", err)
+	}
+}
