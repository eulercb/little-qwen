+func TestConcurrent(t *testing.T) {
+	s, _ := newTestStore()
+	done := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			defer func() { done <- struct{}{} }()
+			for j := 0; j < 100; j++ {
+				k := string(rune('a' + i))
+				s.Set(k, "v", time.Second)
+				s.Get(k)
+				s.Incr(k, 1)
+				s.Keys("*")
+				s.Len()
+				s.TTL(k)
+			}
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+}
