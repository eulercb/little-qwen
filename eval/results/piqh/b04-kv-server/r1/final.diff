+package proto
+
+import (
+	"testing"
+	"time"
+
+	"example.com/kv/store"
+)
+
+func run(t *testing.T, line, want string) {
+	t.Helper()
+	s := store.New(nil)
+	if got := Exec(s, line); got != want {
+		t.Fatalf("Exec(%q) = %q, want %q", line, got, want)
+	}
+}
+
+func TestEmptyLine(t *testing.T) {
+	run(t, "", "-ERR empty command\n")
+	run(t, "   \t  ", "-ERR empty command\n")
+}
+
+func TestPing(t *testing.T) {
+	run(t, "PING", "+PONG\n")
+	run(t, "ping", "+PONG\n")
+	run(t, "pInG", "+PONG\n")
+	run(t, "PING extra", "-ERR wrong number of arguments for 'ping'\n")
+}
+
+func TestSetGet(t *testing.T) {
+	s := store.New(nil)
+	if got := Exec(s, "SET a hello"); got != "+OK\n" {
+		t.Fatalf("SET = %q", got)
+	}
+	if got := Exec(s, "GET a"); got != "$hello\n" {
+		t.Fatalf("GET = %q", got)
+	}
+	if got := Exec(s, "GET nope"); got != "$nil\n" {
+		t.Fatalf("GET missing = %q", got)
+	}
+	// Quoting of values containing special characters.
+	Exec(s, `SET b "a b"`) // space
+	if got := Exec(s, "GET b"); got != `$"a b"
+` {
+		t.Fatalf("GET b = %q", got)
+	}
+	Exec(s, `SET c ""`) // empty
+	if got := Exec(s, "GET c"); got != `$""
+` {
+		t.Fatalf("GET c = %q", got)
+	}
+	Exec(s, `SET d "x\"y"`) // quote
+	if got := Exec(s, "GET d"); got != `$"x\"y"
+` {
+		t.Fatalf("GET d = %q", got)
+	}
+	Exec(s, `SET e "back\\slash"`) // backslash
+	if got := Exec(s, "GET e"); got != `$"back\\slash"
+` {
+		t.Fatalf("GET e = %q", got)
+	}
+	Exec(s, `SET f "new\nline"`) // newline
+	if got := Exec(s, "GET f"); got != `$"new\nline"
+` {
+		t.Fatalf("GET f = %q", got)
+	}
+	// Quoted keys in the request.
+	Exec(s, `SET "k ey" v`)
+	if got := Exec(s, `GET "k ey"`); got != "$v\n" {
+		t.Fatalf("GET quoted key = %q", got)
+	}
+	// SET with EX.
+	if got := Exec(s, "SET t v EX 5"); got != "+OK\n" {
+		t.Fatalf("SET EX = %q", got)
+	}
+	if got := Exec(s, "TTL t"); got != ":5\n" {
+		t.Fatalf("TTL after EX = %q", got)
+	}
+	if got := Exec(s, "SET t v EX 0"); got != "-ERR syntax error\n" {
+		t.Fatalf("SET EX 0 = %q", got)
+	}
+	if got := Exec(s, "SET t v NX"); got != "-ERR syntax error\n" {
+		t.Fatalf("SET bad option = %q", got)
+	}
+	if got := Exec(s, "SET t v EX abc"); got != "-ERR syntax error\n" {
+		t.Fatalf("SET EX non-int = %q", got)
+	}
+	if got := Exec(s, "SET t v EX"); got != "-ERR wrong number of arguments for 'set'\n" {
+		t.Fatalf("SET missing seconds = %q", got)
+	}
+}
+
+func TestDel(t *testing.T) {
+	s := store.New(nil)
+	Exec(s, "SET a 1")
+	Exec(s, "SET b 2")
+	if got := Exec(s, "DEL a b nope"); got != ":2\n" {
+		t.Fatalf("DEL = %q", got)
+	}
+	if got := Exec(s, "DEL a"); got != ":0\n" {
+		t.Fatalf("DEL again = %q", got)
+	}
+	if got := Exec(s, "DEL"); got != "-ERR wrong number of arguments for 'del'\n" {
+		t.Fatalf("DEL no args = %q", got)
+	}
+}
+
+func TestExists(t *testing.T) {
+	s := store.New(nil)
+	Exec(s, "SET a 1")
+	if got := Exec(s, "EXISTS a"); got != ":1\n" {
+		t.Fatalf("EXISTS = %q", got)
+	}
+	if got := Exec(s, "EXISTS b"); got != ":0\n" {
+		t.Fatalf("EXISTS missing = %q", got)
+	}
+}
+
+func TestExpirePersist(t *testing.T) {
+	s := store.New(nil)
+	if got := Exec(s, "EXPIRE nope 5"); got != ":0\n" {
+		t.Fatalf("EXPIRE missing = %q", got)
+	}
+	Exec(s, "SET a 1")
+	if got := Exec(s, "EXPIRE a 5"); got != ":1\n" {
+		t.Fatalf("EXPIRE = %q", got)
+	}
+	if got := Exec(s, "EXPIRE a 5 no"); got != "-ERR wrong number of arguments for 'expire'\n" {
+		t.Fatalf("EXPIRE arity = %q", got)
+	}
+	if got := Exec(s, "EXPIRE a x"); got != "-ERR value is not an integer\n" {
+		t.Fatalf("EXPIRE non-int = %q", got)
+	}
+	if got := Exec(s, "PERSIST a"); got != ":1\n" {
+		t.Fatalf("PERSIST = %q", got)
+	}
+	if got := Exec(s, "PERSIST a"); got != ":0\n" {
+		t.Fatalf("PERSIST again = %q", got)
+	}
+	if got := Exec(s, "PERSIST nope"); got != ":0\n" {
+		t.Fatalf("PERSIST missing = %q", got)
+	}
+}
+
+func TestTTL(t *testing.T) {
+	base := time.Unix(1_000_000, 0)
+	now := base
+	s := store.New(func() time.Time { return now })
+
+	Exec(s, "SET a 1")
+	Exec(s, "SET b 2")
+	if got := Exec(s, "TTL a"); got != ":-1\n" {
+		t.Fatalf("TTL no-expiry = %q", got)
+	}
+	if got := Exec(s, "TTL missing"); got != ":-2\n" {
+		t.Fatalf("TTL missing = %q", got)
+	}
+	if got := Exec(s, "EXPIRE b 5"); got != ":1\n" {
+		t.Fatalf("EXPIRE = %q", got)
+	}
+	// 1.2s remaining rounds up to 2.
+	now = base.Add(3 * time.Second).Add(800 * time.Millisecond)
+	if got := Exec(s, "TTL b"); got != ":2\n" {
+		t.Fatalf("TTL rounded up = %q", got)
+	}
+	// Whole seconds round to themselves.
+	now = base.Add(4 * time.Second)
+	if got := Exec(s, "TTL b"); got != ":1\n" {
+		t.Fatalf("TTL exact = %q", got)
+	}
+}
+
+func TestIncr(t *testing.T) {
+	s := store.New(nil)
+	if got := Exec(s, "INCR c"); got != ":1\n" {
+		t.Fatalf("INCR = %q", got)
+	}
+	if got := Exec(s, "INCRBY c 41"); got != ":42\n" {
+		t.Fatalf("INCRBY = %q", got)
+	}
+	if got := Exec(s, "INCRBY c -50"); got != ":-8\n" {
+		t.Fatalf("INCRBY negative = %q", got)
+	}
+	if got := Exec(s, "INCRBY c x"); got != "-ERR value is not an integer\n" {
+		t.Fatalf("INCRBY non-int = %q", got)
+	}
+	Exec(s, `SET s "abc"`)
+	if got := Exec(s, "INCR s"); got != "-ERR value is not an integer\n" {
+		t.Fatalf("INCR non-int value = %q", got)
+	}
+}
+
+func TestKeysDBSize(t *testing.T) {
+	s := store.New(nil)
+	Exec(s, "SET b 2")
+	Exec(s, "SET a 1")
+	Exec(s, "SET ax 3")
+	if got := Exec(s, "KEYS a*"); got != "*2\n$a\n$ax\n" {
+		t.Fatalf("KEYS = %q", got)
+	}
+	if got := Exec(s, "KEYS z*"); got != "*0\n" {
+		t.Fatalf("KEYS empty = %q", got)
+	}
+	// Keys in arrays are quoted when needed.
+	Exec(s, `SET "x y" v`)
+	if got := Exec(s, "KEYS *y"); got != "*1\n$\"x y\"\n" {
+		t.Fatalf("KEYS quoting = %q", got)
+	}
+	if got := Exec(s, "DBSIZE"); got != ":4\n" {
+		t.Fatalf("DBSIZE = %q", got)
+	}
+}
+
+func TestErrors(t *testing.T) {
+	run(t, "FROB x", "-ERR unknown command 'FROB'\n")
+	run(t, "frob x", "-ERR unknown command 'frob'\n")
+	run(t, "GET", "-ERR wrong number of arguments for 'get'\n")
+	run(t, "GET a b", "-ERR wrong number of arguments for 'get'\n")
+	run(t, `GET "unterminated`, "-ERR syntax error\n")
+	run(t, `GET "bad\q escape"`, "-ERR syntax error\n")
+}
