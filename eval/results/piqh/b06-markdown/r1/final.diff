+		"<p>Some <em>emphasis</em> and <strong>strong</strong> text\n" +
+		"with <code>code</code> and a <a href=\"http://x.io\" title=\"T\">link</a>.</p>\n" +
+		"<ul>\n<li>one</li>\n<li>two\n<ul>\n<li>nested</li>\n</ul>\n</li>\n</ul>\n" +
+		"<ol start=\"3\">\n<li>three</li>\n</ol>\n"
+	if got := ToHTML(in); got != want {
