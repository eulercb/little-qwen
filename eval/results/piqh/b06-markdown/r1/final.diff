+package md
+
+import (
+	"strings"
+)
+
+// escapeRune HTML-escapes a single literal character.
+func escapeRune(c byte) string {
+	switch c {
+	case '&':
+		return "&amp;"
+	case '<':
+		return "&lt;"
+	case '>':
+		return "&gt;"
+	case '"':
+		return "&quot;"
+	default:
+		return string(c)
+	}
+}
+
+// isEscapable reports whether c may follow a backslash as an escape.
+func isEscapable(c byte) bool {
+	switch c {
+	case '\\', '`', '*', '_', '{', '}', '[', ']', '(', ')',
+		'#', '+', '-', '.', '!', '<', '>', '"':
+		return true
+	}
+	return false
+}
+
+// isWordByte reports whether c is a word character (letter or digit).
+func isWordByte(c byte) bool {
+	return c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
+}
+
+type inlineState struct {
+	s   []byte
+	i   int
+	out strings.Builder
+}
+
+// inline renders inline markup over text (already joined lines).
+func inline(text string) string {
+	st := &inlineState{s: []byte(text)}
+	st.emit(len(text))
+	return st.out.String()
+}
+
+// emit processes text[st.i:start] (end-exclusive) and emits the result.
+func (st *inlineState) emit(start int) {
+	s := st.s
+	for st.i < start {
+		c := s[st.i]
+		switch {
+		case c == '\\':
+			if st.i+1 < start && isEscapable(s[st.i+1]) {
+				st.out.WriteString(escapeRune(s[st.i+1]))
+				st.i += 2
+				continue
+			}
+			if st.i+1 == start && start < len(s) && s[start] == '\n' {
+				st.out.WriteString("<br />\n")
+				st.i += 2
+				continue
+			}
+		case c == '`':
+			j := st.i
+			for j < start && s[j] == '`' {
+				j++
+			}
+			n := j - st.i
+			if k := st.findCodeEnd(n, start); k >= 0 {
+				content := string(s[st.i+n : k])
+				content = trimCodeSpace(content)
+				st.out.WriteString("<code>" + htmlEscaper.Replace(content) + "</code>")
+				st.i = k + n
+				continue
+			}
+		case c == '[':
+			if k := st.parseLink(start); k >= 0 {
+				st.i = k
+				continue
+			}
+		case c == '*':
+			if st.i+1 < start && s[st.i+1] == '*' {
+				if k := st.matchStrong(start, 2, false); k >= 0 {
+					st.out.WriteString("<strong>" + inline(string(s[st.i+2:k])) + "</strong>")
+					st.i = k + 2
+					continue
+				}
+			}
+			if st.i+1 < start && s[st.i+1] != ' ' && s[st.i+1] != '\n' {
+				if k := st.matchEmph(start, 1, false); k >= 0 {
+					st.out.WriteString("<em>" + inline(string(s[st.i+1:k])) + "</em>")
+					st.i = k + 1
+					continue
+				}
+			}
+		case c == '_':
+			if st.i+1 < start && s[st.i+1] == '_' {
+				if st.i == 0 || !isWordByte(s[st.i-1]) {
+					if k := st.matchStrong(start, 2, true); k >= 0 {
+						st.out.WriteString("<strong>" + inline(string(s[st.i+2:k])) + "</strong>")
+						st.i = k + 2
+						continue
+					}
+				}
+			}
+			if st.i+1 < start && s[st.i+1] != ' ' && s[st.i+1] != '\n' &&
+				(st.i == 0 || !isWordByte(s[st.i-1])) {
+				if k := st.matchEmph(start, 1, true); k >= 0 {
+					st.out.WriteString("<em>" + inline(string(s[st.i+1:k])) + "</em>")
+					st.i = k + 1
+					continue
+				}
+			}
+		case c == '<':
+			if k, url := st.parseAutolink(start); k >= 0 {
+				st.out.WriteString(`<a href="` + htmlEscaper.Replace(url) + `">` + url + `</a>`)
+				st.i = k
+				continue
+			}
+		case c == '\n':
+			st.out.WriteByte('\n')
+			// A newline at the very end of the whole block is kept as-is
+			// (block renderers do not produce trailing newlines).
+			if st.i+1 == len(st.s) && st.i+1 == start {
+				st.i++
+				continue
+			}
+			j := st.i + 1
+			for j < start && s[j] == ' ' {
+				j++
+			}
+			if j < start && j-st.i-1 >= 2 && st.i+1 < len(st.s) {
+				st.out.WriteString("<br />\n")
+				st.i = j + 1
+				continue
+			}
+			st.i++
+			continue
+		}
+		st.out.WriteString(escapeRune(c))
+		st.i++
+	}
+}
+
+// findCodeEnd finds the next run of exactly n backticks within [from, start]
+// (a longer run does not close); returns the start index of that run or -1.
+func (st *inlineState) findCodeEnd(n, start int) int {
+	s := st.s
+	from := st.i + n
+	for p := from; p < start; {
+		if s[p] != '`' {
+			p++
+			continue
+		}
+		q := p
+		for q < start && s[q] == '`' {
+			q++
+		}
+		if q-p == n {
+			return p
+		}
+		p = q
+	}
+	return -1
+}
+
+func trimCodeSpace(s string) string {
+	if len(s) >= 2 && s[0] == ' ' && s[len(s)-1] == ' ' && s != " " && s != "  " {
+		return s[1 : len(s)-1]
+	}
+	return s
+}
+
+// parseLink tries to parse a link at st.i (the "[" character). On success
+// it appends the rendered link and returns the index just past the
+// construct; on failure it appends a literal "[" and returns -1.
+func (st *inlineState) parseLink(start int) int {
+	s := st.s
+	depth := 1
+	j := st.i + 1
+	for j < start {
+		switch s[j] {
+		case '[':
+			depth++
+		case ']':
+			depth--
+			if depth == 0 {
+				break
+			}
+		}
+		if depth == 0 {
+			break
+		}
+		j++
+	}
+	if depth != 0 || j+1 >= start || s[j+1] != '(' {
+		st.out.WriteByte('[')
+		return -1
+	}
+	k := j + 2
+	urlStart := k
+	for k < start && s[k] != ' ' && s[k] != ')' {
+		k++
+	}
+	url := string(s[urlStart:k])
+	var title string
+	if k < start && s[k] == ' ' && k+1 < start && s[k+1] == '"' {
+		t0 := k + 2
+		for k < start && s[k] != '"' {
+			k++
+		}
+		if k < start && k+1 < start && s[k+1] == ')' {
+			title = string(s[t0:k])
+			k += 2
+		} else {
+			k = -1 // malformed title
+		}
+	} else {
+		if k < start && s[k] == ')' {
+			k++
+		} else {
+			k = -1
+		}
+	}
+	if k < 0 || url == "" || strings.ContainsAny(url, " \t\n") {
+		st.out.WriteByte('[')
+		return -1
+	}
+	text := inline(string(s[st.i+1 : j]))
+	st.out.WriteString("<a href=")
+	st.writeAttr(url)
+	if title != "" {
+		st.out.WriteString(" title=")
+		st.writeAttr(title)
+	}
+	st.out.WriteString(">" + text + "</a>")
+	return k
+}
+
+// writeAttr writes a double-quoted, HTML-escaped attribute value.
+func (st *inlineState) writeAttr(v string) {
+	st.out.WriteByte('"')
+	st.out.WriteString(htmlEscaper.Replace(v))
+	st.out.WriteByte('"')
+}
+
+// matchEmph finds a closing single delimiter.
+func (st *inlineState) matchEmph(start int, w int, under bool) int {
+	return st.matchEmphStrong(start, 1, w, under)
+}
+
+// matchStrong finds a closing double delimiter.
+func (st *inlineState) matchStrong(start int, w int, under bool) int {
+	return st.matchEmphStrong(start, 2, w, under)
+}
+
+func (st *inlineState) matchEmphStrong(start, want, w int, under bool) int {
+	s := st.s
+	closer := byte('*')
+	if under {
+		closer = '_'
+	}
+	for p := st.i + w + 1; p < start; {
+		if s[p] != closer {
+			p++
+			continue
+		}
+		q := p
+		for q < start && s[q] == closer {
+			q++
+		}
+		if q-p != w {
+			p = q // run of the wrong length; skip past it
+			continue
+		}
+		if s[p-1] == ' ' || s[p-1] == '\n' {
+			p = q // closing delimiter preceded by a space
+			continue
+		}
+		if under && q < start && isWordByte(s[q]) {
+			p = q // closing underscore followed by a word char
+			continue
+		}
+		if w == want {
+			return p
+		}
+		p = q
+	}
+	return -1
+}
+func isWordOrSpaceEnd(c byte) bool {
+	return c == ' ' || c == '\n'
+}
+
+// parseAutolink tries to parse <URL> at st.i; returns the index just past
+// the closing '>' and the URL, or -1/"".
+func (st *inlineState) parseAutolink(start int) (int, string) {
+	s := st.s
+	end := st.i + 1
+	for end < start && s[end] != '>' {
+		end++
+	}
+	if end == start || end-st.i-1 < 1 {
+		return -1, ""
+	}
+	url := string(s[st.i+1 : end])
+	if !strings.HasPrefix(url, "http://") && !strings.HasPrefix(url, "https://") {
+		return -1, ""
+	}
+	if strings.ContainsAny(url, " \t\n<>") {
+		return -1, ""
+	}
+	return end + 1, url
+}
