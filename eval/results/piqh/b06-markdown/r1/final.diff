+package md
+
+import "testing"
+
+func TestToHTML(t *testing.T) {
+	cases := map[string]string{
+		"spec example":               "# Title #\n\nSome *emphasis* and **strong** text\nwith `code` and a [link](http://x.io \"T\").\n\n- one\n- two\n  - nested\n3. three\n",
+		"empty":                      "",
+		"blank":                      "\n  \n",
+		"paragraph":                  "a\nb\nc\n",
+		"para leading spaces":        "  a\n   b\n",
