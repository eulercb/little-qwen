+package semver
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParse(t *testing.T) {
+	valid := []struct {
+		in    string
+		major, minor, patch uint64
+		pre   []string
+		build []string
+	}{
+		{"1.2.3", 1, 2, 3, nil, nil},
+		{"v1.2.3", 1, 2, 3, nil, nil},
+		{"V1.2.3", 1, 2, 3, nil, nil},
+		{"0.0.0", 0, 0, 0, nil, nil},
+		{"1.0.0-alpha", 1, 0, 0, []string{"alpha"}, nil},
+		{"1.0.0-alpha.1", 1, 0, 0, []string{"alpha", "1"}, nil},
+		{"1.0.0-0.3.7", 1, 0, 0, []string{"0", "3", "7"}, nil},
+		{"1.0.0-x.7.z.92", 1, 0, 0, []string{"x", "7", "z", "92"}, nil},
+		{"1.0.0+build", 1, 0, 0, nil, []string{"build"}},
+		{"1.0.0+21AF26D3---117B344092BD", 1, 0, 0, nil, []string{"21AF26D3---117B344092BD"}},
+		{"1.0.0-beta+exp.sha.5114f85", 1, 0, 0, []string{"beta"}, []string{"exp", "sha", "5114f85"}},
+		{"1.0.0-rc.1+build.5", 1, 0, 0, []string{"rc", "1"}, []string{"build", "5"}},
+		{"1.0.0-alpha.1.2.3-4", 1, 0, 0, []string{"alpha", "1", "2", "3-4"}, nil},
+	}
+	for _, tc := range valid {
+		got, err := Parse(tc.in)
+		if err != nil {
+			t.Errorf("Parse(%q) unexpected error: %v", tc.in, err)
+			continue
+		}
+		want := Version{tc.major, tc.minor, tc.patch, tc.pre, tc.build}
+		if got.Major != want.Major || got.Minor != want.Minor || got.Patch != want.Patch {
+			t.Errorf("Parse(%q) = %d.%d.%d, want %d.%d.%d", tc.in, got.Major, got.Minor, got.Patch, want.Major, want.Minor, want.Patch)
+		}
+		if !reflect.DeepEqual(got.Pre, want.Pre) {
+			t.Errorf("Parse(%q) pre = %v, want %v", tc.in, got.Pre, want.Pre)
+		}
+		if !reflect.DeepEqual(got.Build, want.Build) {
+			t.Errorf("Parse(%q) build = %v, want %v", tc.in, got.Build, want.Build)
+		}
+	}
+}
+
+func TestParseInvalid(t *testing.T) {
+	invalid := []string{
+		"1",            // missing parts
+		"1.2",          // missing parts
+		"1.2.3.4",      // too many parts
+		"01.2.3",       // leading zero in major
+		"1.02.3",       // leading zero in minor
+		"1.2.03",       // leading zero in patch
+		"1.0.0-01",     // leading zero in numeric pre-release id
+		"1.0.0-alpha..1", // empty identifier
+		"1.0.0-alpha.1.", // empty identifier at end
+		".1.2.3",       // empty major
+		"1..3",         // empty minor
+		"1.0.0-alpha_b", // invalid character
+		"1.0.0+build_b",  // invalid character in build metadata
+		"1.0.0+",       // empty build metadata
+		"1.0.0-",       // empty pre-release
+		"1.0.0-alpha..beta", // empty identifier in the middle
+		"",
+		"v",
+		"v1",
+		"a.b.c",
+		"1.0.0-1.0.2.3.4.5.6.7.8.9.10", // valid actually, keep out
+	}
+	// The last entry is actually valid; filter it out.
+	filtered := make([]string, 0, len(invalid))
+	for _, s := range invalid {
+		if s == "1.0.0-1.0.2.3.4.5.6.7.8.9.10" {
+			continue
+		}
+		filtered = append(filtered, s)
+	}
+	for _, in := range filtered {
+		if _, err := Parse(in); err == nil {
+			t.Errorf("Parse(%q) succeeded, want error", in)
+		}
+	}
+}
+
+func TestString(t *testing.T) {
+	cases := map[string]string{
+		"1.2.3":                    "1.2.3",
+		"v1.2.3":                   "1.2.3",
+		"1.0.0-alpha.1+build.5":    "1.0.0-alpha.1+build.5",
+		"1.0.0+build.5":            "1.0.0+build.5",
+		"1.0.0-alpha":              "1.0.0-alpha",
+		"0.0.0":                    "0.0.0",
+	}
+	for in, want := range cases {
+		v, err := Parse(in)
+		if err != nil {
+			t.Fatalf("Parse(%q) error: %v", in, err)
+		}
+		if got := v.String(); got != want {
+			t.Errorf("Parse(%q).String() = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestComparePrecedence(t *testing.T) {
+	// Order from the SemVer 2.0.0 spec.
+	versions := []string{
+		"1.0.0-alpha",
+		"1.0.0-alpha.1",
+		"1.0.0-alpha.beta",
+		"1.0.0-beta",
+		"1.0.0-beta.2",
+		"1.0.0-beta.11",
+		"1.0.0-rc.1",
+		"1.0.0",
+	}
+	vs := make([]Version, len(versions))
+	for i, s := range versions {
+		vs[i] = MustParse(s)
+	}
+	for i := 0; i < len(vs); i++ {
+		for j := 0; j < len(vs); j++ {
+			want := 0
+			switch {
+			case i < j:
+				want = -1
+			case i > j:
+				want = 1
+			}
+			if got := Compare(vs[i], vs[j]); got != want {
+				t.Errorf("Compare(%s, %s) = %d, want %d", versions[i], versions[j], got, want)
+			}
+		}
+	}
+}
+
+func TestCompareNumeric(t *testing.T) {
+	cases := []struct{ a, b string; want int }{
+		{"1.0.0", "2.0.0", -1},
+		{"2.0.0", "2.0.0", 0},
+		{"2.1.0", "2.0.9", 1},
+		{"2.0.1", "2.0.0", 1},
+		{"10.0.0", "9.0.0", 1},
+		{"1.0.0-2", "1.0.0-11", -1},
+		{"1.0.0-11", "1.0.0-11", 0},
+		{"1.0.0-alpha", "1.0.0", -1},
+		{"1.0.0", "1.0.0-alpha", 1},
+	}
+	for _, tc := range cases {
+		if got := Compare(MustParse(tc.a), MustParse(tc.b)); got != tc.want {
+			t.Errorf("Compare(%s, %s) = %d, want %d", tc.a, tc.b, got, tc.want)
+		}
+	}
+}
+
+func TestCompareIgnoresBuildMetadata(t *testing.T) {
+	if got := Compare(MustParse("1.0.0+a.b.c"), MustParse("1.0.0-zz")); got != 1 {
+		t.Errorf("Compare(1.0.0+a.b.c, 1.0.0-zz) = %d, want 1", got)
+	}
+	if got := Compare(MustParse("1.0.0+one"), MustParse("1.0.0+two")); got != 0 {
+		t.Errorf("Compare(1.0.0+one, 1.0.0+two) = %d, want 0", got)
+	}
+}
+
+func TestMustParsePanics(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Error("MustParse invalid input did not panic")
+		}
+	}()
+	MustParse("1.2")
+}
