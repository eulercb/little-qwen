+// Package semver implements parsing and precedence for Semantic
+// Versioning 2.0.0 (https://semver.org/spec/v2.0.0.html) versions.
+package semver
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Version is a parsed semantic version.
+type Version struct {
+	Major, Minor, Patch uint64
+	Pre                 []string
+	Build               []string
+}
+
+// Parse parses s as a semantic version. An optional leading "v" is
+// accepted. Errors are returned for malformed input: missing parts,
+// leading zeros in numeric components or numeric pre-release
+// identifiers, empty identifiers, or characters outside
+// [0-9A-Za-z-] in identifiers.
+func Parse(s string) (Version, error) {
+	var v Version
+	if len(s) > 0 && (s[0] == 'v' || s[0] == 'V') {
+		s = s[1:]
+	}
+	if !strings.Contains(s, ".") {
+		return v, errors.New("semver: invalid version: " + s)
+	}
+
+	// Split off build metadata.
+	if i := strings.IndexByte(s, '+'); i >= 0 {
+		build := s[i+1:]
+		s = s[:i]
+		if !validDots(build, false) {
+			return v, fmt.Errorf("semver: invalid build metadata in %q", s)
+		}
+		v.Build = strings.Split(build, ".")
+	}
+
+	// Split off pre-release.
+	if i := strings.IndexByte(s, '-'); i >= 0 {
+		pre := s[i+1:]
+		s = s[:i]
+		for _, id := range strings.Split(pre, ".") {
+			if !validIdentifier(id) {
+				return v, fmt.Errorf("semver: invalid pre-release identifier %q in %q", id, s)
+			}
+			v.Pre = append(v.Pre, id)
+		}
+	}
+
+	parts := strings.Split(s, ".")
+	if len(parts) != 3 {
+		return v, errors.New("semver: invalid version: " + s)
+	}
+	nums := [3]*uint64{&v.Major, &v.Minor, &v.Patch}
+	for i, p := range parts {
+		if p == "" || len(p) > 1 && p[0] == '0' {
+			return v, fmt.Errorf("semver: invalid numeric component %q in %q", p, s)
+		}
+		n, err := strconv.ParseUint(p, 10, 64)
+		if err != nil {
+			return v, fmt.Errorf("semver: invalid numeric component %q in %q", p, s)
+		}
+		*nums[i] = n
+	}
+	return v, nil
+}
+
+// validIdentifier reports whether id is a valid pre-release or build
+// identifier: non-empty and only characters from [0-9A-Za-z-].
+// For pre-release identifiers, numeric identifiers must not have
+// leading zeros.
+func validIdentifier(id string) bool {
+	if id == "" {
+		return false
+	}
+	for _, r := range id {
+		switch {
+		case r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r == '-':
+		case r >= '0' && r <= '9':
+		default:
+			return false
+		}
+	}
+	// Reject leading zeros in purely numeric pre-release identifiers.
+	if allDigits(id) && len(id) > 1 && id[0] == '0' {
+		return false
+	}
+	return true
+}
+
+func allDigits(s string) bool {
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// validDots reports whether s is a dot-separated list of identifiers
+// with the same rules as pre-release identifiers (non-empty, charset
+// [0-9A-Za-z-]; leading-zero rule applies only when strict is set,
+// since SemVer does not forbid it in build metadata).
+func validDots(s string, strict bool) bool {
+	if s == "" {
+		return false
+	}
+	for _, id := range strings.Split(s, ".") {
+		if id == "" {
+			return false
+		}
+		for _, r := range id {
+			switch {
+			case r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r == '-':
+			case r >= '0' && r <= '9':
+			default:
+				return false
+			}
+		}
+		if strict && allDigits(id) && len(id) > 1 && id[0] == '0' {
+			return false
+		}
+	}
+	return true
+}
+
+// String returns the canonical version string without the "v" prefix.
+func (v Version) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%d.%d.%d", v.Major, v.Minor, v.Patch)
+	if len(v.Pre) > 0 {
+		b.WriteByte('-')
+		b.WriteString(strings.Join(v.Pre, "."))
+	}
+	if len(v.Build) > 0 {
+		b.WriteByte('+')
+		b.WriteString(strings.Join(v.Build, "."))
+	}
+	return b.String()
+}
+
+// Compare returns -1 if a < b, 0 if a == b, or +1 if a > b, using
+// Semantic Versioning precedence. Build metadata is ignored.
+func Compare(a, b Version) int {
+	if c := compareNum(a.Major, b.Major); c != 0 {
+		return c
+	}
+	if c := compareNum(a.Minor, b.Minor); c != 0 {
+		return c
+	}
+	if c := compareNum(a.Patch, b.Patch); c != 0 {
+		return c
+	}
+	return comparePre(a.Pre, b.Pre)
+}
+
+func compareNum(x, y uint64) int {
+	switch {
+	case x < y:
+		return -1
+	case x > y:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// comparePre compares pre-release identifier lists. A version without
+// a pre-release has higher precedence than one with one.
+func comparePre(a, b []string) int {
+	switch {
+	case len(a) == 0 && len(b) == 0:
+		return 0
+	case len(a) == 0:
+		return 1
+	case len(b) == 0:
+		return -1
+	}
+	for i := 0; i < len(a) && i < len(b); i++ {
+		switch c := compareIdentifier(a[i], b[i]); c {
+		case 0:
+		default:
+			return c
+		}
+	}
+	// All preceding identifiers are equal; the shorter list is lower.
+	switch {
+	case len(a) < len(b):
+		return -1
+	case len(a) > len(b):
+		return 1
+	default:
+		return 0
+	}
+}
+
+// compareIdentifier compares two pre-release identifiers: numeric
+// identifiers compare numerically (and are always lower than
+// alphanumeric ones); alphanumeric identifiers compare in ASCII
+// lexical order.
+func compareIdentifier(x, y string) int {
+	dx, dy := allDigits(x), allDigits(y)
+	switch {
+	case dx && dy:
+		nx, _ := strconv.ParseUint(x, 10, 64)
+		ny, _ := strconv.ParseUint(y, 10, 64)
+		return compareNum(nx, ny)
+	case dx:
+		return -1
+	case dy:
+		return 1
+	default:
+		return strings.Compare(x, y)
+	}
+}
+
+// MustParse parses s as a semantic version and panics if s is invalid.
+func MustParse(s string) Version {
+	v, err := Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
